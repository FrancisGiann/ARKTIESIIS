<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page" id="main-content">
  <% const latestDecision = document.decisions[0] || null; %>
  <% const correctionRequested = latestDecision ? latestDecision.decision_type === 'correction_requested' : document.reviewEvents[0]?.action_type === 'correction_requested'; %>
  <section class="dashboard-heading">
    <div>
      <h1><%= documentTypeLabel(document.document_type) %></h1>
      <p>Submission #<%= document.id %><% if (isStaff) { %> · <%= document.student_no %> · <%= [document.first_name, document.middle_name, document.last_name].filter(Boolean).join(' ') %><% } %></p>
    </div>
    <div class="admin-heading-actions">
      <a class="button button--secondary" href="<%= isStaff ? `/documents/students/${document.student_id}` : '/documents' %>"><%= isStaff ? 'Student documents' : 'My documents' %></a>
      <a class="button button--primary" href="/documents/<%= document.id %>/download">Download file</a>
    </div>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="admin-section" aria-labelledby="submission-title">
    <div class="admin-section__heading"><div><h2 id="submission-title">Submission</h2><p><% if (document.isArchivedReportCard) { %>This historical report card is retained as a read-only archive file. New grades use the teacher workbook review workflow.<% } else if (document.document_type === 'form_137') { %>This is a historical Form 137 file. New records use a separate physical status workflow; authorized staff may scan the paper for temporary local OCR suggestions. Scans and OCR results are not retained in that workflow.<% } else { %>The uploader selected the document type. OCR suggestions are advisory, and a registrar or database administrator must inspect the source file before making a decision.<% } %></p></div></div>
    <dl class="student-profile-grid">
      <div><dt>File name</dt><dd><%= document.original_filename %></dd></div>
      <div><dt>File type</dt><dd><%= document.mime_type %></dd></div>
      <div><dt>File size</dt><dd><%= (Number(document.file_size_bytes) / 1048576).toFixed(2) %> MB</dd></div>
      <div><dt>Status</dt><dd><%= documentStatusLabel(document.status, latestDecision?.decision_type, document.reviewEvents?.[0]?.action_type, document.document_type) %></dd></div>
      <div><dt>Uploaded</dt><dd><%= document.created_at ? new Date(document.created_at).toLocaleString() : '—' %></dd></div>
      <div><dt>Submission version</dt><dd><%= document.supersedes_document_id ? `Corrected from submission #${document.supersedes_document_id}` : 'Original submission' %></dd></div>
    </dl>
  </section>

  <% if (document.isArchivedReportCard) { %>
    <section class="admin-section"><p class="muted-copy">This historical report card can be read and downloaded by authorized staff. It does not enter current OCR or document-review workflows.</p></section>
  <% } else if (isStaff && document.document_type !== 'form_137') { %>
    <section class="admin-section" aria-labelledby="ocr-result-title">
      <div class="admin-section__heading"><div><h2 id="ocr-result-title">OCR result</h2><p>Extracted text is restricted to registrar and database administrator users. OCR does not determine document authenticity.</p></div></div>
      <% if (document.validation) { %>
        <p class="form-alert" role="status"><%= document.validation.message %></p>
        <dl class="student-profile-grid">
          <div><dt>Processing result</dt><dd><%= document.validation.result_status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) %></dd></div>
          <div><dt>Processor</dt><dd><%= document.validation.processor %></dd></div>
          <div><dt>Processed</dt><dd><%= document.validation.created_at ? new Date(document.validation.created_at).toLocaleString() : '—' %></dd></div>
        </dl>
        <% if (document.validation.extracted_text) { %>
          <details class="document-extracted-text"><summary>Show extracted text</summary><pre><%= document.validation.extracted_text %></pre></details>
        <% } %>
        <% if (document.validation.advisoryChecks?.length) { %>
          <div class="admin-section__heading"><div><h3>OCR suggestions for source inspection</h3><p>These checks only point to possible text. The student-name clue compares first and last name text found close together on one OCR line; it does not confirm that the document belongs to the linked student. OCR can omit or misread names, so staff must inspect the source. These checks do not establish acceptance or document authenticity.</p></div></div>
          <ul class="document-review-history"><% for (const check of document.validation.advisoryChecks) { %><li>
            <strong><%= check.key === 'linked_student_name' ? 'Possible linked student-name match' : check.label %></strong><span><%= check.found && (check.key === 'linked_student_name' || check.candidates?.length) ? 'Possible text identified' : 'Possible text not identified' %></span>
            <% if (check.candidates?.length) { %><ul><% for (const candidate of check.candidates) { %><li><%= candidate %></li><% } %></ul><% } %>
          </li><% } %></ul>
        <% } %>
      <% } else { %><p class="empty-state">No OCR result has been recorded for this submission.</p><% } %>
    </section>
  <% } else if (isStaff) { %>
    <section class="admin-section"><p class="muted-copy">This historical Form 137 file is available to authorized staff. Current status history is stored separately; temporary staff scan suggestions are returned only for inspection and are not saved as OCR data.</p></section>
  <% } %>

  <% if (isStaff && !document.isArchivedReportCard && document.document_type !== 'form_137' && ['needs_review', 'failed'].includes(document.status) && !['verified', 'rejected'].includes(latestDecision?.decision_type)) { %>
    <section class="admin-section" aria-labelledby="review-actions-title">
      <div class="admin-section__heading"><div><h2 id="review-actions-title">Staff review decision</h2><p>Inspect the source document, then complete the checklist to record verification, request a corrected upload, or reject it. The checklist records staff observations and does not determine authenticity. <% if (document.validation?.requiresOverrideReason) { %>A reason is required to verify despite an OCR warning or failure.<% } %></p></div></div>
      <div class="document-review-actions">
        <form class="form-stack document-review-action document-review-action--handoff" method="post" action="/documents/<%= document.id %>/review" data-submitting-message="Sending this submission for staff review. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="button button--secondary button--align-start" type="submit">Send for staff review</button>
        </form>
        <form class="form-stack document-review-action document-review-action--verification" method="post" action="/documents/<%= document.id %>/decision" data-submitting-message="Recording the staff decision. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="verified">
          <fieldset class="admin-fieldset">
            <legend>Required source-inspection checklist</legend>
            <p class="field-help">Check each item only after inspecting the submitted source. OCR suggestions do not complete this checklist.</p>
            <% for (const item of verificationChecklistItems) { %>
              <label class="checkbox-field"><input name="<%= item.key %>" value="yes" type="checkbox" required><span><%= item.label %></span></label>
            <% } %>
          </fieldset>
          <div class="field"><label for="verify-reason">Verification reason <%= document.validation?.requiresOverrideReason ? '(required for OCR warning or failure)' : '(optional)' %></label><textarea id="verify-reason" name="reason" rows="3" maxlength="1000" <%= document.validation?.requiresOverrideReason ? 'required' : '' %>></textarea></div>
          <button class="button button--primary button--align-start" type="submit">Record staff verification</button>
        </form>
        <form class="form-stack document-review-action document-review-action--correction" method="post" action="/documents/<%= document.id %>/correction" data-submitting-message="Sending the correction instruction. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="correction-instruction">Correction instruction <%= document.document_type === 'report_card' || (document.document_type === 'psa_birth_certificate' && document.upload_source !== 'student') ? 'for staff' : 'for the student' %></label><textarea id="correction-instruction" name="instruction" rows="4" maxlength="1000" required></textarea></div>
          <button class="button button--secondary button--align-start" type="submit">Request correction</button>
        </form>
        <form class="form-stack document-review-action document-review-action--rejection" method="post" action="/documents/<%= document.id %>/decision" data-submitting-message="Recording the staff decision. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="rejected">
          <div class="field"><label for="rejection-reason">Rejection reason</label><textarea id="rejection-reason" name="reason" rows="3" maxlength="1000" required></textarea></div>
          <button class="button button--secondary button--align-start" type="submit">Reject submission</button>
        </form>
      </div>
    </section>
    <% if (correctionRequested) { %>
      <section class="admin-section" aria-labelledby="staff-correction-title">
        <div class="admin-section__heading"><div><h2 id="staff-correction-title">Submit corrected file</h2><p>Upload a new linked submission while preserving this original.</p></div></div>
        <form class="form-stack document-upload-form" method="post" action="/documents/<%= document.id %>/reupload" enctype="multipart/form-data" data-submitting-message="Uploading the corrected document. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <p class="muted-copy" id="correction-file-help">Accepted file formats: PDF, JPEG, and PNG. Maximum size: <%= uploadMaxMb %> MB.</p>
          <div class="field"><label for="replacement-file">Corrected file</label><input id="replacement-file" name="document" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="correction-file-help" required></div>
          <button class="button button--primary button--align-start" type="submit">Upload corrected document</button>
        </form>
      </section>
    <% } %>

  <% } else if (!document.isArchivedReportCard && correctionRequested && (document.document_type !== 'psa_birth_certificate' || document.upload_source === 'student')) { %>
    <section class="admin-section" aria-labelledby="correction-title">
      <div class="admin-section__heading"><div><h2 id="correction-title">Correction requested</h2><p>Follow the instruction from staff, then upload the corrected file as a new submission.</p></div></div>
      <p class="form-alert" role="status"><%= latestDecision?.reason || document.reviewEvents[0]?.instruction %></p>
      <form class="form-stack document-upload-form" method="post" action="/documents/<%= document.id %>/reupload" enctype="multipart/form-data" data-submitting-message="Uploading the corrected document. Please wait.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p class="muted-copy" id="correction-file-help">Accepted file formats: PDF, JPEG, and PNG. Maximum size: <%= uploadMaxMb %> MB.</p>
        <div class="field"><label for="replacement-file">Corrected file</label><input id="replacement-file" name="document" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="correction-file-help" required></div>
        <button class="button button--primary button--align-start" type="submit">Upload corrected document</button>
      </form>
    </section>
  <% } %>

  <section class="admin-section" aria-labelledby="versions-title">
    <div class="admin-section__heading"><div><h2 id="versions-title">Submissions for this document type</h2><p>Each row is a separate stored file. Earlier submissions remain available.</p></div></div>
    <% if (document.history.length) { %>
      <div class="table-scroll document-history-scroll" tabindex="0" aria-label="Related document submissions">
        <table class="admin-table document-history-table"><caption class="visually-hidden">Submissions for this student and document type</caption>
          <thead><tr><th scope="col">Submission</th><th scope="col">File</th><th scope="col">Status</th><th scope="col">Date</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody><% for (const item of document.history) { %><tr>
            <td data-label="Submission">#<%= item.id %><% if (item.id === document.id) { %> · Current<% } else if (item.id === document.supersedes_document_id) { %> · Previous version<% } %></td>
            <td data-label="File"><%= item.original_filename %></td>
            <td data-label="Status"><%= documentStatusLabel(item.status, item.latest_decision_type, item.latest_review_action, document.document_type) %></td>
            <td data-label="Date"><%= item.created_at ? new Date(item.created_at).toLocaleString() : '—' %></td>
            <td data-label="Actions"><a class="table-action" href="/documents/<%= item.id %>">View</a> · <a class="table-action" href="/documents/<%= item.id %>/download">Download</a></td>
          </tr><% } %></tbody>
        </table>
      </div>
    <% } else { %><p class="empty-state">No related submissions are available.</p><% } %>
  </section>

  <% if (!document.isArchivedReportCard) { %><section class="admin-section" aria-labelledby="review-history-title">
    <div class="admin-section__heading"><div><h2 id="review-history-title">Review history</h2><p>Handoffs, source inspection decisions, and correction instructions recorded for this submission.</p></div></div>
    <% if (document.decisions.length || document.reviewEvents.length) { %>
      <ul class="document-review-history">
        <% for (const decision of document.decisions) { %>
          <li><strong><%= decision.decision_type === 'verified' ? 'Verified after staff source inspection' : decision.decision_type === 'rejected' ? 'Rejected after staff review' : 'Correction requested' %></strong><span><%= decision.created_at ? new Date(decision.created_at).toLocaleString() : '—' %><% if (isStaff) { %> · <%= decision.reviewer_name %><% } %></span>
            <% if (decision.reason) { %><p><%= decision.reason %></p><% } %>
            <% if (isStaff && decision.verificationChecklist?.length) { %><p>Staff source-inspection checklist:</p><ul><% for (const item of decision.verificationChecklist) { %><li><%= item %></li><% } %></ul><% } %>
          </li>
        <% } %>
        <% for (const event of document.reviewEvents) { %>
          <li><strong><%= event.action_type === 'correction_requested' ? 'Correction requested' : 'Sent for staff review' %></strong><span><%= event.created_at ? new Date(event.created_at).toLocaleString() : '—' %><% if (isStaff) { %> · <%= event.reviewer_name %><% } %></span>
            <% if (event.instruction) { %><p><%= event.instruction %></p><% } %>
          </li>
        <% } %>
      </ul>
    <% } else { %><p class="empty-state">No review events have been recorded.</p><% } %>
  </section><% } %>
</main>
<%- include('../partials/foot') %>
