<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page" id="main-content">
  <section class="dashboard-heading">
    <div>
      <h1>Documents · <%= student.student_no %></h1>
      <p><%= [student.first_name, student.middle_name, student.last_name].filter(Boolean).join(' ') %></p>
    </div>
    <a class="button button--secondary" href="/documents">All documents</a>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice === 'form137StatusRecorded' ? 'Form 137 status recorded.' : notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="admin-section" aria-labelledby="form137-status-title">
    <div class="admin-section__heading"><div><h2 id="form137-status-title">Form 137 physical record</h2><p>Scanning sends the paper's file bytes to this server for temporary local OCR. The temporary file is deleted after processing; neither the scan nor extracted OCR text is stored in the document record or database. Only the human-recorded status and instruction are saved. Inspect the physical paper before deciding.</p></div></div>
    <p><strong>Current status:</strong> <%= form137Status.status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) %></p>
    <% if (form137Status.instruction) { %><p class="form-alert" role="status"><%= form137Status.instruction %></p><% } %>
    <% if (form137Status.created_at) { %><p class="muted-copy">Updated <%= new Date(form137Status.created_at).toLocaleString() %></p><% } %>
    <% if (form137StatusHistory.length) { %>
      <ul class="document-review-history">
        <% for (const item of form137StatusHistory) { %><li>
          <strong><%= item.status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) %></strong>
          <span><%= item.created_at ? new Date(item.created_at).toLocaleString() : '—' %> · <%= item.recorded_by_name %></span>
          <% if (item.instruction) { %><p><%= item.instruction %></p><% } %>
        </li><% } %>
      </ul>
    <% } %>
    <form class="form-stack document-upload-form" method="post" action="/documents/students/<%= student.id %>/form137-status" data-submitting-message="Saving the recorded physical status. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-form-grid">
        <div class="field"><label for="form137-status">Record a physical status</label><select id="form137-status" name="status" required>
          <option value="pending">Pending</option><option value="received">Received</option><option value="verified">Verified</option><option value="correction">Correction needed</option><option value="rejected">Rejected</option>
        </select></div>
        <div class="field"><label for="form137-instruction">Instruction or note</label><textarea id="form137-instruction" name="instruction" rows="3" maxlength="1000"></textarea></div>
      </div>
      <p class="muted-copy">An instruction is required when choosing “Correction needed.”</p>
      <button class="button button--secondary button--align-start" type="submit">Save Form 137 status</button>
    </form>
    <% if (form137Scan) { %>
      <section class="admin-section" aria-labelledby="form137-scan-result-title">
        <div class="admin-section__heading"><div><h3 id="form137-scan-result-title">Temporary OCR suggestions</h3><p>These suggestions come from this scan response only. They do not prove authenticity, completeness, or acceptance. Inspect the paper original and record a human status above.</p></div></div>
        <% if (form137Scan.status === 'completed') { %><p class="form-success" role="status"><%= form137Scan.message %></p>
          <ul class="document-review-history"><% for (const suggestion of form137Scan.suggestions) { %><li>
            <strong><%= suggestion.label %></strong>
            <span><%= suggestion.found ? 'Possible text identified' : 'Possible text not identified' %></span>
            <% if (suggestion.candidates?.length) { %><ul><% for (const candidate of suggestion.candidates) { %><li><%= candidate %></li><% } %></ul><% } %>
          </li><% } %></ul>
        <% } else { %><p class="form-alert" role="status"><%= form137Scan.message %></p><% } %>
      </section>
    <% } %>
    <form class="form-stack document-upload-form" method="post" action="/documents/students/<%= student.id %>/form137-scan" enctype="multipart/form-data" data-submitting-message="Processing this temporary scan for suggestions. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="form137-scan-file">Temporary scan of the physical Form 137</label><input id="form137-scan-file" name="form137Scan" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="form137-scan-help" required></div>
      <p class="muted-copy" id="form137-scan-help">Accepted formats: PDF, JPEG, and PNG. Maximum size: <%= uploadMaxMb %> MB. A PDF may contain up to <%= typeof ocrMaxPdfPages === 'number' ? ocrMaxPdfPages : 20 %> pages.</p>
      <button class="button button--secondary button--align-start" type="submit">Scan temporarily for suggestions</button>
    </form>
  </section>

  <section class="admin-section" aria-labelledby="upload-title">
    <div class="admin-section__heading"><div><h2 id="upload-title">Upload a document</h2><p id="upload-format-help">Accepted file formats: PDF, JPEG, and PNG. Maximum size: <%= uploadMaxMb %> MB.</p></div></div>
    <form class="form-stack document-upload-form" method="post" action="/documents/students/<%= student.id %>" enctype="multipart/form-data" data-submitting-message="Uploading the document. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-form-grid">
        <div class="field">
          <label for="document-type">Document type</label>
          <select id="document-type" name="documentType" aria-describedby="upload-format-help" required><option value="">Choose a document type</option><% for (const type of documentTypes) { %><option value="<%= type.value %>"><%= type.label %></option><% } %></select>
        </div>
        <div class="field">
          <label for="document-file">File</label>
          <input id="document-file" name="document" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="upload-format-help" required>
        </div>
      </div>
      <button class="button button--primary button--align-start" type="submit">Upload document</button>
    </form>
  </section>

  <section class="admin-section" aria-labelledby="history-title">
    <div class="admin-section__heading"><div><h2 id="history-title">Submission history</h2><p>Files and review requests remain attached to each submission.</p></div></div>
    <% if (documents.length) { %>
      <div class="table-scroll document-history-scroll" tabindex="0" aria-label="Student document history">
        <table class="admin-table document-history-table"><caption class="visually-hidden">Student document submission history</caption>
          <thead><tr><th scope="col">Document</th><th scope="col">File</th><th scope="col">Status</th><th scope="col">Submitted</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody><% for (const document of documents) { %><tr>
            <td data-label="Document"><%= documentTypeLabel(document.document_type) %><% if (document.supersedes_document_id) { %><br><span class="muted-copy">Corrected submission</span><% } %></td>
            <td data-label="File"><%= document.original_filename %></td>
            <td data-label="Status"><%= documentStatusLabel(document.status, document.latest_decision_type, document.latest_review_action, document.document_type) %></td>
            <td data-label="Submitted"><%= document.created_at ? new Date(document.created_at).toLocaleString() : '—' %></td>
            <td data-label="Actions"><a class="table-action" href="/documents/<%= document.id %>">View details</a></td>
          </tr><% } %></tbody>
        </table>
      </div>
    <% } else { %><p class="empty-state">No documents have been uploaded for this student.</p><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
