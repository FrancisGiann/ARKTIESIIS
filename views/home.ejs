<%- include('partials/head', { title }) %>
<main class="page-shell home-page" id="main-content">
  <section class="home-intro" aria-labelledby="home-title">
    <h1 id="home-title">ARKTIESIIS school records, easier to find.</h1>
    <p>ARKTIESIIS gives staff one searchable place for student profiles, enrollment, academic history, and required-document status.</p>
    <section class="home-access" aria-labelledby="access-title">
      <h2 id="access-title">For school staff and students</h2>
      <p>Staff can manage school records and review documents. Students can sign in to view their own enrollment, classes, approved grades, documents, and finance activity.</p>
      <a class="button button--primary" href="/login">Sign in to ARKTIESIIS</a>
    </section>
  </section>
  <figure class="home-visual" aria-label="Lucena Branch campus">
    <img src="/images/arktiesiis-campus-building-hero.png" alt="Street view of the Ark Technological Institute Education System Incorporated building at Lucena Branch, with its blue glass facade and ARK sign visible." width="1672" height="941" fetchpriority="high">
    <figcaption>Ark Technological Institute Education System Incorporated · Lucena Branch</figcaption>
  </figure>
</main>
<%- include('partials/foot') %>
