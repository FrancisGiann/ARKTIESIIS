<%- include('partials/head', { title }) %>
<main class="home-page" id="main-content">
  <section class="home-hero" id="home-overview" aria-labelledby="home-title">
    <figure class="home-visual">
      <img src="/images/arktiesiis-campus-building-hero.png" alt="Street view of the Ark Technological Institute Education System Inc. building at Lucena Branch, with its blue glass facade and ARK sign visible." width="1672" height="941" fetchpriority="high">
      <figcaption>Ark Technological Institute Education System Inc. · Lucena Branch</figcaption>
    </figure>
    <div class="home-hero__copy">
      <h1 id="home-title">Welcome to ARKTIESIIS, Lucena Branch.</h1>
      <p>Ark Technological Institute Education System Inc. is the school behind this portal. Students and staff use ARKTIESIIS to stay close to the records and everyday information that shape the school day.</p>
      <div class="home-hero__actions">
        <a class="button button--primary home-sign-in" href="/login">Sign in to ARKTIESIIS</a>
        <a class="home-hero__secondary" href="#home-school-day">Explore the school portal</a>
      </div>
      <p class="home-hero__account-note">For access to an account at the school.</p>
    </div>
  </section>

  <section class="home-moment home-school-day" id="home-school-day" aria-labelledby="home-school-day-title">
    <div class="home-moment__heading">
      <h2 id="home-school-day-title">Keep the school day in view.</h2>
    </div>
    <div class="home-moment__copy">
      <p>Class schedules, enrollment details, and approved grades stay close together, so students can find the information connected to their school day.</p>
      <p class="home-school-day__details">Schedules <span aria-hidden="true">·</span> Enrollment <span aria-hidden="true">·</span> Approved grades</p>
    </div>
  </section>

  <section class="home-moment home-documents" id="home-documents" aria-labelledby="home-documents-title">
    <div class="home-documents__copy">
      <h2 id="home-documents-title">Keep school requirements moving with clear next steps.</h2>
      <p>Students can follow the status of permitted document submissions. Limited prechecks can support staff review; authorized staff inspect documents and make every acceptance decision.</p>
    </div>
  </section>

  <section class="home-access" id="home-access" aria-labelledby="home-access-title">
    <div class="home-access__copy">
      <h2 id="home-access-title">Connected to school life at ARKTIESIIS.</h2>
      <p>Sign in with your school account. Ask school staff for account access, or use the recovery option on the sign-in page if you have forgotten your password.</p>
    </div>
    <a class="button button--secondary" href="/login">Sign in</a>
  </section>
</main>
<%- include('partials/foot') %>
