<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page retake-page" id="main-content">
  <header class="dashboard-heading"><div><p class="eyebrow">Finance · Finalized Registrar referrals</p><h1>Retake review</h1><p>Only current finalized referrals appear here. Review each item as a charge with an approved amount and description, or record a reasoned no-charge decision.</p></div></header>
  <% if (notice) { %><p class="notice-panel" role="status"><%= notice %></p><% } %>
  <section class="finance-panel" aria-labelledby="retake-finance-queue-title">
    <div class="finance-panel__heading"><div><h2 id="retake-finance-queue-title">Referral items</h2><p>Registrar evaluation notes are not shared. Charge posting requires the target annual assessment and enrollment to remain current.</p></div></div>
    <% if (items.length) { %><div class="retake-items">
      <% for (const item of items) { %><article class="retake-item">
        <div class="retake-item__heading"><div><p class="eyebrow"><%= item.student_name %> · <%= item.student_no || 'Student number unavailable' %> · <%= item.school_year %> · <%= item.grade_level %></p><h3><%= item.subject_name %></h3></div><span class="status-pill"><%= item.finance_decision ? (item.finance_decision === 'no_charge' ? 'No charge recorded' : 'Charge linked') : (item.assessment_id ? 'Needs Finance decision' : 'Awaiting annual assessment') %></span></div>
        <dl class="finance-review-fields"><div><dt>Target term</dt><dd>Term <%= item.target_term_number %></dd></div><div><dt>Referral revision</dt><dd><%= item.revision_no %></dd></div><div><dt>Evaluation reference</dt><dd><%= item.evaluation_reference %></dd></div><div><dt>Finance-safe explanation</dt><dd><%= item.finance_explanation %></dd></div></dl>
        <p><a class="text-link" href="/finance/students/<%= item.student_id %>/annual?view=charges">Open student account fees</a></p>
        <% if (item.finance_decision) { %><p class="muted-copy"><% if (item.finance_decision === 'no_charge') { %>Finance reason: <%= item.decision_reason %><% } else { %><%= item.charge_description %> · ₱<%= item.approved_amount %> approved<% } %></p>
        <% } else if (item.assessment_id) { %><a class="button button--secondary" href="/finance/retake-referrals/items/<%= item.item_key_id %>">Review item</a>
        <% } else { %><p class="muted-copy">The target annual assessment must be posted before Finance can save either decision.</p><% } %>
      </article><% } %>
    </div><% } else { %><p class="dashboard-empty" role="status">No finalized retake items are waiting for Finance.</p><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
