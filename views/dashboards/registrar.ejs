<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page registrar-dashboard-page" id="main-content">
  <header class="dashboard-heading">
    <div>
      <h1>Registrar workspace</h1>
      <p>Review paper forms, find a student record, or continue to a registrar task.</p>
    </div>
  </header>

  <section class="registrar-overview" aria-labelledby="registrar-overview-heading">
    <div class="registrar-overview__top">
      <div>
        <h2 id="registrar-overview-heading">Enrollment overview</h2>
        <p>Choose a school year and term to review active enrollment.</p>
      </div>
      <% if (overview.schoolYears.length) { %>
        <div class="dashboard-filter-stack">
          <form class="dashboard-filter dashboard-filter--year" method="get" action="/registrar">
            <label class="field">
              <span>School year</span>
              <select name="schoolYear">
                <option value="" <%= !overview.selectedSchoolYear ? 'selected' : '' %>>Select a school year</option>
                <% overview.schoolYears.forEach((schoolYear) => { %><option value="<%= schoolYear %>" <%= overview.selectedSchoolYear === schoolYear ? 'selected' : '' %>><%= schoolYear %></option><% }); %>
              </select>
            </label>
            <button class="button button--secondary" type="submit">View school year</button>
          </form>
          <% if (overview.selectedSchoolYear) { %>
            <form class="dashboard-filter dashboard-filter--term" method="get" action="/registrar">
              <input type="hidden" name="schoolYear" value="<%= overview.selectedSchoolYear %>">
              <label class="field">
                <span>Configured term</span>
                <select name="termId">
                  <option value="">Select a term</option>
                  <% overview.schoolYearTerms.forEach((term) => { %>
                    <% const termName = typeof term.term === 'string' ? term.term.trim() : ''; %>
                    <% const termLabel = termName.toLocaleLowerCase() === `term ${term.termNumber}`.toLocaleLowerCase() ? `Term ${term.termNumber}` : [ `Term ${term.termNumber}`, termName ].filter(Boolean).join(' · '); %>
                    <option value="<%= term.academicTermId %>" <%= overview.selectedTerm?.academicTermId === term.academicTermId ? 'selected' : '' %>><%= termLabel %></option>
                  <% }); %>
                </select>
              </label>
              <button class="button button--secondary" type="submit">Apply term</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (!overview.schoolYears.length) { %>
      <p class="dashboard-empty" role="status">No school-year terms are configured yet. Configure the term order before reviewing term enrollment counts.</p>
    <% } else if (!overview.selectedSchoolYear) { %>
      <p class="dashboard-empty" role="status">No current school year is configured. Choose a school year to review enrollment.</p>
    <% } else { %>
      <% const selectedTermCounts = overview.selectedTerm && overview.termCounts.find((term) => term.academicTermId === overview.selectedTerm.academicTermId); %>
      <dl class="registrar-overview__selected">
        <div class="registrar-overview__lead">
          <dt><%= overview.selectedTerm ? `Active enrolled students · ${overview.selectedTerm.term}` : 'Active enrolled students' %></dt>
          <dd>
            <% if (overview.selectedTerm && overview.activeEnrolledCount !== null) { %>
              <% const activeTermQuery = new URLSearchParams({ schoolYear: overview.selectedSchoolYear, termId: String(overview.selectedTerm.academicTermId), status: 'enrolled', studentStatus: 'active' }); %>
              <a href="/registrar/intake?<%= activeTermQuery %>" aria-label="View <%= overview.activeEnrolledCount.toLocaleString('en-US') %> active enrolled students for <%= overview.selectedTerm.term %>"><%= overview.activeEnrolledCount.toLocaleString('en-US') %></a>
            <% } else { %><%= overview.activeEnrolledCount === null ? '—' : overview.activeEnrolledCount.toLocaleString('en-US') %><% } %>
          </dd>
          <% if (overview.needsTermSelection) { %><small>Select a configured term to view its active enrollment.</small><% } %>
        </div>
        <% if (overview.selectedTerm) { %>
          <% for (const [gradeLabel, gradeCount] of [['Grade 11', selectedTermCounts?.grade11], ['Grade 12', selectedTermCounts?.grade12]]) { %>
            <div class="registrar-overview__grade">
              <dt><%= gradeLabel %></dt>
              <dd>
                <% if (gradeCount !== undefined) { %>
                  <% const selectedGradeQuery = new URLSearchParams({ schoolYear: overview.selectedSchoolYear, termId: String(overview.selectedTerm.academicTermId), gradeLevel: gradeLabel, status: 'enrolled', studentStatus: 'active' }); %>
                  <a href="/registrar/intake?<%= selectedGradeQuery %>" aria-label="View <%= gradeCount.toLocaleString('en-US') %> active <%= gradeLabel %> enrolled students for Term <%= overview.selectedTerm.termNumber %>"><%= gradeCount.toLocaleString('en-US') %></a>
                <% } else { %>—<% } %>
              </dd>
            </div>
          <% } %>
        <% } %>
      </dl>

      <section class="registrar-overview__term-comparison" aria-labelledby="registrar-term-chart-title">
        <h3 class="visually-hidden" id="registrar-term-chart-title">Grade 11 and Grade 12 by term</h3>
        <% if (overview.termCounts.length) { %>
          <% const comparisonMaximum = Math.max(1, ...overview.termCounts.flatMap((term) => [term.grade11, term.grade12])); %>
          <figure class="dashboard-chart registrar-term-chart" aria-labelledby="registrar-term-chart-title">
            <figcaption class="visually-hidden">Active enrolled students by grade and configured term</figcaption>
            <ol class="dashboard-comparison registrar-term-chart__rows" aria-label="Active enrollment by configured term">
              <% for (const term of overview.termCounts) { const termName = typeof term.term === 'string' ? term.term.trim() : ''; const termLabel = termName.toLocaleLowerCase() === `term ${term.termNumber}`.toLocaleLowerCase() ? `Term ${term.termNumber}` : [`Term ${term.termNumber}`, termName].filter(Boolean).join(' · '); %>
                <li class="dashboard-comparison__row">
                  <h4 class="dashboard-comparison__term"><%= termLabel %></h4>
                  <dl class="dashboard-comparison__metrics">
                    <% for (const [gradeLabel, value] of [['Grade 11', term.grade11], ['Grade 12', term.grade12]]) { const enrolledTermQuery = new URLSearchParams({ schoolYear: overview.selectedSchoolYear, termId: String(term.academicTermId), gradeLevel: gradeLabel, status: 'enrolled', studentStatus: 'active' }); %>
                      <div class="dashboard-comparison__metric">
                        <dt><%= gradeLabel %></dt>
                        <dd><a href="/registrar/intake?<%= enrolledTermQuery %>" aria-label="View <%= value.toLocaleString('en-US') %> active <%= gradeLabel %> enrolled students for Term <%= term.termNumber %>"><%= value.toLocaleString('en-US') %></a><span class="dashboard-chart__track" aria-hidden="true"><span style="width: <%= Math.round(value / comparisonMaximum * 100) %>%"></span></span></dd>
                      </div>
                    <% } %>
                  </dl>
                </li>
              <% } %>
            </ol>
          </figure>
        <% } else { %><p class="dashboard-empty" role="status">No configured terms are available for <%= overview.selectedSchoolYear %>.</p><% } %>
      </section>

      <details class="registrar-overview__details">
        <summary>More enrollment counts and how they are counted</summary>
        <dl class="registrar-overview__secondary">
          <div><dt>Students finalized this year</dt><dd><%= overview.everFinalizedCount.toLocaleString('en-US') %></dd></div>
          <div><dt>Pending activation</dt><dd><% if (overview.selectedTerm) { %><% const pendingTermQuery = new URLSearchParams({ schoolYear: overview.selectedSchoolYear, termId: String(overview.selectedTerm.academicTermId), status: 'pending_payment', studentStatus: 'active' }); %><a href="/registrar/intake?<%= pendingTermQuery %>" aria-label="View <%= overview.pendingActivationCount.toLocaleString('en-US') %> active pending placements for <%= overview.selectedTerm.term %>"><%= overview.pendingActivationCount.toLocaleString('en-US') %></a><% } else { %><%= overview.pendingActivationCount.toLocaleString('en-US') %><% } %></dd></div>
          <div><dt>Departed placements</dt><dd><%= overview.departedCount.toLocaleString('en-US') %></dd><% if (overview.selectedTerm) { %><small><a href="/registrar/intake?<%= new URLSearchParams({ schoolYear: overview.selectedSchoolYear, termId: String(overview.selectedTerm.academicTermId), status: 'dropped' }) %>">Dropped <%= overview.droppedCount.toLocaleString('en-US') %></a> · <a href="/registrar/intake?<%= new URLSearchParams({ schoolYear: overview.selectedSchoolYear, termId: String(overview.selectedTerm.academicTermId), status: 'transferred' }) %>">Transferred <%= overview.transferredCount.toLocaleString('en-US') %></a></small><% } %></div>
        </dl>
        <p class="registrar-overview__method">Active counts include active students with enrolled placements. Legacy archive rows are excluded. “Students finalized this year” counts distinct students with a finalized applicable placement in the selected school year; pending and departed counts describe term placements.</p>
      </details>
    <% } %>
  </section>

  <section class="registrar-lookup registrar-lookup--primary" aria-labelledby="find-student-title">
    <div class="registrar-lookup__heading"><h2 id="find-student-title">Find a student</h2><a class="button button--secondary" href="/pre-enrollments">Review paper forms</a></div>
    <form class="admin-search registrar-lookup__form" method="get" action="/registrar/records">
      <div class="field"><label for="registrar-student-search">Student name, number, or LRN</label><input id="registrar-student-search" name="search" type="search" maxlength="100" autocomplete="off" required></div>
      <button class="button button--primary" type="submit">Search records</button>
      <a class="text-link" href="/registrar/records">Browse student records</a>
    </form>
  </section>

  <div class="registrar-task-layout">
    <section class="registrar-task-group" aria-labelledby="registrar-next-tasks">
      <h2 id="registrar-next-tasks">Enrollment and review</h2>
      <nav class="registrar-work-index" aria-label="Enrollment and review tasks">
        <a class="registrar-work-index__link" href="/pre-enrollments"><span><strong>Pre-enrollment records</strong><span>Review saved paper forms and start a new enrollment from a ready record.</span></span><span class="registrar-work-index__action">Review forms</span></a>
        <a class="registrar-work-index__link" href="/documents"><span><strong>Document review</strong><span>Review Good Moral, PSA, and Form 137 status from student records.</span></span><span class="registrar-work-index__action">Review documents</span></a>
        <a class="registrar-work-index__link" href="/registrar/grade-submissions"><span><strong>Grade review</strong><span>Review and approve submitted grades.</span></span><span class="registrar-work-index__action">Review submissions</span></a>
        <a class="registrar-work-index__link" href="/registrar/schedules"><span><strong>Class schedules</strong><span>Manage meeting times for assigned classes.</span></span><span class="registrar-work-index__action">Manage schedules</span></a>
      </nav>
    </section>
    <section class="registrar-task-group registrar-task-group--setup" aria-labelledby="registrar-setup-title">
      <h2 id="registrar-setup-title">Academic setup</h2>
      <p>Manage subjects and teacher assignments for classes.</p>
      <nav class="registrar-work-index" aria-label="Academic setup tasks">
        <a class="registrar-work-index__link" href="/registrar/records/subjects"><span><strong>Subjects</strong><span>Maintain subjects used for classes and academic records.</span></span><span class="registrar-work-index__action">Manage subjects</span></a>
        <a class="registrar-work-index__link" href="/registrar/records/teacher-assignments"><span><strong>Teacher assignments</strong><span>Assign teachers to a term, section, and subject.</span></span><span class="registrar-work-index__action">Manage assignments</span></a>
      </nav>
    </section>
  </div>
</main>
<%- include('../partials/foot') %>
