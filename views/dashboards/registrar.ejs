<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page registrar-dashboard-page" id="main-content">
  <section class="dashboard-heading">
    <div>
      <h1>Registrar dashboard</h1>
      <p>Registrar workspace · Lucena Branch</p>
    </div>
  </section>
  <% if (summary) { %>
    <section class="dashboard-summary registrar-dashboard-summary" aria-label="Registrar summary">
      <dl class="dashboard-summary-grid">
        <div><dt>Active student records</dt><dd><%= summary.active_student_count %></dd></div>
        <div><dt>Archived student records</dt><dd><%= summary.archived_student_count %></dd></div>
        <div><dt>Current enrollments</dt><dd><%= summary.current_enrollment_count %></dd></div>
        <div><dt>Documents awaiting staff review</dt><dd><%= summary.documents_awaiting_review_count %></dd></div>
        <div><dt>Documents queued or processing OCR</dt><dd><%= summary.documents_processing_count %></dd></div>
      </dl>
    </section>
  <% } %>
  <section class="registrar-workspace" aria-labelledby="academic-workspace-title">
    <div class="admin-section__heading">
      <div>
        <h2 id="academic-workspace-title">Registrar workspaces</h2>
        <p>Manage student profiles, enrollment history, the subject catalog, and grades. Grade entries are associated with an enrolled subject and a grading period.</p>
      </div>
    </div>
    <nav class="registrar-work-index" aria-label="Registrar workspaces">
      <a class="registrar-work-index__link" href="/records">
        <span><strong>Student records</strong><span>Profiles, academic terms, sections, and enrollment history.</span></span>
        <span class="registrar-work-index__action">Open workspace</span>
      </a>
      <a class="registrar-work-index__link" href="/documents">
        <span><strong>Document review</strong><span>Search student submissions and review their current status and history.</span></span>
        <span class="registrar-work-index__action">Open workspace</span>
      </a>
      <a class="registrar-work-index__link" href="/records/subjects">
        <span><strong>Subject catalog</strong><span>Manage subjects associated with academic records and grade entries.</span></span>
        <span class="registrar-work-index__action">Open workspace</span>
      </a>
      <a class="registrar-work-index__link" href="/records/teacher-assignments">
        <span><strong>Teacher assignments</strong><span>Assign a teacher to a school term, section, and subject.</span></span>
        <span class="registrar-work-index__action">Open workspace</span>
      </a>
      <a class="registrar-work-index__link" href="/registrar/grade-submissions">
        <span><strong>Teacher grade submissions</strong><span>Review workbook matches and conflicts before importing grades.</span></span>
        <span class="registrar-work-index__action">Open review queue</span>
      </a>
      <a class="registrar-work-index__link" href="/records/grade-import">
        <span><strong>Direct grade import</strong><span>Registrar fallback for direct imports from the corrected SSHS workbook.</span></span>
        <span class="registrar-work-index__action">Open workspace</span>
      </a>
    </nav>
  </section>
</main>
<%- include('../partials/foot') %>
