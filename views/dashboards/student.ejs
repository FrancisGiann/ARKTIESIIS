<%- include('../partials/head', { title }) %>
<main class="page-shell student-home" id="main-content">
  <% const student = ownRecords?.student || null; %>
  <% const currentEnrollment = ownRecords?.enrollments?.find((enrollment) => enrollment.is_current && enrollment.enrollment_status === 'enrolled'); %>
  <% const todaySchedules = classSchedule.filter((schedule) => Number(schedule.day_of_week) === new Date().getDay()); %>
  <% const currentPlacement = currentEnrollment ? formatStudentPlacement(currentEnrollment.grade_level, currentEnrollment.section_name) : ''; %>
  <header class="student-welcome">
    <div>
      <h1><%= student ? `Welcome, ${student.first_name || 'student'}` : 'Your school day' %></h1>
      <% if (currentEnrollment) { %>
        <p><span class="student-welcome__label">Current term</span> <%= currentEnrollment.school_year %> · <%= currentEnrollment.term %><% if (currentPlacement) { %> · <%= currentPlacement %><% } %></p>
      <% } else { %><p>Your current school day at a glance.</p><% } %>
    </div>
    <% if (student) { %><a class="button button--secondary" href="/student/records">My profile</a><% } %>
  </header>

  <% if (!student) { %>
    <section class="student-unlinked" aria-labelledby="unlinked-title">
      <h2 id="unlinked-title">Your student profile is not linked yet</h2>
      <p>Ask the registrar to connect your account. Once linked, your current schedule, grades, finance account, and enrollment history will appear in their own pages.</p>
    </section>
  <% } else { %>
    <section class="student-section student-schedule" aria-labelledby="today-schedule-title">
      <div class="student-section-heading">
        <div><h2 id="today-schedule-title">Today's classes</h2><p><%= new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' }) %></p></div>
        <a class="button button--primary student-schedule__action" href="/student/schedule">View full schedule</a>
      </div>
      <% if (todaySchedules.length) { %>
        <ol class="schedule-agenda">
          <% for (const schedule of todaySchedules) { %>
            <li class="schedule-agenda__row">
              <div class="schedule-agenda__day"><time><%= schedule.start_time %>–<%= schedule.end_time %></time></div>
              <div class="schedule-agenda__class"><strong><%= schedule.subject_name %></strong><span><%= formatStudentPlacement(schedule.grade_level, schedule.section_name) %> · <%= schedule.subject_code %></span></div>
              <div class="schedule-agenda__room"><span><%= schedule.room || 'Room TBA' %></span><span><%= schedule.teacher_name %></span></div>
            </li>
          <% } %>
        </ol>
      <% } else { %>
        <p class="empty-state"><%= classSchedule.length ? 'No classes are listed for today.' : 'Your schedule is not posted for this term yet.' %></p>
      <% } %>
    </section>
    <nav class="student-quick-links" aria-label="Student destinations">
      <a href="/student/grades">My grades</a>
      <a href="/documents">My documents</a>
      <a href="/student/finance">Finance activity</a>
    </nav>

  <% } %>
</main>
<%- include('../partials/foot') %>
