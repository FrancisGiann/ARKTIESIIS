<%- include('../partials/head', { title }) %>
<%
  const statusLabels = {
    draft: 'Draft',
    ready_for_registrar: 'Ready for registrar',
    enrollment_started: 'Enrollment started'
  };
  const eventLabels = {
    created: 'Record created',
    updated: 'Record corrected',
    submitted_ready: 'Submitted as ready',
    enrollment_started: 'Enrollment started'
  };
  const statusLabel = (value) => statusLabels[value] || String(value || 'None').replaceAll('_', ' ').replace(/\b\w/g, (character) => character.toUpperCase());
  const fieldLabel = (value) => String(value || '').replaceAll('_', ' ').replace(/\b\w/g, (character) => character.toUpperCase());
  const fullName = [record.first_name, record.middle_name, record.last_name, record.suffix].filter(Boolean).join(' ');
  const formatAddress = (formatted, blockLot, barangay, city, province, zip) => {
    const fields = [
      ['Block and lot, street/purok', blockLot], ['Barangay', barangay], ['City', city],
      ['Province', province], ['ZIP code', zip]
    ].filter(([, value]) => String(value || '').trim());
    return fields.length
      ? fields.map(([label, value]) => `${label}: ${value}`).join('\n')
      : formatted ? `Legacy free-text address: ${formatted}` : '—';
  };
  const recorderName = [record.creator_first_name, record.creator_last_name].filter(Boolean).join(' ') || 'Staff account';
  const updaterName = [record.updater_first_name, record.updater_last_name].filter(Boolean).join(' ') || 'Staff account';
  const timestampIso = (value) => {
    if (!value) return '';
    if (value instanceof Date) return value.toISOString();
    const raw = String(value).trim();
    return /(?:Z|[+-]\d{2}:?\d{2})$/i.test(raw) ? raw : `${raw.replace(' ', 'T')}Z`;
  };
  const displayTimestamp = (value) => {
    const isoValue = timestampIso(value);
    if (!isoValue) return '—';
    const date = new Date(isoValue);
    return Number.isNaN(date.getTime())
      ? String(value)
      : date.toLocaleString('en-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium', timeStyle: 'short' });
  };
  const displayDate = (value) => {
    const raw = value instanceof Date ? value.toISOString().slice(0, 10) : String(value || '');
    if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw || '—';
    return new Date(`${raw}T00:00:00Z`).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium' });
  };
  const statusClass = record.status === 'ready_for_registrar'
    ? 'pre-enrollment-status--ready'
    : record.status === 'enrollment_started' ? 'pre-enrollment-status--started' : 'pre-enrollment-status--draft';
  const applicantKindLabels = { new: 'New applicant', continuing: 'Continuing student', readmission: 'Returning after a break' };
%>
<main class="page-shell dashboard-page admin-page records-page pre-enrollment-page pre-enrollment-detail-page" id="main-content">
  <a class="context-back" href="/pre-enrollments">Back to pre-enrollment records</a>
  <header class="dashboard-heading pre-enrollment-detail-heading">
    <div class="pre-enrollment-detail-heading__copy">
      <h1><%= fullName || 'Pre-enrollment record' %></h1>
      <div class="pre-enrollment-detail-heading__meta" aria-label="Record summary">
        <span>School year <strong><%= record.school_year || '—' %></strong></span>
        <span class="status-chip pre-enrollment-status <%= statusClass %>"><%= statusLabels[record.status] || 'Draft' %></span>
        <span>Revision <strong><%= record.version %></strong></span>
      </div>
    </div>
    <div class="pre-enrollment-detail-actions">
      <% if (['front_desk', 'registrar'].includes(currentUser.role) && record.status !== 'enrollment_started') { %>
        <a class="button button--secondary" href="/pre-enrollments/<%= encodeURIComponent(record.id) %>/edit">Correct paper record</a>
      <% } %>
      <% if (currentUser.role === 'registrar' && record.status === 'ready_for_registrar') { %>
        <a class="button button--primary" href="/registrar/intake/new?preEnrollmentId=<%= encodeURIComponent(record.id) %>">Start enrollment</a>
      <% } %>
      <% if (record.status === 'enrollment_started') { %>
        <p class="pre-enrollment-readonly-note">Read-only after annual enrollment starts.</p>
      <% } %>
    </div>
  </header>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>

  <section class="form-section pre-enrollment-panel" aria-labelledby="paper-details-heading">
    <div class="pre-enrollment-panel__heading">
      <h2 id="paper-details-heading">Paper details</h2>
      <p>Transcribed from the paper form. The paper receiver may differ from the staff member who entered this record.</p>
    </div>
    <div class="pre-enrollment-detail-groups">
      <section class="pre-enrollment-detail-group" aria-labelledby="pre-student-heading">
        <h3 id="pre-student-heading">Student and contact</h3>
        <dl class="pre-enrollment-summary">
          <% for (const [label, value, spanTwo] of [
            ['Student name', fullName, true], ['LRN', record.lrn], ['Applicant status', applicantKindLabels[record.applicant_kind] || 'Not recorded'],
            ['Student contact number', record.student_contact_number], ['Contact and sign-in email', record.email, true],
            ['Birth date', displayDate(record.birth_date)], ['Gender', record.sex], ['Phone', record.profile_phone],
            ['Birthplace', record.birthplace], ['Facebook name', record.facebook_name, true],
            ['Student address', formatAddress(record.address, record.address_block_lot_street_purok, record.address_barangay, record.address_city, record.address_province, record.address_zip), true],
            ['Mother’s name', record.mother_name], ['Mother’s phone', record.mother_phone],
            ['Father’s name', record.father_name], ['Father’s phone', record.father_phone]
          ]) { %>
            <div class="<%= spanTwo ? 'pre-enrollment-summary__wide' : '' %>"><dt><%= label %></dt><dd><%= value || '—' %></dd></div>
          <% } %>
        </dl>
      </section>
      <section class="pre-enrollment-detail-group" aria-labelledby="pre-emergency-heading">
        <h3 id="pre-emergency-heading">Emergency contact</h3>
        <dl class="pre-enrollment-summary">
          <% for (const [label, value, spanTwo] of [
            ['Contact person', record.emergency_contact_person, true], ['Relationship', record.emergency_contact_relationship],
            ['Contact number', record.emergency_contact_phone],
            ['Address', formatAddress(record.emergency_contact_address, record.emergency_contact_address_block_lot_street_purok,
              record.emergency_contact_address_barangay, record.emergency_contact_address_city,
              record.emergency_contact_address_province, record.emergency_contact_address_zip), true]
          ]) { %><div class="<%= spanTwo ? 'pre-enrollment-summary__wide' : '' %>"><dt><%= label %></dt><dd><%= value || '—' %></dd></div><% } %>
        </dl>
      </section>
      <section class="pre-enrollment-detail-group" aria-labelledby="pre-program-heading">
        <h3 id="pre-program-heading">Program and previous school</h3>
        <dl class="pre-enrollment-summary">
          <% for (const [label, value, spanTwo] of [
            ['Voucher type as written', record.voucher_type_text, false],
            ['Voucher category as written', record.voucher_category_text, false],
            ['Preferred track', record.preferred_track, false],
            ['Preferred cluster', record.preferred_cluster, true],
            ['Grade to enroll', record.target_grade_level, false],
            ['Last grade level', record.prior_grade_level, false],
            ['School attended', record.prior_school, true]
          ]) { %>
            <div class="<%= spanTwo ? 'pre-enrollment-summary__wide' : '' %>"><dt><%= label %></dt><dd><%= value || '—' %></dd></div>
          <% } %>
        </dl>
      </section>
      <% if (record.applicant_kind === 'readmission') { %>
        <section class="pre-enrollment-detail-group" aria-labelledby="pre-readmission-heading">
          <h3 id="pre-readmission-heading">Return evaluation</h3>
          <% if (record.readmission_evaluation) { %>
            <p class="muted-copy">Bound to LRN <%= record.readmission_evaluation.applicant_lrn %>, <%= record.readmission_evaluation.school_year %>, <%= record.readmission_evaluation.target_grade_level %>. Saved revision <%= record.readmission_evaluation_version %> · current revision <%= record.readmission_evaluation.version %> · <%= record.readmission_evaluation.status === 'accepted' ? 'Accepted' : record.readmission_evaluation.status === 'under_review' ? 'Under review' : 'Not accepted' %><% if (Number(record.readmission_evaluation.version) !== Number(record.readmission_evaluation_version) || record.readmission_evaluation.status !== 'accepted') { %> · paper binding needs a registrar review<% } %></p>
            <% if (['registrar','database_admin'].includes(currentUser.role)) { const evaluationHref = record.readmission_evaluation.student_id ? `/registrar/records/students/${encodeURIComponent(record.readmission_evaluation.student_id)}/return-evaluations/${encodeURIComponent(record.readmission_evaluation_id)}` : `/registrar/records/return-evaluations/${encodeURIComponent(record.readmission_evaluation_id)}`; %><a class="text-link" href="<%= evaluationHref %>">Open return evaluation</a><% } %>
          <% } else { %><p class="muted-copy">Evaluation link <%= record.readmission_evaluation_id || 'not saved' %> · revision <%= record.readmission_evaluation_version || '—' %></p><% } %>
        </section>
      <% } %>
      <section class="pre-enrollment-detail-group" aria-labelledby="pre-paper-office-heading">
        <h3 id="pre-paper-office-heading">Signature and office record</h3>
        <dl class="pre-enrollment-summary">
          <div><dt>Student signature present</dt><dd><%= record.student_signature_present ? 'Yes' : 'No' %></dd></div>
          <div><dt>Student signature date</dt><dd><%= displayDate(record.student_signed_date) %></dd></div>
          <div><dt>Paper received by</dt><dd><%= record.received_by || '—' %></dd></div>
          <div><dt>Paper received date</dt><dd><%= displayDate(record.received_date) %></dd></div>
          <div><dt>Entered by</dt><dd><%= recorderName %></dd></div>
          <div><dt>Last updated by</dt><dd><%= updaterName %></dd></div>
        </dl>
      </section>
    </div>
  </section>

  <section class="form-section pre-enrollment-panel" aria-labelledby="requirements-heading">
    <div class="pre-enrollment-panel__heading">
      <h2 id="requirements-heading">Requirements received</h2>
      <p>Receipt indicators only. No document inspection or verification was recorded.</p>
    </div>
    <div class="table-wrap pre-enrollment-table-wrap" role="region" aria-label="Pre-enrollment receipt checklist" tabindex="0">
      <table class="data-table pre-enrollment-receipt-table">
        <thead>
          <tr><th scope="col">Requirement</th><th scope="col">Original</th><th scope="col">Photocopy</th></tr>
        </thead>
        <tbody>
          <% for (const [code, label] of requirements) {
            const receipt = record.receipts.find((row) => row.requirement_code === code) || {};
            const originalCount = Number(receipt.original_pieces);
            const photocopyCount = Number(receipt.photocopy_pieces);
          %>
            <tr>
              <th scope="row"><%= label %></th>
              <td><span class="pre-enrollment-receipt__status"><%= receipt.original_received ? 'Received' : 'Not recorded' %></span><% if (originalCount > 0) { %><span class="pre-enrollment-receipt__count"><%= originalCount %> piece<%= originalCount === 1 ? '' : 's' %></span><% } %></td>
              <td><span class="pre-enrollment-receipt__status"><%= receipt.photocopy_received ? 'Received' : 'Not recorded' %></span><% if (photocopyCount > 0) { %><span class="pre-enrollment-receipt__count"><%= photocopyCount %> piece<%= photocopyCount === 1 ? '' : 's' %></span><% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="form-section pre-enrollment-panel" aria-labelledby="history-heading">
    <div class="pre-enrollment-panel__heading">
      <h2 id="history-heading">Record history</h2>
      <p>Staff actions and changes for this paper record.</p>
    </div>
    <% if (record.events.length) { %>
      <ol class="pre-enrollment-history">
        <% for (const event of record.events) {
          const actorName = [event.first_name, event.last_name].filter(Boolean).join(' ') || 'Staff account';
          const eventDate = timestampIso(event.created_at);
        %>
          <li>
            <strong class="pre-enrollment-history__title"><%= eventLabels[event.event_type] || fieldLabel(event.event_type) %></strong>
            <p class="pre-enrollment-history__metadata">
              <span>Revision <%= event.version %></span>
              <span>Recorded by <%= actorName %></span>
              <span class="pre-enrollment-history__timestamp"><span>Manila time</span><time<% if (eventDate) { %> datetime="<%= eventDate %>"<% } %>><%= displayTimestamp(event.created_at) %></time></span>
            </p>
            <% if (event.from_status !== event.to_status) { %>
              <p class="pre-enrollment-history__transition"><span>Status changed</span><span><%= statusLabel(event.from_status) %> → <%= statusLabel(event.to_status) %></span></p>
            <% } %>
          </li>
        <% } %>
      </ol>
    <% } else { %>
      <p class="empty-state">No history has been recorded yet.</p>
    <% } %>

    <% if (record.revisions.length) { %>
      <details class="pre-enrollment-revision-details">
        <summary>Field revision details · <%= record.revisions.length %> change<%= record.revisions.length === 1 ? '' : 's' %></summary>
        <div class="table-wrap pre-enrollment-table-wrap pre-enrollment-revision-table-wrap" role="region" aria-label="Pre-enrollment field revision details" tabindex="0">
          <table class="data-table pre-enrollment-revision-table">
            <thead><tr><th scope="col">Field</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Recorded by</th><th scope="col">Date</th></tr></thead>
            <tbody>
              <% for (const revision of record.revisions) { %>
                <tr>
                  <th scope="row"><%= fieldLabel(revision.field_name) %></th>
                  <td><%= revision.before_value ?? '—' %></td>
                  <td><%= revision.after_value ?? '—' %></td>
                  <td><%= [revision.first_name, revision.last_name].filter(Boolean).join(' ') || 'Staff account' %></td>
                  <td><time<% if (timestampIso(revision.created_at)) { %> datetime="<%= timestampIso(revision.created_at) %>"<% } %>><%= displayTimestamp(revision.created_at) %></time></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </details>
    <% } else { %>
      <p class="pre-enrollment-no-revisions">No field corrections have been recorded.</p>
    <% } %>
  </section>
</main>
<%- include('../partials/foot') %>
