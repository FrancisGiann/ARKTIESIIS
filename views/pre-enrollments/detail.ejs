<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page pre-enrollment-page" id="main-content">
  <a class="context-back" href="/pre-enrollments">Back to pre-enrollment records</a>
  <header class="dashboard-heading"><div><h1><%= [record.first_name,record.middle_name,record.last_name,record.suffix].filter(Boolean).join(' ') || 'Pre-enrollment record' %></h1><p><%= record.school_year %> · <%= ({draft:'Draft',ready_for_registrar:'Ready for registrar',enrollment_started:'Enrollment started'})[record.status] %> · Revision <%= record.version %></p></div><% if (['front_desk','registrar'].includes(currentUser.role) && record.status !== 'enrollment_started') { %><a class="button button--secondary" href="/pre-enrollments/<%= encodeURIComponent(record.id) %>/edit">Correct paper record</a><% } %><% if (currentUser.role === 'registrar' && record.status === 'ready_for_registrar') { %><a class="button button--primary" href="/registrar/intake/new?preEnrollmentId=<%= encodeURIComponent(record.id) %>">Start enrollment</a><% } %></header>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <section class="form-section"><h2>Paper details</h2><dl class="pre-enrollment-summary">
    <% for (const [label, value] of [['LRN',record.lrn],['Student contact number',record.student_contact_number],['Voucher type as written',record.voucher_type_text],['Voucher category as written',record.voucher_category_text],['Preferred track',record.preferred_track],['Preferred cluster',record.preferred_cluster],['Grade to enroll',record.target_grade_level],['Last grade level',record.prior_grade_level],['School attended',record.prior_school],['Student signature present',record.student_signature_present ? 'Yes' : 'No'],['Student signature date',record.student_signed_date],['Paper received by',record.received_by],['Paper received date',record.received_date],['Authenticated recorder',`${record.creator_first_name || ''} ${record.creator_last_name || ''}`.trim()],['Last updated by',`${record.updater_first_name || ''} ${record.updater_last_name || ''}`.trim()]]) { %><div><dt><%= label %></dt><dd><%= value || '—' %></dd></div><% } %>
  </dl></section>
  <section class="form-section"><h2>Requirements received</h2><p>Receipt indicators only. No document verification was recorded.</p><div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">Requirement</th><th scope="col">Original</th><th scope="col">Photocopy</th></tr></thead><tbody><% for (const [code,label] of requirements) { const receipt = record.receipts.find((row) => row.requirement_code === code) || {}; %><tr><th scope="row"><%= label %></th><td><%= receipt.original_received ? 'Received' : 'Not recorded' %><% if (receipt.original_pieces) { %> · <%= receipt.original_pieces %> piece(s)<% } %></td><td><%= receipt.photocopy_received ? 'Received' : 'Not recorded' %><% if (receipt.photocopy_pieces) { %> · <%= receipt.photocopy_pieces %> piece(s)<% } %></td></tr><% } %></tbody></table></div></section>
  <section class="form-section"><h2>Record history</h2><ol class="pre-enrollment-history"><% for (const event of record.events) { %><li><strong><%= ({created:'Record created',updated:'Record corrected',submitted_ready:'Submitted as ready',enrollment_started:'Enrollment started'})[event.event_type] || event.event_type %></strong><span>Revision <%= event.version %> · <%= [event.first_name,event.last_name].filter(Boolean).join(' ') || 'Staff account' %> · <%= event.created_at %></span><% if (event.from_status !== event.to_status) { %><span>Status: <%= event.from_status || 'none' %> → <%= event.to_status %></span><% } %></li><% } %></ol>
    <% if (record.revisions.length) { %><details><summary>Field revision details</summary><div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">Field</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Recorded by</th><th scope="col">Date</th></tr></thead><tbody><% for (const revision of record.revisions) { %><tr><th scope="row"><%= revision.field_name.replaceAll('_',' ') %></th><td><%= revision.before_value || '—' %></td><td><%= revision.after_value || '—' %></td><td><%= [revision.first_name,revision.last_name].filter(Boolean).join(' ') || 'Staff account' %></td><td><%= revision.created_at %></td></tr><% } %></tbody></table></div></details><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
