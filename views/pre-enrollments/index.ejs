<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page pre-enrollment-page" id="main-content">
  <header class="dashboard-heading">
    <div><h1>Pre-enrollment records</h1><p>Transcribe paper forms and record only which papers were received.</p></div>
    <% if (currentUser.role !== 'database_admin') { %><a class="button button--primary" href="/pre-enrollments/new">Record paper form</a><% } %>
  </header>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <form class="filter-bar" method="get" action="/pre-enrollments">
    <div class="field"><label for="pre-search">Student name or LRN</label><input id="pre-search" name="search" value="<%= filters.search %>" maxlength="100"></div>
    <div class="field"><label for="pre-year">School year</label><input id="pre-year" name="schoolYear" value="<%= filters.schoolYear %>" maxlength="20"></div>
    <div class="field"><label for="pre-status">Status</label><select id="pre-status" name="status"><option value="">All statuses</option><% for (const [value, label] of [['draft','Draft'],['ready_for_registrar','Ready for registrar'],['enrollment_started','Enrollment started']]) { %><option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
    <button class="button button--secondary" type="submit">Search</button>
  </form>
  <p class="muted-copy" role="status"><%= pagination.totalRecords %> record<%= pagination.totalRecords === 1 ? '' : 's' %></p>
  <% if (rows.length) { %>
    <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">Student</th><th scope="col">LRN</th><th scope="col">School year</th><th scope="col">Status</th><th scope="col">Updated by</th><th scope="col">Updated</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>
    <% for (const row of rows) { %><tr><td data-label="Student"><%= [row.first_name, row.middle_name, row.last_name, row.suffix].filter(Boolean).join(' ') || 'Name not recorded' %></td><td data-label="LRN"><%= row.lrn || '—' %></td><td data-label="School year"><%= row.school_year %></td><td data-label="Status"><%= ({draft:'Draft',ready_for_registrar:'Ready for registrar',enrollment_started:'Enrollment started'})[row.status] %></td><td data-label="Updated by"><%= [row.recorder_first_name,row.recorder_last_name].filter(Boolean).join(' ') || 'Staff account' %></td><td data-label="Updated"><%= row.updated_at %></td><td data-label="Actions"><a class="table-action" href="/pre-enrollments/<%= encodeURIComponent(row.id) %>">Open record</a></td></tr><% } %>
    </tbody></table></div>
    <% if (pagination.totalPages > 1) { %><nav class="pagination" aria-label="Pre-enrollment pages"><% if (pagination.page > 1) { %><a href="?search=<%= encodeURIComponent(filters.search) %>&schoolYear=<%= encodeURIComponent(filters.schoolYear) %>&status=<%= encodeURIComponent(filters.status) %>&page=<%= pagination.page - 1 %>">Previous</a><% } %><span>Page <%= pagination.page %> of <%= pagination.totalPages %></span><% if (pagination.page < pagination.totalPages) { %><a href="?search=<%= encodeURIComponent(filters.search) %>&schoolYear=<%= encodeURIComponent(filters.schoolYear) %>&status=<%= encodeURIComponent(filters.status) %>&page=<%= pagination.page + 1 %>">Next</a><% } %></nav><% } %>
  <% } else { %><p class="notice-panel">No pre-enrollment records match these filters.</p><% } %>
</main>
<%- include('../partials/foot') %>
