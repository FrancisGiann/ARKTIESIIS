<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page pre-enrollment-page" id="main-content">
  <header class="dashboard-heading">
    <div><h1>Pre-enrollment records</h1><p>Copy the details from the student’s paper form and note which documents were received. Receipt does not mean a document was checked or verified.</p></div>
    <% if (currentUser.role === 'front_desk') { %><a class="button button--primary" href="/pre-enrollments/new">Record paper form</a><% } %>
  </header>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <form class="filter-bar pre-enrollment-filter-bar" method="get" action="/pre-enrollments">
    <div class="field"><label for="pre-search">Student name or LRN</label><input id="pre-search" name="search" value="<%= filters.search %>" maxlength="100"></div>
    <div class="field"><label for="pre-year">School year</label><input id="pre-year" name="schoolYear" value="<%= filters.schoolYear %>" maxlength="20"></div>
    <div class="field"><label for="pre-status">Status</label><select id="pre-status" name="status"><option value="">All statuses</option><% for (const [value, label] of [['draft','Draft'],['ready_for_registrar','Ready for registrar'],['enrollment_started','Enrollment started']]) { %><option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
    <button class="button button--secondary" type="submit">Search</button>
  </form>
  <p class="muted-copy" role="status"><%= pagination.totalRecords %> record<%= pagination.totalRecords === 1 ? '' : 's' %></p>
  <% if (rows.length) { %>
    <ul class="records-student-list pre-enrollment-record-list" aria-label="Pre-enrollment records">
      <% for (const row of rows) { const statusClass = row.status === 'ready_for_registrar' ? 'pre-enrollment-status--ready' : row.status === 'enrollment_started' ? 'pre-enrollment-status--started' : 'pre-enrollment-status--draft'; const fullName = [row.first_name, row.middle_name, row.last_name, row.suffix].filter(Boolean).join(' ') || 'Name not recorded'; %>
        <li class="records-student-list__item pre-enrollment-record-list__item">
          <div class="records-student-main pre-enrollment-record-list__identity">
            <strong><%= fullName %></strong>
            <span class="pre-enrollment-record-list__lrn">LRN <%= row.lrn || 'Not recorded' %></span>
          </div>
          <div class="pre-enrollment-record-list__year"><span class="muted-copy">School year</span><strong><%= row.school_year %></strong></div>
          <div class="pre-enrollment-record-list__status"><span class="muted-copy">Status</span><span class="status-chip pre-enrollment-status <%= statusClass %>"><%= ({draft:'Draft',ready_for_registrar:'Ready for registrar',enrollment_started:'Enrollment started'})[row.status] %></span></div>
          <div class="pre-enrollment-record-list__updated"><span class="muted-copy">Last updated</span><span><%= row.updated_at %></span><small>By <%= [row.recorder_first_name,row.recorder_last_name].filter(Boolean).join(' ') || 'staff account' %></small></div>
          <a class="button button--secondary records-student-open" aria-label="Open pre-enrollment record for <%= fullName %>" href="/pre-enrollments/<%= encodeURIComponent(row.id) %>">Open record</a>
        </li>
      <% } %>
    </ul>
    <% if (pagination.totalPages > 1) { %><nav class="pagination" aria-label="Pre-enrollment pages"><% if (pagination.page > 1) { %><a href="?search=<%= encodeURIComponent(filters.search) %>&schoolYear=<%= encodeURIComponent(filters.schoolYear) %>&status=<%= encodeURIComponent(filters.status) %>&page=<%= pagination.page - 1 %>">Previous</a><% } %><span>Page <%= pagination.page %> of <%= pagination.totalPages %></span><% if (pagination.page < pagination.totalPages) { %><a href="?search=<%= encodeURIComponent(filters.search) %>&schoolYear=<%= encodeURIComponent(filters.schoolYear) %>&status=<%= encodeURIComponent(filters.status) %>&page=<%= pagination.page + 1 %>">Next</a><% } %></nav><% } %>
  <% } else { %><p class="notice-panel">No pre-enrollment records match these filters.</p><% } %>
</main>
<%- include('../partials/foot') %>
