<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page pre-enrollment-page" id="main-content">
  <a class="context-back" href="<%= record ? `/pre-enrollments/${encodeURIComponent(record.id)}` : '/pre-enrollments' %>">Back to pre-enrollment records</a>
  <header class="dashboard-heading"><div><h1><%= record ? 'Correct pre-enrollment record' : 'Record paper pre-enrollment' %></h1><p>Transcribe the paper form. Receipt indicators record receipt only; they do not verify documents or set grades.</p></div></header>
  <% if (error) { %><p class="form-alert" role="alert" tabindex="-1"><%= error %></p><% } %>
  <% if (record?.status === 'enrollment_started') { %><p class="notice-panel">Annual enrollment has started. This paper record is read-only.</p><% } else { %>
  <form class="form-stack admin-form pre-enrollment-form" method="post" action="<%= record ? `/pre-enrollments/${encodeURIComponent(record.id)}` : '/pre-enrollments' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (record) { %><input type="hidden" name="version" value="<%= record.version %>"><% } else { %><input type="hidden" name="idempotencyKey" value="<%= values.idempotencyKey || '' %>"><% } %>
    <section class="form-section"><h2>Paper form</h2><div class="admin-form-grid">
      <div class="field"><label for="pre-school-year">School year</label><input id="pre-school-year" name="schoolYear" maxlength="20" required value="<%= values.schoolYear || '' %>"></div>
      <div class="field"><label for="pre-applicant-kind">Applicant status</label><select id="pre-applicant-kind" name="applicantKind"><% for (const [kind,label] of [['new','New applicant'],['continuing','Continuing student'],['readmission','Balik-aral applicant']]) { %><option value="<%= kind %>" <%= values.applicantKind === kind ? 'selected' : '' %>><%= label %></option><% } %></select><small>Known interruptions require an accepted registrar evaluation at enrollment.</small></div>
      <div class="field"><label for="pre-first">First name</label><input id="pre-first" name="firstName" maxlength="100" value="<%= values.firstName || '' %>"></div>
      <div class="field"><label for="pre-middle">Middle name <span class="muted-copy">(optional)</span></label><input id="pre-middle" name="middleName" maxlength="100" value="<%= values.middleName || '' %>"></div>
      <div class="field"><label for="pre-last">Last name</label><input id="pre-last" name="lastName" maxlength="100" value="<%= values.lastName || '' %>"></div>
      <div class="field"><label for="pre-suffix">Suffix <span class="muted-copy">(optional)</span></label><input id="pre-suffix" name="suffix" maxlength="20" value="<%= values.suffix || '' %>"></div>
      <div class="field"><label for="pre-lrn">LRN</label><input id="pre-lrn" name="lrn" inputmode="numeric" pattern="[0-9]{0,12}" maxlength="12" value="<%= values.lrn || '' %>"><small>A complete 12-digit LRN is required before the registrar can start enrollment.</small></div>
      <div class="field"><label for="pre-contact">Student contact number</label><input id="pre-contact" name="studentContactNumber" type="tel" maxlength="50" value="<%= values.studentContactNumber || '' %>"></div>
      <div class="field"><label for="pre-readmission-evaluation">Accepted balik-aral evaluation <span class="muted-copy">(required for balik-aral)</span></label><select id="pre-readmission-evaluation" name="readmissionEvaluationBinding"><option value="">Choose accepted evaluation</option><% for (const item of acceptedReadmissionChoices || []) { const binding = `${item.id}@${item.version}`; %><option value="<%= binding %>" <%= values.readmissionEvaluationBinding === binding || values.readmissionEvaluationId === item.id && Number(values.readmissionEvaluationVersion) === Number(item.version) ? 'selected' : '' %>><%= item.applicant_lrn %> · <%= item.first_name %> <%= item.last_name %> · <%= item.school_year %> · <%= item.target_grade_level %> · revision <%= item.version %></option><% } %></select><small>Choose the current accepted evaluation for this exact applicant, year, and grade. Registrar correction requires an explicit current selection when the saved binding is stale. Academic review notes remain registrar-only.</small></div>
      <div class="field"><label for="pre-voucher-type">Voucher type as written <span class="muted-copy">(optional)</span></label><input id="pre-voucher-type" name="voucherTypeText" maxlength="120" value="<%= values.voucherTypeText || '' %>"></div>
      <div class="field"><label for="pre-voucher-category">Voucher category as written <span class="muted-copy">(optional)</span></label><input id="pre-voucher-category" name="voucherCategoryText" maxlength="120" value="<%= values.voucherCategoryText || '' %>"></div>
      <div class="field"><label for="pre-track">Preferred track</label><select id="pre-track" name="preferredTrack"><option value="">Choose or leave blank</option><% for (const track of ['Academic Track','Tech-Pro Track']) { %><option value="<%= track %>" <%= values.preferredTrack === track ? 'selected' : '' %>><%= track %></option><% } %></select></div>
      <div class="field"><label for="pre-cluster">Preferred cluster</label><select id="pre-cluster" name="preferredCluster"><option value="">Choose or leave blank</option><% for (const cluster of ['ASSH (Arts, Social Science, and Humanities)','BE (Business & Entrepreneurship)','BE-TECH-PRO HM (Hospitality Management)','Hospitality and Tourism','ICT Support & Computer Programming']) { %><option value="<%= cluster %>" <%= values.preferredCluster === cluster ? 'selected' : '' %>><%= cluster %></option><% } %></select></div>
      <div class="field"><label for="pre-grade">Grade to enroll</label><select id="pre-grade" name="targetGradeLevel"><option value="">Choose or leave blank</option><% for (const grade of ['Grade 11','Grade 12']) { %><option value="<%= grade %>" <%= values.targetGradeLevel === grade ? 'selected' : '' %>><%= grade %></option><% } %></select></div>
      <div class="field"><label for="pre-prior-grade">Last grade level</label><input id="pre-prior-grade" name="priorGradeLevel" maxlength="80" value="<%= values.priorGradeLevel || '' %>"></div>
      <div class="field"><label for="pre-prior-school">School attended</label><input id="pre-prior-school" name="priorSchool" maxlength="200" value="<%= values.priorSchool || '' %>"></div>
      <label class="field field--check"><input type="checkbox" name="studentSignaturePresent" value="1" <%= values.studentSignaturePresent === true || values.studentSignaturePresent === 1 || values.studentSignaturePresent === '1' ? 'checked' : '' %>><span>Student signature is present on paper</span></label>
      <div class="field"><label for="pre-signed-date">Student signature date</label><input id="pre-signed-date" name="studentSignedDate" type="date" value="<%= values.studentSignedDate || '' %>"></div>
      <div class="field"><label for="pre-received-by">Paper received by</label><input id="pre-received-by" name="receivedBy" maxlength="100" value="<%= values.receivedBy || '' %>"></div>
      <div class="field"><label for="pre-received-date">Paper received date</label><input id="pre-received-date" name="receivedDate" type="date" value="<%= values.receivedDate || '' %>"></div>
    </div></section>
    <section class="form-section"><h2>Student profile and contact</h2><p>These values are saved from the front-desk record and become the new profile source. Email is required before Ready for registrar.</p><div class="admin-form-grid">
      <div class="field"><label for="pre-email">Contact and sign-in email</label><input id="pre-email" name="email" type="email" autocomplete="email" maxlength="255" value="<%= values.email || '' %>"></div>
      <div class="field"><label for="pre-birth-date">Birth date <span class="muted-copy">(optional)</span></label><input id="pre-birth-date" name="birthDate" type="date" value="<%= values.birthDate || '' %>"></div>
      <div class="field"><label for="pre-sex">Gender <span class="muted-copy">(optional)</span></label><select id="pre-sex" name="sex"><option value="">Not recorded</option><% for (const value of ['Male','Female','Other']) { %><option value="<%= value %>" <%= values.sex === value ? 'selected' : '' %>><%= value %></option><% } %></select></div>
      <div class="field"><label for="pre-profile-phone">Phone <span class="muted-copy">(optional)</span></label><input id="pre-profile-phone" name="profilePhone" type="tel" maxlength="50" value="<%= values.profilePhone || '' %>"></div>
      <div class="field"><label for="pre-birthplace">Birthplace <span class="muted-copy">(optional)</span></label><input id="pre-birthplace" name="birthplace" maxlength="160" value="<%= values.birthplace || '' %>"></div>
      <div class="field"><label for="pre-facebook-name">Facebook name <span class="muted-copy">(optional)</span></label><input id="pre-facebook-name" name="facebookName" maxlength="120" value="<%= values.facebookName || '' %>"></div>
    </div>
      <%- include('../records/partials/address-fields', { prefix: 'address', values, student: record }) %>
      <div class="admin-form-grid">
        <div class="field"><label for="pre-emergency-person">Emergency contact person <span class="muted-copy">(optional)</span></label><input id="pre-emergency-person" name="emergencyContactPerson" maxlength="160" value="<%= values.emergencyContactPerson || '' %>"></div>
        <div class="field"><label for="pre-emergency-relationship">Relationship <span class="muted-copy">(optional)</span></label><input id="pre-emergency-relationship" name="emergencyContactRelationship" maxlength="80" value="<%= values.emergencyContactRelationship || '' %>"></div>
        <div class="field"><label for="pre-emergency-phone">Emergency contact number <span class="muted-copy">(optional)</span></label><input id="pre-emergency-phone" name="emergencyContactPhone" type="tel" maxlength="50" value="<%= values.emergencyContactPhone || '' %>"></div>
        <div class="field"><label for="pre-mother-name">Mother’s name <span class="muted-copy">(optional)</span></label><input id="pre-mother-name" name="motherName" maxlength="160" value="<%= values.motherName || '' %>"></div>
        <div class="field"><label for="pre-mother-phone">Mother’s phone <span class="muted-copy">(optional)</span></label><input id="pre-mother-phone" name="motherPhone" type="tel" maxlength="50" value="<%= values.motherPhone || '' %>"></div>
        <div class="field"><label for="pre-father-name">Father’s name <span class="muted-copy">(optional)</span></label><input id="pre-father-name" name="fatherName" maxlength="160" value="<%= values.fatherName || '' %>"></div>
        <div class="field"><label for="pre-father-phone">Father’s phone <span class="muted-copy">(optional)</span></label><input id="pre-father-phone" name="fatherPhone" type="tel" maxlength="50" value="<%= values.fatherPhone || '' %>"></div>
      </div>
      <%- include('../records/partials/address-fields', { prefix: 'emergencyContactAddress', values, student: record }) %>
    </section>
    <section class="form-section"><h2>Requirements received</h2><p>Mark original and photocopy receipt separately and enter pieces when known. These entries do not record inspection, approval, or verification.</p><div class="pre-enrollment-receipts"><% for (const [code, label] of requirements) { %><fieldset class="pre-enrollment-receipt"><legend><%= label %></legend><label class="field field--check"><input type="checkbox" name="receipt_<%= code %>_original" value="1" <%= values[`receipt_${code}_original`] === '1' || values[`receipt_${code}_original`] === true || values[`receipt_${code}_original`] === 1 ? 'checked' : '' %>><span>Original received</span></label><div class="field"><label for="receipt-<%= code %>-original">Original pieces</label><input id="receipt-<%= code %>-original" name="receipt_<%= code %>_original_pieces" type="number" min="1" max="99" value="<%= values[`receipt_${code}_original_pieces`] ?? '' %>"></div><label class="field field--check"><input type="checkbox" name="receipt_<%= code %>_photocopy" value="1" <%= values[`receipt_${code}_photocopy`] === '1' || values[`receipt_${code}_photocopy`] === true || values[`receipt_${code}_photocopy`] === 1 ? 'checked' : '' %>><span>Photocopy received</span></label><div class="field"><label for="receipt-<%= code %>-photocopy">Photocopy pieces</label><input id="receipt-<%= code %>-photocopy" name="receipt_<%= code %>_photocopy_pieces" type="number" min="1" max="99" value="<%= values[`receipt_${code}_photocopy_pieces`] ?? '' %>"></div></fieldset><% } %></div></section>
    <section class="form-section"><h2>Record status</h2><div class="field"><label for="pre-status">Save as</label><select id="pre-status" name="status"><option value="draft" <%= values.status === 'draft' ? 'selected' : '' %>>Draft</option><option value="ready_for_registrar" <%= values.status === 'ready_for_registrar' ? 'selected' : '' %>>Ready for registrar</option></select><small>Ready status requires all checked paper details, including signature and date.</small></div></section>
    <div class="form-actions"><button class="button button--primary" type="submit"><%= record ? 'Save correction' : 'Save pre-enrollment record' %></button><a class="button button--secondary" href="<%= record ? `/pre-enrollments/${encodeURIComponent(record.id)}` : '/pre-enrollments' %>">Cancel</a></div>
  </form><% } %>
</main>
<%- include('../partials/foot') %>
