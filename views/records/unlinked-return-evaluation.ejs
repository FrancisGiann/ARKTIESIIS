<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page readmissions-page" id="main-content">
  <a class="context-back" href="/registrar/records">Back to student records</a>
  <header class="dashboard-heading">
    <div><h1><%= evaluation ? 'Return evaluation' : 'Evaluate return' %></h1><p>Use this review only for an applicant returning after a break. Continuing students follow the usual enrollment path. Saving this review does not create a student profile, account, or enrollment.</p></div>
    <% if (evaluation) { %><p class="status-pill"><%= ({under_review:'Under review',accepted:'Accepted',not_accepted:'Not accepted'})[evaluation.status] || evaluation.status %> · revision <%= evaluation.version %></p><% } %>
  </header>
  <% if (error) { %><p class="form-alert" role="alert" tabindex="-1"><%= error %></p><% } %>
  <% if (evaluation?.student_id) { %><p class="notice-panel" role="status">This applicant now has a linked student record. Open that record to continue the evaluation.</p><p><a class="button button--secondary" href="/registrar/records/students/<%= encodeURIComponent(evaluation.student_id) %>/return-evaluations/<%= encodeURIComponent(evaluation.id) %>">Open student record</a></p><% } else { %>
    <% if (evaluation?.status === 'accepted') { %><p class="notice-panel" role="status">The accepted applicant can continue through the fresh paper intake workflow.</p><% } %>
    <%- include('../partials/return-evaluation-form', { student: null, evaluation, returnEvaluationValues: values, currentUser, csrfToken, expectedVersion }) %>
  <% } %>
</main>
<%- include('../partials/foot') %>
