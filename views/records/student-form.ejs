<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <% if (student) { %>
    <a class="context-back" href="/registrar/records">Back to student search</a>
    <%- include('../partials/student-record-navigation', { student, activeStudentView: 'profile' }) %>
    <h2 class="student-record-view-title">Profile</h2>
  <% } else { %>
    <a class="context-back" href="/registrar/records">Back to student records</a>
    <section class="dashboard-heading"><div><h1>Create student profile</h1><p>Enter the student’s master record details. The number is assigned automatically from the current academic year.</p></div></section>
  <% } %>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="records-form-section records-profile-form-section" aria-labelledby="profile-title">
    <h2 id="profile-title">Profile details</h2>
    <p>Student profiles and history remain stored when a login is deactivated or the profile is archived.</p>
    <% if (student?.status === 'archived') { %><p class="form-alert" role="status">This student record is archived. Profile edits and new enrollments are disabled. Existing academic and finance history remains available for review, but cannot be changed.</p><% } %>
    <form class="form-stack admin-form" method="post" action="<%= student ? `/registrar/records/students/${student.id}` : '/registrar/records/students' %>" data-profile-validation <%= student ? 'data-allow-legacy-unspecified' : '' %> data-submitting-message="Saving the student profile. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset <%= student?.status === 'archived' ? 'disabled' : '' %>>
      <div class="admin-form-grid">
        <% if (student) { %><div class="field"><label for="student-no">Student number</label><input id="student-no" name="studentNo" type="text" maxlength="50" required value="<%= values.studentNo %>"<% if (currentUser.role === 'registrar') { %> readonly aria-describedby="student-number-help"<% } %>><% if (currentUser.role === 'registrar') { %><small id="student-number-help" class="field-help">Only a database administrator can correct a student number.</small><% } %></div><% } else { %><p class="field-help field--full">Student number will be generated as SHS-YYYY-0001, using the current academic year.</p><% } %>
        <div class="field"><label for="student-lrn">Learner Reference Number (LRN)</label><input id="student-lrn" name="lrn" type="text" inputmode="numeric" autocomplete="off" maxlength="12" pattern="[0-9]{12}" value="<%= values.lrn %>"<% if (!student || (student.lrn && currentUser.role === 'database_admin') || (!student.lrn && currentUser.role === 'registrar')) { %> required<% } %><% if (student?.lrn && currentUser.role === 'registrar') { %> readonly aria-describedby="student-lrn-help"<% } %>><small id="student-lrn-help" class="field-help"><% if (student?.lrn && currentUser.role === 'registrar') { %>A recorded LRN can be changed only by a database administrator.<% } else if (student && !student.lrn) { %>Enter the 12-digit LRN to backfill this existing student record.<% } else if (!student) { %>Enter the 12-digit LRN. It is used to match learners during grade import.<% } else { %>Only a database administrator can change a recorded LRN. Leave blank if this legacy record has no LRN yet.<% } %></small></div>
        <div class="field"><label for="first-name">First name</label><input id="first-name" name="firstName" type="text" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." required value="<%= values.firstName %>"></div>
        <div class="field"><label for="middle-name">Middle name (optional)</label><input id="middle-name" name="middleName" type="text" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.middleName %>"></div>
        <div class="field"><label for="last-name">Last name</label><input id="last-name" name="lastName" type="text" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." required value="<%= values.lastName %>"></div>
        <div class="field"><label for="suffix">Suffix (optional)</label><input id="suffix" name="suffix" type="text" maxlength="20" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.suffix %>"></div>
        <div class="field"><label for="birth-date">Birth date (optional)</label><input id="birth-date" name="birthDate" type="date" max="<%= maxBirthDate %>" value="<%= values.birthDate || '' %>"></div>
        <div class="field"><label for="sex">Gender (optional)</label><select id="sex" name="sex"><option value="" <%= values.sex ? '' : 'selected' %>>Not recorded</option><% for (const gender of ['Male', 'Female', 'Other']) { %><option value="<%= gender %>" <%= String(values.sex || '').toLowerCase() === gender.toLowerCase() ? 'selected' : '' %>><%= gender %></option><% } %><% if (values.sex === 'unspecified') { %><option value="unspecified" selected>Not recorded (existing value)</option><% } %></select></div>
        <div class="field"><label for="phone">Phone (optional)</label><input id="phone" name="phone" type="tel" maxlength="50" pattern="\+?[0-9\x28\x29\x20\x2d]{7,50}" title="Use 7 to 15 digits; a leading +, spaces, hyphens, and balanced parentheses are allowed." value="<%= values.phone %>"></div>
        <%- include('./partials/address-fields', { prefix: 'address', values, student }) %>
        <details class="student-profile-extra field--full">
          <summary>Background and family contacts <span class="muted-copy">Optional · staff only</span></summary>
          <div class="admin-form-grid">
            <div class="field"><label for="birthplace">Birthplace</label><input id="birthplace" name="birthplace" maxlength="160" value="<%= values.birthplace %>"></div>
            <div class="field"><label for="facebook-name">Facebook name</label><input id="facebook-name" name="facebookName" maxlength="120" value="<%= values.facebookName %>"></div>
            <div class="field"><label for="mother-name">Mother’s name</label><input id="mother-name" name="motherName" maxlength="160" value="<%= values.motherName %>"></div>
            <div class="field"><label for="mother-phone">Mother’s phone</label><input id="mother-phone" name="motherPhone" type="tel" maxlength="50" pattern="\+?[0-9\x28\x29\x20\x2d]{7,50}" title="Use 7 to 15 digits; a leading +, spaces, hyphens, and balanced parentheses are allowed." value="<%= values.motherPhone %>"></div>
            <div class="field"><label for="father-name">Father’s name</label><input id="father-name" name="fatherName" maxlength="160" value="<%= values.fatherName %>"></div>
            <div class="field"><label for="father-phone">Father’s phone</label><input id="father-phone" name="fatherPhone" type="tel" maxlength="50" pattern="\+?[0-9\x28\x29\x20\x2d]{7,50}" title="Use 7 to 15 digits; a leading +, spaces, hyphens, and balanced parentheses are allowed." value="<%= values.fatherPhone %>"></div>
            <div class="field"><label for="emergency-contact-person">Emergency contact person</label><input id="emergency-contact-person" name="emergencyContactPerson" maxlength="160" value="<%= values.emergencyContactPerson %>"></div>
            <div class="field"><label for="emergency-contact-relationship">Relationship to student</label><input id="emergency-contact-relationship" name="emergencyContactRelationship" maxlength="80" value="<%= values.emergencyContactRelationship %>"></div>
            <div class="field"><label for="emergency-contact-phone">Emergency contact phone</label><input id="emergency-contact-phone" name="emergencyContactPhone" type="tel" maxlength="50" pattern="\+?[0-9\x28\x29\x20\x2d]{7,50}" title="Use 7 to 15 digits; a leading +, spaces, hyphens, and balanced parentheses are allowed." value="<%= values.emergencyContactPhone %>"></div>
            <%- include('./partials/address-fields', { prefix: 'emergencyContactAddress', values, student }) %>
          </div>
        </details>
      </div>
      <div class="admin-form-actions"><button class="button button--primary" type="submit"><%= student ? 'Save profile' : 'Create profile' %></button><a class="button button--secondary" href="/registrar/records">Cancel</a></div>
      </fieldset>
    </form>
  </section>

  <% if (student) { %>
    <details class="student-profile-control">
      <summary><strong>Student login</strong><span>Linked account state and access controls</span></summary>
      <p>Linked account: <%= student.user_id ? (student.linked_account_is_active ? 'Active' : 'Inactive') : 'No login account linked' %></p>
      <% if (currentUser.role === 'registrar' && student.status !== 'archived' && student.user_id && student.linked_account_is_active) { %>
        <form class="form-stack records-compact-form" method="post" action="/registrar/records/students/<%= student.id %>/login/deactivate" data-submitting-message="Deactivating the linked student login. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="login-deactivate-confirmation">Type DEACTIVATE to disable this student login</label><input id="login-deactivate-confirmation" name="confirmation" type="text" maxlength="10" required autocomplete="off"></div>
          <button class="button button--secondary button--align-start" type="submit">Deactivate login</button>
        </form>
      <% } %>
      <% if (currentUser.role === 'database_admin' && student.status !== 'archived') { %>
        <form class="form-stack records-compact-form" method="post" action="/registrar/records/students/<%= student.id %>/archive" data-submitting-message="Archiving the student record. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <p>Archiving retains academic and finance history, marks the profile archived, and disables its linked student login.</p>
          <div class="field"><label for="archive-confirmation">Type <%= student.student_no %> to confirm archiving</label><input id="archive-confirmation" name="confirmation" type="text" maxlength="50" required autocomplete="off"></div>
          <button class="button button--secondary button--align-start" type="submit">Archive student record</button>
        </form>
      <% } %>
    </details>

    <details class="student-profile-control">
      <summary><strong>Enrollment history</strong><span>Review recorded terms and open annual enrollments</span></summary>
      <div class="student-profile-control__body">
      <% const annualRecords = annualEnrollments || []; const correctionRows = enrollments.filter((enrollment) => !enrollment.annual_enrollment_id); const correctionTermIds = new Set(correctionRows.map((enrollment) => String(enrollment.academic_term_id))); const correctionTerms = terms.filter((term) => correctionTermIds.has(String(term.id))); const correctionSections = sections.filter((section) => correctionTermIds.has(String(section.academic_term_id))); %>
      <% if (enrollments.length) { %>
        <div class="table-scroll" tabindex="0" aria-label="Student enrollment history">
          <table class="admin-table"><thead><tr><th scope="col">Academic term</th><th scope="col">Section</th><th scope="col">Status</th><th scope="col">Enrolled</th></tr></thead><tbody>
            <% for (const enrollment of enrollments) { %><tr>
              <td data-label="Academic term"><%= enrollment.school_year %> · <%= enrollment.term %></td>
              <td data-label="Section"><%= enrollment.section_name || 'Not assigned' %></td>
              <td data-label="Status"><%= enrollment.enrollment_status ? enrollment.enrollment_status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Unknown' %></td>
              <td data-label="Enrolled"><%= enrollment.enrolled_at ? new Date(enrollment.enrolled_at).toLocaleDateString() : '—' %></td>
            </tr><% } %>
          </tbody></table>
        </div>
      <% } else { %><p class="empty-state">This student has no enrollments.</p><% } %>
      <% if (annualRecords.length) { %>
        <section class="student-annual-records" aria-labelledby="student-annual-records-title">
          <h3 id="student-annual-records-title">Annual enrollment records</h3>
          <ul><% for (const record of annualRecords) { %><li><strong><%= record.school_year %> · <%= record.grade_level %></strong> · <%= record.intake_status.replaceAll('_', ' ') %>
            <% if (student.status !== 'archived') { %><a class="table-action" href="/registrar/intake/<%= record.annual_enrollment_id %>/manage">Open enrollment</a><% } %>
          </li><% } %></ul>
        </section>
      <% } %>
      <% if (student.status !== 'archived' && correctionTerms.length) { %><form class="form-stack records-enrollment-form" method="post" action="/registrar/records/enrollments">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="studentId" value="<%= student.id %>">
        <h3>Correct historical term record</h3>
        <p class="muted-copy">Only existing term rows without an annual intake link are available for correction. This does not start an annual enrollment.</p>
        <div class="admin-form-grid">
          <div class="field"><label for="enrollment-term">Existing historical term</label><select id="enrollment-term" name="academicTermId" required><option value="">Choose an existing term</option><% for (const term of correctionTerms) { %><option value="<%= term.id %>"><%= term.school_year %> · <%= term.term %></option><% } %></select></div>
          <div class="field"><label for="enrollment-section">Section (optional)</label><select id="enrollment-section" name="sectionId"><option value="">No section assigned</option><% for (const section of correctionSections) { %><option value="<%= section.id %>"><%= formatStudentPlacement(section.grade_level, section.name) %> — <%= section.school_year %> · <%= section.term %></option><% } %></select></div>
        </div>
        <button class="button button--primary button--align-start" type="submit">Save correction</button>
      </form><% } %>
      </div>
    </details>
  <% } %>
</main>
<script src="/js/student-profile-validation.js" defer></script>
<%- include('../partials/foot') %>
