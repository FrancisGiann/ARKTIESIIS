<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page annual-intake-review" id="main-content">
  <a class="context-back" href="/registrar/intake">Back to enrollments</a>
  <header class="dashboard-heading">
    <div>
      <h1>Review enrollment details</h1>
      <p>Check the saved student, placement, paper checklist, and Finance readiness before finalizing enrollment.</p>
    </div>
  </header>
  <nav class="intake-progress" aria-label="Enrollment steps">
    <ol><li><span class="intake-step-label--full">Student</span><span class="intake-step-label--short">Student</span></li><li><span class="intake-step-label--full">Enrollment</span><span class="intake-step-label--short">Enroll</span></li><li><span class="intake-step-label--full">Paper document review</span><span class="intake-step-label--short">Papers</span></li><li><span class="intake-step-label--full">Finance assessment</span><span class="intake-step-label--short">Finance</span></li><li aria-current="step"><span class="intake-step-label--full">Review details</span><span class="intake-step-label--short">Review</span></li></ol>
  </nav>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (sourceReviewRecovery?.formUnavailable) { %>
    <section class="admin-section" aria-label="Source review recovery">
      <p class="form-alert" role="alert">The source-review form is unavailable in the refreshed enrollment state. The save did not return confirmation; check the current state before retrying.</p>
      <% if (sourceReviewRecovery.reason) { %><p><strong>Submitted reason from this attempt:</strong> <%= sourceReviewRecovery.reason %></p><% } %>
    </section>
  <% } %>
  <% if (!record || !checklist || !financeReadiness) { %>
    <section class="admin-section"><p>The final review could not be loaded. Return to enrollments to try again.</p><a class="button button--secondary" href="/registrar/intake">Return to enrollments</a></section>
  <% } else { %>
    <% const parent = record.parent; const birthDate = parent.birth_date ? (parent.birth_date instanceof Date ? parent.birth_date.toISOString().slice(0, 10) : String(parent.birth_date).slice(0, 10)) : 'Not recorded'; const startDate = parent.enrollment_start_date ? (parent.enrollment_start_date instanceof Date ? parent.enrollment_start_date.toISOString().slice(0, 10) : String(parent.enrollment_start_date).slice(0, 10)) : 'Not recorded'; %>
    <% const statusLabel = (value) => {
      const normalized = typeof value === 'string' ? value.trim().toLowerCase() : '';
      const labels = {
        pending: 'Pending', enrolled: 'Enrolled', cancelled: 'Cancelled', dropped: 'Dropped', transferred: 'Transferred',
        legacy: 'Legacy', pending_payment: 'Pending payment', not_applicable: 'Not applicable', applicable: 'Applicable',
        received: 'Received', verified: 'Verified', correction: 'Correction requested', rejected: 'Rejected'
      };
      if (!normalized) return 'Not recorded';
      return labels[normalized] || normalized.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    }; %>
    <section class="admin-section" aria-labelledby="review-student-title">
      <div class="admin-section__heading"><div><h2 id="review-student-title">Student profile</h2><p>From the saved student record</p></div></div>
      <dl class="enrollment-summary-list">
        <div><dt>Student</dt><dd><%= [parent.first_name, parent.middle_name, parent.last_name, parent.suffix].filter(Boolean).join(' ') %></dd></div>
        <div><dt>Student number</dt><dd><%= parent.student_no || 'Not recorded' %></dd></div>
        <div><dt>LRN</dt><dd><%= parent.lrn || 'Not recorded' %></dd></div>
        <div><dt>Date of birth</dt><dd><%= birthDate %></dd></div>
        <div><dt>Gender</dt><dd><%= parent.sex || 'Not recorded' %></dd></div>
        <div><dt>Email</dt><dd><%= parent.student_email || 'Not recorded' %></dd></div>
        <div><dt>Phone</dt><dd><%= parent.phone || 'Not recorded' %></dd></div>
        <div><dt>Address</dt><dd><%= parent.address || 'Not recorded' %></dd></div>
      </dl>
    </section>

    <section class="admin-section" aria-labelledby="review-enrollment-title">
      <div class="admin-section__heading"><div><h2 id="review-enrollment-title">Annual enrollment</h2><p>School year <%= parent.school_year %> · <%= parent.grade_level %></p></div></div>
      <dl class="enrollment-summary-list">
        <div><dt>Intake type</dt><dd><%= ({ new: 'New student', continuing: 'Continuing student', readmission: 'Readmission', standard: 'New student', returning: 'Returning student', transferee: 'Transferee' })[parent.intake_kind] || 'Not recorded' %></dd></div>
        <div><dt>Voucher type</dt><dd><%= parent.voucher_code || 'Not recorded' %></dd></div>
        <div><dt>Entry term</dt><dd>Term <%= parent.entry_term_number || 'Not recorded' %></dd></div>
        <div><dt>Enrollment start date</dt><dd><%= startDate %></dd></div>
        <div><dt>Intake status</dt><dd><%= statusLabel(parent.intake_status) %></dd></div>
      </dl>
      <div class="table-scroll" tabindex="0" aria-label="Annual enrollment term placements">
        <table class="admin-table">
          <thead><tr><th scope="col">Term</th><th scope="col">Section</th><th scope="col">Placement</th><th scope="col">Status</th></tr></thead>
          <tbody><% for (const term of record.terms) { const standardTermLabel = term.annual_term_number ? `Term ${term.annual_term_number}` : 'Term not recorded'; const configuredTermLabel = typeof term.term === 'string' ? term.term.trim() : ''; const termLabel = configuredTermLabel && configuredTermLabel.toLowerCase() !== standardTermLabel.toLowerCase() ? `${standardTermLabel} · ${configuredTermLabel}` : standardTermLabel; %><tr>
            <th scope="row"><%= termLabel %></th>
            <td data-label="Section"><%= term.section_name ? formatStudentPlacement(term.grade_level || parent.grade_level, term.section_name) : 'No section selected' %><% if (term.section_name && (term.cluster || term.strand || term.modality)) { %><small><%= [term.cluster && `Cluster ${term.cluster}`, term.strand && `Strand ${term.strand}`, term.modality && term.modality.replaceAll('_', ' ')].filter(Boolean).join(' · ') %></small><% } %></td>
            <td data-label="Placement"><%= statusLabel(term.term_scope_status) %></td>
            <td data-label="Status"><%= statusLabel(term.enrollment_status) %></td>
          </tr><% } %></tbody>
        </table>
      </div>
      <% if (!record.parent.registrar_confirmation_id && parent.intake_status === 'pending') { %>
        <p><a class="button button--secondary" href="/registrar/intake/<%= annualId %>/pending-form">Print saved pending school e-form</a></p>
      <% } %>
      <p><a class="table-action" href="/registrar/records/students/<%= parent.student_id %>/edit">Edit profile or term placements</a></p>
    </section>

    <section class="admin-section" aria-labelledby="paper-clearance-review-title">
      <div class="admin-section__heading"><div><h2 id="paper-clearance-review-title">Earlier-term paper forms</h2><p>A registrar must record completion for each required earlier attended term after inspecting the returned paper form before this enrollment is finalized. Finance payments and document checklists are separate records.</p></div></div>
      <% if (!prerequisiteReview) { %><p class="form-alert" role="alert">Earlier-term paper review is unavailable. Enrollment confirmation is blocked.</p>
      <% } else if (prerequisiteReview.kind === 'exempt') { %>
        <p>This is a <%= prerequisiteReview.intakeKind === 'readmission' ? 'readmission' : 'new-student' %> entry. There is no internal preceding-year clearance gate for this first enrollment.</p>
      <% } else if (prerequisiteReview.kind === 'already_confirmed') { %>
        <p>This annual enrollment was already confirmed. Its original confirmation remains on record; paper clearance status is shown separately in the Clearance workspace.</p>
      <% } else { %>
        <% if (prerequisiteReview.kind === 'continuing_source') { %><p>Preceding school year: <%= prerequisiteReview.sourceSchoolYear || 'not yet selected from school records' %></p><% } %>
        <% if (prerequisiteReview.terms?.length) { %>
          <div class="table-scroll" tabindex="0" aria-label="Prior-year paper clearance requirements"><table class="admin-table">
            <thead><tr><th scope="col">Prior term</th><th scope="col">Attendance record</th><th scope="col">Paper clearance status</th></tr></thead>
            <tbody><% for (const term of prerequisiteReview.terms) { const labels = { complete: 'Completed', not_attended: 'Term not attended · reason recorded', not_applicable: 'Outside required terms', missing_placement: 'Not completed · placement record needed', missing: 'Not completed', unreviewed: 'Not completed', invalid_exclusion: 'Not completed · attendance reason needs correction', incomplete: 'Not completed' }; %><tr>
              <th scope="row"><%= term.termLabel %></th><td data-label="Attendance record"><%= term.state === 'not_attended' ? 'No attendance for the entire term' : term.state === 'not_applicable' ? 'Before entry or future term' : term.scopeStatus === 'attended' ? 'Attended' : 'Attendance not confirmed' %></td><td data-label="Paper clearance status"><%= labels[term.state] || 'Not completed' %></td>
            </tr><% } %></tbody>
          </table></div>
        <% } %>
        <% if (prerequisiteReview.blockers?.length) { %><ul class="form-alert" aria-label="Paper form items to resolve"><% for (const blocker of prerequisiteReview.blockers) { %><li><%= blocker %></li><% } %></ul><% } else { %><p class="form-success" role="status">All required earlier-term paper forms are complete.</p><% } %>
        <p><a class="table-action" href="/registrar/records/students/<%= parent.student_id %>/clearance">Open this student’s Clearance workspace</a></p>
        <% if (sourceOptions && !sourceOptions.sourceLocked) { %>
          <form class="form-stack admin-form" method="post" action="/registrar/intake/<%= annualId %>/continuity-source" <% if (sourceReviewRecovery?.hasRetainedValues) { %>data-unsaved-initially-dirty="true"<% } %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= values.sourceBindingIdempotencyKey %>">
            <fieldset class="admin-fieldset"><legend>Bind the audited preceding school year</legend>
              <p>Choose the matching preceding school year and grade from the student’s school records. This review is retained with the enrollment.</p>
              <div class="field"><label for="continuity-source-id">Preceding school year and grade</label><select id="continuity-source-id" name="sourceAnnualId" required><option value="" <%= sourceReviewRecovery && !sourceReviewRecovery.selectedSourceAnnualId ? 'selected' : '' %>>Choose the verified source</option><% for (const source of sourceOptions.candidates.filter((candidate) => candidate.selectable)) { const sourceId = String(source.id); %><option value="<%= sourceId %>" <%= sourceReviewRecovery?.selectedSourceAnnualId === sourceId ? 'selected' : '' %>><%= source.schoolYear %> · <%= source.gradeLevel %></option><% } %></select></div>
              <% if (sourceReviewRecovery?.sourceUnavailable) { %><p class="form-alert" role="alert">The source submitted earlier is no longer eligible. Choose an available school record before saving.</p><% } %>
              <% if (!sourceOptions.candidates.some((candidate) => candidate.selectable)) { %><p>No eligible source is available in the exact prior school year. Resolve the registrar record instead of selecting another year.</p><% } %>
              <div class="field"><label for="continuity-source-reason">School-record review reason</label><textarea id="continuity-source-reason" name="reason" rows="2" maxlength="1000" required><%= sourceReviewRecovery?.reason || '' %></textarea></div>
              <button class="button button--secondary" type="submit" <%= sourceOptions.candidates.some((candidate) => candidate.selectable) ? '' : 'disabled' %>>Save source review</button>
            </fieldset>
          </form>
        <% } %>
      <% } %>
    </section>

    <section class="admin-section" aria-labelledby="review-papers-title">
      <div class="admin-section__heading"><div><h2 id="review-papers-title">Paper checklist</h2><p><%= checklist.summary.completeCount %> of <%= checklist.summary.requiredCount %> applicable required items recorded as verified or not applicable.</p></div></div>
      <div class="table-scroll" tabindex="0" aria-label="Submitted paper requirements and checklist statuses">
        <table class="admin-table">
          <thead><tr><th scope="col">Requirement</th><th scope="col">Status</th><th scope="col">Received</th><th scope="col">Registrar note</th></tr></thead>
          <tbody><% for (const item of checklist.requirements) { const notApplicable = item.is_applicable === 0 || item.is_applicable === false; %><tr>
            <th scope="row"><%= item.requirement_name %><% if (item.is_optional) { %><small>Optional</small><% } %></th>
            <td data-label="Status"><%= statusLabel(notApplicable ? 'not_applicable' : item.status) %></td>
            <td data-label="Received"><% if (notApplicable) { %>—<% } else { %><%= item.originals_required ? `${item.originals_received || 0} originals` : '' %><%= item.copies_required ? `${item.originals_required ? ', ' : ''}${item.copies_received || 0} photocopies` : '' %><%= item.pieces_required ? `${item.originals_required || item.copies_required ? ', ' : ''}${item.pieces_received || 0} pieces` : '' %><% if (!item.originals_required && !item.copies_required && !item.pieces_required) { %>No count required<% } %><% } %></td>
            <td data-label="Registrar note"><%= item.note || '—' %></td>
          </tr><% } %></tbody>
        </table>
      </div>
      <p><a class="table-action" href="/documents/students/<%= parent.student_id %>#physical-checklist-title">Update paper checklist</a></p>
    </section>

    <section class="admin-section" aria-labelledby="review-finance-title">
      <div class="admin-section__heading"><div><h2 id="review-finance-title">Finance readiness</h2><p>Entry term: Term <%= financeReadiness.entryTermNumber %>. Fee amounts and optional selections are managed by Finance.</p></div></div>
      <% if (record.parent.registrar_confirmation_id) { %>
        <p class="form-success" role="status">This annual enrollment already has a Registrar confirmation on record. Later Finance activity does not undo that confirmation.</p>
      <% } else { const readinessLabels = {
        awaiting_finance_assessment: 'Awaiting Finance assessment', finance_review_required: 'Finance review or DP setup required',
        awaiting_down_payment: 'Awaiting entry-term DP settlement', ready_for_registrar: 'Ready for Registrar'
      }; %>
        <p><strong><%= readinessLabels[financeReadiness.status] || 'Finance review required' %></strong></p>
        <% if (financeReadiness.status === 'awaiting_finance_assessment') { %>
          <p>Finance selects the approved fee schedule and optional fees, posts the assessment, and records its review.</p>
        <% } else if (financeReadiness.status === 'awaiting_down_payment') { %>
          <p>The full scheduled tuition DP for this exact entry term must be settled through eligible allocations. Unallocated or unrelated credit and the remaining annual balance do not change this check.</p>
        <% } else if (financeReadiness.status === 'ready_for_registrar') { %>
          <p>Finance reviewed the current assessment and the full entry-term tuition DP is settled. Complete the Registrar review below to finalize enrollment.</p>
        <% } else { %>
          <p>Finance must review the current assessment and confirm the scheduled entry-term DP setup. A missing DP schedule cannot be treated as zero.</p>
        <% } %>
      <% } %>
    </section>

    <section class="admin-section fee-confirmation" aria-labelledby="review-confirm-title">
      <% if (confirmationComplete) { %>
        <div class="admin-section__heading"><div><h2 id="review-confirm-title">Enrollment already confirmed</h2><p>This annual enrollment has a registrar confirmation on record.</p></div></div>
        <a class="button button--secondary" href="/registrar/intake/<%= annualId %>/manage">Open student record</a>
      <% } else { %>
        <div class="admin-section__heading"><div><h2 id="review-confirm-title">Finalize enrollment</h2><p>Confirming reuses Finance’s reviewed assessment and activates the entry term after its full tuition DP is settled.</p></div></div>
        <% if (!prerequisiteReview?.ready) { %><p class="form-alert" role="alert">Resolve each earlier-term paper form item above before confirming enrollment.</p><% } %>
        <form method="post" action="/registrar/intake/<%= annualId %>/confirm" class="fee-confirmation__form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="idempotencyKey" value="<%= values.idempotencyKey %>">
          <input type="hidden" name="clearanceSnapshotFingerprint" value="<%= prerequisiteReview?.fingerprint || '' %>">
          <button class="button button--primary" type="submit" <%= prerequisiteReview?.ready && financeReadiness.status === 'ready_for_registrar' ? '' : 'disabled' %>>Confirm enrollment</button>
          <a class="button button--secondary" href="/registrar/intake/<%= annualId %>/manage">Back to student record</a>
        </form>
      <% } %>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
