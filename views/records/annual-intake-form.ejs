<%- include('../partials/head', { title }) %>
<% const initialEntryTerm = Number(values.entryTermNumber || 1); %>
<main class="page-shell dashboard-page admin-page records-page registrar-intake" id="main-content">
  <a class="context-back" href="/registrar/intake">Back to annual enrollment</a>
  <header class="dashboard-heading">
    <div><h1>Enroll a student</h1>
      <p>Enter the student, choose the annual section, record any papers received, then review the configured fees.</p></div>
  </header>
  <% if (error) { %><p class="form-alert" role="alert" tabindex="-1" data-wizard-error><%= error %></p><% } %>
  <ol class="intake-steps" aria-label="Enrollment steps">
    <li data-step-indicator="1" aria-label="Step 1 of 4: Student"><span class="intake-step-label--full">Student</span><span class="intake-step-label--short">Student</span></li>
    <li data-step-indicator="2" aria-label="Step 2 of 4: Enrollment"><span class="intake-step-label--full">Enrollment</span><span class="intake-step-label--short">Enroll</span></li>
    <li data-step-indicator="3" aria-label="Step 3 of 4: Documents received"><span class="intake-step-label--full">Documents received</span><span class="intake-step-label--short">Documents</span></li>
    <li data-step-indicator="4" aria-label="Step 4 of 4: Fees and confirmation"><span class="intake-step-label--full">Fees and confirmation</span><span class="intake-step-label--short">Fees</span></li>
  </ol>
  <form class="form-stack admin-form annual-intake-form" method="post" action="/registrar/intake"
    data-intake-wizard data-active-step="<%= activeStep || 1 %>" data-submitting-message="Saving the student and paper updates. Please wait.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="<%= values.idempotencyKey || idempotencyKey %>">

    <section class="intake-step" data-step-panel="1" aria-labelledby="intake-student-heading">
      <div class="intake-step__heading"><h2 id="intake-student-heading">Student details</h2></div>
        <p>Returning students keep their existing profile, login, and paper checklist history. <a href="/registrar/records" target="_blank" rel="noopener">Find a student by name or LRN</a> if you do not know the student number.</p>
      <div class="admin-form-grid">
        <div class="field"><label for="annual-student-mode">Student record</label>
          <select id="annual-student-mode" aria-controls="new-student-fields">
            <option value="new" <%= values.studentNo ? '' : 'selected' %>>New student</option>
            <option value="returning" <%= values.studentNo ? 'selected' : '' %>>Returning student</option>
          </select>
        </div>
        <div class="field" id="returning-student-field"><label for="annual-student-no">Existing student number</label>
          <input id="annual-student-no" name="studentNo" maxlength="50" autocomplete="off" value="<%= values.studentNo || '' %>">
          <small>Enter the student number from the existing student record.</small>
        </div>
      </div>
      <div class="admin-form-grid" id="new-student-fields">
        <div class="field"><label for="annual-lrn">Learner Reference Number (LRN)</label><input id="annual-lrn" name="lrn" inputmode="numeric" pattern="[0-9]{12}" maxlength="12" value="<%= values.lrn || '' %>"></div>
        <div class="field"><label for="annual-email">Contact and sign-in email</label><input id="annual-email" name="email" type="email" autocomplete="email" maxlength="255" value="<%= values.email || '' %>"></div>
        <div class="field"><label for="annual-first-name">First name</label><input id="annual-first-name" name="firstName" maxlength="100" value="<%= values.firstName || '' %>"></div>
        <div class="field"><label for="annual-middle-name">Middle name <span class="muted-copy">(optional)</span></label><input id="annual-middle-name" name="middleName" maxlength="100" value="<%= values.middleName || '' %>"></div>
        <div class="field"><label for="annual-last-name">Last name</label><input id="annual-last-name" name="lastName" maxlength="100" value="<%= values.lastName || '' %>"></div>
        <div class="field"><label for="annual-suffix">Suffix <span class="muted-copy">(optional)</span></label><input id="annual-suffix" name="suffix" maxlength="20" value="<%= values.suffix || '' %>"></div>
        <div class="field"><label for="annual-birth-date">Birth date <span class="muted-copy">(optional)</span></label><input id="annual-birth-date" name="birthDate" type="date" value="<%= values.birthDate || '' %>"></div>
        <div class="field"><label for="annual-sex">Gender <span class="muted-copy">(optional)</span></label><input id="annual-sex" name="sex" maxlength="20" value="<%= values.sex || '' %>"></div>
        <div class="field"><label for="annual-phone">Phone <span class="muted-copy">(optional)</span></label><input id="annual-phone" name="phone" type="tel" maxlength="50" value="<%= values.phone || '' %>"></div>
        <div class="field field--full"><label for="annual-address">Address <span class="muted-copy">(optional)</span></label><textarea id="annual-address" name="address" maxlength="500" rows="2"><%= values.address || '' %></textarea></div>
      </div>
      <div class="intake-actions"><button class="button button--primary" type="button" data-step-next>Continue to enrollment</button><a class="button button--secondary" href="/registrar/intake">Cancel</a></div>
    </section>

    <section class="intake-step" data-step-panel="2" aria-labelledby="intake-enrollment-heading">
      <div class="intake-step__heading"><h2 id="intake-enrollment-heading">Enrollment details</h2></div>
      <div class="admin-form-grid">
        <div class="field"><label for="annual-school-year">School year</label><select id="annual-school-year" name="schoolYear" required><option value="">Choose school year</option><% for (const year of schoolYears) { %><option value="<%= year.school_year %>" <%= values.schoolYear === year.school_year ? 'selected' : '' %>><%= year.school_year %></option><% } %></select></div>
        <div class="field"><label for="annual-grade">Grade level</label><select id="annual-grade" name="gradeLevel" required><option value="">Choose grade</option><% for (const grade of ['Grade 11', 'Grade 12']) { %><option value="<%= grade %>" <%= values.gradeLevel === grade ? 'selected' : '' %>><%= grade %></option><% } %></select></div>
        <div class="field"><label for="annual-voucher">Voucher classification</label><select id="annual-voucher" name="voucherCode" required><option value="">Choose voucher</option><% for (const [voucher, label] of [['PUB', 'Public-school voucher (PUB)'], ['ESC', 'ESC voucher'], ['NV', 'No voucher (NV)']]) { %><option value="<%= voucher %>" <%= values.voucherCode === voucher ? 'selected' : '' %>><%= label %></option><% } %></select></div>
        <div class="field"><label for="annual-voucher-category">Voucher category <span class="muted-copy">(optional)</span></label><select id="annual-voucher-category" name="voucherCategory"><option value="">Not recorded</option><% for (const category of ['A', 'B', 'C', 'D', 'E']) { %><option value="<%= category %>" <%= values.voucherCategory === category ? 'selected' : '' %>><%= category %></option><% } %></select><small>This is a registrar reference and does not change the fees.</small></div>
        <div class="field"><label for="annual-intake-kind">Intake type</label><select id="annual-intake-kind" name="intakeKind"><option value="standard">Standard intake</option><option value="transferee" <%= values.intakeKind === 'transferee' ? 'selected' : '' %>>Transferee</option></select></div>
        <div class="field"><label for="annual-entry-term">Entry term</label><select id="annual-entry-term" name="entryTermNumber" required><option value="">Choose entry term</option><% for (let termNumber = 1; termNumber <= 3; termNumber += 1) { %><option value="<%= termNumber %>" <%= String(values.entryTermNumber || '1') === String(termNumber) ? 'selected' : '' %>>Term <%= termNumber %></option><% } %></select></div>
        <div class="field"><label for="annual-start-date">Enrollment start date</label><input id="annual-start-date" name="enrollmentStartDate" type="date" value="<%= values.enrollmentStartDate || '' %>" required></div>
      </div>
      <section class="intake-section-choice" aria-labelledby="term-placement-title">
        <h3 id="term-placement-title">Annual section</h3>
        <p>Use this section for the school year. You can change individual terms when needed.</p>
        <div class="field"><label for="annual-section-mode">Sections</label><select id="annual-section-mode" name="sectionMode"><option value="same" <%= (values.sectionMode || 'same') === 'same' ? 'selected' : '' %>>Same section for all terms</option><option value="per_term" <%= values.sectionMode === 'per_term' ? 'selected' : '' %>>Different sections by term</option></select></div>
        <div class="field" id="annual-common-section-field"><label for="annual-common-section">Section for the entry term</label>
          <select id="annual-common-section" name="annualSectionId" required><option value="">Choose section</option><% for (const section of sections) { %><option value="<%= section.id %>" data-year="<%= section.school_year %>" data-grade="<%= section.grade_level %>" data-term-number="<%= section.term_number %>" data-name="<%= section.name %>" data-cluster="<%= section.cluster || '' %>" data-strand="<%= section.strand || '' %>" <%= String(values.annualSectionId || values[`section${initialEntryTerm}Id`] || '') === String(section.id) ? 'selected' : '' %>><%= section.name %> · Term <%= section.term_number || 'unmapped' %><% if (section.cluster) { %> · Cluster <%= section.cluster %><% } %><% if (section.strand) { %> · <%= section.strand %><% } %><% if (section.adviser) { %> · Adviser <%= section.adviser %><% } %><% if (section.modality) { %> · <%= section.modality.replaceAll('_', ' ') %><% if (section.modular_subtype) { %> (<%= section.modular_subtype.replaceAll('_', ' ') %>)<% } %><% } %></option><% } %></select>
        </div>
        <ul id="annual-section-plan-preview" class="section-plan" aria-live="polite"></ul>
        <div class="admin-form-grid intake-term-sections">
          <% for (let termNumber = 1; termNumber <= 3; termNumber += 1) { %>
            <div class="field" data-placement-number="<%= termNumber %>"><label for="annual-section-<%= termNumber %>">Term <%= termNumber %> section <span class="muted-copy">(optional for future terms)</span></label>
              <select id="annual-section-<%= termNumber %>" name="section<%= termNumber %>Id" data-term-select data-term-number="<%= termNumber %>"><option value="">Leave unassigned</option><% for (const section of sections) { %><option value="<%= section.id %>" data-year="<%= section.school_year %>" data-grade="<%= section.grade_level %>" data-term-number="<%= section.term_number %>" data-name="<%= section.name %>" data-cluster="<%= section.cluster || '' %>" data-strand="<%= section.strand || '' %>" <%= String(values[`section${termNumber}Id`] || '') === String(section.id) ? 'selected' : '' %>><%= section.name %> · Term <%= section.term_number || 'unmapped' %><% if (section.cluster) { %> · Cluster <%= section.cluster %><% } %><% if (section.strand) { %> · <%= section.strand %><% } %><% if (section.modality) { %> · <%= section.modality.replaceAll('_', ' ') %><% } %></option><% } %></select>
              <input type="hidden" id="annual-section-<%= termNumber %>-override" name="section<%= termNumber %>Override" value="<%= values[`section${termNumber}Override`] || '' %>">
            </div>
          <% } %>
        </div>
      </section>
      <div class="intake-actions"><button class="button button--secondary" type="button" data-step-back>Back</button><button class="button button--primary" type="button" data-step-next>Continue to documents</button></div>
    </section>

    <section class="intake-step" data-step-panel="3" aria-labelledby="intake-documents-heading">
      <div class="intake-step__heading"><h2 id="intake-documents-heading">Documents received</h2></div>
      <p>Check a row only when recording a paper update today. Existing history remains unchanged unless you select a row and add an update. Missing papers do not block enrollment.</p>
      <p class="muted-copy">Record counts only when known. SF10 / Form 137 keeps its separate staff-only history. Do not upload scans here.</p>
      <div class="paper-checklist-rows">
        <% for (const requirement of paperRequirements) { const code = requirement.requirement_code; const appliesByGrade = requirement.applicability === 'grade11' ? 'Applies to Grade 11 intake' : requirement.applicability === 'grade12' ? 'Applies to Grade 12 intake' : null; const manualApplicability = ['als', 'esc', 'optional'].includes(requirement.applicability); const formPrefix = `paper_${code}`; %>
          <article class="paper-checklist-row" data-requirement-applicability="<%= requirement.applicability %>">
            <div class="paper-checklist-row__main">
              <label class="paper-checklist-row__check"><input type="checkbox" name="<%= formPrefix %>_record" value="1" data-paper-record <%= values[`${formPrefix}_record`] === '1' ? 'checked' : '' %>><span><strong><%= requirement.requirement_name %></strong><% if (requirement.guidance) { %><small><%= requirement.guidance %></small><% } %></span></label>
              <details class="paper-checklist-row__details" data-paper-details <%= values[`${formPrefix}_record`] === '1' ? 'open' : '' %>><summary>Record an update</summary>
                <div class="paper-checklist-row__fields" data-paper-update-fields>
                <% if (manualApplicability) { %><label class="field"><span>Applies to this learner?</span><select name="<%= formPrefix %>_applicable"><option value="">Choose</option><option value="1" <%= values[`${formPrefix}_applicable`] === '1' ? 'selected' : '' %>>Yes</option><option value="0" <%= values[`${formPrefix}_applicable`] === '0' ? 'selected' : '' %>>No</option></select></label>
                <% } else { %><input type="hidden" name="<%= formPrefix %>_applicable" value="1"><span class="paper-applicability"><%= appliesByGrade || 'Applies to all learners' %></span><% } %>
                <label class="field"><span>Record status</span><select name="<%= formPrefix %>_status"><option value="">Choose status</option><% for (const state of ['pending', 'received', 'verified', 'correction', 'rejected']) { %><option value="<%= state %>" <%= values[`${formPrefix}_status`] === state ? 'selected' : '' %>><%= ({ pending: 'Pending', received: 'Received', verified: 'Verified', correction: 'Correction needed', rejected: 'Rejected' })[state] %></option><% } %></select></label>
                </div>
                <div class="paper-counts">
                  <label class="field"><span>Originals</span><input type="number" min="0" max="20" name="<%= formPrefix %>_originals" value="<%= values[`${formPrefix}_originals`] || '' %>"></label>
                  <label class="field"><span>Photocopies</span><input type="number" min="0" max="50" name="<%= formPrefix %>_copies" value="<%= values[`${formPrefix}_copies`] || '' %>"></label>
                  <label class="field"><span>Pieces</span><input type="number" min="0" max="50" name="<%= formPrefix %>_pieces" value="<%= values[`${formPrefix}_pieces`] || '' %>"></label>
                  <label class="field paper-note"><span>Staff note <span class="muted-copy">(required for correction)</span></span><input type="text" maxlength="1000" name="<%= formPrefix %>_note" data-paper-note value="<%= values[`${formPrefix}_note`] || '' %>"></label>
                </div>
              </details>
              </div>
            <input type="hidden" name="<%= formPrefix %>_token" value="<%= paperTokens[code] %>">
          </article>
        <% } %>
      </div>
      <div class="intake-actions"><button class="button button--secondary" type="button" data-step-back>Back</button><button class="button button--primary" type="submit">Save and review fees</button></div>
    </section>
  </form>
  <% if (!schoolYears.length || !sections.length) { %><p class="notice-panel">Term order and section setup are needed before the intake can be saved. Ask the registrar administrator to finish school-year setup.</p><% } %>
</main>
<script src="/js/annual-intake-form.js" defer></script>
<%- include('../partials/foot') %>
