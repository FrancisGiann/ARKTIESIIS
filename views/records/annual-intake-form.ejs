<%- include('../partials/head', { title }) %>
<% const initialEntryTerm = Number(values.entryTermNumber || 1); %>
<% const savedAddress = (formatted, blockLot, barangay, city, province, zip) => {
  const parts = [['Block and Lot, Street/Purok', blockLot], ['Barangay', barangay], ['City', city], ['Province', province], ['ZIP code', zip]]
    .filter(([, value]) => value)
    .map(([label, value]) => `${label}: ${value}`);
  return parts.length ? parts.join('\n') : (formatted ? `Legacy free-text address: ${formatted}` : '');
}; %>
<main class="page-shell dashboard-page admin-page records-page registrar-intake" id="main-content">
  <a class="context-back" href="/registrar/intake">Back to annual enrollment</a>
  <header class="dashboard-heading">
    <div><h1><%= preEnrollmentSource ? 'Review saved paper enrollment' : 'Enroll a student' %></h1>
      <p><%= preEnrollmentSource ? 'Review the authoritative saved profile and applicant history, then choose annual placement and finance details before confirmation.' : 'Enter the student and annual placement, record the documents received, then review fees and details before confirming.' %></p></div>
  </header>
  <% if (error) { %><p class="form-alert" role="alert" tabindex="-1" data-wizard-error><%= error %></p><% } %>
  <ol class="intake-steps" aria-label="Enrollment steps">
    <li data-step-indicator="1" aria-label="Step 1 of 5: Student"><span class="intake-step-label--full">Student</span><span class="intake-step-label--short">Student</span></li>
    <li data-step-indicator="2" aria-label="Step 2 of 5: Enrollment"><span class="intake-step-label--full">Enrollment</span><span class="intake-step-label--short">Enroll</span></li>
    <li data-step-indicator="3" aria-label="Step 3 of 5: Documents received"><span class="intake-step-label--full">Documents received</span><span class="intake-step-label--short">Papers</span></li>
    <li data-step-indicator="4" aria-label="Step 4 of 5: Fees"><span class="intake-step-label--full">Fees</span><span class="intake-step-label--short">Fees</span></li>
    <li data-step-indicator="5" aria-label="Step 5 of 5: Review details"><span class="intake-step-label--full">Review details</span><span class="intake-step-label--short">Review</span></li>
  </ol>
  <form class="form-stack admin-form annual-intake-form" method="post" action="/registrar/intake"
    data-intake-wizard data-profile-validation data-active-step="<%= activeStep || 1 %>" data-submitting-message="Saving the student and paper updates. Please wait.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="<%= values.idempotencyKey || idempotencyKey %>">
    <% if (values.preEnrollmentId) { %><input type="hidden" name="preEnrollmentId" value="<%= values.preEnrollmentId %>"><input type="hidden" name="preEnrollmentVersion" value="<%= values.preEnrollmentVersion || '' %>"><% } %>

    <% if (preEnrollmentSource) { %>
      <section class="form-section pre-enrollment-handoff" aria-labelledby="handoff-heading">
        <h2 id="handoff-heading">Paper pre-enrollment for review</h2>
        <p>This record is revision <%= preEnrollmentSource.version %>. The saved profile is authoritative; correct transcription errors in the paper record before conversion. Receipt counts stay separate from the enrollment checklist below.</p>
        <% if (String(values.preEnrollmentVersion || '') !== String(preEnrollmentSource.version) || preEnrollmentSource.status !== 'ready_for_registrar') { %><p class="form-alert" role="alert">The paper record changed after this enrollment form opened. Reload the source record before continuing; this form keeps its original revision and token.</p><% } %>
        <h3>Saved front-desk profile</h3>
        <dl class="pre-enrollment-summary">
          <% for (const [label,value,wide] of [
            ['Student name',[preEnrollmentSource.first_name,preEnrollmentSource.middle_name,preEnrollmentSource.last_name,preEnrollmentSource.suffix].filter(Boolean).join(' '),true],
            ['LRN',preEnrollmentSource.lrn],['Email',preEnrollmentSource.email,true],['Birth date',preEnrollmentSource.birth_date],['Gender',preEnrollmentSource.sex],
            ['Student contact number',preEnrollmentSource.student_contact_number],['Profile phone',preEnrollmentSource.profile_phone],
            ['Birthplace',preEnrollmentSource.birthplace],['Facebook name',preEnrollmentSource.facebook_name,true],
            ['Student address',savedAddress(preEnrollmentSource.address,preEnrollmentSource.address_block_lot_street_purok,preEnrollmentSource.address_barangay,preEnrollmentSource.address_city,preEnrollmentSource.address_province,preEnrollmentSource.address_zip),true],
            ['Emergency contact person',preEnrollmentSource.emergency_contact_person],['Relationship',preEnrollmentSource.emergency_contact_relationship],
            ['Emergency contact phone',preEnrollmentSource.emergency_contact_phone],
            ['Emergency contact address',savedAddress(preEnrollmentSource.emergency_contact_address,preEnrollmentSource.emergency_contact_address_block_lot_street_purok,preEnrollmentSource.emergency_contact_address_barangay,preEnrollmentSource.emergency_contact_address_city,preEnrollmentSource.emergency_contact_address_province,preEnrollmentSource.emergency_contact_address_zip),true],
            ['Mother',preEnrollmentSource.mother_name],['Mother phone',preEnrollmentSource.mother_phone],['Father',preEnrollmentSource.father_name],['Father phone',preEnrollmentSource.father_phone]
          ]) { %><div class="<%= wide ? 'pre-enrollment-summary__wide' : '' %>"><dt><%= label %></dt><dd><%= value || '—' %></dd></div><% } %>
        </dl>
        <dl class="pre-enrollment-summary">
          <% const applicantKindLabel = ({new:'New applicant',continuing:'Continuing student',readmission:'Returning after a break'})[preEnrollmentSource.applicant_kind] || 'Not recorded'; %>
          <% for (const [label,value] of [['Applicant status',applicantKindLabel],['School year',preEnrollmentSource.school_year],['Target grade',preEnrollmentSource.target_grade_level],['Voucher type as written',preEnrollmentSource.voucher_type_text],['Voucher category as written',preEnrollmentSource.voucher_category_text],['Preferred track',preEnrollmentSource.preferred_track],['Preferred cluster',preEnrollmentSource.preferred_cluster],['Last grade level',preEnrollmentSource.prior_grade_level],['School attended',preEnrollmentSource.prior_school],['Student signature present',preEnrollmentSource.student_signature_present ? 'Yes' : 'No'],['Student signature date',preEnrollmentSource.student_signed_date],['Paper received by',preEnrollmentSource.received_by],['Paper received date',preEnrollmentSource.received_date]]) { %><div><dt><%= label %></dt><dd><%= value || '—' %></dd></div><% } %>
        </dl>
        <% if (preEnrollmentSource.applicant_kind === 'readmission') { %><p class="pre-enrollment-handoff__evaluation">Return evaluation: <%= preEnrollmentSource.readmission_evaluation?.status === 'accepted' ? 'Accepted' : 'Needs registrar review' %> · bound to revision <%= preEnrollmentSource.readmission_evaluation_version %> for <%= preEnrollmentSource.school_year %>, <%= preEnrollmentSource.target_grade_level %>.</p><% } %>
        <details class="pre-enrollment-handoff__receipts"><summary>Paper receipts recorded · <%= (preEnrollmentSource.receipts || []).length %> requirement rows</summary>
          <ul><% for (const receipt of preEnrollmentSource.receipts || []) { const label = (preEnrollmentReceiptRequirements || []).find(([code]) => code === receipt.requirement_code)?.[1] || receipt.requirement_code; %><li><%= label %>: original <%= receipt.original_received ? `received${receipt.original_pieces ? ` (${receipt.original_pieces})` : ''}` : 'not recorded' %>; photocopy <%= receipt.photocopy_received ? `received${receipt.photocopy_pieces ? ` (${receipt.photocopy_pieces})` : ''}` : 'not recorded' %></li><% } %></ul>
        </details>
      </section>
    <% } %>

    <section class="intake-step" data-step-panel="1" aria-labelledby="intake-student-heading">
      <div class="intake-step__heading"><h2 id="intake-student-heading">Student details</h2></div>
      <% if (preEnrollmentSource) { %>
        <p>Review the saved front-desk profile. Correct the source record before conversion if a transcription is wrong; do not re-enter identity details here.</p>
        <input type="hidden" name="studentReviewFingerprint" value="<%= values.studentReviewFingerprint || '' %>">
        <div class="admin-form-grid">
          <div class="field"><label for="annual-student-mode">Enrollment record</label>
            <select id="annual-student-mode" aria-controls="new-student-fields" <%= preEnrollmentSource.existingStudent ? 'disabled' : '' %>>
              <% if (!preEnrollmentSource.existingStudent) { %><option value="new" selected>Create a new student record from this paper form</option><% } %>
              <% if (preEnrollmentSource.existingStudent) { %><option value="returning" selected>Link the existing student record matched by LRN</option><% } %>
            </select>
          </div>
        </div>
        <% if (preEnrollmentSource.existingStudent) { %>
          <div class="form-section" id="returning-student-field" hidden>
            <div class="field"><label for="annual-student-no">Existing student number</label>
              <select id="annual-student-no" disabled>
                <option value="">Choose the existing record</option>
                <option value="<%= preEnrollmentSource.existingStudent.studentNo %>" <%= values.studentNo === preEnrollmentSource.existingStudent.studentNo ? 'selected' : '' %>><%= preEnrollmentSource.existingStudent.studentNo %> · matches this LRN</option>
              </select>
              <input type="hidden" name="studentNo" value="<%= preEnrollmentSource.existingStudent.studentNo %>">
              <small>Choose this option only when the paper applicant is the same learner as the existing record.</small>
            </div>
            <h3>Existing profile review</h3>
            <p>Approve each difference you want to copy from the paper record. Unselected profile fields stay unchanged.</p>
            <% if (!profileReviewFields.length) { %><p class="notice-panel">The saved paper profile matches the existing record. No profile changes are needed.</p><% } else { %>
              <div class="table-wrap annual-profile-comparison-wrap" role="region" aria-label="Existing and paper profile differences" tabindex="0"><table class="data-table annual-profile-comparison"><thead><tr><th scope="col">Field</th><th scope="col">Current student record</th><th scope="col">Saved paper record</th><th scope="col">Approve change</th></tr></thead><tbody>
                <% for (const item of profileReviewFields) { %><tr><th scope="row"><%= item.label %></th><td><%= item.studentValue || '—' %></td><td><%= item.sourceValue || '—' %></td><td><label class="field--check"><input type="checkbox" name="approvedProfileFields" value="<%= item.key %>" <%= (values.approvedProfileFields || []).includes(item.key) ? 'checked' : '' %>><span>Approve this field</span></label></td></tr><% } %>
              </tbody></table></div>
            <% } %>
          </div>
        <% } else { %><div id="returning-student-field" hidden><input id="annual-student-no" name="studentNo" disabled></div><% } %>
        <div class="notice-panel" id="new-student-fields">
          <h3>Saved front-desk profile</h3>
          <dl class="pre-enrollment-summary">
            <% for (const [label,value] of [['Name',[preEnrollmentSource.first_name,preEnrollmentSource.middle_name,preEnrollmentSource.last_name,preEnrollmentSource.suffix].filter(Boolean).join(' ')],['LRN',preEnrollmentSource.lrn],['Contact email',preEnrollmentSource.email],['Birth date',preEnrollmentSource.birth_date],['Gender',preEnrollmentSource.sex],['Phone',preEnrollmentSource.profile_phone],['Address',savedAddress(preEnrollmentSource.address,preEnrollmentSource.address_block_lot_street_purok,preEnrollmentSource.address_barangay,preEnrollmentSource.address_city,preEnrollmentSource.address_province,preEnrollmentSource.address_zip)],['Emergency contact',preEnrollmentSource.emergency_contact_person],['Emergency contact number',preEnrollmentSource.emergency_contact_phone],['Emergency contact address',savedAddress(preEnrollmentSource.emergency_contact_address,preEnrollmentSource.emergency_contact_address_block_lot_street_purok,preEnrollmentSource.emergency_contact_address_barangay,preEnrollmentSource.emergency_contact_address_city,preEnrollmentSource.emergency_contact_address_province,preEnrollmentSource.emergency_contact_address_zip)],['Mother',preEnrollmentSource.mother_name],['Father',preEnrollmentSource.father_name]]) { %><div><dt><%= label %></dt><dd><%= value || '—' %></dd></div><% } %>
          </dl>
        </div>
      <% } else { %>
        <p>Returning students keep their existing profile, login, and paper checklist history. <a href="/registrar/records" target="_blank" rel="noopener">Find a student by name or LRN</a> if you do not know the student number.</p>
      <div class="admin-form-grid">
        <div class="field"><label for="annual-student-mode">Student record</label>
          <select id="annual-student-mode" aria-controls="new-student-fields">
            <option value="new" <%= values.studentNo ? '' : 'selected' %>>New student</option>
            <option value="returning" <%= values.studentNo ? 'selected' : '' %>>Returning student</option>
          </select>
        </div>
        <div class="field" id="returning-student-field"><label for="annual-student-no">Existing student number</label>
          <input id="annual-student-no" name="studentNo" maxlength="50" autocomplete="off" value="<%= values.studentNo || '' %>">
          <small>Enter the student number from the existing student record.</small>
        </div>
      </div>
      <div class="admin-form-grid" id="new-student-fields">
        <div class="field"><label for="annual-lrn">Learner Reference Number (LRN)</label><input id="annual-lrn" name="lrn" inputmode="numeric" pattern="[0-9]{12}" maxlength="12" title="Enter exactly 12 digits." value="<%= values.lrn || '' %>"></div>
        <div class="field"><label for="annual-email">Contact and sign-in email</label><input id="annual-email" name="email" type="email" autocomplete="email" maxlength="255" value="<%= values.email || '' %>"></div>
        <div class="field"><label for="annual-first-name">First name</label><input id="annual-first-name" name="firstName" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.firstName || '' %>"></div>
        <div class="field"><label for="annual-middle-name">Middle name <span class="muted-copy">(optional)</span></label><input id="annual-middle-name" name="middleName" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.middleName || '' %>"></div>
        <div class="field"><label for="annual-last-name">Last name</label><input id="annual-last-name" name="lastName" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.lastName || '' %>"></div>
        <div class="field"><label for="annual-suffix">Suffix <span class="muted-copy">(optional)</span></label><input id="annual-suffix" name="suffix" maxlength="20" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.suffix || '' %>"></div>
        <div class="field"><label for="annual-birth-date">Birth date <span class="muted-copy">(optional)</span></label><input id="annual-birth-date" name="birthDate" type="date" max="<%= maxBirthDate %>" value="<%= values.birthDate || '' %>"></div>
        <div class="field"><label for="annual-sex">Gender <span class="muted-copy">(optional)</span></label><select id="annual-sex" name="sex"><option value="" <%= values.sex ? '' : 'selected' %>>Not recorded</option><% for (const gender of ['Male', 'Female', 'Other']) { %><option value="<%= gender %>" <%= String(values.sex || '').toLowerCase() === gender.toLowerCase() ? 'selected' : '' %>><%= gender %></option><% } %><% if (values.sex && !['male', 'female', 'other'].includes(String(values.sex).toLowerCase())) { %><option value="<%= values.sex %>" selected>Invalid value (choose again): <%= values.sex %></option><% } %></select></div>
        <div class="field"><label for="annual-phone">Phone <span class="muted-copy">(optional)</span></label><input id="annual-phone" name="phone" type="tel" maxlength="50" pattern="\+?[0-9\x28\x29\x20\x2d]{7,50}" title="Use 7 to 15 digits; a leading +, spaces, hyphens, and balanced parentheses are allowed." value="<%= values.phone || '' %>"></div>
      </div>
      <%- include('partials/address-fields', { prefix: 'address', values, student: null }) %>
      <div class="admin-form-grid">
        <div class="field"><label for="annual-emergency-person">Emergency contact person <span class="muted-copy">(optional)</span></label><input id="annual-emergency-person" name="emergencyContactPerson" maxlength="160" value="<%= values.emergencyContactPerson || '' %>"></div>
        <div class="field"><label for="annual-emergency-relationship">Relationship <span class="muted-copy">(optional)</span></label><input id="annual-emergency-relationship" name="emergencyContactRelationship" maxlength="80" value="<%= values.emergencyContactRelationship || '' %>"></div>
        <div class="field"><label for="annual-emergency-phone">Emergency contact number <span class="muted-copy">(optional)</span></label><input id="annual-emergency-phone" name="emergencyContactPhone" type="tel" maxlength="50" pattern="\+?[0-9\x28\x29\x20\x2d]{7,50}" value="<%= values.emergencyContactPhone || '' %>"></div>
      </div>
      <%- include('partials/address-fields', { prefix: 'emergencyContactAddress', values, student: null }) %>
      <% } %>
      <div class="intake-actions"><button class="button button--primary" type="button" data-step-next>Continue to enrollment</button><a class="button button--secondary" href="/registrar/intake">Cancel</a></div>
    </section>

    <section class="intake-step" data-step-panel="2" aria-labelledby="intake-enrollment-heading">
      <div class="intake-step__heading"><h2 id="intake-enrollment-heading">Enrollment details</h2></div>
      <div class="admin-form-grid">
        <div class="field"><label for="annual-school-year">School year</label><select id="annual-school-year" name="schoolYear" required><option value="">Choose school year</option><% if (values.schoolYear && !schoolYears.some((year) => year.school_year === values.schoolYear)) { %><option value="<%= values.schoolYear %>" selected><%= values.schoolYear %> · configure term order before saving</option><% } %><% for (const year of schoolYears) { %><option value="<%= year.school_year %>" <%= values.schoolYear === year.school_year ? 'selected' : '' %>><%= year.school_year %></option><% } %></select></div>
        <div class="field"><label for="annual-grade">Grade level</label><select id="annual-grade" name="gradeLevel" required><option value="">Choose grade</option><% for (const grade of ['Grade 11', 'Grade 12']) { %><option value="<%= grade %>" <%= values.gradeLevel === grade ? 'selected' : '' %>><%= grade %></option><% } %></select></div>
        <div class="field"><label for="annual-voucher">Voucher type</label><select id="annual-voucher" name="voucherCode" required><option value="">Choose voucher type</option><% for (const [voucher, label] of [['PUB', 'Public-school voucher (PUB)'], ['ESC', 'ESC voucher'], ['NV', 'No voucher (NV)']]) { %><option value="<%= voucher %>" <%= values.voucherCode === voucher ? 'selected' : '' %>><%= label %></option><% } %></select></div>
        <% if (preEnrollmentSource) { %><div class="field"><span class="field__label">Applicant type</span><p><%= ({new:'New applicant',continuing:'Continuing student',readmission:'Returning after a break'})[preEnrollmentSource.applicant_kind] || 'Needs registrar review' %></p></div><% } else { %><div class="field"><label for="annual-intake-kind">Intake type</label><select id="annual-intake-kind" name="intakeKind"><option value="standard">Standard intake</option><option value="transferee" <%= values.intakeKind === 'transferee' ? 'selected' : '' %>>Transferee</option></select></div><% } %>
        <div class="field"><label for="annual-entry-term">Entry term</label><select id="annual-entry-term" name="entryTermNumber" required><option value="">Choose entry term</option><% for (let termNumber = 1; termNumber <= 3; termNumber += 1) { %><option value="<%= termNumber %>" <%= String(values.entryTermNumber || '1') === String(termNumber) ? 'selected' : '' %>>Term <%= termNumber %></option><% } %></select></div>
        <div class="field"><label for="annual-start-date">Enrollment start date</label><input id="annual-start-date" name="enrollmentStartDate" type="date" value="<%= values.enrollmentStartDate || '' %>" required></div>
      </div>
      <section class="intake-section-choice" aria-labelledby="term-placement-title">
        <h3 id="term-placement-title">Annual section</h3>
        <p>Use this section for the school year. You can change individual terms when needed.</p>
        <div class="field"><label for="annual-section-mode">Sections</label><select id="annual-section-mode" name="sectionMode"><option value="same" <%= (values.sectionMode || 'same') === 'same' ? 'selected' : '' %>>Same section for all terms</option><option value="per_term" <%= values.sectionMode === 'per_term' ? 'selected' : '' %>>Different sections by term</option></select></div>
        <div class="field" id="annual-common-section-field"><label for="annual-common-section">Section for the entry term</label>
          <select id="annual-common-section" name="annualSectionId" required><option value="">Choose section</option><% for (const section of sections) { %><option value="<%= section.id %>" data-year="<%= section.school_year %>" data-grade="<%= section.grade_level %>" data-term-number="<%= section.term_number %>" data-name="<%= section.name %>" data-cluster="<%= section.cluster || '' %>" data-strand="<%= section.strand || '' %>" <%= String(values.annualSectionId || values[`section${initialEntryTerm}Id`] || '') === String(section.id) ? 'selected' : '' %>><%= section.name %> · Term <%= section.term_number || 'unmapped' %><% if (section.cluster) { %> · Cluster <%= section.cluster %><% } %><% if (section.strand) { %> · <%= section.strand %><% } %><% if (section.adviser) { %> · Adviser <%= section.adviser %><% } %><% if (section.modality) { %> · <%= section.modality.replaceAll('_', ' ') %><% if (section.modular_subtype) { %> (<%= section.modular_subtype.replaceAll('_', ' ') %>)<% } %><% } %></option><% } %></select>
        </div>
        <ul id="annual-section-plan-preview" class="section-plan" aria-live="polite"></ul>
        <div class="admin-form-grid intake-term-sections">
          <% for (let termNumber = 1; termNumber <= 3; termNumber += 1) { %>
            <div class="field" data-placement-number="<%= termNumber %>"><label for="annual-section-<%= termNumber %>">Term <%= termNumber %> section <span class="muted-copy">(optional for future terms)</span></label>
              <select id="annual-section-<%= termNumber %>" name="section<%= termNumber %>Id" data-term-select data-term-number="<%= termNumber %>"><option value="">Leave unassigned</option><% for (const section of sections) { %><option value="<%= section.id %>" data-year="<%= section.school_year %>" data-grade="<%= section.grade_level %>" data-term-number="<%= section.term_number %>" data-name="<%= section.name %>" data-cluster="<%= section.cluster || '' %>" data-strand="<%= section.strand || '' %>" <%= String(values[`section${termNumber}Id`] || '') === String(section.id) ? 'selected' : '' %>><%= section.name %> · Term <%= section.term_number || 'unmapped' %><% if (section.cluster) { %> · Cluster <%= section.cluster %><% } %><% if (section.strand) { %> · <%= section.strand %><% } %><% if (section.modality) { %> · <%= section.modality.replaceAll('_', ' ') %><% } %></option><% } %></select>
              <input type="hidden" id="annual-section-<%= termNumber %>-override" name="section<%= termNumber %>Override" value="<%= values[`section${termNumber}Override`] || '' %>">
            </div>
          <% } %>
        </div>
      </section>
      <div class="intake-actions"><button class="button button--secondary" type="button" data-step-back>Back</button><button class="button button--primary" type="button" data-step-next>Continue to documents</button></div>
    </section>

    <section class="intake-step" data-step-panel="3" aria-labelledby="intake-documents-heading">
      <div class="intake-step__heading"><h2 id="intake-documents-heading">Documents received</h2></div>
      <p>Select a paper only after staff has received and checked it. Checking the box records that item as verified today; leave it unchecked when it was not received and checked. Existing history stays unchanged unless you select a row. Missing papers do not block enrollment.</p>
      <p class="muted-copy">Place submitted papers together in a long brown envelope; the envelope is a storage container and is not tracked. Enter only counts that apply to each paper, and leave counts blank if unknown. SF10 / Form 137 keeps its separate staff-only history. Do not upload scans here.</p>
      <div class="paper-checklist-rows">
        <% for (const requirement of paperRequirements) { const code = requirement.requirement_code; const appliesByGrade = requirement.applicability === 'grade11' ? 'Applies to Grade 11 intake' : requirement.applicability === 'grade12' ? 'Applies to Grade 12 intake' : null; const manualApplicability = ['als', 'esc', 'optional'].includes(requirement.applicability); const hasCountTypes = Number(requirement.originals_required) > 0 || Number(requirement.copies_required) > 0 || Number(requirement.pieces_required) > 0; const formPrefix = `paper_${code}`; %>
          <article class="paper-checklist-row" data-requirement-applicability="<%= requirement.applicability %>">
            <div class="paper-checklist-row__main">
              <label class="paper-checklist-row__check"><input type="checkbox" name="<%= formPrefix %>_record" value="1" data-paper-record <%= values[`${formPrefix}_record`] === '1' ? 'checked' : '' %>><span><strong><%= requirement.requirement_name %></strong><% if (requirement.guidance) { %><small><%= requirement.guidance %></small><% } %></span></label>
              <% if (!manualApplicability) { %><input type="hidden" name="<%= formPrefix %>_applicable" value="1"><% } %>
              <% if (manualApplicability || hasCountTypes) { %><details class="paper-checklist-row__details" data-paper-details <%= values[`${formPrefix}_record`] === '1' ? 'open' : '' %>><summary><%= manualApplicability ? (hasCountTypes ? 'Applicability and counts' : 'Applicability') : 'Optional counts' %></summary>
                <div class="paper-checklist-row__fields" data-paper-update-fields>
                <% if (manualApplicability) { %><label class="field"><span>Applies to this learner?</span><select name="<%= formPrefix %>_applicable"><option value="">Choose</option><option value="1" <%= values[`${formPrefix}_applicable`] === '1' ? 'selected' : '' %>>Yes</option><option value="0" <%= values[`${formPrefix}_applicable`] === '0' ? 'selected' : '' %>>No</option></select></label>
                <% } else { %><span class="paper-applicability"><%= appliesByGrade || 'Applies to all learners' %></span><% } %>
                </div>
                <div class="paper-counts">
                  <% if (Number(requirement.originals_required) > 0) { %><label class="field"><span>Originals received</span><input type="number" min="0" max="20" name="<%= formPrefix %>_originals" value="<%= values[`${formPrefix}_originals`] || '' %>"></label><% } %>
                  <% if (Number(requirement.copies_required) > 0) { %><label class="field"><span>Photocopies received</span><input type="number" min="0" max="50" name="<%= formPrefix %>_copies" value="<%= values[`${formPrefix}_copies`] || '' %>"></label><% } %>
                  <% if (Number(requirement.pieces_required) > 0) { %><label class="field"><span>Pieces received</span><input type="number" min="0" max="50" name="<%= formPrefix %>_pieces" value="<%= values[`${formPrefix}_pieces`] || '' %>"></label><% } %>
                </div>
              </details><% } %>
              </div>
            <input type="hidden" name="<%= formPrefix %>_token" value="<%= paperTokens[code] %>">
          </article>
        <% } %>
      </div>
      <div class="intake-actions"><button class="button button--secondary" type="button" data-step-back>Back</button><button class="button button--primary" type="submit">Save and review fees</button></div>
    </section>
  </form>
  <% if (!schoolYears.length || !sections.length) { %><p class="notice-panel">Term order and section setup are needed before the intake can be saved. Ask the registrar administrator to finish school-year setup.</p><% } %>
</main>
<script src="/js/student-profile-validation.js" defer></script>
<script src="/js/annual-intake-form.js" defer></script>
<%- include('../partials/foot') %>
