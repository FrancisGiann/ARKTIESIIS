<%- include('../partials/head', { title }) %>
<main class="page-shell admin-page records-page annual-term-activation-review" id="main-content">
  <a class="context-back" href="/registrar/intake">Back to annual intake</a>
  <header class="dashboard-heading">
    <div><h1>Review term activation</h1><p>Earlier attended terms need complete paper signatures and registrar confirmation before this term can be activated.</p></div>
  </header>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (!review) { %>
    <section class="admin-section"><p>The earlier-term paper review could not be loaded. This term cannot be activated.</p></section>
  <% } else { %>
    <section class="admin-section" aria-labelledby="activation-target-title">
      <div class="admin-section__heading"><div><h2 id="activation-target-title"><%= review.targetTermLabel %> · Term <%= review.targetTermNumber || 'not recorded' %></h2><p><strong><%= review.studentName || 'Student name not recorded' %></strong><% if (review.studentNo) { %> · Student no. <%= review.studentNo %><% } %> · <%= review.schoolYear || 'School year not recorded' %> · <%= review.gradeLevel || 'Grade not recorded' %><% if (review.sectionName) { %> · <%= review.sectionName %><% } %></p></div></div>
      <% if (review.terms.length) { %>
        <div class="table-scroll" tabindex="0" aria-label="Earlier term paper form reviews">
          <table class="admin-table"><thead><tr><th scope="col">Earlier term</th><th scope="col">Paper form status</th><th scope="col">Required signatures</th><th scope="col">Recorded signatures</th></tr></thead>
            <tbody><% for (const term of review.terms) { const labels = { complete: 'Complete', not_attended: 'Did not attend · reason recorded', not_applicable: 'Not applicable', missing_placement: 'Term placement missing', missing: 'Attendance review needed', unreviewed: 'Attendance review needed', invalid_exclusion: 'Attendance decision needs correction', incomplete: term.awaitingConfirmation ? 'Waiting for registrar confirmation' : 'Signatures or review incomplete' }; %><tr>
              <th scope="row"><%= term.termLabel %></th><td data-label="Paper form status"><%= labels[term.state] || 'Review needed' %></td>
              <td data-label="Required signatures"><%= term.requiredCount == null ? '—' : term.requiredCount %></td><td data-label="Recorded signatures"><%= term.signedCount == null ? '—' : term.signedCount %></td>
            </tr><% } %></tbody>
          </table>
        </div>
      <% } else { %><p>No earlier applicable term is required before this placement.</p><% } %>
      <% if (review.blockers.length) { %><ul class="form-alert" aria-label="Paper form items to resolve"><% for (const blocker of review.blockers) { %><li><%= blocker %></li><% } %></ul><% } else { %><p class="form-success" role="status">All required earlier-term paper forms are complete.</p><% } %>
      <p><a class="table-action" href="/registrar/records/students/<%= review.studentId %>/clearance">Open the student’s Clearance tab</a></p>
    </section>
    <section class="admin-section" aria-labelledby="activate-term-title">
      <div class="admin-section__heading"><div><h2 id="activate-term-title">Activate placement</h2><p>Earlier paper forms are checked again when you save. If a review changes, reload this page before continuing.</p></div></div>
      <% if (review.alreadyFinalized) { %>
        <p class="form-success" role="status">This term was already activated<% if (review.finalizedAt) { %> on <%= new Date(review.finalizedAt).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %><% } %>. This page is read-only.</p>
      <% } else if (review.ready) { %>
        <form method="post" action="/registrar/intake/<%= review.enrollmentId %>/finalize" class="fee-confirmation__form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="idempotencyKey" value="<%= idempotencyKey %>">
          <input type="hidden" name="clearanceSnapshotFingerprint" value="<%= review.fingerprint %>">
          <button class="button button--primary" type="submit">Activate term</button>
          <a class="button button--secondary" href="/registrar/intake">Return to annual intake</a>
        </form>
      <% } else { %><p class="form-alert">This term cannot be activated until every paper form item above is resolved.</p><a class="button button--secondary" href="/registrar/intake">Return to annual intake</a><% } %>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
