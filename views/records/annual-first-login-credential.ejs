<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <header class="dashboard-heading">
    <div><h1>One-time student password</h1>
      <p>Give this password to the student privately. It is shown only once.</p></div>
    <button class="button button--primary" type="button" data-print-page>Print / save as PDF</button>
  </header>
  <section class="admin-section" aria-labelledby="first-login-student">
    <h2 id="first-login-student"><%= [credential.firstName, credential.middleName, credential.lastName, credential.suffix].filter(Boolean).join(' ') %></h2>
    <dl class="enrollment-summary-list">
      <div><dt>Student number</dt><dd><%= credential.studentNo %></dd></div>
      <div><dt>Email</dt><dd><%= credential.email || 'Not recorded' %></dd></div>
    </dl>
    <p class="form-success" role="status"><strong>Temporary password:</strong> <code><%= credential.temporaryPassword %></code></p>
    <p>The student must complete the existing email sign-in verification and change this password at first login. If it is lost, use the existing password reset flow.</p>
  </section>
  <p class="admin-form-actions"><a class="button button--secondary" href="/registrar/intake/<%= credential.annualEnrollmentId %>/review">Return to enrollment review</a></p>
</main>
<%- include('../partials/foot') %>
