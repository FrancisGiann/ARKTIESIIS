<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <a class="context-back" href="/registrar/intake">Back to enrollments</a>
  <section class="dashboard-heading"><div><h1>Enroll a student</h1><p>Create a student profile, inactive login, and pending enrollment for an existing term and section.</p></div></section>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <section class="admin-form-section" aria-labelledby="intake-form-title">
    <h2 id="intake-form-title">Student details</h2>
    <p>The student number is assigned automatically from the selected academic year in the format SHS-YYYY-0001. LRN and email must be unused. Finance must record a payment and explicitly clear this enrollment before the login can be activated.</p>
    <form class="form-stack admin-form" method="post" action="/registrar/intake" data-profile-validation data-submitting-message="Saving the enrollment. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-form-grid">
        <div class="field"><label for="intake-lrn">Learner Reference Number (LRN)</label><input id="intake-lrn" name="lrn" inputmode="numeric" pattern="[0-9]{12}" maxlength="12" title="Enter exactly 12 digits." required value="<%= values.lrn || '' %>"></div>
        <div class="field"><label for="intake-first-name">First name</label><input id="intake-first-name" name="firstName" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." required value="<%= values.firstName || '' %>"></div>
        <div class="field"><label for="intake-middle-name">Middle name (optional)</label><input id="intake-middle-name" name="middleName" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.middleName || '' %>"></div>
        <div class="field"><label for="intake-last-name">Last name</label><input id="intake-last-name" name="lastName" maxlength="100" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." required value="<%= values.lastName || '' %>"></div>
        <div class="field"><label for="intake-suffix">Suffix (optional)</label><input id="intake-suffix" name="suffix" maxlength="20" pattern="\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?(?:\s+\p{L}[\p{L}\p{M}]*(?:[.\x2d'’][\p{L}\p{M}]+)*\.?)*" title="Use letters; spaces, hyphens, apostrophes, and initials are allowed." value="<%= values.suffix || '' %>"></div>
        <div class="field"><label for="intake-birth-date">Birth date (optional)</label><input id="intake-birth-date" name="birthDate" type="date" max="<%= maxBirthDate %>" value="<%= values.birthDate || '' %>"></div>
        <div class="field"><label for="intake-sex">Gender (optional)</label><select id="intake-sex" name="sex"><option value="" <%= values.sex ? '' : 'selected' %>>Not recorded</option><% for (const gender of ['Male', 'Female', 'Other']) { %><option value="<%= gender %>" <%= String(values.sex || '').toLowerCase() === gender.toLowerCase() ? 'selected' : '' %>><%= gender %></option><% } %><% if (values.sex && !['male', 'female', 'other'].includes(String(values.sex).toLowerCase())) { %><option value="<%= values.sex %>" selected>Invalid value (choose again): <%= values.sex %></option><% } %></select></div>
        <div class="field"><label for="intake-phone">Phone (optional)</label><input id="intake-phone" name="phone" type="tel" maxlength="50" pattern="\+?[0-9\x28\x29\x20\x2d]{7,50}" title="Use 7 to 15 digits; a leading +, spaces, hyphens, and balanced parentheses are allowed." value="<%= values.phone || '' %>"></div>
        <div class="field"><label for="intake-email">Email</label><input id="intake-email" name="email" type="email" autocomplete="email" maxlength="255" required value="<%= values.email || '' %>"></div>
        <div class="field"><label for="intake-term">Academic term</label><select id="intake-term" name="academicTermId" required><option value="">Choose a term</option><% for (const term of terms) { %><option value="<%= term.id %>" <%= String(values.academicTermId || '') === String(term.id) ? 'selected' : '' %>><%= term.school_year %> · <%= term.term %><%= term.is_current ? ' (current)' : '' %></option><% } %></select></div>
        <div class="field"><label for="intake-section">Section</label><select id="intake-section" name="sectionId" required><option value="">Choose a section</option><% for (const section of sections) { %><option value="<%= section.id %>" <%= String(values.sectionId || '') === String(section.id) ? 'selected' : '' %>><%= formatStudentPlacement(section.grade_level, section.name) %> — <%= section.school_year %> · <%= section.term %></option><% } %></select></div>
        <div class="field field--full"><label for="intake-address">Address (optional)</label><textarea id="intake-address" name="address" maxlength="500" rows="3" aria-describedby="intake-address-help"><%= values.address || '' %></textarea><small id="intake-address-help">Include street or area text. Numbers and punctuation are welcome.</small></div>
      </div>
      <div class="admin-form-actions"><button class="button button--primary" type="submit" <%= terms.length && sections.length ? '' : 'disabled' %>>Save pending enrollment</button><a class="button button--secondary" href="/registrar/intake">Cancel</a></div>
    </form>
  </section>
</main>
<script src="/js/student-profile-validation.js" defer></script>
<%- include('../partials/foot') %>
