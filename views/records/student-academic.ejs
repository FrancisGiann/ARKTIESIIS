<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <a class="context-back" href="/registrar/records/students/<%= student.id %>/edit">Back to student profile</a>
  <%- include('../partials/student-record-navigation', { student, activeStudentView: 'academics' }) %>
  <h2 class="student-record-view-title">Academic record</h2>
  <% if (student.status === 'archived') { %>
    <p class="form-alert" role="status">This student record is archived. Existing enrollments, subjects, and grades are available for review; grade and subject changes are disabled.</p>
  <% } %>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="admin-section" aria-labelledby="student-info-title">
    <div class="admin-section__heading"><div><h2 id="student-info-title">Student information</h2><p>Profile details and enrollment history for this student.</p></div></div>
    <dl class="student-profile-grid">
      <div><dt>Student number</dt><dd><%= student.student_no %></dd></div>
      <div><dt>Name</dt><dd><%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></dd></div>
      <div><dt>Status</dt><dd><span class="record-status <%= student.status === 'active' ? 'record-status--active' : student.status === 'archived' ? 'record-status--archived' : '' %>"><%= student.status ? student.status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Unknown' %></span></dd></div>
      <div><dt>Phone</dt><dd><%= student.phone || 'Not provided' %></dd></div>
      <div><dt>Address</dt><dd><%= student.address || 'Not provided' %></dd></div>
    </dl>
  </section>

  <section class="admin-section" aria-labelledby="enrollment-history-title">
    <div class="admin-section__heading"><div><h2 id="enrollment-history-title">Enrollment history</h2><p>Subjects and grades are kept with the existing enrollment they belong to.</p></div></div>
    <% if (enrollments.length) { %>
      <% for (const enrollment of enrollments) { %>
        <article class="academic-enrollment" aria-labelledby="enrollment-<%= enrollment.id %>-title">
          <h3 id="enrollment-<%= enrollment.id %>-title"><%= enrollment.school_year %> · <%= enrollment.term %></h3>
          <p class="muted-copy"><%= enrollment.section_name || 'No section assigned' %> · <%= enrollment.enrollment_status ? enrollment.enrollment_status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Unknown enrollment status' %><%= enrollment.is_current ? ' · Current term' : '' %></p>
          <% if (enrollment.subjects.length) { %>
            <div class="academic-subject-list">
              <% for (const assignment of enrollment.subjects) { %>
                <section class="academic-subject" aria-labelledby="assignment-<%= assignment.id %>-title">
                  <div class="admin-section__heading"><div><h4 id="assignment-<%= assignment.id %>-title"><%= assignment.subjectCode %> · <%= assignment.subjectName %></h4><p><%= assignment.units ?? 'Units not set' %> <%= assignment.units === null || assignment.units === undefined ? '' : (assignment.units === 1 ? 'unit' : 'units') %></p></div></div>
                  <% if (assignment.grades.length) { %>
                    <div class="academic-grade-list">
                      <% for (const grade of assignment.grades) { %>
                        <div class="academic-grade-item">
                          <div><strong><%= grade.gradingPeriod %></strong><span>Grade: <%= grade.gradeValue ?? 'Pending' %><% if (grade.remarks) { %> · <%= grade.remarks %><% } %></span></div>
                        </div>
                      <% } %>
                    </div>
                  <% } else { %><p class="empty-state">No grades recorded for this subject.</p><% } %>
                </section>
              <% } %>
            </div>
          <% } else { %><p class="empty-state">No subjects are assigned to this enrollment.</p><% } %>
          <% if (student.status !== 'archived' && ['registrar', 'database_admin'].includes(currentUser.role)) { %>
            <form class="form-stack records-enrollment-form academic-assignment-form" method="post" action="/registrar/records/student-subjects">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="studentId" value="<%= student.id %>"><input type="hidden" name="enrollmentId" value="<%= enrollment.id %>">
              <h4>Assign a subject</h4>
              <div class="field"><label for="subject-for-enrollment-<%= enrollment.id %>">Subject</label><select id="subject-for-enrollment-<%= enrollment.id %>" name="subjectId" required><option value="">Choose a subject</option><% for (const subject of subjects) { %><option value="<%= subject.id %>"><%= subject.subject_code %> · <%= subject.subject_name %></option><% } %></select></div>
              <button class="button button--primary button--align-start" type="submit" <%= subjects.length ? '' : 'disabled' %>>Assign subject</button>
            </form>
          <% } %>
        </article>
      <% } %>
    <% } else { %><p class="empty-state">This student has no enrollments. Create an enrollment from the student profile before assigning subjects.</p><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
