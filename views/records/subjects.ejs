<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <% const canManageSubjects = ['registrar', 'database_admin'].includes(currentUser.role); %>
  <a class="context-back" href="/registrar/records">Back to student records</a>
  <section class="dashboard-heading">
    <div>
      <h1>Subject catalog</h1>
      <p>Maintain the subjects available for student enrollments.</p>
    </div>
  </section>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <% if (canManageSubjects) { %>
    <section class="admin-form-section records-form-section" aria-labelledby="new-subject-title">
      <h2 id="new-subject-title">Add subject</h2>
      <p>Subject codes are stored in uppercase. Units are optional.</p>
      <form class="form-stack admin-form" method="post" action="/registrar/records/subjects">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-form-grid">
          <div class="field"><label for="subject-code">Subject code</label><input id="subject-code" name="subjectCode" type="text" maxlength="50" required value="<%= values.subjectCode %>"></div>
          <div class="field"><label for="subject-name">Subject name</label><input id="subject-name" name="subjectName" type="text" maxlength="200" required value="<%= values.subjectName %>"></div>
          <div class="field"><label for="subject-units">Units (optional)</label><input id="subject-units" name="units" type="number" min="0.01" max="999.99" step="0.01" value="<%= values.units %>"></div>
        </div>
        <button class="button button--primary button--align-start" type="submit">Add subject</button>
      </form>
    </section>
  <% } %>

  <section class="admin-section" aria-labelledby="catalog-title">
    <div class="admin-section__heading"><div><h2 id="catalog-title">Subjects</h2><p><%= subjects.length %> subject<%= subjects.length === 1 ? '' : 's' %></p></div></div>
    <% if (subjects.length) { %>
      <ul class="subject-catalog" aria-label="Subjects in the catalog">
        <% for (const subject of subjects) { %>
          <li class="subject-catalog__item">
            <% if (canManageSubjects) { %>
              <details class="subject-catalog__disclosure">
                <summary class="subject-catalog__summary">
                  <span class="subject-catalog__code"><%= subject.subject_code %></span>
                  <span class="subject-catalog__name"><%= subject.subject_name %></span>
                  <span class="subject-catalog__units"><%= subject.units == null ? 'Units not set' : `${subject.units} units` %></span>
                  <span class="subject-catalog__edit">Edit</span>
                </summary>
                <form class="subject-catalog__form" method="post" action="/registrar/records/subjects/<%= subject.id %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="admin-form-grid">
                    <div class="field"><label for="subject-code-<%= subject.id %>">Subject code</label><input id="subject-code-<%= subject.id %>" name="subjectCode" type="text" maxlength="50" required value="<%= subject.subject_code %>"></div>
                    <div class="field"><label for="subject-name-<%= subject.id %>">Subject name</label><input id="subject-name-<%= subject.id %>" name="subjectName" type="text" maxlength="200" required value="<%= subject.subject_name %>"></div>
                    <div class="field"><label for="subject-units-<%= subject.id %>">Units (optional)</label><input id="subject-units-<%= subject.id %>" name="units" type="number" min="0.01" max="999.99" step="0.01" value="<%= subject.units ?? '' %>"></div>
                  </div>
                  <button class="button button--secondary" type="submit">Save subject</button>
                </form>
              </details>
            <% } else { %>
              <div class="subject-catalog__summary">
                <span class="subject-catalog__code"><%= subject.subject_code %></span>
                <span class="subject-catalog__name"><%= subject.subject_name %></span>
                <span class="subject-catalog__units"><%= subject.units == null ? 'Units not set' : `${subject.units} units` %></span>
              </div>
            <% } %>
          </li>
        <% } %>
      </ul>
    <% } else { %><p class="empty-state">No subjects have been added.</p><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
