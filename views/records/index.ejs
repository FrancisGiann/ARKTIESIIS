<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <% const currentTerm = terms.find((term) => term.is_current); %>
  <% const createValues = (typeof formValues === 'undefined' ? {} : formValues) || {}; %>
  <section class="dashboard-heading records-heading">
    <div>
      <h1><%= view === 'setup' ? 'Academic setup' : 'Student records' %></h1>
      <p><%= view === 'setup' ? 'Configure academic terms and sections used by student records.' : `${currentUser.role === 'database_admin' ? 'Database administrator' : 'Registrar'} workspace · Lucena Branch` %></p>
    </div>
    <div class="admin-heading-actions">
      <% if (view === 'setup') { %><a class="button button--secondary" href="/registrar/records">Back to student records</a><% } else { %><% if (currentUser.role === 'registrar') { %><a class="button button--primary" href="/pre-enrollments">Review paper submissions</a><% } %><a class="button button--secondary" href="/registrar/records?view=setup">Academic setup</a><% } %>
      <% if (currentUser.role === 'registrar') { %><a class="button button--secondary" href="/registrar/intake">Enrollment intake</a><% } %>
      <% if (currentUser.role === 'database_admin') { %><a class="button button--secondary" href="/admin/student-accounts">Set up student logins</a><% } %>
      <a class="button button--secondary" href="/registrar/records/grades/missing">Grade completion overview</a>
    </div>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <% if (view !== 'setup') { %><section class="records-context-strip records-context-strip--term" aria-label="Academic term context">
    <p><strong>Current term</strong><span><% if (currentTerm) { %><%= currentTerm.school_year %> · <%= currentTerm.term %><% } else { %>No academic term is marked current.<% } %></span></p>
  </section><% } %>

  <% if (view === 'setup') { %>
    <section class="records-context-strip records-context-strip--term" aria-label="Academic setup next step">
      <p><strong>Current term</strong><span><% if (currentTerm) { %><%= currentTerm.school_year %> · <%= currentTerm.term %><% } else { %>No academic term is marked current.<% } %></span></p>
      <% const currentTermSections = currentTerm ? sections.filter((section) => Number(section.academic_term_id) === Number(currentTerm.id)) : []; %>
      <% if (currentTerm && !currentTermSections.length) { %>
        <p><strong>Next step</strong><span>No sections are set up for the current term.</span><a class="button button--primary" href="/registrar/records?view=setup&amp;openForm=section&amp;termId=<%= currentTerm.id %>#section-name">Add a section for this term</a></p>
      <% } else if (!currentTerm) { %>
        <p><strong>Next step</strong><span>Create an academic term before adding sections.</span><a class="button button--primary" href="/registrar/records?view=setup&amp;openForm=term#school-year">Add an academic term</a></p>
      <% } %>
      <nav class="admin-heading-actions" aria-label="Academic setup tasks">
        <a class="button button--secondary" href="/registrar/records/subjects?openForm=1#subject-code">Subjects</a>
        <a class="button button--secondary" href="/registrar/records/teacher-assignments<% if (currentTerm) { %>?termId=<%= currentTerm.id %><% } %>">Teacher assignments</a>
      </nav>
    </section>
  <% } %>

  <% if (view !== 'setup') { %>
  <section class="admin-section records-list-panel" aria-labelledby="students-title">
    <div class="admin-section__heading">
      <div><h2 id="students-title">Find a student record</h2><p>Search by name, student number, or LRN. Enrollment and required-document status stay visible in each result. Use Evaluate return only for a student returning after a break; continuing students follow the usual enrollment path.</p></div>
    </div>
    <form class="admin-search records-search" method="get" action="/registrar/records">
      <div class="field">
        <label for="student-search">Name, student number, or LRN</label>
        <input id="student-search" name="search" type="search" maxlength="100" value="<%= searchTerm %>" autocomplete="off">
      </div>
      <div class="field">
        <label for="term-filter">Academic term</label>
        <select id="term-filter" name="termId">
          <option value="">All terms</option>
          <% for (const term of terms) { %>
            <option value="<%= term.id %>" <%= academicTermId === term.id ? 'selected' : '' %>><%= term.school_year %> · <%= term.term %><%= term.is_current ? ' (current)' : '' %></option>
          <% } %>
        </select>
      </div>
      <div class="field">
        <label for="return-status-filter">Previously recorded return evaluation status</label>
        <select id="return-status-filter" name="returnStatus">
          <option value="">All statuses</option>
          <% for (const [value, label] of [['under_review', 'Under review'], ['accepted', 'Accepted'], ['not_accepted', 'Not accepted']]) { %>
            <option value="<%= value %>" <%= returnStatus === value ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
      </div>
      <button class="button button--secondary" type="submit">Search records</button>
      <% if (searchTerm || academicTermId || returnStatus) { %><a class="table-action" href="/registrar/records">Clear filters</a><% } %>
    </form>
    <% if (students.length) { %>
      <% const firstStudentNumber = (page - 1) * pageSize + 1; const lastStudentNumber = Math.min(page * pageSize, totalStudents); %>
      <p class="records-list-count" role="status">Showing <%= firstStudentNumber %>–<%= lastStudentNumber %> of <%= totalStudents %> students</p>
      <ul class="records-student-list" aria-label="Student records">
        <% for (const student of students) { %>
          <li class="records-student-list__item">
            <div class="records-student-main">
              <strong><%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></strong>
              <span>Student no. <%= student.student_no %> · LRN <%= student.lrn || 'Not recorded' %></span>
            </div>
            <div class="records-student-enrollment">
              <% if (student.academic_term_id) { %>
                <span><%= student.school_year %> · <%= student.term %><% if (student.section_name) { %> · <%= student.section_name %><% } %></span>
                <span><%= student.enrollment_status ? student.enrollment_status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Enrollment status unavailable' %></span>
              <% } else { %><span>No enrollment</span><% } %>
            </div>
            <span class="record-status <%= student.status === 'active' ? 'record-status--active' : student.status === 'archived' ? 'record-status--archived' : '' %>"><%= student.status ? student.status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Unknown' %></span>
            <a class="button button--primary records-student-open" href="/registrar/records/students/<%= student.id %>">Open record</a>
            <details class="records-student-details">
              <summary>Document details and other actions</summary>
              <div class="records-document-checks" aria-label="Required document status">
              <% const statusLabel = (status) => ({ valid: 'Verified', needs_review: 'Review needed', rejected: 'Rejected', pending: 'Processing', processing: 'Processing', failed: 'Review needed' })[status] || 'Missing'; %>
              <span>Good Moral <strong><%= statusLabel(student.good_moral_status) %></strong></span>
              <span>PSA <strong><%= statusLabel(student.psa_status) %></strong></span>
              <span>Form 137 physical record (staff only) <strong><%= student.form137_status ? student.form137_status.replaceAll('_', ' ') : 'Not recorded' %></strong></span>
              </div>
              <nav class="records-student-actions" aria-label="<%= [student.first_name, student.last_name].filter(Boolean).join(' ') %> secondary record actions">
              <a class="table-action" href="/registrar/records/students/<%= student.id %>/edit">Edit profile</a>
              <a class="table-action" href="/documents/students/<%= student.id %>">Documents</a>
              </nav>
            </details>
          </li>
        <% } %>
      </ul>
      <% if (totalPages > 1) { const pageUrl = (targetPage) => { const query = new URLSearchParams(); if (searchTerm) query.set('search', searchTerm); if (academicTermId) query.set('termId', String(academicTermId)); query.set('page', String(targetPage)); return `/registrar/records?${query.toString()}`; }; %>
        <nav class="records-pagination" aria-label="Student record pages">
          <% if (page > 1) { %><a class="button button--secondary" rel="prev" href="<%= pageUrl(page - 1) %>">Previous</a><% } else { %><span class="button button--secondary" aria-disabled="true">Previous</span><% } %>
          <span aria-current="page">Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a class="button button--secondary" rel="next" href="<%= pageUrl(page + 1) %>">Next</a><% } else { %><span class="button button--secondary" aria-disabled="true">Next</span><% } %>
        </nav>
      <% } %>
    <% } else { %><p class="empty-state">No student records match these filters. For a returning student, verify the name or LRN against the saved student record before starting a return evaluation.</p><% } %>
  </section>
  <% if (searchTerm && unlinkedEvaluations.length) { %>
    <section class="admin-section records-list-panel" aria-labelledby="previous-return-evaluations-title">
      <div class="admin-section__heading"><div><h2 id="previous-return-evaluations-title">Previously recorded return evaluations</h2><p>These saved reviews have no linked student record. Search by applicant name or LRN to reopen their existing review and history.</p></div></div>
      <div class="table-scroll" tabindex="0" aria-label="Previously recorded return evaluations"><table class="admin-table"><thead><tr><th scope="col">Applicant</th><th scope="col">LRN</th><th scope="col">School year</th><th scope="col">Target grade</th><th scope="col">Status</th><th scope="col">Revision</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead><tbody>
          <% for (const evaluation of unlinkedEvaluations) { const statusLabel = ({under_review:'Under review',accepted:'Accepted',not_accepted:'Not accepted'})[evaluation.status] || 'Under review'; %><tr>
            <th scope="row" data-label="Applicant"><%= [evaluation.first_name, evaluation.middle_name, evaluation.last_name, evaluation.suffix].filter(Boolean).join(' ') %></th>
            <td data-label="LRN"><%= evaluation.applicant_lrn %></td><td data-label="School year"><%= evaluation.school_year %></td><td data-label="Target grade"><%= evaluation.target_grade_level %></td>
            <td data-label="Status"><span class="status-chip"><%= statusLabel %></span></td><td data-label="Revision"><%= evaluation.version %></td>
            <td data-label="Action"><a class="table-action" href="/registrar/records/return-evaluations/<%= encodeURIComponent(evaluation.id) %>">Open evaluation</a></td>
          </tr><% } %>
        </tbody></table></div>
    </section>
  <% } %>
  <% } %>

  <% if (view === 'setup') { %><div class="records-management-grid">
    <section class="admin-section" aria-labelledby="terms-title">
      <div class="admin-section__heading"><div><h2 id="terms-title">Academic terms</h2><p>Create a term and choose which existing term is current.</p></div></div>
      <details class="records-create-disclosure" <%= openForm === 'term' ? 'open' : '' %>>
        <summary>Add academic term</summary>
        <form class="form-stack records-compact-form" method="post" action="/registrar/records/terms">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="admin-form-grid">
            <div class="field"><label for="school-year">School year</label><input id="school-year" name="schoolYear" type="text" maxlength="20" required value="<%= createValues.schoolYear || '' %>"></div>
            <div class="field"><label for="term-name">Term</label><input id="term-name" name="term" type="text" maxlength="30" required value="<%= createValues.term || '' %>"></div>
          </div>
          <label class="checkbox-field"><input name="isCurrent" value="1" type="checkbox" <%= createValues.isCurrent === '1' ? 'checked' : '' %>><span>Set this as the current term</span></label>
          <button class="button button--primary button--align-start" type="submit">Create term</button>
        </form>
      </details>
      <% if (terms.length) { %>
        <div class="table-scroll records-small-table" tabindex="0" aria-label="Academic terms">
          <table class="admin-table"><thead><tr><th scope="col">Term</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody><% for (const term of terms) { %><tr>
              <td data-label="Term"><%= term.school_year %> · <%= term.term %></td>
              <td data-label="Status"><%= term.is_current ? 'Current' : 'Previous' %></td>
              <td data-label="Actions"><% if (!term.is_current) { %>
                <form method="post" action="/registrar/records/terms/<%= term.id %>/current"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-action table-button" type="submit">Set current</button></form>
              <% } else { %><span class="muted-copy">Current term</span><% } %></td>
            </tr><% } %></tbody>
          </table>
        </div>
      <% } else { %><p class="empty-state">No academic terms have been created.</p><% } %>
    </section>

    <section class="admin-section" aria-labelledby="sections-title">
      <div class="admin-section__heading"><div><h2 id="sections-title">Sections</h2><p>Each section belongs to one academic term.</p></div></div>
      <details class="records-create-disclosure" <%= openForm === 'section' ? 'open' : '' %>>
        <summary>Add section</summary>
        <form class="form-stack records-compact-form" method="post" action="/registrar/records/sections">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="section-name">Section name</label><input id="section-name" name="name" type="text" maxlength="100" required value="<%= createValues.name || '' %>"></div>
          <div class="admin-form-grid">
            <div class="field"><label for="grade-level">Grade level (optional)</label><input id="grade-level" name="gradeLevel" type="text" maxlength="50" value="<%= createValues.gradeLevel || '' %>"></div>
            <div class="field"><label for="section-term">Academic term</label><select id="section-term" name="academicTermId" required><option value="">Choose a term</option><% for (const term of terms) { %><option value="<%= term.id %>" <%= String(createValues.academicTermId || '') === String(term.id) ? 'selected' : '' %>><%= term.school_year %> · <%= term.term %></option><% } %></select></div>
            <div class="field"><label for="section-cluster">Cluster (optional)</label><input id="section-cluster" name="cluster" maxlength="80" value="<%= createValues.cluster || '' %>"></div>
            <div class="field"><label for="section-strand">Strand (optional)</label><input id="section-strand" name="strand" maxlength="80" value="<%= createValues.strand || '' %>"></div>
            <div class="field"><label for="section-adviser">Adviser (optional)</label><input id="section-adviser" name="adviser" maxlength="160" value="<%= createValues.adviser || '' %>"></div>
            <div class="field"><label for="section-modality">Modality (optional)</label><select id="section-modality" name="modality"><option value="">Not recorded</option><% for (const [value, label] of [['face-to-face', 'Face to face'], ['distance', 'Distance'], ['modular', 'Modular'], ['hybrid', 'Hybrid']]) { %><option value="<%= value %>" <%= createValues.modality === value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
            <div class="field"><label for="section-modular-subtype">Modular subtype (if modular)</label><input id="section-modular-subtype" name="modularSubtype" maxlength="80" placeholder="e.g. printed modules" value="<%= createValues.modularSubtype || '' %>"></div>
          </div>
          <button class="button button--primary button--align-start" type="submit" <%= terms.length ? '' : 'disabled' %>>Create section</button>
        </form>
      </details>
      <% if (sections.length) { %>
        <% const termSectionGroups = terms.map((term) => ({ term, rows: sections.filter((section) => String(section.academic_term_id) === String(term.id)) })).filter((group) => group.rows.length); %>
        <% const ungroupedSections = sections.filter((section) => !terms.some((term) => String(term.id) === String(section.academic_term_id))); %>
        <div class="records-section-groups" aria-label="Sections grouped by academic term">
          <% for (const group of termSectionGroups) { %>
            <details class="records-section-group" <%= group.term.is_current ? 'open' : '' %>>
              <summary><strong><%= group.term.school_year %> · <%= group.term.term %></strong><span><%= group.rows.length %> <%= group.rows.length === 1 ? 'section' : 'sections' %></span></summary>
              <div class="table-scroll records-small-table" tabindex="0" aria-label="Sections for <%= group.term.school_year %> · <%= group.term.term %>">
                <table class="admin-table"><thead><tr><th scope="col">Section</th><th scope="col">Grade level</th><th scope="col">Cluster and strand</th><th scope="col">Adviser and modality</th></tr></thead>
                  <tbody><% for (const section of group.rows) { %><tr><td data-label="Section"><%= section.name %></td><td data-label="Grade level"><%= section.grade_level || '—' %></td><td data-label="Cluster and strand"><%= [section.cluster ? `Cluster ${section.cluster}` : '', section.strand].filter(Boolean).join(' · ') || '—' %></td><td data-label="Adviser and modality"><%= [section.adviser, section.modality, section.modular_subtype].filter(Boolean).join(' · ') || '—' %></td></tr><% } %></tbody>
                </table>
              </div>
            </details>
          <% } %>
          <% if (ungroupedSections.length) { %>
            <details class="records-section-group" open>
              <summary><strong>Term unavailable</strong><span><%= ungroupedSections.length %> <%= ungroupedSections.length === 1 ? 'section' : 'sections' %></span></summary>
              <div class="table-scroll records-small-table" tabindex="0" aria-label="Sections without an available academic term">
                <table class="admin-table"><thead><tr><th scope="col">Section</th><th scope="col">Grade level</th><th scope="col">Term</th><th scope="col">Cluster and strand</th><th scope="col">Adviser and modality</th></tr></thead>
                  <tbody><% for (const section of ungroupedSections) { %><tr><td data-label="Section"><%= section.name %></td><td data-label="Grade level"><%= section.grade_level || '—' %></td><td data-label="Term"><%= section.school_year || '—' %> · <%= section.term || '—' %></td><td data-label="Cluster and strand"><%= [section.cluster ? `Cluster ${section.cluster}` : '', section.strand].filter(Boolean).join(' · ') || '—' %></td><td data-label="Adviser and modality"><%= [section.adviser, section.modality, section.modular_subtype].filter(Boolean).join(' · ') || '—' %></td></tr><% } %></tbody>
                </table>
              </div>
            </details>
          <% } %>
        </div>
      <% } else { %><p class="empty-state">No sections have been created.</p><% } %>
    </section>
  </div><% } %>
</main>
<%- include('../partials/foot') %>
