<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <% const currentTerm = terms.find((term) => term.is_current); %>
  <section class="dashboard-heading records-heading">
    <div>
      <h1>Student records</h1>
      <p><%= currentUser.role === 'database_admin' ? 'Database administrator' : 'Registrar' %> workspace <span aria-hidden="true">·</span> Lucena Branch</p>
    </div>
    <div class="admin-heading-actions">
      <% if (currentUser.role === 'registrar') { %><a class="button button--secondary" href="/registrar/intake">Enrollment intake</a><% } %>
      <% if (currentUser.role === 'database_admin') { %><a class="button button--secondary" href="/admin/student-accounts">Set up student logins</a><% } %>
    </div>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="records-context-strip records-context-strip--term" aria-label="Academic term context">
    <p><strong>Current term</strong><span><% if (currentTerm) { %><%= currentTerm.school_year %> · <%= currentTerm.term %><% } else { %>No academic term is marked current.<% } %></span></p>
  </section>

  <section class="admin-section records-list-panel" aria-labelledby="students-title">
    <div class="admin-section__heading">
      <div>
        <h2 id="students-title">Student master list</h2>
        <p>Find a student by name, student number, or LRN. Enrollment and required-document status stay visible in the result.</p>
      </div>
    </div>
    <form class="admin-search records-search" method="get" action="/registrar/records">
      <div class="field">
        <label for="student-search">Name, student number, or LRN</label>
        <input id="student-search" name="search" type="search" maxlength="100" value="<%= searchTerm %>" autocomplete="off">
      </div>
      <div class="field">
        <label for="term-filter">Academic term</label>
        <select id="term-filter" name="termId">
          <option value="">All terms</option>
          <% for (const term of terms) { %>
            <option value="<%= term.id %>" <%= academicTermId === term.id ? 'selected' : '' %>><%= term.school_year %> · <%= term.term %><%= term.is_current ? ' (current)' : '' %></option>
          <% } %>
        </select>
      </div>
      <button class="button button--secondary" type="submit">Filter records</button>
      <% if (searchTerm || academicTermId) { %><a class="table-action" href="/registrar/records">Clear filters</a><% } %>
    </form>
    <% if (students.length) { %>
      <% const firstStudentNumber = (page - 1) * pageSize + 1; const lastStudentNumber = Math.min(page * pageSize, totalStudents); %>
      <p class="records-list-count" role="status">Showing <%= firstStudentNumber %>–<%= lastStudentNumber %> of <%= totalStudents %> students</p>
      <ul class="records-student-list" aria-label="Student records">
        <% for (const student of students) { %>
          <li class="records-student-list__item">
            <div class="records-student-main">
              <strong><%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></strong>
              <span>Student no. <%= student.student_no %> · LRN <%= student.lrn || 'Not recorded' %></span>
            </div>
            <div class="records-student-enrollment">
              <% if (student.academic_term_id) { %>
                <span><%= student.school_year %> · <%= student.term %><% if (student.section_name) { %> · <%= student.section_name %><% } %></span>
                <span><%= student.enrollment_status ? student.enrollment_status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Enrollment status unavailable' %></span>
              <% } else { %><span>No enrollment</span><% } %>
            </div>
            <div class="records-document-checks" aria-label="Required document status">
              <% const statusLabel = (status) => ({ valid: 'Verified', needs_review: 'Review needed', rejected: 'Rejected', pending: 'Processing', processing: 'Processing', failed: 'Review needed' })[status] || 'Missing'; %>
              <span>Good Moral <strong><%= statusLabel(student.good_moral_status) %></strong></span>
              <span>PSA <strong><%= statusLabel(student.psa_status) %></strong></span>
              <span>Form 137 physical record (staff only) <strong><%= student.form137_status ? student.form137_status.replaceAll('_', ' ') : 'Not recorded' %></strong></span>
            </div>
            <span class="record-status <%= student.status === 'active' ? 'record-status--active' : student.status === 'archived' ? 'record-status--archived' : '' %>"><%= student.status ? student.status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Unknown' %></span>
            <nav class="records-student-actions" aria-label="<%= [student.first_name, student.last_name].filter(Boolean).join(' ') %> record actions">
              <a class="table-action" href="/registrar/records/students/<%= student.id %>">Open student record</a>
              <a class="table-action" href="/registrar/records/students/<%= student.id %>/edit">Edit profile</a>
              <a class="table-action" href="/documents/students/<%= student.id %>">Documents</a>
            </nav>
          </li>
        <% } %>
      </ul>
      <% if (totalPages > 1) { const pageUrl = (targetPage) => { const query = new URLSearchParams(); if (searchTerm) query.set('search', searchTerm); if (academicTermId) query.set('termId', String(academicTermId)); query.set('page', String(targetPage)); return `/registrar/records?${query.toString()}`; }; %>
        <nav class="records-pagination" aria-label="Student record pages">
          <% if (page > 1) { %><a class="button button--secondary" rel="prev" href="<%= pageUrl(page - 1) %>">Previous</a><% } else { %><span class="button button--secondary" aria-disabled="true">Previous</span><% } %>
          <span aria-current="page">Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a class="button button--secondary" rel="next" href="<%= pageUrl(page + 1) %>">Next</a><% } else { %><span class="button button--secondary" aria-disabled="true">Next</span><% } %>
        </nav>
      <% } %>
    <% } else { %><p class="empty-state">No student records match these filters.</p><% } %>
  </section>

  <div class="records-management-grid">
    <section class="admin-section" aria-labelledby="terms-title">
      <div class="admin-section__heading"><div><h2 id="terms-title">Academic terms</h2><p>Create a term and choose which existing term is current.</p></div></div>
      <form class="form-stack records-compact-form" method="post" action="/registrar/records/terms">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-form-grid">
          <div class="field"><label for="school-year">School year</label><input id="school-year" name="schoolYear" type="text" maxlength="20" required></div>
          <div class="field"><label for="term-name">Term</label><input id="term-name" name="term" type="text" maxlength="30" required></div>
        </div>
        <label class="checkbox-field"><input name="isCurrent" value="1" type="checkbox"><span>Set this as the current term</span></label>
        <button class="button button--primary button--align-start" type="submit">Create term</button>
      </form>
      <% if (terms.length) { %>
        <div class="table-scroll records-small-table" tabindex="0" aria-label="Academic terms">
          <table class="admin-table"><thead><tr><th scope="col">Term</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody><% for (const term of terms) { %><tr>
              <td data-label="Term"><%= term.school_year %> · <%= term.term %></td>
              <td data-label="Status"><%= term.is_current ? 'Current' : 'Previous' %></td>
              <td data-label="Actions"><% if (!term.is_current) { %>
                <form method="post" action="/registrar/records/terms/<%= term.id %>/current"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="table-action table-button" type="submit">Set current</button></form>
              <% } else { %><span class="muted-copy">Current term</span><% } %></td>
            </tr><% } %></tbody>
          </table>
        </div>
      <% } else { %><p class="empty-state">No academic terms have been created.</p><% } %>
    </section>

    <section class="admin-section" aria-labelledby="sections-title">
      <div class="admin-section__heading"><div><h2 id="sections-title">Sections</h2><p>Each section belongs to one academic term.</p></div></div>
      <form class="form-stack records-compact-form" method="post" action="/registrar/records/sections">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="section-name">Section name</label><input id="section-name" name="name" type="text" maxlength="100" required></div>
        <div class="admin-form-grid">
          <div class="field"><label for="grade-level">Grade level (optional)</label><input id="grade-level" name="gradeLevel" type="text" maxlength="50"></div>
          <div class="field"><label for="section-term">Academic term</label><select id="section-term" name="academicTermId" required><option value="">Choose a term</option><% for (const term of terms) { %><option value="<%= term.id %>"><%= term.school_year %> · <%= term.term %></option><% } %></select></div>
        </div>
        <button class="button button--primary button--align-start" type="submit" <%= terms.length ? '' : 'disabled' %>>Create section</button>
      </form>
      <% if (sections.length) { %>
        <div class="table-scroll records-small-table" tabindex="0" aria-label="Sections and academic terms">
          <table class="admin-table"><thead><tr><th scope="col">Section</th><th scope="col">Grade level</th><th scope="col">Term</th></tr></thead>
            <tbody><% for (const section of sections) { %><tr><td data-label="Section"><%= section.name %></td><td data-label="Grade level"><%= section.grade_level || '—' %></td><td data-label="Term"><%= section.school_year %> · <%= section.term %></td></tr><% } %></tbody>
          </table>
        </div>
      <% } else { %><p class="empty-state">No sections have been created.</p><% } %>
    </section>
  </div>
</main>
<%- include('../partials/foot') %>
