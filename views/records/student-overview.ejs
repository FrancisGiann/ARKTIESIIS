<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page student-record-overview" id="main-content">
  <a class="context-back" href="/registrar/records">Back to student search</a>
  <%- include('../partials/student-record-navigation', { student, activeStudentView: studentView }) %>
  <h2 class="student-record-view-title"><%= ({ overview: 'Overview', history: 'Profile revision history', requests: 'Document requests', 'return-evaluation': 'Return evaluation' })[studentView] %></h2>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (requestError) { %><p class="form-alert" role="alert"><%= requestError %></p><% } %>
  <% if (returnEvaluationError) { %><p class="form-alert" role="alert" tabindex="-1"><%= returnEvaluationError %></p><% } %>

  <% if (studentView === 'overview') { %>
  <section class="student-record-status-grid" aria-label="Student record status">
    <article class="admin-section">
      <h2>Enrollment</h2>
      <% const currentEnrollment = enrollments.find((entry) => entry.is_current) || enrollments[0]; %>
      <% const currentPlacement = currentEnrollment ? formatStudentPlacement(currentEnrollment.grade_level, currentEnrollment.section_name) : ''; %>
      <% if (currentEnrollment) { %>
        <p><strong><%= currentEnrollment.school_year %> · <%= currentEnrollment.term %></strong></p>
        <p><%= currentPlacement || 'Section not assigned' %></p>
        <p>Status: <%= currentEnrollment.enrollment_status.replaceAll('_', ' ') %></p>
      <% } else { %><p class="empty-state">No enrollment has been recorded.</p><% } %>
      <a class="text-link" href="/registrar/records/students/<%= student.id %>/edit">Review enrollment history</a>
    </article>
    <article class="admin-section" aria-labelledby="document-status-title">
      <h2 id="document-status-title">Required document status</h2>
      <% const documentLabel = (status) => ({ valid: 'Verified by staff', needs_review: 'Needs staff review', rejected: 'Rejected', pending: 'Precheck queued', processing: 'Precheck running', failed: 'Staff review required' })[status] || 'Not submitted'; %>
      <% const previousReportCardLabel = (status, decision) => status === 'needs_review' && decision === 'correction_requested' ? 'Correction requested' : documentLabel(status); %>
      <% const previousReportCardPaperLabel = (status) => ({ pending: 'Pending', received: 'Received', verified: 'Checked by staff', correction: 'Clearer or replacement copy needed', rejected: 'Not accepted for this requirement' })[status] || 'Not recorded'; %>
      <dl class="student-record-document-list">
        <div><dt>Good Moral Certificate</dt><dd><span class="record-document-status"><%= documentLabel(student.good_moral_status) %></span></dd></div>
        <div><dt>PSA birth certificate</dt><dd><span class="record-document-status"><%= documentLabel(student.psa_status) %></span></dd></div>
        <div><dt>Previous-school report card · digital enrollment scan</dt><dd><span class="record-document-status"><%= previousReportCardLabel(student.previous_report_card_status, student.previous_report_card_latest_decision_type) %></span><a class="text-link" href="/documents/students/<%= student.id %>">Review digital submission</a></dd></div>
        <div><dt>Previous-school report card · paper copy (staff only)</dt><dd><span class="record-document-status"><%= previousReportCardPaperLabel(student.previous_school_report_card_physical_status) %></span><a class="text-link" href="/documents/students/<%= student.id %>#previous-school-report-card-status-title">Record paper-copy status</a></dd></div>
        <div><dt>Form 137 paper record (staff only)</dt><dd><span class="record-document-status"><%= student.form137_status ? student.form137_status.replaceAll('_', ' ') : 'Not recorded' %></span><a class="text-link" href="/documents/students/<%= student.id %>#form137-status-title">Record Form 137 status</a></dd></div>
      </dl>
      <p class="muted-copy">The digital scan and paper-copy status are separate enrollment records. Neither writes grades. Form 137 stays in its own staff-only physical-record workflow.</p>
    </article>
  </section>
  <section class="student-record-status-grid" aria-label="Document request finance summary">
    <article class="admin-section"><h2>Document request finance status</h2>
      <p><strong><%= financeSummary.status %></strong></p>
      <p>All-years outstanding: <strong><%= financeSummary.outstanding === null ? 'Pending finance review' : `₱${financeSummary.outstanding}` %></strong></p>
      <p class="muted-copy">This safe summary combines all annual years and legacy records. Finance notes and payment arrangement details remain private.</p>
      <a class="text-link" href="/registrar/records/students/<%= student.id %>?view=requests">Review document requests</a>
    </article>
  </section>
  <% if (returnEligibility?.eligible || returnEvaluations.length) { %><section class="admin-section" aria-labelledby="return-evaluations-title">
    <div class="admin-section__heading"><div><h2 id="return-evaluations-title">Return evaluations</h2><p>Use this review only when a student returns after a break. Continuing students keep the usual enrollment path. The action appears when a recorded departure or school-year gap is on file.</p></div>
      <% if (currentUser.role === 'registrar' && returnEligibility?.eligible && /^\d{12}$/.test(String(student.lrn || ''))) { %><a class="button button--secondary" href="/registrar/records/students/<%= student.id %>/return-evaluations/new">Evaluate return</a><% } else if (currentUser.role === 'registrar' && returnEligibility?.eligible) { %><a class="text-link" href="/registrar/records/students/<%= student.id %>/edit">Add a valid 12-digit LRN in the saved profile before starting an evaluation.</a><% } %>
    </div>
    <% if (returnEvaluations.length) { %><div class="table-scroll" tabindex="0" aria-label="Return evaluation history"><table class="admin-table"><thead><tr><th scope="col">School year</th><th scope="col">Target grade</th><th scope="col">Status</th><th scope="col">Revision</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead><tbody>
      <% for (const item of returnEvaluations) { %><tr><td data-label="School year"><%= item.school_year %></td><td data-label="Target grade"><%= item.target_grade_level %></td><td data-label="Status"><%= ({under_review:'Under review',accepted:'Accepted',not_accepted:'Not accepted'})[item.status] || item.status %></td><td data-label="Revision"><%= item.version %></td><td data-label="Action"><a class="table-action" href="/registrar/records/students/<%= student.id %>/return-evaluations/<%= encodeURIComponent(item.id) %>">Open evaluation</a></td></tr><% } %>
    </tbody></table></div><% } else { %><p class="empty-state">No return evaluations are recorded for this student.</p><% } %>
  </section><% } %>
  <% } %>

  <% if (studentView === 'return-evaluation') { %>
    <section class="admin-section" aria-labelledby="return-review-context-title">
      <h3 id="return-review-context-title">Current academic record context</h3>
      <p>This is the student's live saved academic history and may include enrollment after this evaluation. The evaluation's prior-progress findings and revision history remain separate.</p>
      <p><a class="text-link" href="/registrar/records/students/<%= student.id %>/academic">Open full academic history and grades</a></p>
      <% if (returnEligibility?.departure) { const departureDate = returnEligibility.departure.effectiveDate instanceof Date ? returnEligibility.departure.effectiveDate.toISOString().slice(0, 10) : String(returnEligibility.departure.effectiveDate || '').slice(0, 10); %>
        <p><strong>Recorded departure on file:</strong> <%= returnEligibility.departure.departureType === 'transferred' ? 'Transferred' : returnEligibility.departure.departureType === 'dropped' ? 'Dropped' : String(returnEligibility.departure.departureType || 'Departure recorded').replaceAll('_', ' ') %><% if (returnEligibility.departure.schoolYear) { %> during <%= returnEligibility.departure.schoolYear %><% } %><% if (returnEligibility.departure.term) { %>, <%= returnEligibility.departure.term %><% } %><% if (departureDate) { %> · effective <%= departureDate %><% } %>.</p>
      <% } else if (returnEligibility?.basis === 'school_year_gap') { %>
        <p><strong>Eligibility context:</strong> the latest saved participation is in <%= returnEligibility.latestRecordedSchoolYear || 'an earlier school year' %>; no departure case is recorded.</p>
      <% } %>
      <% if (lastEnrollment) { %>
        <article class="academic-enrollment" aria-labelledby="return-last-enrollment-title">
          <h4 id="return-last-enrollment-title">Last recorded enrollment</h4>
          <p><strong><%= lastEnrollment.school_year %> · <%= lastEnrollment.term %></strong> · <%= formatStudentPlacement(lastEnrollment.grade_level, lastEnrollment.section_name) || 'Section not assigned' %> · Status: <%= String(lastEnrollment.enrollment_status || 'not recorded').replaceAll('_', ' ') %></p>
          <p class="muted-copy">This identifies a saved enrollment record and does not by itself establish when or why the student stopped attending.</p>
        </article>
      <% } else if (enrollments.length) { %>
        <p class="notice-panel" role="status">Saved enrollments are listed below. A single latest term cannot be established from the available configured order.</p>
      <% } %>
      <% if (enrollments.length) { %>
        <div class="records-request-list" aria-label="Saved academic enrollments">
          <% for (const enrollment of enrollments) { %>
            <article class="academic-enrollment" aria-labelledby="return-enrollment-<%= enrollment.id %>">
              <h4 id="return-enrollment-<%= enrollment.id %>">Recorded enrollment · <%= enrollment.school_year %> · <%= enrollment.term %></h4>
              <p><%= formatStudentPlacement(enrollment.grade_level, enrollment.section_name) || 'Section not assigned' %> · Status: <%= String(enrollment.enrollment_status || 'not recorded').replaceAll('_', ' ') %></p>
              <% if (enrollment.subjects?.length) { %>
                <div class="table-scroll" tabindex="0" aria-label="Recorded subjects and grades for <%= enrollment.school_year %> <%= enrollment.term %>"><table class="admin-table">
                  <thead><tr><th scope="col">Subject code</th><th scope="col">Subject name</th><th scope="col">Recorded grades and remarks</th></tr></thead>
                  <tbody><% for (const subject of enrollment.subjects) { %><tr>
                    <td data-label="Subject code"><%= subject.subjectCode || 'Not recorded' %></td><td data-label="Subject name"><%= subject.subjectName || 'Not recorded' %></td>
                    <td data-label="Recorded grades and remarks"><% if (subject.grades?.length) { %><ul><% for (const grade of subject.grades) { %><li><%= grade.gradingPeriod || 'Period not recorded' %>: <%= grade.gradeValue ?? 'No grade recorded' %><% if (grade.remarks) { %> · <%= grade.remarks %><% } %></li><% } %></ul><% } else { %>No grades recorded<% } %></td>
                  </tr><% } %></tbody>
                </table></div>
                <p class="muted-copy">These are recorded subject assignments and marks. A mark does not by itself establish subject completion.</p>
              <% } else { %><p class="empty-state">No subject assignments are recorded for this enrollment.</p><% } %>
            </article>
          <% } %>
        </div>
      <% } else { %><p class="empty-state">No academic enrollment history is recorded.</p><% } %>
    </section>
    <% if (returnEvaluation) { %><p class="status-pill"><%= ({under_review:'Under review',accepted:'Accepted',not_accepted:'Not accepted'})[returnEvaluation.status] || returnEvaluation.status %> · revision <%= returnEvaluation.version %></p><% } %>
    <% if (!returnEvaluation && currentUser.role === 'registrar' && !/^\d{12}$/.test(String(student.lrn || ''))) { %>
      <p class="notice-panel" role="status">This student record needs a valid 12-digit LRN before a return evaluation can be started. <a class="text-link" href="/registrar/records/students/<%= student.id %>/edit">Review the student profile</a>.</p>
    <% } else { %>
      <%- include('../partials/return-evaluation-form', { student, evaluation: returnEvaluation, returnEvaluationValues, error: returnEvaluationError, csrfToken, currentUser, expectedVersion: returnEvaluationExpectedVersion }) %>
    <% } %>
  <% } %>

  <% if (studentView === 'requests') { %>
  <section class="admin-section" aria-labelledby="document-request-ledger-title">
    <div class="admin-section__heading">
      <div><h2 id="document-request-ledger-title">Document requests and release history</h2><p>Staff tracking only. This ledger does not create a certificate, send a file, or change document access.</p></div>
    </div>
    <section class="registrar-overview__selected" aria-label="Safe finance balance summary">
      <div><dt>Finance status</dt><dd><%= financeSummary.status %></dd></div>
      <div><dt>All-years outstanding</dt><dd><%= financeSummary.outstanding === null ? 'Pending finance review' : `₱${financeSummary.outstanding}` %></dd></div>
    </section>
    <p class="muted-copy">Finance checks annual balances across all years and legacy records. Payment arrangements, finance reasons, and private finance notes stay with Finance.</p>
    <form class="form-stack records-compact-form" method="post" action="/registrar/records/students/<%= student.id %>/document-requests">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="idempotencyKey" value="<%= newDocumentRequestKey %>">
      <div class="admin-form-grid">
        <div class="field"><label for="request-document-type">Document type</label><input id="request-document-type" name="documentType" maxlength="50" value="<%= requestFormValues.documentType || '' %>" required placeholder="e.g. Transcript of Records"></div>
        <div class="field"><label for="request-document-name">Document name or description</label><input id="request-document-name" name="documentName" maxlength="150" value="<%= requestFormValues.documentName || '' %>" required></div>
        <div class="field"><label for="request-requested-on">Request date</label><input id="request-requested-on" name="requestedOn" type="date" value="<%= requestFormValues.requestedOn || '' %>" required></div>
        <div class="field"><label for="request-reference">Reference (optional)</label><input id="request-reference" name="reference" maxlength="200" value="<%= requestFormValues.reference || '' %>"></div>
      </div>
      <button class="button button--primary button--align-start" type="submit">Record document request</button>
    </form>
    <% if (documentRequests.length) { %>
      <div class="records-request-list">
        <% for (const request of documentRequests) { const requestDate = request.requested_on instanceof Date ? request.requested_on.toISOString().slice(0, 10) : String(request.requested_on || '').slice(0, 10); const releaseDate = request.released_on instanceof Date ? request.released_on.toISOString().slice(0, 10) : String(request.released_on || '').slice(0, 10); const expectedClaimDate = request.expected_claim_date instanceof Date ? request.expected_claim_date.toISOString().slice(0, 10) : String(request.expected_claim_date || '').slice(0, 10); const requestKey = requestIdempotencyKeys[request.id]; const clearance = requestClearanceData[request.id] || { status: 'pending', history: [], claimSlipHistory: [], claimSlipCurrent: false }; %>
          <article class="academic-enrollment" aria-labelledby="document-request-<%= request.id %>">
            <h3 id="document-request-<%= request.id %>"><%= request.document_name %> <span class="record-status"><%= request.status.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) %></span></h3>
            <p><strong><%= request.document_type %></strong> · Requested <%= requestDate %> · Reference: <%= request.reference_text || 'None' %></p>
            <p>Finance clearance: <strong><%= clearance.status.replaceAll('_', ' ') %></strong><% if (clearance.status === 'approved') { %><%= clearance.hasArrangement ? ' with payment arrangement' : '' %> · <%= clearance.actorName %> · <%= clearance.decidedAt instanceof Date ? clearance.decidedAt.toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : clearance.decidedAt %><% } %></p>
            <% if (clearance.status === 'reapproval_required') { %><p class="form-alert">Finance must review the increased balance before processing continues. Issue a new claim slip after approval.</p><% } %>
            <% if (request.status === 'released') { %><p>Release recorded <%= releaseDate %> to <%= request.recipient %><%= request.handover_reference ? ` · Reference ${request.handover_reference}` : '' %>.</p><% } %>
            <% if (clearance.history.length) { %><details><summary>Finance decision history (<%= clearance.history.length %>)</summary><ol class="records-request-history"><% for (const event of clearance.history) { %><li><strong><%= event.eventType.replaceAll('_', ' ') %></strong> · <%= event.status.replaceAll('_', ' ') %> · <%= event.actorName %> · <%= event.createdAt instanceof Date ? event.createdAt.toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : event.createdAt %><% if (event.eventType === 'approved' && event.hasArrangement) { %> · Payment arrangement recorded<% } %></li><% } %></ol></details><% } %>
            <% if (clearance.claimSlipHistory.length) { %><details><summary>Claim slip history (<%= clearance.claimSlipHistory.length %>)</summary><ol class="records-request-history"><% for (const slip of clearance.claimSlipHistory) { const slipDate = slip.expected_claim_date instanceof Date ? slip.expected_claim_date.toISOString().slice(0, 10) : String(slip.expected_claim_date || '').slice(0, 10); %><li><strong><%= slip.event_type %></strong> · Expected claim date <%= slipDate %> · <%= [slip.issuer_first_name, slip.issuer_last_name].filter(Boolean).join(' ') || 'Registrar staff' %><% if (slip.reason) { %><p>Reason: <%= slip.reason %></p><% } %></li><% } %></ol></details><% } %>
            <% if (clearance.claimSlipCurrent) { %><p><a class="button button--secondary" href="/registrar/records/students/<%= student.id %>/document-requests/<%= request.id %>/claim-slip">Print current claim slip</a></p><% } %>
            <% if (['processing', 'ready'].includes(request.status) && clearance.status === 'approved') { %>
              <details <%= requestForm === 'claim-slip' && requestFormId === request.id ? 'open' : '' %>><summary><%= request.current_claim_slip_id ? 'Reissue or reschedule claim slip' : 'Issue claim slip' %></summary>
                <form class="form-stack records-compact-form" method="post" action="/registrar/records/students/<%= student.id %>/document-requests/<%= request.id %>/claim-slip">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= claimSlipIdempotencyKeys[request.id] %>">
                  <div class="admin-form-grid"><div class="field"><label for="claim-date-<%= request.id %>">Expected claim date</label><input id="claim-date-<%= request.id %>" name="expectedClaimDate" type="date" value="<%= requestForm === 'claim-slip' && requestFormId === request.id ? requestFormValues.expectedClaimDate || '' : expectedClaimDate %>" required></div>
                    <% if (request.current_claim_slip_id) { %><div class="field"><label for="claim-reason-<%= request.id %>">Reason for reissue or reschedule</label><input id="claim-reason-<%= request.id %>" name="reason" maxlength="500" minlength="5" value="<%= requestForm === 'claim-slip' && requestFormId === request.id ? requestFormValues.reason || '' : '' %>" required></div><% } %></div>
                  <button class="button button--secondary" type="submit">Save claim slip</button>
                </form>
              </details>
            <% } %>
            <% if (['requested', 'processing', 'ready'].includes(request.status)) { %>
              <details <%= requestForm === 'status' && requestFormId === request.id ? 'open' : '' %>><summary>Update request status</summary>
                <form class="form-stack records-compact-form document-request-status-form" method="post" action="/registrar/records/students/<%= student.id %>/document-requests/<%= request.id %>/status">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= requestKey %>">
                  <div class="admin-form-grid">
                    <div class="field"><label for="request-status-<%= request.id %>">Status</label><select id="request-status-<%= request.id %>" name="status" required><% const nextStatuses = { requested: ['processing', 'cancelled'], processing: ['ready', 'cancelled'], ready: ['released', 'cancelled'] }; for (const nextStatus of nextStatuses[request.status] || []) { %><option value="<%= nextStatus %>" <%= requestForm === 'status' && requestFormId === request.id && requestFormValues.status === nextStatus ? 'selected' : '' %>><%= nextStatus.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) %></option><% } %></select></div>
                    <div class="field request-status-conditional" data-status-only="released" hidden><label for="request-release-date-<%= request.id %>">Release date</label><input id="request-release-date-<%= request.id %>" name="releasedOn" type="date" value="<%= requestForm === 'status' && requestFormId === request.id ? requestFormValues.releasedOn || '' : '' %>" data-required-status="released" disabled></div>
                    <div class="field request-status-conditional" data-status-only="released" hidden><label for="request-recipient-<%= request.id %>">Recipient</label><input id="request-recipient-<%= request.id %>" name="recipient" maxlength="150" value="<%= requestForm === 'status' && requestFormId === request.id ? requestFormValues.recipient || '' : '' %>" data-required-status="released" disabled></div>
                    <div class="field request-status-conditional" data-status-only="released" hidden><label for="request-handover-reference-<%= request.id %>">Handover reference (optional)</label><input id="request-handover-reference-<%= request.id %>" name="handoverReference" maxlength="200" value="<%= requestForm === 'status' && requestFormId === request.id ? requestFormValues.handoverReference || '' : '' %>" disabled></div>
                    <div class="field request-status-conditional" data-status-only="cancelled" hidden><label for="request-cancel-reason-<%= request.id %>">Cancellation reason</label><input id="request-cancel-reason-<%= request.id %>" name="reason" maxlength="500" value="<%= requestForm === 'status' && requestFormId === request.id ? requestFormValues.reason || '' : '' %>" data-required-status="cancelled" disabled></div>
                  </div>
                  <button class="button button--secondary button--align-start" type="submit">Save status</button>
                </form>
              </details>
            <% } %>
            <details <%= requestForm === 'correct' && requestFormId === request.id ? 'open' : '' %>><summary>Correct request details</summary>
              <form class="form-stack records-compact-form" method="post" action="/registrar/records/students/<%= student.id %>/document-requests/<%= request.id %>/correct">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= correctionIdempotencyKeys[request.id] %>">
                <div class="admin-form-grid">
                  <div class="field"><label for="correct-type-<%= request.id %>">Document type</label><input id="correct-type-<%= request.id %>" name="documentType" maxlength="50" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.documentType || '' : request.document_type %>" required></div>
                  <div class="field"><label for="correct-name-<%= request.id %>">Document name</label><input id="correct-name-<%= request.id %>" name="documentName" maxlength="150" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.documentName || '' : request.document_name %>" required></div>
                  <div class="field"><label for="correct-date-<%= request.id %>">Request date</label><input id="correct-date-<%= request.id %>" name="requestedOn" type="date" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.requestedOn || '' : requestDate %>" required></div>
                  <div class="field"><label for="correct-reference-<%= request.id %>">Reference</label><input id="correct-reference-<%= request.id %>" name="reference" maxlength="200" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.reference || '' : request.reference_text || '' %>"></div>
                  <% if (request.status === 'released') { %>
                    <div class="field"><label for="correct-release-date-<%= request.id %>">Release date</label><input id="correct-release-date-<%= request.id %>" name="releasedOn" type="date" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.releasedOn || '' : releaseDate %>" required></div>
                    <div class="field"><label for="correct-recipient-<%= request.id %>">Recipient</label><input id="correct-recipient-<%= request.id %>" name="recipient" maxlength="150" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.recipient || '' : request.recipient %>" required></div>
                    <div class="field"><label for="correct-handover-reference-<%= request.id %>">Handover reference (optional)</label><input id="correct-handover-reference-<%= request.id %>" name="handoverReference" maxlength="200" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.handoverReference || '' : request.handover_reference || '' %>"></div>
                  <% } %>
                  <div class="field"><label for="correct-reason-<%= request.id %>">Correction reason</label><input id="correct-reason-<%= request.id %>" name="reason" maxlength="500" value="<%= requestForm === 'correct' && requestFormId === request.id ? requestFormValues.reason || '' : '' %>" required></div>
                </div>
                <button class="button button--secondary button--align-start" type="submit">Record correction</button>
              </form>
            </details>
            <details><summary>Request event history (<%= request.history.length %>)</summary>
              <ol class="records-request-history"><% for (const event of request.history) { %><li>
                <strong><%= event.event_type.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) %></strong>
                <% if (event.status_from && event.status_from !== event.status_to) { %> · <%= event.status_from %> → <%= event.status_to %><% } else { %> · <%= event.status_to %><% } %>
                · <%= [event.actor_first_name, event.actor_last_name].filter(Boolean).join(' ') || 'Staff' %>
                <% if (event.released_on) { const eventReleaseDate = event.released_on instanceof Date ? event.released_on.toISOString().slice(0, 10) : String(event.released_on).slice(0, 10); %> · Release date <%= eventReleaseDate %> to <%= event.recipient %><% } %>
                <% if (event.handover_reference && event.event_type === 'released') { %> · Handover reference <%= event.handover_reference %><% } %>
                <% if (event.reason) { %><p>Reason: <%= event.reason %></p><% } %>
                <% if (event.event_type === 'corrected') { const oldRequestedDate = event.requested_on_before instanceof Date ? event.requested_on_before.toISOString().slice(0, 10) : String(event.requested_on_before || '').slice(0, 10); const newRequestedDate = event.requested_on_after instanceof Date ? event.requested_on_after.toISOString().slice(0, 10) : String(event.requested_on_after || '').slice(0, 10); %>
                  <% if (event.document_name_before !== event.document_name_after) { %><p>Document name: <%= event.document_name_before %> → <%= event.document_name_after %></p><% } %>
                  <% if (event.document_type_before !== event.document_type_after) { %><p>Document type: <%= event.document_type_before %> → <%= event.document_type_after %></p><% } %>
                  <% if (oldRequestedDate !== newRequestedDate) { %><p>Request date: <%= oldRequestedDate %> → <%= newRequestedDate %></p><% } %>
                  <% if ((event.reference_before || '') !== (event.reference_after || '')) { %><p>Reference: <%= event.reference_before || 'None' %> → <%= event.reference_after || 'None' %></p><% } %>
                  <% const oldReleaseDate = event.released_on_before instanceof Date ? event.released_on_before.toISOString().slice(0, 10) : String(event.released_on_before || '').slice(0, 10); const newReleaseDate = event.released_on_after instanceof Date ? event.released_on_after.toISOString().slice(0, 10) : String(event.released_on_after || '').slice(0, 10); %>
                  <% if (oldReleaseDate !== newReleaseDate) { %><p>Release date: <%= oldReleaseDate || 'None' %> → <%= newReleaseDate || 'None' %></p><% } %>
                  <% if ((event.recipient_before || '') !== (event.recipient_after || '')) { %><p>Recipient: <%= event.recipient_before || 'None' %> → <%= event.recipient_after || 'None' %></p><% } %>
                  <% if ((event.handover_reference_before || '') !== (event.handover_reference_after || '')) { %><p>Handover reference: <%= event.handover_reference_before || 'None' %> → <%= event.handover_reference_after || 'None' %></p><% } %>
                <% } %>
              </li><% } %></ol>
            </details>
          </article>
        <% } %>
      </div>
    <% } else { %><p class="empty-state">No document requests have been recorded.</p><% } %>
  </section>
  <% } %>

  <% if (studentView === 'history') { %>
  <section class="admin-section" aria-labelledby="profile-revision-history-title">
    <div class="admin-section__heading"><div><h2 id="profile-revision-history-title">Student profile revision history</h2><p>Staff-only history records changed profile fields from the first saved edit onward.</p></div></div>
    <% if (profileRevisions.length) { %>
      <div class="table-scroll" tabindex="0" aria-label="Student profile revision history"><table class="admin-table">
        <thead><tr><th scope="col">Changed</th><th scope="col">Field</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Staff</th></tr></thead>
        <tbody><% const profileFieldLabel = (field) => ({ student_no: 'Student number', lrn: 'LRN', first_name: 'First name', middle_name: 'Middle name', last_name: 'Last name', suffix: 'Suffix', birth_date: 'Birth date', sex: 'Gender', address: 'Address', phone: 'Phone' })[field] || field; for (const revision of profileRevisions) { %>
          <tr><td data-label="Changed"><%= revision.created_at instanceof Date ? revision.created_at.toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : revision.created_at %></td>
            <td data-label="Field"><%= profileFieldLabel(revision.field_name) %></td>
            <td data-label="Before"><%= revision.before_value ?? '—' %></td><td data-label="After"><%= revision.after_value ?? '—' %></td>
            <td data-label="Staff"><%= [revision.actor_first_name, revision.actor_last_name].filter(Boolean).join(' ') || 'Staff' %></td></tr>
        <% } %></tbody>
      </table></div>
    <% } else { %><p class="empty-state">No profile field revisions are recorded.</p><% } %>
  </section>
  <% } %>
</main>
<script src="/js/registrar-records-followup.js" defer></script>
<%- include('../partials/foot') %>
