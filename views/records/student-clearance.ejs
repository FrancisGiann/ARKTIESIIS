<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page student-clearance-page" id="main-content">
  <% const clearanceStudentName = [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ');
    const nextTerm = terms.find((term) => !term.future && !term.beforeEntry && term.state !== 'complete'
      && term.state !== 'not_attended' && term.enrollment_id);
  %>
  <a class="context-back" href="/registrar/records/clearance">Back to paper clearance</a>
  <section class="dashboard-heading">
    <div><h1>Paper clearance</h1><p><strong><%= clearanceStudentName %></strong><% if (student.student_no) { %> · Student no. <%= student.student_no %><% } %></p>
      <p>After checking the returned paper form, the registrar records one completion for each applicable term.</p></div>
  </section>
  <% if (notice) { %><p class="form-success" role="status">Paper clearance status saved and recorded in history.</p><% } %>
  <% if (error) { %><p class="form-alert" role="alert" tabindex="-1"><%= error %></p><% } %>

  <% const groups = []; const groupMap = new Map(); for (const term of terms) { let group = groupMap.get(term.school_year); if (!group) { group = { schoolYear: term.school_year, gradeLevel: term.grade_level, terms: [] }; groupMap.set(term.school_year, group); groups.push(group); } group.terms.push(term); } %>
  <% if (!groups.length) { %><section class="admin-section"><p class="empty-state">No term placements are recorded for this student.</p></section><% } %>
  <% for (const group of groups) { %>
    <section class="clearance-year" aria-labelledby="clearance-year-<%= group.schoolYear.replace(/[^A-Za-z0-9]/g, '-') %>">
      <div class="clearance-year-heading"><h2 id="clearance-year-<%= group.schoolYear.replace(/[^A-Za-z0-9]/g, '-') %>"><%= group.schoolYear %> · <%= group.gradeLevel %></h2></div>
      <% for (const term of group.terms) {
        const complete = term.state === 'complete';
        const outsideRequiredTerms = term.state === 'not_applicable' || term.beforeEntry || term.future;
        const excludedTerm = term.state === 'not_attended';
        const open = Number(nextTerm?.enrollment_id) === Number(term.enrollment_id) || term.completionConflict
          || term.scopeConflict || Boolean(term.completionAttempt) || Boolean(term.scopeAttempt);
      %>
        <details id="clearance-term-<%= term.enrollment_id %>" class="clearance-term clearance-term--<%= complete ? 'complete' : outsideRequiredTerms ? 'not_applicable' : 'pending' %>" <%= open ? 'open' : '' %>>
          <summary class="clearance-term-summary">
            <span class="clearance-term-title"><strong><%= term.term_label %></strong><span><%= group.schoolYear %> · Term <%= term.annual_term_number %> · <%= term.grade_level %> · <%= term.section_name || 'Section not recorded' %></span></span>
            <span class="record-status clearance-status clearance-status--<%= complete ? 'complete' : outsideRequiredTerms ? 'not_applicable' : 'pending' %>"><%= complete ? 'Completed' : outsideRequiredTerms ? 'Outside required terms' : 'Not completed' %></span>
            <span class="clearance-term-summary-note"><%= complete ? 'Completion recorded by registrar' : outsideRequiredTerms ? term.beforeEntry ? 'Before the saved entry term' : 'Future term' : excludedTerm ? 'A saved exclusion remains in the history' : 'No completion is recorded' %></span>
          </summary>
          <div class="clearance-term-content">
            <% if (outsideRequiredTerms) { %>
              <p>This term is outside the required clearance scope and cannot be marked complete here.</p>
            <% } else if (currentUser.role === 'registrar' && student.status !== 'archived' && !term.completionConflict && !term.scopeConflict) { %>
              <form class="admin-form clearance-edit-form clearance-completion-form" method="post" action="/registrar/records/students/<%= student.id %>/clearance/terms/<%= term.enrollment_id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="idempotencyKey" value="<%= term.completionToken %>">
                <input type="hidden" name="expectedVersion" value="<%= term.completionAttempt?.values?.expectedVersion ?? term.version ?? 0 %>">
                <label class="checkbox-field clearance-completion-checkbox"><input type="checkbox" name="paperCompleted" value="1" aria-describedby="clearance-inspection-help-<%= term.enrollment_id %>" <%= (term.completionAttempt ? term.completionAttempt.values.paperCompleted : complete) ? 'checked' : '' %>><span>Paper clearance completed</span></label>
                <p class="muted-copy clearance-completion-help" id="clearance-inspection-help-<%= term.enrollment_id %>">Inspect the returned paper form before checking this box. The saved record includes the registrar and date automatically.</p>
                <% if (complete) { %>
                  <details class="clearance-corrections">
                    <summary>Change saved completion</summary>
                    <div class="field"><label for="clearance-correction-reason-<%= term.enrollment_id %>">Correction reason</label><textarea id="clearance-correction-reason-<%= term.enrollment_id %>" name="correctionReason" rows="2" maxlength="1000"><%= term.completionAttempt?.values?.correctionReason || '' %></textarea><p class="muted-copy">Required only when clearing the saved completion.</p></div>
                  </details>
                <% } else if (excludedTerm) { %>
                  <details class="clearance-corrections">
                    <summary>Change saved term exclusion</summary>
                    <div class="field"><label for="clearance-exclusion-reason-<%= term.enrollment_id %>">Correction reason</label><textarea id="clearance-exclusion-reason-<%= term.enrollment_id %>" name="correctionReason" rows="2" maxlength="1000"><%= term.completionAttempt?.values?.correctionReason || '' %></textarea><p class="muted-copy">Required only when changing the saved exclusion.</p></div>
                  </details>
                <% } %>
                <button class="button button--primary button--align-start" type="submit">Save clearance status</button>
              </form>
            <% } else if (term.completionConflict || term.scopeConflict) { %>
              <p class="form-alert" role="alert">This clearance changed after the form was opened. Reload this term before correcting its saved status or applicability.</p>
              <a class="button button--secondary" href="/registrar/records/students/<%= student.id %>/clearance#clearance-term-<%= term.enrollment_id %>">Reload term</a>
            <% } else if (student.status === 'archived') { %>
              <p class="muted-copy">Archived student records are read-only.</p>
            <% } else { %>
              <p class="muted-copy"><%= complete ? 'The registrar recorded this term as completed after inspecting the paper form.' : excludedTerm ? 'The saved term exclusion is retained in the registrar history.' : 'Not completed: no registrar confirmation is recorded.' %></p>
            <% } %>

            <% if (currentUser.role === 'registrar' && student.status !== 'archived' && term.enrollment_id
              && !outsideRequiredTerms && !term.completionConflict && !term.scopeConflict) {
              const attemptedScopeReason = term.scopeAttempt?.values?.scopeReason;
              const savedScopeReason = term.scope_status === 'not_attended' ? term.scope_reason : '';
              const scopeReasonValue = attemptedScopeReason ?? savedScopeReason ?? '';
            %>
              <details class="clearance-scope-exception" <%= term.scopeAttempt ? 'open' : '' %>>
                <summary><%= excludedTerm ? 'Update term not attended decision' : 'Record term not attended' %></summary>
                <p class="muted-copy">Use this only when school records establish that the student did not attend the entire term. This separate applicability correction is reasoned and audited; it does not record paper completion.</p>
                <% if (excludedTerm && savedScopeReason) { %><p class="muted-copy"><strong>Saved reason:</strong> <%= savedScopeReason %></p><% } %>
                <form class="admin-form clearance-scope-exception-form" method="post" action="/registrar/records/students/<%= student.id %>/clearance/terms/<%= term.enrollment_id %>/not-attended">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="idempotencyKey" value="<%= term.scopeToken %>">
                  <input type="hidden" name="expectedVersion" value="<%= term.scopeAttempt?.values?.expectedVersion ?? term.version ?? 0 %>">
                  <div class="field"><label for="clearance-scope-reason-<%= term.enrollment_id %>">Reason the entire term was not attended</label><textarea id="clearance-scope-reason-<%= term.enrollment_id %>" name="scopeReason" rows="2" minlength="5" maxlength="1000" required><%= scopeReasonValue %></textarea></div>
                  <button class="button button--secondary" type="submit"><%= excludedTerm ? 'Update saved decision' : 'Save term exception' %></button>
                </form>
              </details>
            <% } %>

            <% if (term.history?.length) { %>
              <details class="clearance-review-record">
                <summary>Change history</summary>
                <ol class="document-review-history">
                  <% for (const event of term.history) { const historyLabels = { created: 'Clearance record created', paper_confirmation: 'Paper clearance status saved', reopened: 'Legacy clearance reopened', attested: 'Legacy checklist confirmed', items_updated: 'Legacy checklist updated', scope_reviewed: 'Term applicability updated' }; %>
                    <li><strong><%= historyLabels[event.event_type] || 'Clearance history updated' %></strong><span><%= event.created_at instanceof Date ? event.created_at.toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : new Date(event.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %> · <%= [event.actor_first_name, event.actor_last_name].filter(Boolean).join(' ') || 'Registrar' %></span>
                      <% if (event.reason) { %><p><strong>Recorded reason:</strong> <%= event.reason %></p><% } %>
                      <% for (const summary of event.changeSummary || []) { %><p><%= summary %></p><% } %>
                    </li>
                  <% } %>
                </ol>
              </details>
            <% } %>
          </div>
        </details>
      <% } %>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
