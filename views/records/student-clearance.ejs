<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page student-clearance-page" id="main-content">
  <% const clearanceStudentName = [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ');
    const nextTerm = terms.find((term) => !term.future && !term.beforeEntry
      && !['complete', 'not_attended', 'not_applicable'].includes(term.state));
    const nextTermTemplates = nextTerm ? templates.filter((item) => item.grade_level === nextTerm.grade_level
      && (nextTerm.past || item.status === 'approved')) : [];
    const needsTemplateSetup = Boolean(nextTerm && !nextTerm.template_id && nextTermTemplates.length === 0);
    const nextTermLabel = nextTerm ? `${nextTerm.school_year} · ${nextTerm.grade_level} · ${nextTerm.term_label}` : '';
    const nextStepText = !terms.length ? 'No term placements are recorded on this student profile yet.'
      : !nextTerm ? 'No term review is due now. Future and pre-entry terms will be reviewed when they become applicable.'
        : needsTemplateSetup ? `No matching paper form is set up for ${nextTerm.grade_level}. If school records show attendance, a registrar must first add a form version that matches the paper copy.`
          : nextTerm.awaitingConfirmation ? `All required signatures and review decisions are recorded for ${nextTermLabel}. Confirm that the printed form was inspected.`
            : nextTerm.state === 'incomplete' ? `Continue the paper review for ${nextTermLabel}. Record missing signatures and resolve any undecided sign-off lines.`
            : `Check the attendance record and record the matching paper form for ${nextTermLabel}.`;
  %>
  <a class="context-back" href="/registrar/records/students/<%= student.id %>">Back to student record</a>
  <%- include('../partials/student-record-navigation', { student, activeStudentView: 'clearance' }) %>
  <section class="dashboard-heading">
    <div><h2>Paper clearance</h2><p>Record signatures from the school’s printed form. Signatures stay on paper.</p></div>
    <% if (currentUser.role === 'registrar') { %><a class="button button--secondary" href="/registrar/records/clearance/templates">Manage paper forms</a><% } %>
  </section>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert" tabindex="-1"><%= error %></p><% } %>
  <% if (staleAttempt) { %><p class="muted-copy" role="status">Your changes were not saved because this form was out of date. The current saved review below is shown as-is; compare it before re-entering anything. Your submitted draft is available separately and was not merged.</p><% } %>
  <section class="clearance-next-step" aria-labelledby="clearance-next-step-title">
    <div><h2 id="clearance-next-step-title"><%= nextTerm ? 'Next step' : 'Current status' %></h2><p><%= currentUser.role === 'database_admin' && nextTerm ? 'Registrar follow-up: ' : '' %><%= nextStepText %></p></div>
    <% if (nextTerm && needsTemplateSetup) { %><a class="button button--secondary" href="/registrar/records/clearance/templates"><%= currentUser.role === 'registrar' ? 'Set up paper forms' : 'View paper forms' %></a>
    <% } else if (nextTerm) { %><a class="button button--secondary" href="#clearance-term-<%= nextTerm.enrollment_id %>">Review this term</a><% } %>
  </section>
  <p class="muted-copy">Use the printed form version and subject lines that apply to each term. If school records differ from the paper copy, explain the correction before saving it.</p>

  <% const groups = []; const groupMap = new Map(); for (const term of terms) { let group = groupMap.get(term.school_year); if (!group) { group = { schoolYear: term.school_year, gradeLevel: term.grade_level, terms: [] }; groupMap.set(term.school_year, group); groups.push(group); } group.terms.push(term); } %>
  <% if (!groups.length) { %><section class="admin-section"><p class="empty-state">No term placements are recorded for this student.</p></section><% } %>
  <% for (const group of groups) { %>
    <section class="admin-section clearance-year" aria-labelledby="clearance-year-<%= group.schoolYear.replace(/[^A-Za-z0-9]/g, '-') %>">
      <div class="admin-section__heading"><div><h2 id="clearance-year-<%= group.schoolYear.replace(/[^A-Za-z0-9]/g, '-') %>"><%= group.schoolYear %> · <%= group.gradeLevel %></h2><p>Attendance decision and paper-signature history</p></div></div>
      <div class="table-scroll" tabindex="0" aria-label="Paper clearance for <%= group.schoolYear %>">
        <table class="admin-table clearance-term-table">
          <thead><tr><th scope="col">Term</th><th scope="col">Attendance</th><th scope="col">Review and history</th></tr></thead>
          <tbody>
          <% for (const term of group.terms) { const createValues = term.createAttempt?.values || null; const updateValues = term.updateAttempt?.values || null;
            const itemOverrides = updateValues?.itemsById || {}; const matchingTermTemplates = templates.filter((item) => item.grade_level === term.grade_level && (term.past || item.status === 'approved'));
            const requiredRows = (term.clearanceItems || []).filter((item) => item.applicability_status === 'required');
            const signedRows = requiredRows.filter((item) => Number(item.signature_present) === 1 && String(item.signer_name || '').trim());
            const detailsOpen = Number(nextTerm?.enrollment_id) === Number(term.enrollment_id) || Number(staleAttempt?.recordId) === Number(term.enrollment_id) || Number(staleAttempt?.recordId) === Number(term.clearance_id);
          %>
            <tr id="clearance-term-<%= term.enrollment_id %>" class="clearance-term-summary-row">
              <td data-label="Term"><strong><%= term.term_label %></strong><br>Term <%= term.annual_term_number %><br><span class="muted-copy"><%= term.section_name || 'Section not recorded' %></span></td>
              <td data-label="Attendance"><strong><%= ({ complete: 'Complete', incomplete: 'Attended · review in progress', not_attended: 'Not attended', not_applicable: 'Not applicable', unreviewed: 'Attendance not reviewed', not_reviewed: 'Attendance review needed' })[term.state] || 'Attendance review needed' %></strong>
                <% if (term.scope_reason) { %><p><%= term.scope_reason %></p><% } %>
                <% if (term.future) { %><p class="muted-copy">This term is after the configured current academic term.</p><% } else if (term.beforeEntry) { %><p class="muted-copy">This term is before the saved entry term.</p><% } %>
              </td>
              <td data-label="Review and history">
                <% if (term.attested_at) { %><p><strong>Confirmed</strong> after inspection on <%= term.inspected_on instanceof Date ? term.inspected_on.toISOString().slice(0, 10) : String(term.inspected_on || '').slice(0, 10) %></p><p>Review version <%= term.version %></p>
                <% } else if (term.clearance_id && term.scope_status === 'not_attended') { %><p><strong>Attendance decision saved</strong> · review <%= term.version %></p>
                <% } else if (term.clearance_id && !term.template_id) { %><p><strong>Choose a matching paper form to continue.</strong><% if (matchingTermTemplates.length) { %> Select the version printed on the paper copy.<% } else { %> Ask the registrar to set up the form version printed by the school.<% } %></p>
                <% } else if (term.clearance_id) { %><p><strong>Inspection date</strong> <%= term.inspected_on instanceof Date ? term.inspected_on.toISOString().slice(0, 10) : String(term.inspected_on || '').slice(0, 10) || 'Not recorded' %></p>
                  <% if (term.awaitingConfirmation) { %><p>All required signatures and review decisions are complete · waiting for registrar confirmation</p>
                  <% } else { %><p><%= Math.max(0, requiredRows.length - signedRows.length) %> required signatures still missing<% if (Number(term.unresolved_count) > 0) { %> · <%= term.unresolved_count %> laboratory decision<%= Number(term.unresolved_count) === 1 ? '' : 's' %> to review<% } %><% if (Number(term.teacher_context_missing_count) > 0) { %> · <%= term.teacher_context_missing_count %> teacher name explanation<%= Number(term.teacher_context_missing_count) === 1 ? '' : 's' %> needed<% } %></p><% } %>
                  <p>Review version <%= term.version %></p><% } %>
                <% if (term.history?.length) { %><details class="clearance-history"><summary>Audit history (<%= term.history.length %>)</summary><ol class="document-review-history"><% for (const event of term.history) { %><li><strong><%= event.event_type.replaceAll('_', ' ') %></strong><span><%= event.created_at instanceof Date ? event.created_at.toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : new Date(event.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %> · <%= [event.actor_first_name, event.actor_last_name].filter(Boolean).join(' ') || 'Registrar' %></span><% for (const summary of event.changeSummary || []) { %><p><%= summary %></p><% } %><% if (event.reason) { %><p><strong>Recorded reason:</strong> <%= event.reason %></p><% } %></li><% } %></ol></details><% } else if (term.clearance_id) { %><p class="muted-copy">No saved change history.</p><% } %>
              </td>
            </tr>
            <tr class="clearance-requirements-row">
              <td data-label="Paper requirements" colspan="3">
                <% if (term.staleDraft) { const stale = term.staleDraft.values; const templateDraft = templates.find((item) => String(item.id) === stale.templateId); %>
                  <details class="clearance-stale-draft"><summary>Unapplied changes (not saved)</summary>
                    <p>Your submitted values are kept here for reference only. They did not update the saved review and will not be copied into the current form.</p>
                    <dl><div><dt>Attendance decision</dt><dd><%= stale.scopeStatus === 'attended' ? 'Attended' : stale.scopeStatus === 'not_attended' ? 'Did not attend' : 'Not selected' %></dd></div>
                      <% if (stale.scopeReason) { %><div><dt>Attendance reason</dt><dd><%= stale.scopeReason %></dd></div><% } %>
                      <% if (templateDraft) { %><div><dt>Paper form</dt><dd><%= templateDraft.grade_level %> · <%= templateDraft.track_label %> · version <%= templateDraft.version_no %></dd></div><% } %>
                      <% if (stale.templateSelectionReason) { %><div><dt>Older paper form reason</dt><dd><%= stale.templateSelectionReason %></dd></div><% } %>
                      <% if (stale.inspectedOn) { %><div><dt>Inspection date</dt><dd><%= stale.inspectedOn %></dd></div><% } %>
                      <% if (stale.correctionReason) { %><div><dt>Correction reason</dt><dd><%= stale.correctionReason %></dd></div><% } %>
                      <% if (stale.paperTeacherRows.length) { %><div><dt>Paper subject lines</dt><dd><ul><% for (const row of stale.paperTeacherRows) { %><li><%= [row.subjectCode, row.subjectName].filter(Boolean).join(' · ') %></li><% } %></ul></dd></div><% } %>
                      <% const staleItems = Object.entries(stale.itemsById); if (staleItems.length) { %><div><dt>Paper sign-off entries</dt><dd><ul><% for (const [itemId, itemDraft] of staleItems) { const savedItem = (term.clearanceItems || []).find((item) => String(item.id) === itemId); %><li><%= savedItem?.label_snapshot || 'Saved paper sign-off' %><% if (savedItem?.subject_name_snapshot) { %> · <%= savedItem.subject_name_snapshot %><% } %>: <%= itemDraft.applicabilityStatus === 'not_applicable' ? 'Not applicable' : itemDraft.applicabilityStatus === 'unreviewed' ? 'Not decided' : 'Required' %>, <%= itemDraft.signaturePresent ? `signature present — ${itemDraft.signerName}` : 'signature not marked' %><% if (itemDraft.paperSignedOn) { %>, paper date <%= itemDraft.paperSignedOn %><% } %></li><% } %></ul></dd></div><% } %>
                    </dl>
                  </details>
                <% } %>
                <% if (term.clearance_id && !term.future && !term.beforeEntry) { %>
                  <% if (term.scope_status === 'attended') { %><p class="clearance-signature-progress"><strong><%= signedRows.length %> of <%= requiredRows.length %> required signatures recorded</strong><% if (term.attested_at) { %> · registrar confirmed<% } else if (term.awaitingConfirmation) { %> · awaiting registrar confirmation<% } else { %> · review in progress<% } %></p><% } else if (term.scope_status === 'not_attended') { %><p class="clearance-signature-progress">Attendance decision saved. This term has no paper signature review.</p><% } %>
                  <% if (term.track_label_snapshot) { %><p class="muted-copy">Paper form: <%= term.track_label_snapshot %> · version <%= term.template_version || 'saved form' %></p><% } %>
                  <% if (term.clearanceItems.length || (term.scope_status === 'not_attended' && currentUser.role === 'registrar')) { %>
                    <details class="clearance-details" <%= detailsOpen ? 'open' : '' %>>
                      <summary>Record paper signatures</summary>
                      <form class="admin-form clearance-edit-form" method="post" action="/registrar/records/students/<%= student.id %>/clearance/records/<%= term.clearance_id %>">
                        <div class="clearance-form-intro"><h3>Enter the printed signatures</h3><p>For each required line, mark whether a signature appears and copy the signer’s name. Add the paper date when it is shown. Saving progress does not confirm the form.</p></div>
                        <% if (currentUser.role !== 'registrar') { %><p class="muted-copy">Database administrators can review these saved details and history; registrar editing is required for changes.</p><fieldset disabled aria-label="Read-only clearance details"><% } %>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="idempotencyKey" value="<%= term.updateToken %>">
                        <input type="hidden" name="expectedVersion" value="<%= updateValues?.expectedVersion || term.version %>">
                        <% if (term.template_id) { %><input type="hidden" name="templateId" value="<%= term.template_id %>"><% } %>
                        <% if (term.clearanceItems.length) { %><div class="table-scroll" tabindex="0" aria-label="Saved paper sign-off rows for <%= term.term_label %>">
                          <table class="admin-table clearance-items-table"><thead><tr><th scope="col">Sign-off row</th><th scope="col">Paper signature</th><th scope="col">Date</th></tr></thead><tbody>
                            <% for (const item of term.clearanceItems) { const itemDate = item.paper_signed_on instanceof Date ? item.paper_signed_on.toISOString().slice(0, 10) : item.paper_signed_on ? String(item.paper_signed_on).slice(0, 10) : ''; const itemValues = itemOverrides[String(item.id)] || null; const itemApplicability = itemValues ? itemValues.applicabilityStatus : item.applicability_status; const itemHasSignature = itemValues ? itemValues.signaturePresent : Number(item.signature_present) === 1; const itemSigner = itemValues ? itemValues.signerName : item.signer_name || ''; const itemPaperDate = itemValues ? itemValues.paperSignedOn : itemDate; const itemSignerContext = itemValues ? itemValues.signerContextReason : item.signer_context_reason || ''; const itemApplicabilityReason = itemValues ? itemValues.applicabilityReason : item.applicability_reason || ''; %>
                              <tr>
                                <td data-label="Sign-off row"><strong><%= item.label_snapshot %></strong><% if (item.category === 'teacher') { %><br><%= [item.subject_code_snapshot, item.subject_name_snapshot].filter(Boolean).join(' · ') %><br><span class="muted-copy"><%= item.teacher_context_status === 'assigned' ? (item.teacher_name_snapshot || 'Teacher from saved term record') : `Teacher assignment ${item.teacher_context_status}` %></span><% } else { %><br><span class="muted-copy"><%= item.category === 'laboratory' ? 'Laboratory' : item.category.replaceAll('_', ' ') %></span><% } %>
                                  <% if (item.category === 'laboratory') { %><label class="field" for="item-<%= item.id %>-applicability">Does this lab sign-off apply?</label><select id="item-<%= item.id %>-applicability" name="item_<%= item.id %>_applicabilityStatus" required aria-describedby="item-<%= item.id %>-applicability-help"><option value="unreviewed" <%= itemApplicability === 'unreviewed' ? 'selected' : '' %>>Not decided yet</option><option value="required" <%= itemApplicability === 'required' ? 'selected' : '' %>>Required</option><option value="not_applicable" <%= itemApplicability === 'not_applicable' ? 'selected' : '' %>>Not applicable</option></select><span id="item-<%= item.id %>-applicability-help" class="muted-copy">An undecided row can be saved as progress; it must be resolved before confirmation.</span><label class="field" for="item-<%= item.id %>-applicability-reason">Reason if not applicable</label><input id="item-<%= item.id %>-applicability-reason" name="item_<%= item.id %>_applicabilityReason" maxlength="1000" value="<%= itemApplicabilityReason %>">
                                  <% } else { %><input type="hidden" name="item_<%= item.id %>_applicabilityStatus" value="required"><% } %>
                                </td>
                                <td data-label="Paper signature"><label class="checkbox-field"><input type="checkbox" name="item_<%= item.id %>_signaturePresent" value="1" <%= itemHasSignature ? 'checked' : '' %>><span>Signature appears on paper</span></label><label class="field" for="item-<%= item.id %>-signer">Name beside signature</label><input id="item-<%= item.id %>-signer" name="item_<%= item.id %>_signerName" maxlength="160" value="<%= itemSigner %>" autocomplete="off"></td>
                                <td data-label="Date"><label class="field" for="item-<%= item.id %>-date">Date written on paper, if shown</label><input id="item-<%= item.id %>-date" name="item_<%= item.id %>_paperSignedOn" type="date" value="<%= itemPaperDate %>"><% if (item.category === 'teacher' && item.teacher_context_status !== 'assigned') { %><details class="clearance-row-context"><summary>Teacher name is missing or changed</summary><p class="muted-copy">Enter the paper signer’s name and explain why it applies to this term. Do not change the older teacher account.</p><label class="field" for="item-<%= item.id %>-context">Why this signer applies</label><textarea id="item-<%= item.id %>-context" name="item_<%= item.id %>_signerContextReason" rows="2" maxlength="1000"><%= itemSignerContext %></textarea></details><% } %></td>
                              </tr>
                            <% } %>
                          </tbody></table>
                        </div><% } else { %><p class="muted-copy">No paper sign-off rows are saved yet. Choose the matching form and compare its subject lines with school records before recording signatures.</p><% } %>
                        <details class="clearance-corrections" <%= updateValues || term.staleDraft ? 'open' : '' %>>
                          <summary>Change attendance or correct saved details</summary>
                          <p>Use this section only when school records show a different attendance decision, the paper form differs from the saved subject list, or an earlier entry needs correction. A correction to a completed review clears its confirmation; reload, inspect the paper form again, then confirm it separately.</p>
                          <fieldset class="clearance-fieldset"><legend>Attendance shown by school records</legend>
                            <label class="checkbox-field"><input type="radio" name="scopeStatus" value="attended" <%= (updateValues ? updateValues.scopeStatus : term.scope_status) === 'attended' ? 'checked' : '' %> required><span>Attended this term</span></label>
                            <label class="checkbox-field"><input type="radio" name="scopeStatus" value="not_attended" <%= (updateValues ? updateValues.scopeStatus : term.scope_status) === 'not_attended' ? 'checked' : '' %>><span>Did not attend this term</span></label>
                            <div class="field"><label for="clearance-scope-reason-<%= term.clearance_id %>">Reason if records show no attendance</label><textarea id="clearance-scope-reason-<%= term.clearance_id %>" name="scopeReason" rows="2" maxlength="1000"><%= updateValues?.scopeReason ?? term.scope_reason ?? '' %></textarea></div>
                          </fieldset>
                          <% if (!term.template_id && matchingTermTemplates.length) { %><div class="field"><label for="conversion-template-<%= term.clearance_id %>">Paper form matching this record</label><select id="conversion-template-<%= term.clearance_id %>" name="templateId"><option value="">Choose the form matching this paper copy</option><% for (const template of matchingTermTemplates) { %><option value="<%= template.id %>" <%= updateValues?.templateId === String(template.id) ? 'selected' : '' %>><%= template.track_label %> · version <%= template.version_no %><%= template.status === 'superseded' ? ' · older version' : ' · approved' %></option><% } %></select></div>
                            <% if (term.past) { %><div class="field"><label for="conversion-template-reason-<%= term.clearance_id %>">Why this older form matches the historical copy</label><p class="muted-copy">Required when selecting a superseded paper form.</p><textarea id="conversion-template-reason-<%= term.clearance_id %>" name="templateSelectionReason" rows="2" maxlength="1000"><%= updateValues?.templateSelectionReason || '' %></textarea></div><% } %><% } %>
                          <% if (!term.template_id && !matchingTermTemplates.length) { %><p class="muted-copy">No form version is available for <%= term.grade_level %>. You can still save “Did not attend” when school records support that decision. An attended term needs a matching form set up by a registrar.<% if (currentUser.role === 'registrar') { %> <a href="/registrar/records/clearance/templates">Manage paper forms</a>.<% } %></p><% } %>
                          <details class="clearance-reconciliation" <%= updateValues?.paperTeacherRows?.length ? 'open' : '' %>><summary>Compare or add paper subject lines</summary>
                            <p>Teacher sign-off rows follow the saved subject list. Add a line only when the printed form and school records show it is missing; this does not change academic records or grades.</p>
                            <div class="admin-form-grid"><% for (let row = 0; row < 6; row += 1) { const paperRow = updateValues?.paperTeacherRows?.[row] || {}; %><div class="field"><label for="paper-code-<%= term.clearance_id %>-<%= row %>">Paper subject code <%= row + 1 %></label><input id="paper-code-<%= term.clearance_id %>-<%= row %>" name="paperSubjectCode" maxlength="50" value="<%= paperRow.subjectCode || '' %>"></div><div class="field"><label for="paper-name-<%= term.clearance_id %>-<%= row %>">Paper subject name <%= row + 1 %></label><input id="paper-name-<%= term.clearance_id %>-<%= row %>" name="paperSubjectName" maxlength="200" value="<%= paperRow.subjectName || '' %>"></div><% } %></div>
                            <label class="checkbox-field"><input type="checkbox" name="rosterReviewed" value="1" <%= updateValues?.rosterReviewed ? 'checked' : '' %>><span>I compared the subject lines with the printed form and saved school record.</span></label>
                            <div class="field"><label for="roster-reason-<%= term.clearance_id %>">Why the paper subject lines differ</label><textarea id="roster-reason-<%= term.clearance_id %>" name="rosterReconciliationReason" rows="2" maxlength="1000"><%= updateValues?.rosterReconciliationReason || '' %></textarea></div>
                          </details>
                          <div class="field"><label for="clearance-correction-reason-<%= term.clearance_id %>">Reason for this correction</label><p class="muted-copy">Required when changing saved information.</p><textarea id="clearance-correction-reason-<%= term.clearance_id %>" name="correctionReason" rows="2" maxlength="1000"><%= updateValues?.correctionReason || '' %></textarea></div>
                        </details>
                        <div class="field"><label for="inspection-date-<%= term.clearance_id %>">Date the paper form was inspected</label><input id="inspection-date-<%= term.clearance_id %>" name="inspectedOn" type="date" value="<%= updateValues?.inspectedOn ?? (term.inspected_on instanceof Date ? term.inspected_on.toISOString().slice(0, 10) : term.inspected_on ? String(term.inspected_on).slice(0, 10) : '') %>"><p class="muted-copy">Optional while saving progress. Required to confirm that you inspected the paper form.</p></div>
                        <% if (currentUser.role === 'registrar') { %>
                          <% if (term.attested_at) { %><button class="button button--primary" type="submit" name="clearanceAction" value="progress">Save correction and reopen</button>
                          <% } else if (term.scope_status === 'not_attended') { %><button class="button button--primary" type="submit" name="clearanceAction" value="progress">Save attendance decision</button>
                          <% } else { %><div class="clearance-form-actions"><button class="button button--secondary" type="submit" name="clearanceAction" value="progress">Save progress</button><button class="button button--primary" type="submit" name="clearanceAction" value="attest">Confirm inspected paper form</button></div><% } %>
                        <% } %>
                        <% if (currentUser.role !== 'registrar') { %></fieldset><% } %>
                      </form>
                    </details>
                  <% } else { %><p class="muted-copy">This applicability review has no sign-off rows. Choose attended to add the matching paper form and teacher/subject rows.</p><% } %>
                <% } else if (term.state === 'not_applicable') { %>
                  <p class="muted-copy">No checklist review is available for a pre-entry or configured future term.</p>
                <% } else if (currentUser.role === 'registrar') { %>
                  <details class="clearance-details" <%= detailsOpen ? 'open' : '' %>><summary>Start this term’s paper review</summary>
                    <form class="admin-form" method="post" action="/registrar/records/students/<%= student.id %>/clearance/terms/<%= term.enrollment_id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= term.createToken %>">
                      <div class="clearance-form-intro"><h3>Check the attendance record</h3><p>Choose the decision shown by school records. Recording “Did not attend” needs a reason and does not require a paper form version.</p></div>
                      <fieldset class="clearance-fieldset"><legend>Attendance for this term</legend>
                        <label class="checkbox-field"><input type="radio" name="scopeStatus" value="attended" <%= createValues ? createValues.scopeStatus === 'attended' ? 'checked' : '' : 'checked' %> required><span>Attended this term</span></label>
                        <label class="checkbox-field"><input type="radio" name="scopeStatus" value="not_attended" <%= createValues?.scopeStatus === 'not_attended' ? 'checked' : '' %>><span>Did not attend this term</span></label>
                        <div class="field"><label for="create-scope-reason-<%= term.enrollment_id %>">Reason if school records show no attendance</label><textarea id="create-scope-reason-<%= term.enrollment_id %>" name="scopeReason" rows="2" maxlength="1000"><%= createValues?.scopeReason || '' %></textarea></div>
                      </fieldset>
                      <% if (matchingTermTemplates.length) { %><div class="field"><label for="create-template-<%= term.enrollment_id %>">Paper form matching this grade and term</label><p class="muted-copy">Choose the labels and track printed on the copy. Do not infer the track from the section name.</p><select id="create-template-<%= term.enrollment_id %>" name="templateId"><option value="">Choose the form matching this paper copy</option><% for (const template of matchingTermTemplates) { %><option value="<%= template.id %>" <%= createValues?.templateId === String(template.id) ? 'selected' : '' %>><%= template.track_label %> · version <%= template.version_no %><%= template.status === 'superseded' ? ' · older version' : ' · approved' %></option><% } %></select></div>
                        <% if (term.past) { %><div class="field"><label for="create-template-reason-<%= term.enrollment_id %>">Why this older form matches the historical copy</label><p class="muted-copy">Required when using a superseded form version.</p><textarea id="create-template-reason-<%= term.enrollment_id %>" name="templateSelectionReason" rows="2" maxlength="1000"><%= createValues?.templateSelectionReason || '' %></textarea></div><% } %>
                      <% } else { %><p class="clearance-template-needed" role="status">No form version matches <%= term.grade_level %>. A registrar can still record “Did not attend” when school records show no attendance. For an attended term, set up the form labels printed on the school copy.<% if (currentUser.role === 'registrar') { %> <a href="/registrar/records/clearance/templates">Set up a paper form</a>.<% } %></p><% } %>
                      <p>Teacher sign-off rows will follow the saved subject list. Compare the list with the paper form; only add missing subject lines shown on school records. This does not change academic records or grades.</p>
                      <label class="checkbox-field"><input type="checkbox" name="rosterReviewed" value="1" <%= createValues?.rosterReviewed ? 'checked' : '' %>><span>I compared the saved subject list with the school paper form.</span></label>
                      <details class="clearance-reconciliation" <%= createValues?.paperTeacherRows?.length ? 'open' : '' %>><summary>Compare or add paper subject lines</summary><p>Enter only subject lines that school records and the printed form show are missing from the saved list. This is used for historical paper records or an empty subject list; no grades or academic records are changed.</p><div class="admin-form-grid"><% for (let row = 0; row < 8; row += 1) { const paperRow = createValues?.paperTeacherRows?.[row] || {}; %><div class="field"><label for="create-code-<%= term.enrollment_id %>-<%= row %>">Paper subject code <%= row + 1 %></label><input id="create-code-<%= term.enrollment_id %>-<%= row %>" name="paperSubjectCode" maxlength="50" value="<%= paperRow.subjectCode || '' %>"></div><div class="field"><label for="create-name-<%= term.enrollment_id %>-<%= row %>">Paper subject name <%= row + 1 %></label><input id="create-name-<%= term.enrollment_id %>-<%= row %>" name="paperSubjectName" maxlength="200" value="<%= paperRow.subjectName || '' %>"></div><% } %></div><div class="field"><label for="create-roster-reason-<%= term.enrollment_id %>">Why the paper subject lines differ</label><textarea id="create-roster-reason-<%= term.enrollment_id %>" name="rosterReconciliationReason" rows="2" maxlength="1000"><%= createValues?.rosterReconciliationReason || '' %></textarea></div></details>
                      <button class="button button--primary" type="submit"><%= createValues?.scopeStatus === 'not_attended' ? 'Save attendance decision' : 'Save attendance and paper review' %></button>
                    </form>
                  </details>
                <% } else { %><p class="muted-copy">A registrar has not reviewed this term yet.</p><% } %>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
