<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page records-page term-clearance-templates" id="main-content">
  <a class="context-back" href="/registrar/records/clearance">Back to clearance overview</a>
  <%- include('partials/clearance-workspace-tabs', { activeTab: 'setup' }) %>
  <section class="dashboard-heading">
    <div><h1>Checklist setup</h1><p>Match each new checklist to the school’s printed form. Saved student reviews keep the signature lines they started with.</p></div>
  </section>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (recoveryNotice) { %><p class="muted-copy" role="status"><%= recoveryNotice %></p><% } %>
  <% if (templates.length) { %>
    <details class="clearance-template-history">
      <summary>Saved paper form versions (<%= templates.length %>)</summary>
      <p class="muted-copy">Past student reviews keep the form version originally selected for that paper copy.</p>
      <div class="table-scroll" tabindex="0" aria-label="Saved paper form versions"><table class="admin-table"><thead><tr><th scope="col">Grade and track</th><th scope="col">Version</th><th scope="col">Status</th><th scope="col">Signature lines on the form</th><th scope="col">Created</th></tr></thead><tbody>
        <% for (const template of templates) { %><tr><td data-label="Grade and track"><strong><%= template.grade_level %></strong><br><%= template.track_label %></td><td data-label="Version"><%= template.version_no %></td><td data-label="Status"><%= template.status === 'approved' ? 'Current for new reviews' : 'Earlier version · saved reviews unchanged' %></td><td data-label="Signature lines on the form"><ul><% for (const label of String(template.item_labels || '').split('\n')) { if (label) { %><li><%= label %></li><% } } %></ul></td><td data-label="Created"><%= new Date(template.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila' }) %></td></tr><% } %>
      </tbody></table></div>
    </details>
  <% } else { %>
    <section class="admin-section clearance-template-empty" aria-labelledby="template-list-title">
      <h2 id="template-list-title">No paper forms set up yet</h2>
      <p>An attended term needs a checklist version that matches the printed form. A term marked “Term not attended” requires a reason, is excluded from required clearance, and is never counted as complete.</p>
      <% if (currentUser.role === 'registrar') { %><p><a class="table-action" href="#template-create-title">Set up the first paper form</a></p><% } else { %><p>Ask the registrar to set up the matching paper form.</p><% } %>
    </section>
  <% } %>
  <% if (currentUser.role === 'registrar') { %>
    <details class="clearance-template-editor-details" <%= !templates.length || error || recoveryNotice ? 'open' : '' %>>
      <summary><%= !templates.length ? 'Set up the first paper form' : 'Set up a new paper form version' %></summary>
      <section class="admin-section clearance-template-editor" aria-labelledby="template-create-title">
      <div class="admin-section__heading"><div><h2 id="template-create-title">Set up a checklist version</h2><p>Use the grade and track printed on the form. Do not guess the track from a section name. This setup records which lines are printed; it does not record student signatures.</p></div></div>
      <form class="admin-form" method="post" action="/registrar/records/clearance/templates">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="idempotencyKey" value="<%= idempotencyKey %>">
        <div class="admin-form-grid">
          <div class="field"><label for="template-grade">Grade level</label><select id="template-grade" name="gradeLevel" required><option value="">Choose grade</option><% for (const grade of ['Grade 11', 'Grade 12']) { %><option value="<%= grade %>" <%= values.gradeLevel === grade ? 'selected' : '' %>><%= grade %></option><% } %></select></div>
          <div class="field"><label for="template-track">Track on the printed form</label><input id="template-track" name="trackLabel" maxlength="80" value="<%= values.trackLabel || '' %>" required></div>
        </div>
        <fieldset class="clearance-fieldset">
          <legend>Office signature lines</legend>
          <p class="muted-copy">Check each office name printed on the paper form. New checklists use these names; older saved versions keep their saved labels.</p>
          <% const officeConfirmations = Array.isArray(values.officeConfirmations) ? values.officeConfirmations : []; %>
          <div class="clearance-office-confirmations">
            <% for (const [office, label] of [['registrar', 'Registrar'], ['guidance', 'Guidance'], ['finance', 'Finance']]) { %>
              <label class="checkbox-field clearance-office-confirmation"><input type="checkbox" name="officeConfirmations" value="<%= office %>" <%= officeConfirmations.includes(office) ? 'checked' : '' %> required><span><strong><%= label %></strong><small>Signature line is on the paper form</small></span></label>
            <% } %>
          </div>
          <label class="checkbox-field"><input type="checkbox" name="teacherRosterConfirmed" value="1" <%= values.teacherRosterConfirmed ? 'checked' : '' %> required><span>Each subject in the saved term list has its own teacher signature line.</span></label>
          <label class="checkbox-field"><input type="checkbox" name="laboratoryRowsConfirmed" value="1" <%= values.laboratoryRowsConfirmed ? 'checked' : '' %> required><span>I checked for laboratory signature lines. An empty list means this form has none.</span></label>
        </fieldset>
        <% const laboratoryLabels = Array.isArray(values.laboratoryLabels) ? values.laboratoryLabels : values.laboratoryLabels ? [values.laboratoryLabels] : []; %>
        <details class="clearance-template-labs" <%= laboratoryLabels.some((label) => label) ? 'open' : '' %>>
          <summary>Add laboratory signature lines (optional)</summary>
          <p class="muted-copy">Enter each laboratory line as printed. Leave all blank if there are none.</p>
          <div class="admin-form-grid"><% for (let index = 0; index < 8; index += 1) { %><div class="field"><label for="template-lab-<%= index %>">Laboratory line <%= index + 1 %></label><input id="template-lab-<%= index %>" name="laboratoryLabel" maxlength="120" value="<%= laboratoryLabels[index] || '' %>"></div><% } %></div>
        </details>
        <p class="muted-copy">Saving makes this the current checklist version for new reviews. Earlier student reviews stay as recorded.</p>
        <button class="button button--primary" type="submit">Save checklist version</button>
      </form>
      </section>
    </details>
  <% } else { %><p class="muted-copy">Database administrators can review saved templates. Only registrars can create an approved version.</p><% } %>
</main>
<%- include('../partials/foot') %>
