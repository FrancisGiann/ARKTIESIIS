<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page annual-fee-review" id="main-content">
  <a class="context-back" href="/registrar/intake">Back to annual intake</a>
  <header class="dashboard-heading fee-review-heading">
    <div>
      <h1>Review fees</h1>
      <% if (preview?.parent) { %>
        <p><strong><%= [preview.parent.first_name, preview.parent.middle_name, preview.parent.last_name, preview.parent.suffix].filter(Boolean).join(' ') %></strong>
          · <%= preview.parent.student_no %> · <%= preview.parent.school_year %> · <%= preview.parent.grade_level %> · Voucher <%= preview.parent.voucher_code %></p>
      <% } else { %><p>Check the configured student-payable assessment before confirming.</p><% } %>
    </div>
    <% if (preview) { %><p class="fee-total-line"><span>Student payable</span><strong>₱<%= formatMoney(preview.total) %></strong></p><% } %>
  </header>
  <nav class="intake-progress" aria-label="Enrollment steps">
    <ol><li><span class="intake-step-label--full">Student</span><span class="intake-step-label--short">Student</span></li><li><span class="intake-step-label--full">Enrollment</span><span class="intake-step-label--short">Enroll</span></li><li><span class="intake-step-label--full">Documents received</span><span class="intake-step-label--short">Papers</span></li><li aria-current="step"><span class="intake-step-label--full">Fees</span><span class="intake-step-label--short">Fees</span></li><li><span class="intake-step-label--full">Review details</span><span class="intake-step-label--short">Review</span></li></ol>
  </nav>
  <% if (successNotice) { %><p class="form-success" role="status"><%= successNotice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (!preview) { %>
    <section class="admin-section"><p>The fee summary is unavailable. Return to the intake roster and review it again.</p><a class="button button--secondary" href="/registrar/intake">Return to annual intake</a></section>
  <% } else { %>
    <form method="get" action="/registrar/intake/<%= annualId %>/fees" class="fee-optional-choice" aria-label="Review fees and optional charges"
      data-fee-review data-track-optional="<%= !preview.existingAssessment && preview.optionalLines?.length ? 'true' : 'false' %>"
      data-selected-lines="<%= preview.optionalLineIds.join(',') %>">
      <input type="hidden" name="idempotencyKey" value="<%= values.idempotencyKey %>">
      <% if (preview.existingAssessment) { for (const lineId of preview.optionalLineIds) { %><input type="hidden" name="optionalLineIds" value="<%= lineId %>"><% } } %>
    <% const tuitionLines = preview.lines.filter((line) => String(line.category || '').toLowerCase() === 'tuition'); %>
    <section class="admin-section fee-assessment" aria-labelledby="fee-context-title">
      <div class="admin-section__heading"><div><h2 id="fee-context-title">Approved annual fees</h2>
        <p>Schedule version <%= preview.scheduleVersion %> · <%= preview.existingAssessment ? 'Saved assessment' : 'Active approved schedule' %></p></div></div>
      <% if (preview.existingAssessment) { %>
        <p>This saved assessment and its fee choices preserve the original fee details.</p>
      <% } else { %>
        <p>Fees are calculated from the selected voucher and active approved schedule. Optional items are included only when selected.</p>
      <% } %>
      <% if (!preview.existingAssessment && preview.optionalLines?.length) { %>
        <p class="fee-confirmation__refresh" data-fee-refresh-message hidden role="status">Update the fee total before continuing with these optional charges.</p>
        <fieldset><legend>Optional fees</legend>
          <% for (const line of preview.optionalLines) { %>
            <label class="checkbox-field fee-optional-choice__row">
              <input type="checkbox" name="optionalLineIds" value="<%= line.id %>" <%= line.selected ? 'checked' : '' %>>
              <span><strong>Term <%= line.termNumber %> · <%= line.lineName %></strong><small><%= line.installment %> · ₱<%= formatMoney(line.amount) %></small></span>
            </label>
          <% } %>
        </fieldset>
        <noscript><p class="muted-copy">Review details carries your current optional choices into the final summary.</p></noscript>
      <% } %>
      <div class="fee-term-summary" aria-label="Payable by term">
        <% for (const subtotal of preview.termTotals) { %><p><span>Term <%= subtotal.termNumber %></span><strong>₱<%= formatMoney(subtotal.amount) %></strong></p><% } %>
      </div>
      <%- include('./partials/annual-tuition-breakdown', { preview, headingId: 'approved-tuition-title' }) %>
      <div class="fee-review-actions" aria-label="Review enrollment details">
        <button class="button button--primary" type="submit" formaction="/registrar/intake/<%= annualId %>/review" data-fee-submit>Review details</button>
        <% if (!preview.existingAssessment && preview.optionalLines?.length) { %><button class="button button--secondary" type="submit">Update fee total</button><% } %>
        <a class="button button--secondary" href="/registrar/intake/<%= annualId %>/manage">Back to student record</a>
      </div>
    </section>
    <details class="fee-breakdown">
      <summary>View itemized fee breakdown</summary>
      <div class="table-scroll" tabindex="0" aria-label="Itemized fee assessment lines">
        <table class="admin-table fee-assessment-table">
          <thead><tr><th scope="col">Term</th><th scope="col">Fee</th><th scope="col">Schedule label</th><th scope="col">Amount</th><th scope="col">Approved coverage</th><th scope="col">Payable</th></tr></thead>
          <tbody>
            <% if (preview.lines.length) { %>
              <% for (const line of preview.lines) { %>
                <tr>
                  <td data-label="Term">Term <%= line.termNumber %></td>
                  <td data-label="Fee"><%= line.lineName %><small><%= line.category.replaceAll('_', ' ') %><% if (line.isOptional) { %> · Optional<% } %></small></td>
                  <td data-label="Schedule label"><%= line.installment %></td>
                  <td data-label="Amount">₱<%= formatMoney(line.grossAmount) %></td>
                  <td data-label="Approved coverage"><%= line.waivedAmount === '0.00' ? '—' : `₱${formatMoney(line.waivedAmount)}` %></td>
                  <td data-label="Payable"><strong>₱<%= formatMoney(line.amount) %></strong></td>
                </tr>
              <% } %>
            <% } else { %><tr><td colspan="6">No payable fee lines apply to this entry term and selection.</td></tr><% } %>
          </tbody>
          <tfoot><tr><th scope="row" colspan="5">Total payable</th><td data-label="Total payable"><strong>₱<%= formatMoney(preview.total) %></strong></td></tr></tfoot>
        </table>
      </div>
    </details>
    </form>
  <% } %>
</main>
<script src="/js/annual-fee-confirmation.js" defer></script>
<%- include('../partials/foot') %>
