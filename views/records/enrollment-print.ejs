<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <% if (typeof pageSessionBinding === 'string' && /^[a-f0-9]{64}$/.test(pageSessionBinding)) { %><script src="/js/page-session-restore-gate.js" data-page-session-binding="<%= pageSessionBinding %>"></script><% } %>
</head>
<body class="enrollment-print-page"<% if (typeof pageSessionBinding === 'string' && /^[a-f0-9]{64}$/.test(pageSessionBinding)) { %> data-page-session-binding="<%= pageSessionBinding %>"<% } %>>
  <main class="enrollment-print" id="main-content">
    <header class="enrollment-print__header">
      <p>ARK Technological Institute Education System Inc. · Main Branch</p>
      <h1>Student Enrollment Form</h1>
      <p>Enrollment <%= enrollment.enrollmentId %> · Prepared <%= printedAt.toLocaleString() %></p>
    </header>
    <section aria-labelledby="enrollment-details-title">
      <h2 id="enrollment-details-title">Student and enrollment details</h2>
      <dl class="enrollment-print__details">
        <div><dt>Student number</dt><dd><%= enrollment.studentNo %></dd></div>
        <div><dt>Student name</dt><dd><%= [enrollment.firstName, enrollment.middleName, enrollment.lastName, enrollment.suffix].filter(Boolean).join(' ') %></dd></div>
        <div><dt>Academic term</dt><dd><%= enrollment.schoolYear %> · <%= enrollment.term %></dd></div>
        <div><dt>Section</dt><dd><%= enrollment.sectionName || '—' %></dd></div>
        <div><dt>Email</dt><dd><%= enrollment.email %></dd></div>
      </dl>
    </section>
    <% if (enrollment.temporaryPassword) { %><section class="enrollment-print__credential" aria-labelledby="temporary-password-title">
      <h2 id="temporary-password-title">One-time temporary password</h2>
      <p class="enrollment-print__password"><%= enrollment.temporaryPassword %></p>
      <p>Give this password to the student privately. The student must complete email verification and change it at sign-in. If this form is lost, use the existing password reset flow; the temporary password cannot be recovered.</p>
    </section><% } %>
    <footer class="enrollment-print__actions">
      <button class="button button--primary" type="button" data-print-page>Print enrollment form</button>
      <a class="button button--secondary" href="/registrar/intake">Return to enrollments</a>
    </footer>
  </main>
<% if (typeof pageSessionBinding === 'string' && /^[a-f0-9]{64}$/.test(pageSessionBinding)) { %>
<dialog class="page-session-dialog" id="page-session-dialog" aria-labelledby="page-session-title" aria-describedby="page-session-message">
  <h2 id="page-session-title">Checking your session</h2>
  <p id="page-session-message">Please wait while we check your sign-in.</p>
  <button class="button button--primary" id="page-session-action" type="button">Retry</button>
</dialog>
<script src="/js/page-session-guard.js" defer></script>
<% } %>
<script src="/js/app.js" defer></script>
</body>
</html>
