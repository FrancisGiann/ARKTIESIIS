<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <a class="context-back" href="/teacher">Back to my classes</a>
  <section class="dashboard-heading"><div><h1>Submit class grades</h1><p><%= assignment.school_year %> · <%= assignment.term %> · <%= formatStudentPlacement(assignment.grade_level, assignment.section_name) %> · <%= assignment.subject_code %> — <%= assignment.subject_name %></p></div></section>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (assignment.latest_submission_status) { %>
    <p class="record-status <%= assignment.latest_submission_status === 'approved' ? 'record-status--valid' : assignment.latest_submission_status === 'pending' ? 'record-status--pending' : 'record-status--archived' %>">Current workbook: <%= assignment.latest_submission_status.replaceAll('_', ' ') %><% if (assignment.latest_revision_number) { %> · revision <%= assignment.latest_revision_number %><% } %></p>
    <% if (assignment.latest_submission_id) { %><p><a href="/teacher/grades/submissions/<%= assignment.latest_submission_id %>">View my latest submission</a></p><% } %>
    <% if (assignment.latest_submission_status === 'correction_requested' && assignment.latest_decision_reason) { %><div class="form-alert"><strong>Registrar correction instructions</strong><p><%= assignment.latest_decision_reason %></p></div><% } %>
  <% } %>
  <% if (!preview) { %>
    <% if (!assignment.latest_submission_status || assignment.latest_submission_status === 'correction_requested') { %>
      <section class="admin-section" aria-labelledby="upload-workbook-title"><div class="admin-section__heading"><div><h2 id="upload-workbook-title">Upload corrected workbook</h2><p>Only one workbook is accepted for this assignment. A new revision can be submitted after the registrar requests a correction.</p></div></div>
        <% if (assignment.roster.length) { %><div class="table-scroll" tabindex="0" aria-label="Assigned class roster"><table class="admin-table"><caption class="visually-hidden">Students enrolled in this assigned subject</caption><thead><tr><th scope="col">Student number</th><th scope="col">Student name</th></tr></thead><tbody><% for (const student of assignment.roster) { %><tr><td><%= student.student_no %></td><td><%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></td></tr><% } %></tbody></table></div><% } else { %><p class="empty-state">There are no active students enrolled in this subject context.</p><% } %>
        <% if (contextKey) { %><form class="form-stack records-compact-form" method="post" enctype="multipart/form-data" action="/teacher/grades/<%= assignment.assignment_id %>/preview" data-submitting-message="Checking your workbook. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="contextKey" value="<%= contextKey %>">
          <div class="field"><label for="teacher-workbook">Corrected SSHS E-Class Record (.xlsx)</label><input id="teacher-workbook" name="workbook" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required><small class="field-help">Maximum 5 MB. The original workbook is retained privately for you and the registrar.</small></div>
          <button class="button button--primary button--align-start" type="submit">Preview workbook</button>
        </form><% } else { %><p class="form-alert">This assignment is not supported by the configured 2026–2027 workbook importer.</p><% } %>
      </section>
    <% } else { %><p class="empty-state">This assignment already has a workbook under review or has completed review.</p><% } %>
  <% } else { %>
    <section class="admin-section grade-import-preview" aria-labelledby="preview-context-title">
      <div class="admin-section__heading"><div><h2 id="preview-context-title">Workbook preview</h2><p>Parsed from the corrected workbook. No grades are written until the registrar approves it.</p></div></div>
      <% if (preview.contextMismatch) { %><p class="form-alert" role="alert">Workbook context does not match the assigned class. The registrar will see this conflict and can request a correction.</p><% } %>
      <p><%= preview.counts.eligible %> matched roster rows, <%= preview.counts.unresolved %> rows with issues, and <%= preview.counts.conflicts %> grade conflicts.</p>
      <div class="table-scroll grade-import-preview__table-scroll" tabindex="0" aria-label="Teacher workbook preview"><table class="admin-table grade-import-preview__table">
        <caption class="visually-hidden">Learner matches and grades parsed from the submitted workbook</caption><thead><tr><th scope="col">Workbook row</th><th scope="col">Student match</th><th scope="col">Workbook name</th><th scope="col">Term 1</th><th scope="col">Term 2</th><th scope="col">Term 3</th><th scope="col">Final</th><th scope="col">Validation</th></tr></thead><tbody>
          <% for (const row of preview.rows) { %><tr><td><%= row.sourceRow %></td><td><%= row.studentId ? `${row.studentNo} · ${row.studentName}` : 'No assigned-roster match' %></td><td><%= row.workbookName || '—' %></td>
            <% for (const grade of row.grades) { %><td><%= grade.gradeValue ?? '—' %><% if (grade.existingGradeId) { %><small class="field-help">Existing: <%= grade.existingGradeValue ?? 'blank' %></small><% } %></td><% } %>
            <td><% if (row.issue) { %><span class="record-status record-status--archived">Needs review</span><p><%= row.issue %></p><% } else if (row.nameMismatch) { %><span class="record-status record-status--pending">Name differs from student record</span><% } else { %><span class="record-status record-status--valid">Matched</span><% } %></td>
          </tr><% } %>
        </tbody></table></div>
      <form class="form-stack" method="post" action="/teacher/grades/<%= assignment.assignment_id %>/submit" data-submitting-message="Submitting workbook to the registrar. Please wait.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="previewId" value="<%= preview.id %>">
        <% if (assignment.latest_submission_status === 'correction_requested') { %><input type="hidden" name="previousSubmissionId" value="<%= assignment.latest_submission_id %>"><% } %>
        <div class="admin-form-actions"><button class="button button--primary" type="submit">Submit workbook for registrar review</button><a class="button button--secondary" href="/teacher/grades/<%= assignment.assignment_id %>">Choose another workbook</a></div>
      </form>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
