<%- include('../partials/head', { title }) %>
<% const accountCategory = user.role === 'student' ? 'students' : 'staff'; %>
<main class="page-shell dashboard-page admin-page admin-account-form-page" id="main-content">
  <a class="context-back" href="/admin/users?category=<%= accountCategory %>" aria-label="Back to user accounts" title="Back to user accounts">&#8592;</a>
  <section class="dashboard-heading">
    <div>
      <h1>Manage user account</h1>
      <p>Account #<%= user.id %><% if (user.created_at) { %> · Created <%= new Date(user.created_at).toLocaleDateString() %><% } %></p>
    </div>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (currentUserId === user.id) { %><p class="form-success" role="status">Changing your email address or password signs out this session. Sign in again with the updated credentials.</p><% } %>

  <% if (user.invitation_required) { %>
    <section class="admin-form-section admin-account-form-section" aria-labelledby="invitation-status-title">
      <h2 id="invitation-status-title">Password setup invitation</h2>
      <% if (!user.is_active) { %>
        <p class="form-alert" role="status">This account is inactive. Its recipient cannot finish setup until the account is reactivated.</p>
      <% } else { %>
        <% const invitationState = user.invitation_status || 'unknown'; %>
        <p>This account is waiting for its recipient to choose a password. The latest invitation is <strong><%= invitationState === 'expired' ? 'expired' : invitationState === 'revoked' ? 'revoked' : invitationState === 'failed' ? 'undelivered' : invitationState === 'sent' ? 'sent' : 'not confirmed' %></strong>.</p>
        <% if (invitationState === 'pending' || invitationState === 'unknown') { %><p class="field-help">The message may still be sending, or delivery may not have been confirmed. Refresh this page to check the saved status before sending another invitation.</p><% } %>
        <% if (user.invitation_status === 'revoked' && user.latest_invitation_revoked_at) { %><p class="field-help">The latest link was revoked <time datetime="<%= new Date(user.latest_invitation_revoked_at).toISOString() %>"><%= new Intl.DateTimeFormat('en-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(user.latest_invitation_revoked_at)) %> (Asia/Manila)</time>.</p>
        <% } else if (user.invitation_expires_at) { const invitationExpired = user.invitation_status === 'expired'; %><p class="field-help">The latest link <%= invitationExpired ? 'expired' : 'expires' %> <time datetime="<%= new Date(user.invitation_expires_at).toISOString() %>"><%= new Intl.DateTimeFormat('en-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(user.invitation_expires_at)) %> (Asia/Manila)</time>.</p><% } %>
        <div class="admin-form-actions">
          <form method="post" action="/admin/users/<%= user.id %>/invitation/resend" data-submitting-message="Sending a new setup invitation. Please wait.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button button--secondary" type="submit">Send setup invitation again</button>
          </form>
          <form method="post" action="/admin/users/<%= user.id %>/invitation/revoke" data-confirm="Revoke this setup link? The account will remain unable to sign in until you send a new invitation." data-submitting-message="Revoking the setup invitation. Please wait.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button button--danger" type="submit">Revoke setup invitation</button>
          </form>
        </div>
      <% } %>
    </section>
  <% } else if (user.latest_invitation_consumed_at) { %>
    <p class="form-success" role="status">Account setup was completed. The recipient chose a password using the one-time invitation.</p>
  <% } %>

  <section class="admin-form-section admin-account-form-section" aria-labelledby="account-settings-title">
    <h2 id="account-settings-title">Account settings</h2>
    <form class="form-stack admin-form admin-user-form" method="post" action="/admin/users/<%= user.id %>" data-account-role-form data-submitting-message="Saving the account. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-form-grid">
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" maxlength="255" autocomplete="email" required value="<%= user.email || '' %>">
        </div>
        <div class="field">
          <label for="role">Role</label>
          <select id="role" name="role" required>
            <% for (const role of ['database_admin', 'registrar', 'front_desk', 'teacher', 'finance', 'student']) { %>
              <option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>><%= role.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) %></option>
            <% } %>
          </select>
        </div>
      </div>
      <fieldset class="admin-fieldset admin-user-profile">
        <legend>Profile information</legend>
        <p class="field-help admin-user-profile__help" data-staff-profile <%= user.role === 'student' ? 'hidden' : '' %>>Enter the staff member's name and optional department. Changing roles keeps any student record and its academic history.</p>
        <p class="field-help admin-user-profile__help" data-student-profile <%= user.role === 'student' ? '' : 'hidden' %>>Link this login to an existing student record. Student numbers are assigned when student records are created.</p>
        <div class="admin-form-grid">
          <div class="field" data-staff-profile <%= user.role === 'student' ? 'hidden' : '' %>>
            <label for="first-name">First name (staff)</label>
            <input id="first-name" name="firstName" type="text" maxlength="100" autocomplete="given-name" <%= user.role === 'student' ? 'disabled' : '' %> value="<%= user.first_name || '' %>">
          </div>
          <div class="field" data-staff-profile <%= user.role === 'student' ? 'hidden' : '' %>>
            <label for="last-name">Last name (staff)</label>
            <input id="last-name" name="lastName" type="text" maxlength="100" autocomplete="family-name" <%= user.role === 'student' ? 'disabled' : '' %> value="<%= user.last_name || '' %>">
          </div>
          <div class="field" data-staff-profile <%= user.role === 'student' ? 'hidden' : '' %>>
            <label for="department">Department (staff, optional)</label>
            <input id="department" name="department" type="text" maxlength="100" <%= user.role === 'student' ? 'disabled' : '' %> value="<%= user.department || '' %>">
          </div>
          <div class="field" data-student-profile <%= user.role === 'student' ? '' : 'hidden' %>>
            <label for="student-number">Existing student number</label>
            <input id="student-number" name="studentNo" type="text" maxlength="50" <%= user.role === 'student' ? '' : 'disabled' %> value="<%= user.student_no || '' %>">
            <% if (user.student_no) { %>
              <span class="field-help">Linked student: <%= [user.student_first_name, user.student_middle_name, user.student_last_name, user.student_suffix].filter(Boolean).join(' ') %></span>
            <% } %>
          </div>
        </div>
      </fieldset>
      <label class="checkbox-field admin-user-active" for="is-active">
        <input id="is-active" name="isActive" type="checkbox" value="1" <%= user.is_active ? 'checked' : '' %>>
        <span class="admin-user-active__copy"><strong>Active account</strong><span class="field-help">Inactive accounts cannot sign in. At least one active database administrator must remain.</span></span>
      </label>
      <div class="admin-form-actions">
        <button class="button button--primary" type="submit">Save account</button>
        <a class="button button--secondary" href="/admin/users?category=<%= accountCategory %>">Cancel</a>
      </div>
    </form>
  </section>

  <% if (!user.invitation_required) { %><section class="admin-form-section admin-account-form-section admin-user-password-section" aria-labelledby="password-reset-title">
    <h2 id="password-reset-title">Reset password</h2>
    <p class="admin-user-password-intro">Set a new password for this account. Pending email sign-in codes will be invalidated.</p>
    <form class="form-stack admin-form admin-user-form" method="post" action="/admin/users/<%= user.id %>/password" data-password-match-form data-submitting-message="Resetting the password. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-form-grid">
        <div class="field">
          <label for="new-password">New password</label>
          <input id="new-password" name="password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required aria-describedby="new-password-help" data-password-source data-password-toggle>
          <span id="new-password-help" class="field-help">Use 12 or more ordinary letters, numbers, or symbols. Emoji and some other characters reach the maximum length sooner.</span>
        </div>
        <div class="field">
          <label for="confirm-password">Confirm new password</label>
          <input id="confirm-password" name="confirmPassword" type="password" minlength="12" maxlength="72" autocomplete="new-password" required aria-describedby="new-password-mismatch" data-password-confirm data-password-toggle>
          <span id="new-password-mismatch" class="password-match-error" data-password-mismatch-message aria-live="polite" aria-atomic="true"></span>
        </div>
      </div>
      <button class="button button--secondary button--align-start" type="submit">Reset password</button>
    </form>
  </section><% } else { %><p class="field-help">An administrator password reset is available after the recipient finishes account setup.</p><% } %>
</main>
<script src="/js/admin-user-role-fields.js" defer></script>
<%- include('../partials/foot') %>
