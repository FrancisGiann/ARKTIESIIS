<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page admin-page records-page" id="main-content">
  <a class="context-back" href="/admin">Back to database administration</a>
  <section class="dashboard-heading">
    <div>
      <h1>Student login setup</h1>
      <p>Link student login accounts to existing student records.</p>
    </div>
  </section>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="admin-form-section bulk-account-upload" aria-labelledby="bulk-upload-title">
    <div class="admin-section__heading"><div><h2 id="bulk-upload-title">Upload a student list</h2>
      <p>The first worksheet must start with <strong>Student Number</strong> and <strong>Email</strong> columns. Upload up to 100 students in an .xlsx file no larger than 2 MB. Student records and enrollments are not changed by this setup.</p>
      <p><a class="table-action" href="/admin/student-accounts/template.csv">Download the student list template</a>. Open it in Excel, replace the sample row, then save it as an .xlsx workbook before uploading. Enter one existing student number and contact email per row.</p></div></div>
    <form class="form-stack admin-form" method="post" action="/admin/student-accounts/preview" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="student-account-workbook">Excel workbook (.xlsx)</label><input id="student-account-workbook" name="workbook" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></div>
      <button class="button button--primary button--align-start" type="submit">Preview student list</button>
    </form>
  </section>

  <% if (rows.length) { %>
    <section class="admin-section" aria-labelledby="student-list-preview-title">
      <div class="admin-section__heading"><div><h2 id="student-list-preview-title">Student list preview</h2><p>Every row must match one existing, unlinked student record and use an available email.</p></div></div>
      <% const errorRows = rows.filter((row) => row.errors.length); %>
      <% if (errorRows.length) { %><p class="form-alert" role="status"><%= errorRows.length %> of <%= rows.length %> rows need correction. No accounts will be created.</p><% } else { %><p class="form-success" role="status">All <%= rows.length %> rows are ready. Confirm to create the accounts and download their temporary credentials once.</p><% } %>
      <div class="table-scroll" tabindex="0" aria-label="Student login list preview">
        <table class="admin-table">
          <thead><tr><th scope="col">Workbook row</th><th scope="col">Student number</th><th scope="col">Email</th><th scope="col">Result</th></tr></thead>
          <tbody><% for (const row of rows) { %><tr>
            <td data-label="Workbook row"><%= row.rowNumber %></td>
            <td data-label="Student number"><%= row.studentNo || '—' %></td>
            <td data-label="Email"><%= row.email || '—' %></td>
            <td data-label="Result"><% if (row.errors.length) { %><ul><% for (const rowError of row.errors) { %><li><%= rowError %></li><% } %></ul><% } else { %>Ready<% } %></td>
          </tr><% } %></tbody>
        </table>
      </div>
      <% if (canConfirm) { %>
        <form class="form-stack records-compact-form" method="post" action="/admin/student-accounts/confirm" data-submitting-message="Creating the student accounts and preparing the one-time credential download. Please wait.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="previewId" value="<%= previewId %>">
          <p>The temporary passwords appear only in the download response. Save it securely; a lost password can be recovered through the account password reset flow.</p>
          <button class="button button--primary button--align-start" type="submit">Confirm and download credentials</button>
        </form>
      <% } %>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
