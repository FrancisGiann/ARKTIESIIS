<%- include('../partials/head', { title }) %>
<% const accountCategory = values.role === 'student' ? 'students' : 'staff'; %>
<main class="page-shell dashboard-page admin-page admin-account-form-page" id="main-content">
  <a class="context-back" href="/admin/users?category=<%= accountCategory %>">Back to user accounts</a>
  <section class="dashboard-heading">
    <div>
      <h1>Create user account</h1>
      <p>Assign an approved role and set an initial password.</p>
    </div>
  </section>

  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="admin-form-section admin-account-form-section" aria-labelledby="account-details-title">
    <h2 id="account-details-title">Account details</h2>
    <form class="form-stack admin-form admin-user-form" method="post" action="/admin/users" data-password-match-form data-submitting-message="Creating the account. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-form-grid">
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" maxlength="255" autocomplete="email" required value="<%= values.email || '' %>">
        </div>
        <div class="field">
          <label for="role">Role</label>
          <select id="role" name="role" required>
            <% for (const role of ['registrar', 'front_desk', 'teacher', 'finance', 'database_admin', 'student']) { %>
              <option value="<%= role %>" <%= values.role === role ? 'selected' : '' %>><%= role.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) %></option>
            <% } %>
          </select>
          <span class="field-help">The role controls which protected system areas the account can access.</span>
        </div>
      </div>
      <fieldset class="admin-fieldset admin-user-profile">
        <legend>Profile information</legend>
        <p class="field-help admin-user-profile__help">Staff roles use these name and department fields. A student login must link to an existing student record by student number.</p>
        <div class="admin-form-grid">
          <div class="field">
            <label for="first-name">First name (staff)</label>
            <input id="first-name" name="firstName" type="text" maxlength="100" autocomplete="given-name" value="<%= values.first_name || '' %>">
          </div>
          <div class="field">
            <label for="last-name">Last name (staff)</label>
            <input id="last-name" name="lastName" type="text" maxlength="100" autocomplete="family-name" value="<%= values.last_name || '' %>">
          </div>
          <div class="field">
            <label for="department">Department (staff, optional)</label>
            <input id="department" name="department" type="text" maxlength="100" value="<%= values.department || '' %>">
          </div>
          <div class="field">
          <label for="student-number">Student number (student logins only)</label>
            <input id="student-number" name="studentNo" type="text" maxlength="50" value="<%= values.student_no || '' %>">
          </div>
        </div>
      </fieldset>
      <div class="admin-form-grid">
        <div class="field">
          <label for="password">Initial password</label>
          <input id="password" name="password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required aria-describedby="password-help" data-password-source>
          <span id="password-help" class="field-help">Use 12 or more ordinary letters, numbers, or symbols. Emoji and some other characters reach the maximum length sooner. Passwords are stored securely.</span>
        </div>
        <div class="field">
          <label for="confirm-password">Confirm password</label>
          <input id="confirm-password" name="confirmPassword" type="password" minlength="12" maxlength="72" autocomplete="new-password" required aria-describedby="confirm-password-mismatch" data-password-confirm>
          <span id="confirm-password-mismatch" class="password-match-error" data-password-mismatch-message aria-live="polite" aria-atomic="true"></span>
        </div>
      </div>
      <div class="admin-form-actions">
        <button class="button button--primary" type="submit">Create account</button>
        <a class="button button--secondary" href="/admin/users?category=<%= accountCategory %>">Cancel</a>
      </div>
    </form>
  </section>
</main>
<%- include('../partials/foot') %>
