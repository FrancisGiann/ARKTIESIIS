<%- include('../partials/head', { title }) %>
<main class="page-shell records-page registrar-schedules-page" id="main-content">
  <a class="context-back" href="/registrar/records/teacher-assignments">Back to teacher assignments</a>
  <header class="page-heading">
    <div><h1>Class schedules</h1><p>Choose a term, section, or assigned class to set and review its weekly meeting times.</p></div>
  </header>
  <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
  <% if (contextNotice) { %><p class="form-error" role="status"><%= contextNotice %></p><% } %>

  <section class="class-context-panel schedule-context-panel" aria-labelledby="schedule-context-title">
    <div class="section-heading"><div><h2 id="schedule-context-title">Class context</h2><p>Changing the term clears section and class filters. Changing the section clears the class filter.</p></div></div>
    <form class="class-context-filter" method="get" action="/registrar/schedules" data-clear-section-on-term-change data-clear-assignment-on-section-change>
      <div class="field"><label for="schedule-term-filter">Academic term</label>
        <select id="schedule-term-filter" name="termId" required>
          <% for (const term of terms) { %><option value="<%= term.id %>" <%= Number(academicTermId) === Number(term.id) ? 'selected' : '' %>><%= term.school_year %> · <%= term.term %><%= term.is_current ? ' · Current' : '' %></option><% } %>
        </select>
      </div>
      <div class="field"><label for="schedule-section-filter">Section</label>
        <select id="schedule-section-filter" name="sectionId" <%= !sections.length ? 'disabled' : '' %>>
          <option value="">All sections in this term</option>
          <% for (const section of sections) { %><option value="<%= section.id %>" <%= Number(selectedSectionId) === Number(section.id) ? 'selected' : '' %>><%= formatStudentPlacement(section.grade_level, section.name) %></option><% } %>
        </select>
      </div>
      <div class="field"><label for="schedule-assignment-filter">Assigned class</label>
        <select id="schedule-assignment-filter" name="assignmentId" <%= !assignments.length ? 'disabled' : '' %>>
          <option value="">All active classes in this context</option>
          <% for (const assignment of assignments) { %><option value="<%= assignment.id %>" <%= Number(selectedAssignmentId) === Number(assignment.id) ? 'selected' : '' %>><%= formatStudentPlacement(assignment.grade_level, assignment.section_name) %> · <%= assignment.subject_code %> · <%= assignment.teacher_name %></option><% } %>
        </select>
      </div>
      <button class="button button--secondary" type="submit">Show class times</button>
      <% if (selectedSectionId || selectedAssignmentId) { %><a class="table-action" href="/registrar/schedules?termId=<%= academicTermId || '' %>">Clear section and class filters</a><% } %>
    </form>
  </section>

  <section class="schedule-controls" aria-label="Selected class schedule">
    <form class="schedule-create-form" method="post" action="/registrar/schedules" aria-labelledby="schedule-create-title" id="schedule-create-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="termId" value="<%= academicTermId || '' %>">
      <input type="hidden" name="filterSectionId" value="<%= selectedSectionId || '' %>">
      <input type="hidden" name="filterAssignmentId" value="<%= selectedAssignmentId || '' %>">
      <div><h2 id="schedule-create-title">Add a class time</h2><p>Choose a day, start and end time, and room. Conflicts are checked when saved.</p></div>
      <% if (!assignments.length) { %><p class="empty-state">No active teacher assignments match this context. Create an assignment before setting class times.</p><% } %>
      <label for="schedule-assignment">Assigned class</label>
      <select id="schedule-assignment" name="assignmentId" required <%= !assignments.length ? 'disabled' : '' %>>
        <option value="">Choose an active class</option>
        <% const scheduleFormAssignments = selectedAssignmentId ? assignments.filter((assignment) => Number(assignment.id) === Number(selectedAssignmentId)) : assignments; %>
        <% for (const assignment of scheduleFormAssignments) { %>
          <option value="<%= assignment.id %>" <%= String(values.assignmentId || selectedAssignmentId || '') === String(assignment.id) ? 'selected' : '' %>><%= formatStudentPlacement(assignment.grade_level, assignment.section_name) %> · <%= assignment.subject_code %> · <%= assignment.teacher_name %></option>
        <% } %>
      </select>
      <div class="schedule-time-fields">
        <div><label for="schedule-day">Day</label><select id="schedule-day" name="dayOfWeek" required>
          <% for (const [value, label] of [[1,'Monday'],[2,'Tuesday'],[3,'Wednesday'],[4,'Thursday'],[5,'Friday'],[6,'Saturday']]) { %>
            <option value="<%= value %>" <%= String(values.dayOfWeek || '1') === String(value) ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select></div>
        <div><label for="schedule-start">Starts</label><input id="schedule-start" name="startTime" type="time" required value="<%= values.startTime || '' %>"></div>
        <div><label for="schedule-end">Ends</label><input id="schedule-end" name="endTime" type="time" required value="<%= values.endTime || '' %>"></div>
        <div><label for="schedule-room">Room <span class="field-optional">Optional</span></label><input id="schedule-room" name="room" maxlength="80" value="<%= values.room || '' %>" autocomplete="off"></div>
      </div>
      <div class="schedule-form-actions">
        <button class="button button--primary" type="submit" <%= !assignments.length ? 'disabled' : '' %>>Add class time</button>
        <% if (academicTermId) { %><a class="table-action" href="/registrar/schedules?termId=<%= academicTermId %><% if (selectedSectionId) { %>&amp;sectionId=<%= selectedSectionId %><% } %><% if (selectedAssignmentId) { %>&amp;assignmentId=<%= selectedAssignmentId %><% } %>#schedule-create-title">Clear day, time, and room</a><% } %>
      </div>
    </form>
  </section>

  <section class="schedule-list" aria-labelledby="schedule-list-title" id="schedule-list">
    <div class="section-heading"><div><h2 id="schedule-list-title">Weekly schedule</h2><p>Overlaps for a section, teacher, or room are blocked when schedule times are saved.</p></div></div>
    <% if (schedules.length) { %>
      <% const dayNames = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']; %>
      <% const orderedSchedules = [...schedules].sort((left, right) => Number(left.day_of_week) - Number(right.day_of_week)
        || String(left.start_time).localeCompare(String(right.start_time))
        || String(left.subject_code).localeCompare(String(right.subject_code))); %>
      <% const scheduleGroupsBySection = new Map(); %>
      <% for (const schedule of orderedSchedules) {
        const sectionKey = String(schedule.section_id ?? `${schedule.grade_level || ''}:${schedule.section_name || ''}`);
        if (!scheduleGroupsBySection.has(sectionKey)) scheduleGroupsBySection.set(sectionKey, []);
        scheduleGroupsBySection.get(sectionKey).push(schedule);
      } %>
      <% const scheduleGroups = [...scheduleGroupsBySection.values()].sort((left, right) =>
        String(left[0].grade_level).localeCompare(String(right[0].grade_level), undefined, { numeric: true })
        || String(left[0].section_name).localeCompare(String(right[0].section_name))); %>
      <div class="schedule-section-grid" aria-label="Class times grouped by section">
        <% for (const [groupIndex, sectionSchedules] of scheduleGroups.entries()) { const first = sectionSchedules[0]; %>
          <article class="schedule-section-card" aria-labelledby="schedule-section-title-<%= groupIndex %>">
            <header class="schedule-section-card__heading">
              <div><h3 id="schedule-section-title-<%= groupIndex %>"><%= formatStudentPlacement(first.grade_level, first.section_name) %></h3>
                <p><%= first.school_year %> · <%= first.term %></p></div>
              <span class="schedule-section-card__count"><%= sectionSchedules.length %> <%= sectionSchedules.length === 1 ? 'class time' : 'class times' %></span>
            </header>
            <ol class="schedule-entry-list">
              <% for (const schedule of sectionSchedules) { const dayLabel = dayNames[Number(schedule.day_of_week)] || 'Unknown day'; const isActiveAssignment = schedule.assignment_is_active === true || schedule.assignment_is_active === 1; const isEditing = Number(editScheduleId) === Number(schedule.id); %>
                <li class="schedule-entry" id="schedule-<%= schedule.id %>">
                  <div class="schedule-entry__overview<%= isActiveAssignment ? '' : ' schedule-entry__overview--revoked' %>">
                    <div class="schedule-entry__day-time"><span><%= dayLabel %></span><strong><%= schedule.start_time %>–<%= schedule.end_time %></strong></div>
                    <div class="schedule-entry__class">
                      <h4><span><%= schedule.subject_code %></span> <%= schedule.subject_name %></h4>
                      <p>Teacher: <%= schedule.teacher_name %></p>
                      <p>Room: <%= schedule.room || 'To be announced' %></p>
                    </div>
                    <% if (!isActiveAssignment) { %><span class="schedule-entry__status schedule-entry__status--revoked">Assignment revoked</span><% } %>
                  </div>
                  <% if (isActiveAssignment) { %>
                    <details class="schedule-edit" <%= isEditing ? 'open' : '' %>>
                      <summary>Edit class time</summary>
                      <form method="post" action="/registrar/schedules/<%= schedule.id %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="termId" value="<%= academicTermId || '' %>">
                        <input type="hidden" name="filterSectionId" value="<%= selectedSectionId || '' %>">
                        <input type="hidden" name="filterAssignmentId" value="<%= selectedAssignmentId || '' %>">
                        <label for="assignment-<%= schedule.id %>">Assigned class</label>
                        <select id="assignment-<%= schedule.id %>" name="assignmentId" required>
                          <% for (const assignment of assignments) { %><option value="<%= assignment.id %>" <%= Number(isEditing ? values.assignmentId : schedule.assignment_id) === Number(assignment.id) ? 'selected' : '' %>><%= formatStudentPlacement(assignment.grade_level, assignment.section_name) %> · <%= assignment.subject_code %> · <%= assignment.teacher_name %></option><% } %>
                        </select>
                        <label for="day-<%= schedule.id %>">Day</label><select id="day-<%= schedule.id %>" name="dayOfWeek" required>
                          <% for (const [value, label] of [[1,'Monday'],[2,'Tuesday'],[3,'Wednesday'],[4,'Thursday'],[5,'Friday'],[6,'Saturday']]) { %><option value="<%= value %>" <%= Number(isEditing ? values.dayOfWeek : schedule.day_of_week) === value ? 'selected' : '' %>><%= label %></option><% } %>
                        </select>
                        <label for="start-<%= schedule.id %>">Starts</label><input id="start-<%= schedule.id %>" type="time" name="startTime" required value="<%= isEditing ? values.startTime : schedule.start_time %>">
                        <label for="end-<%= schedule.id %>">Ends</label><input id="end-<%= schedule.id %>" type="time" name="endTime" required value="<%= isEditing ? values.endTime : schedule.end_time %>">
                        <label for="room-<%= schedule.id %>">Room <span class="field-optional">Optional</span></label><input id="room-<%= schedule.id %>" name="room" maxlength="80" value="<%= isEditing ? values.room : schedule.room || '' %>">
                        <div class="schedule-form-actions"><button class="button button--secondary" type="submit">Save class time</button><a class="table-action" href="/registrar/schedules?termId=<%= academicTermId || '' %><% if (selectedSectionId) { %>&amp;sectionId=<%= selectedSectionId %><% } %><% if (selectedAssignmentId) { %>&amp;assignmentId=<%= selectedAssignmentId %><% } %>#schedule-<%= schedule.id %>">Cancel</a></div>
                      </form>
                      <form method="post" action="/registrar/schedules/<%= schedule.id %>/delete" class="schedule-delete-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="termId" value="<%= academicTermId || '' %>">
                        <input type="hidden" name="filterSectionId" value="<%= selectedSectionId || '' %>">
                        <input type="hidden" name="filterAssignmentId" value="<%= selectedAssignmentId || '' %>">
                        <button class="button button--danger" type="submit">Remove class time</button>
                      </form>
                    </details>
                  <% } %>
                </li>
              <% } %>
            </ol>
          </article>
        <% } %>
      </div>
    <% } else { %><p class="empty-state">No class times match this context yet. Select an active class above to add its first time.</p><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
