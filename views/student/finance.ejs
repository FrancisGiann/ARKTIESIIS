<%- include('../partials/head', { title }) %>
<main class="page-shell student-page student-finance-page" id="main-content">
  <a class="context-back" href="/student">Back to my school day</a>
  <header class="page-heading student-finance-heading">
    <div>
      <h1>Fees and payments</h1>
      <p>See the fees on your account, payments applied, and what remains due.</p>
    </div>
    <% if (finance.student) { %><a class="button button--secondary" href="/student/finance/statement">Statement of Account</a><% } %>
  </header>

  <% if (!finance.student) { %>
    <section class="student-unlinked" aria-labelledby="finance-unlinked-title">
      <h2 id="finance-unlinked-title">Your student profile is not linked yet</h2>
      <p>Ask the registrar to connect your account before viewing a personal finance ledger.</p>
    </section>
  <% } else { %>
    <% const summary = annualLedger.summary; %>
    <% const pesoAmount = (amount) => { const text = String(amount ?? '0.00'); const negative = text.startsWith('-'); const value = formatMoney(negative ? text.slice(1) : text); return negative ? `−₱${value}` : `₱${value}`; }; %>
    <% const deductionAmount = (amount) => { const value = String(amount ?? '0.00'); return /^-?0(?:\.0{1,2})?$/.test(value) ? `₱${formatMoney('0.00')}` : `−₱${formatMoney(value.replace(/^-/, ''))}`; }; %>
    <% const currentTermPlacement = annualLedger.terms.find((term) => term.is_current === true || term.is_current === 1 || term.is_current === '1') || null; %>
    <% const showTermBalanceContext = Boolean(summary.annualBalanceSchoolYear || currentTermPlacement || Number(summary.priorTermYearDebt) > 0); %>
    <% const recentFinanceEvents = annualLedger.events.slice(-5).reverse(); %>
    <section class="student-finance-ledger" aria-labelledby="finance-ledger-title">
      <div class="student-finance-ledger__heading">
        <div>
          <h2 id="finance-ledger-title">Account balance and activity</h2>
          <p><%= [finance.student.first_name, finance.student.middle_name, finance.student.last_name, finance.student.suffix].filter(Boolean).join(' ') %> · <%= finance.student.student_no %></p>
        </div>
        <p class="student-finance-ledger__note">This account is read-only. Contact the finance office about a balance or payment record.</p>
      </div>

      <section class="student-finance-summary" aria-label="Balance summary">
        <div class="student-finance-summary__lead">
          <div>
            <h3>Account balance</h3>
            <p>Includes school-year fees due across all years and any earlier account balances. Unused payment credit stays separate until applied to a fee.</p>
          </div>
          <p class="student-finance-summary__amount"><%= pesoAmount(summary.totalBalance) %></p>
        </div>
        <dl class="student-finance-balance-breakdown">
          <div><dt>School-year fees due · all years</dt><dd><%= pesoAmount(summary.annualFeeBalance) %></dd></div>
          <% if (summary.showPreviousAccountBalance) { %><div><dt>Earlier account balance</dt><dd><%= pesoAmount(summary.unattributedLegacyBalance) %></dd></div><% } %>
          <% if (summary.showPreviouslyConfirmedBalance) { %><div><dt>Confirmed previous balance</dt><dd><%= pesoAmount(summary.openingLiabilityDue) %></dd></div><% } %>
          <% if (Number(summary.availableCredit) > 0) { %><div class="student-finance-balance-breakdown__credit"><dt>Unused payment credit</dt><dd><%= pesoAmount(summary.availableCredit) %><span class="student-finance-balance-breakdown__note">Payments already recorded but not yet applied to fees. This amount is not included in the account balance.</span></dd></div><% } %>
        </dl>
      </section>

      <% if (showTermBalanceContext) { %><details class="student-finance-term-context">
        <summary>Term balance context</summary>
        <p>These term figures are already included in school-year fees due above. They are reference views and are not added again.</p>
        <dl class="student-finance-term-context__list">
          <% if (summary.annualBalanceSchoolYear) { %><div><dt>Latest school-year balance · <%= summary.annualBalanceSchoolYear %></dt><dd><%= pesoAmount(summary.annualBalance) %></dd></div><% } %>
          <% if (currentTermPlacement) { %><div><dt>Current term · <%= [currentTermPlacement.term, currentTermPlacement.school_year].filter(Boolean).join(' · ') %></dt><dd><%= pesoAmount(summary.currentTermOutstanding) %></dd></div><% } %>
          <% if (Number(summary.priorTermYearDebt) > 0) { %><div><dt>Earlier terms and school years</dt><dd><%= pesoAmount(summary.priorTermYearDebt) %></dd></div><% } %>
        </dl>
      </details><% } %>

      <section class="student-finance-charges" aria-labelledby="finance-charges-title">
        <div class="student-finance-section-heading">
          <div>
            <h3 id="finance-charges-title">Fee breakdown</h3>
            <p>For each fee: assessed amount − approved coverage + other adjustments − payments applied = remaining due. Adjustments can increase or reduce a fee.</p>
          </div>
        </div>
        <% if (annualLedger.chargeGroups?.length) { %>
          <div class="student-finance-charge-groups">
            <% for (const group of annualLedger.chargeGroups) { %>
              <section class="student-finance-charge-group" aria-label="<%= group.school_year %>, <%= group.term %>">
                <div class="student-finance-charge-group__heading"><h4><%= group.school_year %> · <%= group.term %></h4><p><span>Remaining due</span><strong><%= pesoAmount(group.due) %></strong></p></div>
                <ul class="student-finance-charge-list">
                  <% for (const charge of group.charges) { %>
                    <li class="student-finance-charge">
                      <h5><%= charge.line_name %><% if (charge.installment) { %> · <%= charge.installment %><% } %><% if (charge.fee_category) { %><span class="student-finance-charge__category"><%= String(charge.fee_category).replaceAll('_', ' ').replace(/(^|\s)\S/g, (letter) => letter.toUpperCase()) %></span><% } %></h5>
                      <dl class="student-finance-charge__details">
                        <div><dt>Assessed amount</dt><dd><%= pesoAmount(charge.assessed_amount) %></dd></div>
                        <div><dt>Approved coverage</dt><dd><%= deductionAmount(charge.coverage_amount) %></dd></div>
                        <div><dt>Other adjustments</dt><dd><%= pesoAmount(charge.other_adjustments) %></dd></div>
                        <div><dt>Payments applied</dt><dd><%= deductionAmount(charge.applied_amount) %></dd></div>
                        <div class="student-finance-charge__due"><dt>Remaining due</dt><dd><%= pesoAmount(charge.due_amount) %></dd></div>
                      </dl>
                    </li>
                  <% } %>
                </ul>
              </section>
            <% } %>
          </div>
        <% } else { %>
          <p class="student-finance-empty">No fees have been assessed for any school year yet. Your account balance may still include earlier balances shown above.</p>
        <% } %>
      </section>

      <section class="student-finance-placements" aria-labelledby="finance-placements-title">
        <div class="student-finance-section-heading">
          <div>
            <h3 id="finance-placements-title">Enrollment by term</h3>
            <p>Term balances are already included in school-year fees above. Term account clearance is separate from the registrar’s paper clearance and does not change the amount due.</p>
          </div>
        </div>
        <% if (annualLedger.terms.length) { %>
          <ol class="student-finance-term-list">
            <% for (const term of annualLedger.terms) { %>
              <% const isCurrentTerm = term.is_current === true || term.is_current === 1 || term.is_current === '1'; %>
              <li class="student-finance-term">
                <div class="student-finance-term__heading">
                  <div class="student-finance-term__identity">
                    <h4><%= term.school_year %> · <%= term.term %></h4>
                    <% if (isCurrentTerm) { %><span class="student-finance-current">Current term</span><% } %>
                  </div>
                  <div class="student-finance-term__outstanding">
                  <span>Remaining due</span>
                  <strong><%= pesoAmount(term.outstanding) %></strong>
                  </div>
                </div>
                <dl class="student-finance-term__details">
                  <div>
                    <dt>Enrollment status</dt>
                    <dd><%= term.enrollment_status ? String(term.enrollment_status).replaceAll('_', ' ').replace(/(^|\s)\S/g, (letter) => letter.toUpperCase()) : 'Not recorded' %></dd>
                  </div>
                  <div>
                    <dt>Registrar confirmation</dt>
                    <dd><%= term.term_scope_status === 'not_applicable' ? 'Not applicable before entry term' : term.registrar_confirmation_id ? 'Confirmed by registrar' : 'Awaiting registrar confirmation' %></dd>
                  </div>
                  <div>
                    <dt>Term account clearance</dt>
                    <dd><%= term.signed_clearance_status === 'signed' ? 'Recorded' : 'Not recorded' %></dd>
                  </div>
                </dl>
              </li>
            <% } %>
          </ol>
        <% } else { %>
          <p class="student-finance-empty">No enrollment terms are available yet.</p>
        <% } %>
      </section>

      <% const paymentPurposeHistory = annualLedger.paymentPurposeHistory || {}; const studentPayments = paymentPurposeHistory.payments || []; const earlierPayments = paymentPurposeHistory.earlier_payments || []; %>
      <section class="student-finance-activity" aria-labelledby="finance-payment-purpose-title">
        <div class="student-finance-section-heading">
          <div><h3 id="finance-payment-purpose-title">Payment history and purposes</h3><p>Each payment total is separate from its saved fee applications. Current fee balances reflect the account today.</p></div>
        </div>
        <% if (studentPayments.length || earlierPayments.length) { %>
          <ol class="student-finance-activity-list student-finance-payment-list">
            <% for (const payment of studentPayments) { const paymentDate = new Date(payment.payment_date); const paymentReversed = payment.is_reversed === true || payment.is_reversed === 1 || payment.is_reversed === '1'; %>
              <li class="student-finance-activity-item student-finance-payment-item">
                <div class="student-finance-payment-summary">
                  <div class="student-finance-activity-item__entry"><strong>Payment #<%= payment.payment_id %> · total <%= pesoAmount(payment.amount) %></strong><span><%= Number.isFinite(paymentDate.getTime()) ? paymentDate.toLocaleDateString() : 'Date not recorded' %> · <%= paymentReversed ? 'Reversed' : 'Recorded' %></span></div>
                  <div class="student-finance-activity-item__details"><span><%= payment.reference_no ? `Current reference: ${payment.reference_no}` : 'No current reference recorded' %><%= payment.receipt_issued ? ' · Receipt marked issued' : '' %></span><a href="/student/finance/payments/<%= payment.payment_id %>/confirmation">Open printable payment confirmation</a></div>
                </div>
                <% if (payment.allocations.length) { %>
                  <div class="table-scroll student-finance-payment-allocations" tabindex="0" aria-label="Saved fee applications for payment #<%= payment.payment_id %>"><table class="portal-table student-finance-history__table"><thead><tr><th scope="col">Fee / payment purpose</th><th scope="col">Originally applied</th><th scope="col">Currently applied</th><th scope="col">Current fee balance</th></tr></thead><tbody>
                    <% for (const allocation of payment.allocations) { %><tr><td data-label="Fee / payment purpose"><%= allocation.purpose %><% if (paymentReversed) { %><br><span class="muted-copy">Payment reversed; this application is no longer active.</span><% } else if (Number(allocation.released_amount) > 0) { %><br><span class="muted-copy">₱<%= formatMoney(allocation.released_amount) %> has since been removed from this application.</span><% } %></td><td data-label="Originally applied"><%= allocation.original_amount == null ? 'Unavailable' : pesoAmount(allocation.original_amount) %></td><td data-label="Currently applied"><%= allocation.current_amount == null ? 'Unavailable' : pesoAmount(allocation.current_amount) %></td><td data-label="Current fee balance"><%= allocation.current_fee_balance == null ? 'Unavailable' : pesoAmount(allocation.current_fee_balance) %></td></tr><% } %>
                  </tbody></table></div>
                <% } else if (paymentReversed) { %><p class="student-finance-payment-note">This payment is reversed and has no saved fee applications.</p>
                <% } else if (payment.current_available_credit != null) { %><p class="student-finance-payment-note">No fee application is linked to this payment.</p>
                <% } else { %><p class="student-finance-payment-note">No saved fee application is linked to this payment. Its purpose is unavailable in the current record.</p><% } %>
                <% if (paymentReversed) { %><p class="student-finance-payment-credit"><strong>Unused credit currently available:</strong> ₱0.00 · Payment reversed</p>
                <% } else if (payment.current_available_credit != null) { %><p class="student-finance-payment-credit"><strong>Unused credit currently available:</strong> <%= pesoAmount(payment.current_available_credit) %></p><% } %>
              </li>
            <% } %>
            <% for (const payment of earlierPayments) { const paymentDate = new Date(payment.payment_date); %>
              <li class="student-finance-activity-item">
                <div class="student-finance-activity-item__entry"><strong>Earlier account payment #<%= payment.transaction_id %> · total <%= pesoAmount(payment.amount) %></strong><span><%= Number.isFinite(paymentDate.getTime()) ? paymentDate.toLocaleDateString() : 'Date not recorded' %></span></div>
                <div class="student-finance-activity-item__details"><span>Earlier account record</span></div>
                <% if (payment.allocations.length) { %><ul class="document-review-history"><% for (const allocation of payment.allocations) { %><li><strong><%= allocation.purpose %></strong><span>Amount applied later <%= allocation.original_amount == null ? 'Unavailable' : pesoAmount(allocation.original_amount) %> · currently applied <%= allocation.current_amount == null ? 'Unavailable' : pesoAmount(allocation.current_amount) %><% if (Number(allocation.released_amount) > 0) { %> · removed <%= pesoAmount(allocation.released_amount) %><% } %></span></li><% } %></ul>
                <% } else { %><p>Purpose is not recorded in the available history.</p><% } %>
              </li>
            <% } %>
          </ol>
        <% } else { %><p class="student-finance-empty">No payment records are available yet.</p><% } %>
      </section>

      <section class="student-finance-activity" aria-labelledby="finance-activity-title">
        <div class="student-finance-section-heading">
          <div>
            <h3 id="finance-activity-title">Recent account activity</h3>
            <p><%= annualLedger.events.length %> total entries in your account history.</p>
          </div>
        </div>
        <% if (recentFinanceEvents.length) { %>
          <ol class="student-finance-activity-list">
            <% for (const event of recentFinanceEvents) { %>
              <% const eventDate = new Date(event.event_date); %>
              <% const hasValidEventDate = Number.isFinite(eventDate.getTime()); %>
              <li class="student-finance-activity-item">
                <div class="student-finance-activity-item__entry">
                  <strong><%= event.display_label || 'Account update' %></strong>
                  <% if (hasValidEventDate) { %><time datetime="<%= eventDate.toISOString() %>"><%= eventDate.toLocaleString() %></time><% } else { %><span>Date not recorded</span><% } %>
                </div>
                <div class="student-finance-activity-item__details">
                  <span><%= event.details || 'Recorded by finance' %></span>
                  <span>Reference: <%= event.reference_no || '—' %></span>
                </div>
                <p class="student-finance-activity-item__amount"><span>Recorded amount</span><strong><%= event.amount == null ? '—' : pesoAmount(event.amount) %></strong></p>
              </li>
            <% } %>
          </ol>
        <% } else { %>
          <p class="student-finance-empty">No account activity has been recorded.</p>
        <% } %>

        <details class="student-finance-history">
          <summary>View complete account history · <%= annualLedger.events.length %> entries</summary>
          <% if (annualLedger.events.length) { %>
            <div class="table-scroll student-finance-history__scroll" tabindex="0" aria-label="Complete account history, oldest entries first">
              <table class="portal-table student-finance-history__table">
                <thead><tr><th scope="col">Date</th><th scope="col">Entry</th><th scope="col">Details</th><th scope="col">Reference</th><th scope="col">Recorded amount</th></tr></thead>
                <tbody>
                  <% for (const event of annualLedger.events) { %>
                    <% const eventDate = new Date(event.event_date); %>
                    <tr>
                      <td data-label="Date"><%= Number.isFinite(eventDate.getTime()) ? eventDate.toLocaleString() : 'Date not recorded' %></td>
                  <td data-label="Entry"><%= event.display_label || 'Account update' %></td>
                      <td data-label="Details"><%= event.details || 'Recorded by finance' %></td>
                      <td data-label="Reference"><%= event.reference_no || '—' %></td>
                      <td data-label="Recorded amount"><%= event.amount == null ? '—' : pesoAmount(event.amount) %></td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="student-finance-empty">No account activity has been recorded.</p>
          <% } %>
        </details>
      </section>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
