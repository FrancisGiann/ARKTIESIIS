<%- include('../partials/head', { title }) %>
<main class="page-shell student-page" id="main-content">
  <a class="context-back" href="/student">Back to my school day</a>
  <header class="page-heading"><div><h1>My grades</h1><p>Only grades published after registrar approval appear here.</p></div></header>
  <% if (!ownRecords?.student) { %>
    <section class="student-unlinked" aria-labelledby="grades-unlinked-title"><h2 id="grades-unlinked-title">Your student profile is not linked yet</h2><p>Ask the registrar to connect your account before viewing grades.</p></section>
  <% } else if (grades.length) { %>
    <section class="student-section" aria-labelledby="approved-grades-title">
      <div class="student-section-heading"><div><h2 id="approved-grades-title">Approved grades</h2><p><%= ownRecords.student.student_no %></p></div></div>
      <div class="table-scroll" tabindex="0" aria-label="Your registrar-approved grades">
        <table class="portal-table"><caption class="visually-hidden">Published grades for your enrolled subjects</caption><thead><tr><th scope="col">Term</th><th scope="col">Subject</th><th scope="col">Period</th><th scope="col">Grade</th></tr></thead><tbody>
          <% for (const grade of grades) { %><tr>
            <td data-label="Term"><%= grade.school_year %> · <%= grade.term %></td>
            <td data-label="Subject"><%= grade.subject_name %></td>
            <td data-label="Period"><%= grade.grading_period %></td>
            <td data-label="Grade"><%= grade.grade_value ?? '—' %></td>
          </tr><% } %>
        </tbody></table>
      </div>
    </section>
  <% } else { %><p class="empty-state">Approved grades will appear here after the registrar reviews a teacher submission.</p><% } %>
</main>
<%- include('../partials/foot') %>
