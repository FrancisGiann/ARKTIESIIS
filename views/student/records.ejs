<%- include('../partials/head', { title }) %>
<main class="page-shell student-page" id="main-content">
  <a class="context-back" href="/student">Back to my school day</a>
  <header class="page-heading"><div><h1>My profile and enrollment history</h1><p>Your school records are maintained by the registrar. Contact them to request a correction.</p></div></header>
  <% const student = ownRecords?.student || null; %>
  <% if (!student) { %>
    <section class="student-unlinked" aria-labelledby="records-unlinked-title"><h2 id="records-unlinked-title">Your student profile is not linked yet</h2><p>Ask the registrar to connect your account to a student record.</p></section>
  <% } else { %>
    <% const fullName = [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' '); %>
    <section class="student-section" aria-labelledby="profile-title">
      <div class="student-section-heading"><div><h2 id="profile-title"><%= fullName %></h2><p>Student number <strong><%= student.student_no %></strong></p></div><span class="record-status record-status--<%= student.status === 'active' ? 'active' : 'archived' %>"><%= student.status %></span></div>
      <dl class="student-profile-details">
        <div><dt>Birth date</dt><dd><%= student.birth_date ? new Date(student.birth_date).toLocaleDateString() : 'Not provided' %></dd></div>
        <div><dt>Sex</dt><dd><%= student.sex || 'Not provided' %></dd></div>
        <div><dt>Phone</dt><dd><%= student.phone || 'Not provided' %></dd></div>
        <div><dt>Address</dt><dd><%= student.address || 'Not provided' %></dd></div>
      </dl>
    </section>
    <section class="student-section" aria-labelledby="enrollment-history-title">
      <div class="student-section-heading"><div><h2 id="enrollment-history-title">Enrollment history</h2><p>Class and enrollment status by academic term.</p></div></div>
      <% if (ownRecords.enrollments.length) { %>
        <ol class="enrollment-history">
          <% for (const enrollment of ownRecords.enrollments) { %><li>
            <div><strong><%= enrollment.school_year %> · <%= enrollment.term %></strong><span><%= formatStudentPlacement(enrollment.grade_level, enrollment.section_name) || 'Section not assigned' %></span></div>
            <span class="status-chip status-chip--<%= enrollment.enrollment_status === 'enrolled' ? 'good' : 'pending' %>"><%= enrollment.enrollment_status.replaceAll('_', ' ') %></span>
          </li><% } %>
        </ol>
      <% } else { %><p class="empty-state">No enrollment history is available on your profile yet.</p><% } %>
    </section>
    <section class="student-section" aria-labelledby="paper-clearance-progress-title">
      <div class="student-section-heading"><div><h2 id="paper-clearance-progress-title">Paper clearance progress</h2><p>Read-only status from the registrar’s inspection of the printed school form.</p></div></div>
      <% if (paperClearanceProgressAvailable === false) { %><p class="empty-state" role="status">Paper-clearance progress is temporarily unavailable. Your profile and enrollment history are still available. Please try again later or contact the registrar.</p>
      <% } else if (paperClearanceProgress?.terms?.length) { %><div class="table-scroll" tabindex="0" aria-label="Paper clearance progress"><table class="portal-table"><thead><tr><th scope="col">School year and grade</th><th scope="col">Term</th><th scope="col">Progress</th></tr></thead><tbody>
        <% for (const item of paperClearanceProgress.terms) { %><tr><td data-label="School year and grade"><%= item.schoolYear %> · <%= item.gradeLevel %></td><td data-label="Term"><%= item.term %></td><td data-label="Progress"><% if (item.status === 'complete') { %>Complete<% if (item.requirementCount) { %> · <%= item.signedCount %> of <%= item.requirementCount %> required signatures recorded<% } %><% } else if (item.status === 'not_attended') { %>Registrar recorded that this term was not attended<% } else if (item.status === 'not_applicable') { %>No clearance required for this term<% } else if (item.awaitingConfirmation) { %>All recorded signatures are present · waiting for registrar confirmation<% } else if (item.status === 'incomplete') { %><%= item.signedCount %> of <%= item.requirementCount %> required signatures recorded · registrar review pending<% } else { %>Registrar review pending<% } %></td></tr><% } %>
      </tbody></table></div><% } else { %><p class="empty-state">No paper-clearance progress has been recorded yet.</p><% } %>
      <p class="muted-copy">This page does not show staff notes or signer details. Contact the registrar if a status needs review.</p>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
