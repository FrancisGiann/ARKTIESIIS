<%- include('../partials/head', { title }) %>
<main class="page-shell auth-page" id="main-content">
  <section class="auth-intro" aria-labelledby="login-title">
    <a class="context-back" href="/">Back to home</a>
    <h1 id="login-title">Sign in</h1>
    <p>Use the email address and password associated with your school account.</p>
    <% if (twoFactorRequired) { %>
      <p class="auth-note">After your password is accepted, a six-digit verification code will be sent to your school email.</p>
    <% } else { %>
      <p class="auth-note">Development-only password sign-in is enabled.</p>
    <% } %>
  </section>
  <section class="auth-form-section" aria-labelledby="credentials-title">
    <h2 id="credentials-title">School account</h2>
    <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
    <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
    <form class="form-stack" method="post" action="/login" data-submitting-message="Checking your sign-in. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="email">School email</label>
        <input id="email" name="email" type="email" autocomplete="username" maxlength="255" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="button button--primary" type="submit">Continue</button>
    </form>
    <p class="field-help"><a href="/password/forgot">Forgot your password?</a></p>
  </section>
</main>
<%- include('../partials/foot') %>
