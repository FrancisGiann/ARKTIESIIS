<%- include('../partials/head', { title }) %>
<main class="page-shell auth-page" id="main-content">
  <section class="auth-intro" aria-labelledby="password-reset-title">
    <a class="context-back" href="/login">Back to sign in</a>
    <h1 id="password-reset-title">Reset password</h1>
    <p>Choose a new password for your account. Use 12 or more ordinary letters, numbers, or symbols. Emoji and some other characters reach the maximum length sooner.</p>
  </section>
  <section class="auth-form-section" aria-labelledby="new-password-title">
    <h2 id="new-password-title">New password</h2>
    <% if (error && !resetLinkUnavailable && requestId && token) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
    <% if (resetLinkUnavailable || !requestId || !token) { %>
      <p class="form-alert" role="alert"><%= error || 'This reset link is invalid or has expired.' %></p>
      <a class="button button--primary" href="/password/forgot">Request a new reset link</a>
    <% } else { %>
    <form class="form-stack" method="post" action="/password/reset" data-password-match-form data-submitting-message="Resetting your password. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="requestId" value="<%= requestId %>">
      <input type="hidden" name="token" value="<%= token %>">
      <div class="field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required aria-describedby="password-help" data-password-source>
        <span class="field-help" id="password-help">Use 12 or more ordinary letters, numbers, or symbols. Emoji and some other characters reach the maximum length sooner.</span>
      </div>
      <div class="field">
        <label for="confirm-password">Confirm new password</label>
        <input id="confirm-password" name="confirmPassword" type="password" minlength="12" maxlength="72" autocomplete="new-password" required aria-describedby="password-mismatch" data-password-confirm>
        <span id="password-mismatch" class="password-match-error" data-password-mismatch-message aria-live="polite" aria-atomic="true"></span>
      </div>
      <button class="button button--primary" type="submit">Set new password</button>
    </form>
    <% } %>
  </section>
</main>
<%- include('../partials/foot') %>
