<%- include('../partials/head', { title }) %>
<main class="page-shell auth-page" id="main-content">
  <section class="auth-intro" aria-labelledby="forgot-password-title">
    <a class="context-back" href="/login">Back to sign in</a>
    <h1 id="forgot-password-title">Forgot password</h1>
    <p>Enter the email address on your school account. If the account is active, reset instructions will be sent to that address.</p>
  </section>
  <section class="auth-form-section" aria-labelledby="reset-request-title">
    <h2 id="reset-request-title">Request a password reset</h2>
    <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
    <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
    <form class="form-stack" method="post" action="/password/forgot" data-submitting-message="Checking your account. Please wait.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="email">School email</label>
        <input id="email" name="email" type="email" autocomplete="username" maxlength="255" required>
      </div>
      <button class="button button--primary" type="submit">Send reset instructions</button>
    </form>
  </section>
</main>
<%- include('../partials/foot') %>
