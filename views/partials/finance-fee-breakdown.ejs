<%
  const feeYears = (typeof years !== 'undefined' && years) || ledger.feeBreakdownYears || [];
  const displayStaffDetails = typeof staffOnlyDetails !== 'undefined' && staffOnlyDetails === true;
  const applicationHistory = displayStaffDetails && typeof feeApplicationsByCharge !== 'undefined' ? (feeApplicationsByCharge || {}) : {};
  const expandAllYears = typeof openAllYears !== 'undefined' && openAllYears === true;
  const yearToExpand = (typeof expandedSchoolYear !== 'undefined' ? expandedSchoolYear : null) || null;
  const requestedTableClass = typeof tableClass === 'string' ? tableClass : 'admin-table';
  const requestedAccountView = typeof accountView === 'string' ? accountView : '';
  const studentIsArchived = typeof archivedStudent !== 'undefined' && archivedStudent === true;
  const currentFailedAction = typeof failedAction !== 'undefined' ? failedAction : null;
  const cash = (amount) => {
    const value = String(amount ?? '0.00');
    const negative = value.startsWith('-');
    const formatted = formatMoney(negative ? value.slice(1) : value);
    return negative ? `−₱${formatted}` : `₱${formatted}`;
  };
  const reduction = (amount) => {
    const value = String(amount ?? '0.00');
    const negative = value.startsWith('-');
    const formatted = formatMoney(negative ? value.slice(1) : value);
    return negative ? `₱${formatted}` : /^0(?:\.0{1,2})?$/.test(value) ? `₱${formatted}` : `−₱${formatted}`;
  };
  const balance = (amount) => {
    const value = String(amount ?? '0.00');
    const negative = value.startsWith('-');
    const formatted = formatMoney(negative ? value.slice(1) : value);
    return negative ? `₱${formatted} credit` : Number(value) > 0 ? `₱${formatted} due` : `₱${formatted}`;
  };
  const balanceState = (amount) => {
    const value = String(amount ?? '0.00');
    if (value.startsWith('-')) return 'credit';
    return /^0(?:\.0{1,2})?$/.test(value) ? 'zero' : 'due';
  };
  const paymentStatusClass = (status) => {
    const value = String(status || '').toLocaleLowerCase('en');
    if (value.includes('unavailable') || value.includes('needs review') || value.includes('missing')) return 'finance-fee-status--error';
    if (value === 'fully paid' || value === 'no payment required') return 'finance-fee-status--settled';
    if (value === 'unpaid' || value === 'partially paid') return 'finance-fee-status--due';
    return '';
  };
  const categoryLabel = (value) => String(value || 'Fee').replaceAll('_', ' ').replace(/(^|\s)\S/g, (letter) => letter.toUpperCase());
  const dateLabel = (value) => {
    if (!value) return 'Date not recorded';
    const date = new Date(value);
    return Number.isFinite(date.getTime())
      ? new Intl.DateTimeFormat('en-PH', { dateStyle: 'medium', timeZone: 'Asia/Manila' }).format(date)
      : 'Date not recorded';
  };
  const recoveryFor = (path) => currentFailedAction?.path === path ? (currentFailedAction.input || {}) : {};
%>
<div class="finance-fee-breakdown-list">
  <% for (const [yearIndex, year] of feeYears.entries()) { const yearHasRecovery = displayStaffDetails && year.terms.some((group) => group.charges.some((charge) => currentFailedAction && (currentFailedAction.path === `/students/${ledger.student.id}/annual/charges/${charge.charge_id}/adjustments` || currentFailedAction.path === `/students/${ledger.student.id}/annual/charges/${charge.charge_id}/comments` || (ledger.adjustments || []).some((item) => Number(item.charge_id) === Number(charge.charge_id) && currentFailedAction.path === `/students/${ledger.student.id}/annual/adjustments/${item.adjustment_id}/reverse`)))); const isExpanded = expandAllYears || yearHasRecovery || String(year.school_year) === String(yearToExpand) || (!yearToExpand && yearIndex === 0); %>
    <details class="finance-fee-school-year" <%= isExpanded ? 'open' : '' %>>
      <summary><strong><%= year.school_year %></strong><span>School-year balance <%= balance(year.subtotal.due_amount) %></span></summary>
      <div class="finance-fee-shared-headings" aria-hidden="true"><span>Fee / installment</span><span>Assessed fee</span><span>Discounts / exemptions</span><span>Adjustments</span><span>Payments applied</span><span>Balance</span></div>
      <% for (const group of year.terms) { const termHasRecovery = displayStaffDetails && group.charges.some((charge) => currentFailedAction && (currentFailedAction.path === `/students/${ledger.student.id}/annual/charges/${charge.charge_id}/adjustments` || currentFailedAction.path === `/students/${ledger.student.id}/annual/charges/${charge.charge_id}/comments` || (ledger.adjustments || []).some((item) => Number(item.charge_id) === Number(charge.charge_id) && currentFailedAction.path === `/students/${ledger.student.id}/annual/adjustments/${item.adjustment_id}/reverse`))); const termIsExpanded = expandAllYears || termHasRecovery; %>
        <details class="finance-fee-term-group" <%= termIsExpanded ? 'open' : '' %>>
          <summary><strong><%= group.term %></strong><span>Term subtotal <%= balance(group.termSubtotal.due_amount) %></span></summary>
          <% if (!group.tuitionBreakdownRecorded) { %>
            <p class="finance-fee-breakdown-note" role="status">Tuition installment breakdown not recorded. Saved fee lines remain as recorded; no amounts have been split or replaced by a newer schedule.</p>
          <% } %>
          <div class="table-scroll" tabindex="0" aria-label="<%= year.school_year %> <%= group.term %> fee breakdown">
            <table class="<%= requestedTableClass %> finance-fee-breakdown-table">
              <colgroup><col class="finance-fee-breakdown-col--label"><col class="finance-fee-breakdown-col--amount"><col class="finance-fee-breakdown-col--amount"><col class="finance-fee-breakdown-col--amount"><col class="finance-fee-breakdown-col--amount"><col class="finance-fee-breakdown-col--amount"></colgroup>
              <thead class="finance-fee-table-accessible-head"><tr><th scope="col">Fee / installment</th><th scope="col">Assessed fee</th><th scope="col">Discounts / exemptions</th><th scope="col">Adjustments</th><th scope="col">Payments applied</th><th scope="col">Balance</th></tr></thead>
              <tbody>
                <% const rowsByCategory = [
                  { label: 'Tuition subtotal', category: 'tuition' },
                  { label: 'Miscellaneous subtotal', category: 'miscellaneous' },
                  { label: 'Other fees subtotal', category: 'other' }
                ]; %>
                <% for (const charge of group.charges) { const installment = charge.installment || 'Installment not recorded'; const applications = applicationHistory[String(charge.charge_id)] || []; const feeAdjustments = displayStaffDetails ? (ledger.adjustments || []).filter((item) => Number(item.charge_id) === Number(charge.charge_id)) : []; const feeComments = displayStaffDetails ? (ledger.feeComments || []).filter((item) => Number(item.charge_id) === Number(charge.charge_id)) : []; const feeStudentId = ledger?.student?.id; const adjustmentPath = feeStudentId == null ? '' : `/students/${feeStudentId}/annual/charges/${charge.charge_id}/adjustments`; const commentPath = feeStudentId == null ? '' : `/students/${feeStudentId}/annual/charges/${charge.charge_id}/comments`; const adjustmentRecovery = recoveryFor(adjustmentPath); const commentRecovery = recoveryFor(commentPath); const adjustmentNeedsRecovery = currentFailedAction?.path === adjustmentPath; const commentNeedsRecovery = currentFailedAction?.path === commentPath; const reversalNeedsRecovery = feeAdjustments.some((item) => currentFailedAction?.path === `/students/${feeStudentId}/annual/adjustments/${item.adjustment_id}/reverse`); %>
                  <tr>
                    <td data-label="Fee / installment">
                      <strong><%= charge.line_name %> · <%= installment %></strong>
                      <span class="finance-fee-breakdown-category"><%= categoryLabel(charge.fee_category) %></span>
                      <span class="finance-fee-status <%= paymentStatusClass(charge.payment_status) %>"><%= charge.payment_status %></span>
                      <% if (charge.fee_basis_negative) { %><span class="finance-fee-breakdown-note" role="status">Negative fee basis: review the recorded reduction. Any credit is shown in the balance.</span><% } %>
                      <% if (displayStaffDetails && applications.length) { %>
                        <details class="finance-fee-staff-details">
                          <summary>Payment applications · <%= applications.length %></summary>
                          <p class="muted-copy">Earlier account applications remain identified as earlier payments. Missing dates or receipt references are not reconstructed.</p>
                          <div class="table-scroll" tabindex="0" aria-label="Payment applications for <%= charge.line_name %>">
                            <table class="admin-table finance-fee-applications-table"><thead><tr><th scope="col">Application</th><th scope="col">Date</th><th scope="col">Receipt reference</th><th scope="col">Originally applied</th><th scope="col">Still applied</th><th scope="col">Released</th><th scope="col">Reversed</th></tr></thead><tbody>
                              <% for (const application of applications) { const paymentId = application.payment_id || application.transaction_id; %>
                                <tr>
                                  <td data-label="Application"><%= application.application_kind === 'earlier payment' ? `Earlier payment #${paymentId}` : `Payment #${paymentId}` %></td>
                                  <td data-label="Date"><%= dateLabel(application.payment_date) %></td>
                                  <td data-label="Receipt reference"><%= application.reference_no || 'No receipt reference recorded' %></td>
                                  <td data-label="Originally applied"><%= application.original_amount == null ? 'Unavailable' : cash(application.original_amount) %></td>
                                  <td data-label="Still applied"><%= application.still_applied_amount == null ? 'Unavailable' : cash(application.still_applied_amount) %></td>
                                  <td data-label="Released"><%= application.released_display_amount == null ? 'Unavailable' : cash(application.released_display_amount) %></td>
                                  <td data-label="Reversed"><%= application.reversed_display_amount == null ? 'Unavailable' : cash(application.reversed_display_amount) %></td>
                                </tr>
                              <% } %>
                            </tbody></table>
                          </div>
                        </details>
                      <% } %>
                      <% if (displayStaffDetails && feeAdjustments.length) { %>
                        <details class="finance-fee-staff-details" <%= reversalNeedsRecovery ? 'open' : '' %>>
                          <summary>History &amp; comments<% if (feeComments.length) { %><span> · <%= feeComments.length %> comments</span><% } %></summary>
                          <% if (feeAdjustments.length) { %><h4>Adjustment history</h4><ul class="document-review-history">
                            <% for (const adjustment of feeAdjustments) { const reversalEntry = adjustment.reverses_adjustment_id != null; const alreadyReversed = adjustment.already_reversed === true || adjustment.already_reversed === 1 || adjustment.already_reversed === '1'; const reversalPath = `/students/${ledger.student.id}/annual/adjustments/${adjustment.adjustment_id}/reverse`; const reversalRecovery = recoveryFor(reversalPath); %>
                              <li><strong><%= reversalEntry ? `Reversal of adjustment #${adjustment.reverses_adjustment_id}` : `Adjustment #${adjustment.adjustment_id}` %> · <%= cash(adjustment.amount) %></strong><span><%= dateLabel(adjustment.created_at) %> · <%= adjustment.reason %></span>
                                <% if (!reversalEntry && alreadyReversed) { %><p>Already reversed.</p>
                                <% } else if (!reversalEntry && !studentIsArchived) { %><form class="form-stack" method="post" action="/finance/students/<%= ledger.student.id %>/annual/adjustments/<%= adjustment.adjustment_id %>/reverse"<% if (currentFailedAction?.path === reversalPath) { %> data-unsaved-initially-dirty="true"<% } %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= tokens[`adjustmentReversal:${adjustment.adjustment_id}`] %>"><label class="field"><span>Reversal reason</span><textarea name="reason" rows="2" maxlength="1000" required><%= reversalRecovery.reason || '' %></textarea></label><button class="button button--secondary" type="submit">Reverse adjustment</button></form><% } %>
                              </li>
                            <% } %></ul><% } %>
                          <% if (feeComments.length) { %><h4>Fee comments</h4><ul class="document-review-history"><% for (const comment of feeComments) { %><li><strong><%= comment.actor_name %> · <%= dateLabel(comment.created_at) %></strong><p><%= comment.comment %></p></li><% } %></ul><% } %>
                        </details>
                      <% } else if (displayStaffDetails && feeComments.length) { %>
                        <details class="finance-fee-staff-details"><summary>Comments · <%= feeComments.length %></summary><ul class="document-review-history"><% for (const comment of feeComments) { %><li><strong><%= comment.actor_name %> · <%= dateLabel(comment.created_at) %></strong><p><%= comment.comment %></p></li><% } %></ul></details>
                      <% } %>
                      <% if (displayStaffDetails && requestedAccountView === 'charges' && !studentIsArchived) { %>
                        <details class="finance-fee-adjustment-details" <%= adjustmentNeedsRecovery || adjustmentRecovery.amount || adjustmentRecovery.reason ? 'open' : '' %>><summary>Adjust</summary><form class="form-stack" method="post" action="/finance/students/<%= ledger.student.id %>/annual/charges/<%= charge.charge_id %>/adjustments"<% if (currentFailedAction?.path === adjustmentPath) { %> data-unsaved-initially-dirty="true"<% } %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= tokens[`adjustment:${charge.charge_id}`] %>"><label class="field"><span>Adjustment amount (PHP)</span><input name="amount" inputmode="decimal" maxlength="14" value="<%= adjustmentRecovery.amount || '' %>" required><small class="muted-copy">A positive amount increases the fee; a negative amount reduces it.</small></label><label class="field"><span>Reason</span><textarea name="reason" rows="2" maxlength="1000" required><%= adjustmentRecovery.reason || '' %></textarea></label><button class="button button--secondary" type="submit">Record adjustment</button></form></details>
                        <details class="finance-fee-comment-details" <%= commentNeedsRecovery || commentRecovery.comment ? 'open' : '' %>><summary>Add comment<% if (feeComments.length) { %><span> · <%= feeComments.length %> recorded</span><% } %></summary><form class="form-stack" method="post" action="/finance/students/<%= ledger.student.id %>/annual/charges/<%= charge.charge_id %>/comments"<% if (currentFailedAction?.path === commentPath) { %> data-unsaved-initially-dirty="true"<% } %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= tokens[`feeComment:${charge.charge_id}`] %>"><label class="field"><span>Append comment</span><textarea name="comment" rows="2" maxlength="1000" required><%= commentRecovery.comment || '' %></textarea></label><button class="button button--secondary" type="submit">Add fee comment</button></form></details>
                      <% } %>
                    </td>
                    <td data-label="Assessed fee"><%= cash(charge.assessed_amount) %></td>
                    <td data-label="Discounts / exemptions"><%= reduction(charge.coverage_amount) %></td>
                    <td data-label="Adjustments"><%= cash(charge.other_adjustments) %></td>
                    <td data-label="Payments applied"><%= reduction(charge.applied_amount) %></td>
                    <td data-label="Balance" data-balance-state="<%= balanceState(charge.due_amount) %>"><strong><%= balance(charge.due_amount) %></strong></td>
                  </tr>
                <% } %>
                <% for (const subtotal of rowsByCategory) { const categoryRows = group.charges.filter((charge) => subtotal.category === 'other' ? !['tuition', 'miscellaneous'].includes(String(charge.fee_category || '').toLowerCase()) : String(charge.fee_category || '').toLowerCase() === subtotal.category); const categoryTotal = subtotal.category === 'tuition' ? group.tuitionSubtotal : subtotal.category === 'miscellaneous' ? group.miscellaneousSubtotal : group.otherFeesSubtotal; if (!categoryRows.length) continue; %>
                  <tr class="finance-fee-subtotal"><td data-label="Subtotal"><strong><%= subtotal.label %></strong></td><td data-label="Assessed fee"><%= cash(categoryTotal.assessed_amount) %></td><td data-label="Discounts / exemptions"><%= reduction(categoryTotal.coverage_amount) %></td><td data-label="Adjustments"><%= cash(categoryTotal.other_adjustments) %></td><td data-label="Payments applied"><%= reduction(categoryTotal.applied_amount) %></td><td data-label="Balance"><strong><%= balance(categoryTotal.due_amount) %></strong></td></tr>
                <% } %>
                <tr class="finance-fee-subtotal finance-fee-subtotal--term"><td data-label="Subtotal"><strong>Term subtotal</strong></td><td data-label="Assessed fee"><%= cash(group.termSubtotal.assessed_amount) %></td><td data-label="Discounts / exemptions"><%= reduction(group.termSubtotal.coverage_amount) %></td><td data-label="Adjustments"><%= cash(group.termSubtotal.other_adjustments) %></td><td data-label="Payments applied"><%= reduction(group.termSubtotal.applied_amount) %></td><td data-label="Balance"><strong><%= balance(group.termSubtotal.due_amount) %></strong></td></tr>
              </tbody>
            </table>
          </div>
        </details>
      <% } %>
    </details>
  <% } %>
</div>
