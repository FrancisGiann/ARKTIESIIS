<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#f7f8f8">
  <meta name="color-scheme" content="light">
  <% const isPublicHome = typeof publicSeo !== 'undefined' && publicSeo === true; %>
  <title><%= isPublicHome ? 'ARKTIESIIS | Ark Technological Institute Education System Inc. in Lucena' : `${title} | ARKTIESIIS` %></title>
  <meta name="robots" content="<%= isPublicHome ? 'index, follow' : 'noindex, nofollow, noarchive' %>">
  <% if (isPublicHome) { %>
  <meta name="description" content="ARKTIESIIS is the school portal of Ark Technological Institute Education System Inc. in Lucena. Students and staff use it for schedules, enrollment, approved grades, and school requirements.">
  <link rel="canonical" href="https://arklucena.com/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ARKTIESIIS">
  <meta property="og:title" content="ARKTIESIIS | Ark Technological Institute Education System Inc. in Lucena">
  <meta property="og:description" content="The school portal of Ark Technological Institute Education System Inc. in Lucena, with schedules, enrollment, approved grades, and school requirements for students and staff.">
  <meta property="og:url" content="https://arklucena.com/">
  <meta property="og:image" content="https://arklucena.com/images/arktiesiis-campus-building-hero.png">
  <meta property="og:image:alt" content="Ark Technological Institute Education System Inc. campus building in Lucena">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="ARKTIESIIS | Ark Technological Institute Education System Inc. in Lucena">
  <meta name="twitter:description" content="The school portal of Ark Technological Institute Education System Inc. in Lucena.">
  <meta name="twitter:image" content="https://arklucena.com/images/arktiesiis-campus-building-hero.png">
  <% } %>
  <link rel="icon" type="image/png" sizes="447x447" href="/images/arktiesiis-school-seal.png">
  <link rel="apple-touch-icon" href="/images/arktiesiis-school-seal.png">
  <link rel="manifest" href="/site-manifest.json">
  <% const stylesheetUrl = typeof assetVersion === 'undefined' ? '/css/app.css' : `/css/app.css?v=${assetVersion}`; %>
  <link rel="stylesheet" href="<%= stylesheetUrl %>">
  <% if (typeof pageStylesheet === 'string' && /^\/css\/[a-z0-9-]+\.css$/.test(pageStylesheet)) { %><link rel="stylesheet" href="<%= typeof assetVersion === 'undefined' ? pageStylesheet : `${pageStylesheet}?v=${assetVersion}` %>"><% } %>
</head>
<body class="<%= typeof currentUser !== 'undefined' && currentUser && typeof navigationItems !== 'undefined' ? `workspace-body${currentUser.role === 'registrar' ? ' workspace-body--registrar' : ''}${navigationItems.some((item) => item.current && item.id?.startsWith('finance-')) ? ' workspace-body--finance' : ''}` : 'public-body' %>">
<a class="skip-link" href="#main-content">Skip to main content</a>
<% if (typeof currentUser !== 'undefined' && currentUser && typeof navigationItems !== 'undefined') { %>
  <% const roleLabels = { database_admin: 'Database administrator', registrar: 'Registrar', front_desk: 'Front desk', teacher: 'Teacher', finance: 'Finance', student: 'Student' }; %>
  <% const workspaceHomes = { database_admin: '/admin', registrar: '/registrar', front_desk: '/front-desk', teacher: '/teacher', finance: '/finance/overview', student: '/student' }; %>
  <% const currentNavItem = navigationItems.find((item) => item.current); %>
  <div class="app-shell">
    <header class="app-header">
      <a class="brand" href="<%= workspaceHomes[currentUser.role] || '/' %>" aria-label="ARKTIESIIS, Ark Technological Institute Education System Inc., Main Branch">
        <img class="brand__seal" src="/images/arktiesiis-school-seal.png" alt="Official school seal">
        <span class="brand__copy"><strong class="brand__name">ARKTIESIIS</strong><span class="brand__institution">Ark Technological Institute Education System Inc.</span><span class="brand__branch">Main Branch</span></span>
      </a>
      <details class="mobile-nav">
        <summary><span>Menu</span><span class="mobile-nav__current"><%= currentNavItem?.label || 'Workspace' %></span></summary>
        <div class="mobile-nav__panel">
          <div class="mobile-nav__identity"><strong><%= roleLabels[currentUser.role] || 'School account' %></strong><span><%= currentUser.email %></span></div>
          <% for (const group of navigationGroups || []) { %>
            <section class="nav-group">
              <h2><%= group.label %></h2>
              <nav aria-label="<%= group.label %>">
                <% for (const item of group.items) { %>
                  <a class="mobile-nav__link<%= item.current ? ' is-current' : '' %>" href="<%= item.href %>"<% if (item.current) { %> aria-current="page"<% } %>><%= item.label %></a>
                <% } %>
              </nav>
            </section>
          <% } %>
          <div class="mobile-nav__account">
            <a class="mobile-nav__link<%= currentNavItem?.id === 'account' ? ' is-current' : '' %>" href="/account"<% if (currentNavItem?.id === 'account') { %> aria-current="page"<% } %>>Account settings</a>
            <form method="post" action="/logout" data-confirm data-confirm-title="Sign out?" data-confirm-message="Are you sure you want to sign out?" data-confirm-accept-label="Sign out"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sign-out-button" type="submit">Sign out</button></form>
          </div>
        </div>
      </details>
      <div class="app-header__user">
        <span class="role-label"><%= roleLabels[currentUser.role] || 'School account' %></span>
        <a class="account-shortcut<%= currentNavItem?.id === 'account' ? ' is-current' : '' %>" href="/account"<% if (currentNavItem?.id === 'account') { %> aria-current="page"<% } %>>Account settings</a>
        <form method="post" action="/logout" data-confirm data-confirm-title="Sign out?" data-confirm-message="Are you sure you want to sign out?" data-confirm-accept-label="Sign out">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="sign-out-button" type="submit">Sign out</button>
        </form>
      </div>
    </header>
    <div class="app-frame">
      <aside class="desktop-nav" aria-label="Workspace navigation">
        <nav class="app-nav" aria-label="Main navigation">
          <% for (const group of navigationGroups || []) { %>
            <section class="nav-group">
              <h2><%= group.label %></h2>
              <ul>
                <% for (const item of group.items) { %>
                  <li><a class="app-nav__link<%= item.current ? ' is-current' : '' %>" href="<%= item.href %>"<% if (item.current) { %> aria-current="page"<% } %>><%= item.label %></a></li>
                <% } %>
              </ul>
            </section>
          <% } %>
        </nav>
      </aside>
      <div class="app-content">
<% } else { %>
  <div class="public-shell">
    <header class="public-header">
      <a class="brand" href="/" aria-label="ARKTIESIIS home">
        <img class="brand__seal" src="/images/arktiesiis-school-seal.png" alt="Official school seal">
        <span class="brand__copy"><strong class="brand__name">ARKTIESIIS</strong><span class="brand__institution">Ark Technological Institute Education System Inc.</span><span class="brand__branch">Main Branch</span></span>
      </a>
    </header>
    <div class="public-content">
<% } %>
