<%- include('../partials/head', { title }) %>
<main class="page-shell account-page" id="main-content">
  <section class="dashboard-heading"><div><h1>Change your temporary password</h1><p>Your student login needs a private password before you can open student pages.</p></div></section>
  <p class="form-alert" role="status">You have signed in with email verification. Change the temporary password now to continue.</p>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <section class="admin-form-section account-password-change" aria-labelledby="password-change-title">
    <h2 id="password-change-title">Choose a new password</h2>
    <form class="form-stack admin-form" method="post" action="/account/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="current-password">Temporary password</label><input id="current-password" name="currentPassword" type="password" autocomplete="current-password" maxlength="72" required></div>
      <div class="field"><label for="new-password">New password</label><input id="new-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required aria-describedby="new-password-help"><small id="new-password-help">Use 12 or more ordinary letters, numbers, or symbols. Emoji and some other characters reach the maximum length sooner. Avoid sharing or reusing a password.</small></div>
      <div class="field"><label for="confirm-password">Confirm new password</label><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="72" required></div>
      <div class="admin-form-actions"><button class="button button--primary" type="submit">Change password</button></div>
    </form>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button button--secondary" type="submit">Sign out</button>
    </form>
  </section>
</main>
<%- include('../partials/foot') %>
