<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page <%= student ? 'finance-detail-page' : 'finance-workspace-page' %>" id="main-content">
  <% if (student) { %><a class="context-back" href="/finance/legacy<%= searchSuffix %>">Back to legacy finance workspace</a><% } %>
  <section class="dashboard-heading">
    <div>
      <h1><%= student ? 'Financial account' : 'Finance workspace' %></h1>
      <p><%= student ? 'Review this student account and its recorded transactions.' : 'Review account activity, find a student, and record finance transactions.' %></p>
    </div>
  </section>

  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (student?.status === 'archived') { %>
    <p class="form-alert" role="status">This student record is archived. Existing financial account and transaction history is available for review; new accounts and transactions are disabled.</p>
  <% } %>

  <% if (!student) { %>
    <% const accountRows = searchTerm ? students : recentAccounts; %>
    <section class="finance-panel finance-overview-panel" aria-labelledby="finance-search-heading">
      <div class="finance-overview-heading">
        <div>
          <h2 id="finance-search-heading"><%= searchTerm ? 'Student search results' : 'Find a student account' %></h2>
          <p><%= searchTerm ? 'Matches across active and archived student records.' : 'Search a student record to review or create its finance account.' %></p>
        </div>
        <form class="finance-search" method="get" action="/finance">
          <label class="field">
            <span>Student name or number</span>
            <input type="search" name="search" maxlength="100" value="<%= searchTerm %>" autocomplete="off" placeholder="Enter a name or student number" required>
          </label>
          <button class="button button--primary" type="submit">Find student</button>
        </form>
      </div>
      <% if (searchError) { %><p class="form-alert" role="alert"><%= searchError %></p><% } %>
      <% if (searchTerm && !searchError && students.length === 0) { %><p class="empty-state">No matching students were found. Check the name or student number and search again.</p><% } %>
      <% if (accountRows.length) { %>
        <div class="table-scroll finance-account-list" tabindex="0" aria-label="<%= searchTerm ? 'Finance search results' : 'Recent financial accounts' %>">
          <table class="admin-table finance-overview-table">
            <caption class="visually-hidden"><%= searchTerm ? 'Student search results and account summary' : 'Recently updated student financial accounts' %></caption>
            <thead><tr><th scope="col">Student number</th><th scope="col">Student</th><th scope="col">Account status</th><th scope="col">Balance</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
            <tbody>
              <% accountRows.forEach((result) => { %>
                <% const balanceAmount = result.balance === null || result.balance === undefined ? null : Number(result.balance); %>
                <% const accountStatus = !result.financial_account_id ? 'Not created' : balanceAmount > 0 ? 'Due' : balanceAmount < 0 ? 'Credit' : 'Settled'; %>
                <tr>
                  <td data-label="Student number"><%= result.student_no %></td>
                  <td data-label="Student"><%= [result.first_name, result.middle_name, result.last_name, result.suffix].filter(Boolean).join(' ') %></td>
                  <td data-label="Account status"><span class="finance-status finance-status--<%= accountStatus.toLowerCase().replaceAll(' ', '-') %>"><%= accountStatus %></span></td>
                  <td data-label="Balance"><%= balanceAmount === null ? '—' : `₱${formatMoney(result.balance)}` %></td>
                  <td data-label="Action"><a class="table-action" href="/finance/students/<%= result.student_id %><%= searchSuffix %>"><%= result.financial_account_id ? 'View account' : 'Create account' %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="finance-caption"><%= searchTerm ? `Showing at most ${students.length === 100 ? '100' : students.length} matches.` : `Showing ${recentAccounts.length} of the most recently updated accounts.` %> Search covers all student records.</p>
      <% } else if (!searchTerm && !searchError) { %>
        <p class="empty-state">No financial accounts are available yet. Search for a student to create an account.</p>
      <% } %>
    </section>
    <% if (pendingEnrollments?.length) { %>
      <section class="finance-panel" aria-labelledby="pending-enrollment-payments-heading">
        <div class="admin-section__heading"><div><h2 id="pending-enrollment-payments-heading">Pending enrollment payments</h2><p>Record a payment from the student's financial account and explicitly clear the matching enrollment.</p></div></div>
        <div class="table-scroll" tabindex="0" aria-label="Enrollments awaiting payment clearance">
          <table class="admin-table">
            <thead><tr><th scope="col">Student</th><th scope="col">Term and section</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
            <tbody><% for (const enrollment of pendingEnrollments) { %><tr>
              <td data-label="Student"><strong><%= [enrollment.first_name, enrollment.middle_name, enrollment.last_name, enrollment.suffix].filter(Boolean).join(' ') %></strong><br><%= enrollment.student_no %></td>
              <td data-label="Term and section"><%= enrollment.school_year %> · <%= enrollment.term %><br><%= enrollment.section_name || 'No section' %></td>
              <td data-label="Action"><a class="table-action" href="/finance/students/<%= enrollment.student_id %>">Open account and record payment</a></td>
            </tr><% } %></tbody>
          </table>
        </div>
      </section>
    <% } %>
  <% } %>

  <% if (student) { %>
    <section class="finance-panel finance-account" aria-labelledby="finance-account-heading">
      <% const accountStatus = !account ? 'not-created' : Number(account.balance) === 0 ? 'settled' : Number(account.balance) < 0 ? 'credit' : 'due'; %>
      <header class="finance-account__heading finance-account-summary">
        <div class="finance-account-identity">
          <h2 id="finance-account-heading"><%= [student.first_name, student.middle_name, student.last_name, student.suffix].filter(Boolean).join(' ') %></h2>
          <p class="finance-account-number"><span>Student number</span><strong><%= student.student_no %></strong></p>
          <% if (student.status === 'archived') { %><span class="finance-account-archive-label">Archived record · Read only</span><% } %>
        </div>
        <dl class="finance-balance-summary">
          <% if (account) { %>
            <div class="finance-balance-summary__amount">
              <dt>Current balance</dt>
              <dd><span aria-hidden="true">₱</span><strong><%= formatMoney(account.balance) %></strong></dd>
            </div>
          <% } %>
          <div class="finance-balance-summary__status">
            <dt>Account status</dt>
            <dd><span class="finance-status finance-account-status finance-account-status--<%= accountStatus %>"><%= accountStatus === 'not-created' ? 'Not created' : accountStatus === 'settled' ? 'Settled' : accountStatus === 'credit' ? 'Credit' : 'Due' %></span></dd>
          </div>
        </dl>
      </header>

      <% if (pendingEnrollments?.length) { %>
        <% const unclearedEnrollments = pendingEnrollments.filter((enrollment) => enrollment.clearance_status !== 'cleared'); %>
        <section class="finance-task-panel finance-clearance-task" aria-labelledby="finance-enrollment-clearance-title">
          <div class="finance-task-heading">
            <div>
              <h3 id="finance-enrollment-clearance-title">Payment clearance</h3>
              <p>Clearance is recorded for a specific enrollment. The account balance alone does not clear it.</p>
            </div>
          </div>
          <div class="finance-enrollment-list">
            <% for (const enrollment of pendingEnrollments) { %>
              <article class="finance-enrollment-item">
                <div class="finance-enrollment-item__context">
                  <p class="finance-enrollment-item__term"><%= enrollment.school_year %> · <%= enrollment.term %></p>
                  <strong><%= enrollment.section_name || 'No section' %></strong>
                </div>
                <span class="finance-status finance-clearance-status finance-clearance-status--<%= enrollment.clearance_status === 'cleared' ? 'cleared' : 'pending' %>"><%= enrollment.clearance_status === 'cleared' ? 'Cleared' : 'Pending' %></span>
                <% if (enrollment.clearance_status !== 'cleared') { %>
                  <form class="form-stack finance-clearance-followup" method="post" action="/finance/students/<%= student.student_id %>/enrollment-clearance<%= searchSuffix %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="enrollmentId" value="<%= enrollment.enrollment_id %>">
                    <% if (availableEnrollmentPayments?.length) { %>
                      <label class="field" for="payment-for-enrollment-<%= enrollment.enrollment_id %>">
                        <span>Unused recorded payment</span>
                        <select id="payment-for-enrollment-<%= enrollment.enrollment_id %>" name="paymentTransactionId" required>
                          <option value="">Choose a payment</option>
                          <% for (const payment of availableEnrollmentPayments) { %>
                            <option value="<%= payment.transaction_id %>">#<%= payment.transaction_id %> · ₱<%= formatMoney(payment.amount) %> · <%= payment.created_at ? new Date(payment.created_at).toLocaleString() : 'date unavailable' %><%= payment.reference_no ? ` · ${payment.reference_no}` : '' %></option>
                          <% } %>
                        </select>
                      </label>
                      <label class="checkbox-field"><input type="checkbox" name="confirmEnrollmentClearance" value="1" required><span>I confirm this payment satisfies eligibility for this specific enrollment.</span></label>
                      <button class="button button--secondary" type="submit">Assign payment and clear enrollment</button>
                    <% } else { %>
                      <p>No unused recorded payments are available for this student's account.</p>
                    <% } %>
                  </form>
                <% } %>
              </article>
            <% } %>
          </div>
        </section>
      <% } %>

      <% if (!account) { %>
        <section class="finance-task-panel finance-account-create">
          <h3>No financial account exists</h3>
          <% if (student.status === 'archived') { %>
            <p>A financial account cannot be created for an archived student record.</p>
          <% } else { %>
            <p>Create an account to begin recording charges, payments, and signed adjustments.</p>
            <form method="post" action="/finance/students/<%= student.student_id %>/account<%= searchSuffix %>" data-submitting-message="Creating the financial account. Please wait.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button--primary" type="submit">Create financial account</button>
            </form>
          <% } %>
        </section>
      <% } else { %>
        <section class="finance-task-panel finance-transaction-task" aria-labelledby="finance-entry-heading">
          <div class="finance-task-heading">
            <div>
              <h3 id="finance-entry-heading"><%= student.status === 'archived' ? 'Transactions are read-only' : 'Record a transaction' %></h3>
            </div>
          </div>
            <% if (student.status === 'archived') { %>
              <p>New transactions are disabled for archived student records.</p>
            <% } else { %>
            <form class="form-stack finance-entry" method="post" action="/finance/students/<%= student.student_id %>/transactions<%= searchSuffix %>" data-submitting-message="Recording the finance transaction. Please wait.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="field">
                <span>Transaction type</span>
                <select name="transactionType" required>
                  <option value="" <%= !transactionValues.transactionType ? 'selected' : '' %>>Choose a type</option>
                  <option value="charge" <%= transactionValues.transactionType === 'charge' ? 'selected' : '' %>>Charge (increases balance)</option>
                  <option value="payment" <%= transactionValues.transactionType === 'payment' ? 'selected' : '' %>>Payment (decreases balance)</option>
                  <option value="adjustment" <%= transactionValues.transactionType === 'adjustment' ? 'selected' : '' %>>Adjustment (signed amount)</option>
                </select>
              </label>
              <label class="field">
                <span>Amount (PHP)</span>
                <input type="text" name="amount" inputmode="decimal" maxlength="14" placeholder="1250.00 or -125.50" value="<%= transactionValues.amount %>" required aria-describedby="finance-amount-help">
                <small id="finance-amount-help">Use up to two decimal places. Adjustments may be positive or negative.</small>
              </label>
              <label class="field finance-entry__field--wide">
                <span>Description <span class="field__optional">(optional for charges and payments; required for adjustments)</span></span>
                <textarea class="finance-entry__description" name="description" rows="3" maxlength="500"><%= transactionValues.description %></textarea>
                <small>Adjustments require a description that explains the reason.</small>
              </label>
              <label class="field">
                <span>Reference number <span class="field__optional">(optional)</span></span>
                <input type="text" name="referenceNo" maxlength="100" value="<%= transactionValues.referenceNo %>">
                <small>A reference may be used once per account. SQL Server collation determines case matching.</small>
              </label>
              <% const unclearedEnrollments = pendingEnrollments.filter((enrollment) => enrollment.clearance_status !== 'cleared'); %>
              <% if (unclearedEnrollments.length) { %>
                <fieldset class="finance-enrollment-clearance-form finance-entry__clearance">
                  <legend>Optional enrollment clearance</legend>
                  <label class="field" for="clear-enrollment-id">
                    <span>Pending enrollment to clear</span>
                    <select id="clear-enrollment-id" name="clearEnrollmentId">
                      <option value="">Do not clear</option>
                      <% for (const enrollment of unclearedEnrollments) { %>
                        <option value="<%= enrollment.enrollment_id %>" <%= String(transactionValues.clearEnrollmentId || '') === String(enrollment.enrollment_id) ? 'selected' : '' %>><%= enrollment.school_year %> · <%= enrollment.term %> · <%= enrollment.section_name || 'No section' %></option>
                      <% } %>
                    </select>
                  </label>
                  <label class="checkbox-field"><input type="checkbox" name="confirmEnrollmentClearance" value="1" <%= transactionValues.confirmEnrollmentClearance === '1' ? 'checked' : '' %>><span>I confirm this recorded payment satisfies eligibility for the selected enrollment.</span></label>
                  <small>Only a payment tied to this selected pending enrollment can clear it. No school payment amount is assumed by the system.</small>
                </fieldset>
              <% } %>
              <button class="button button--primary" type="submit">Record transaction</button>
            </form>
            <% } %>
        </section>
        <section class="finance-task-panel finance-history-panel" aria-labelledby="finance-history-heading">
          <div class="finance-task-heading">
            <div>
              <h3 id="finance-history-heading">Recent transaction history</h3>
            </div>
            <% if (transactions.length) { %><p class="finance-caption">Latest 100 transactions</p><% } %>
          </div>
          <% if (!transactions.length) { %>
            <p class="finance-empty-copy">No transactions have been recorded.</p>
          <% } else { %>
            <div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable transaction history for <%= student.student_no %>">
              <table class="admin-table finance-table finance-history-table">
                <caption class="visually-hidden">Recent financial transactions for <%= student.student_no %></caption>
                <thead><tr><th scope="col">Date</th><th scope="col">Type</th><th scope="col">Amount</th><th scope="col">Description / reference</th><th scope="col">Recorded by</th></tr></thead>
                <tbody>
                  <% transactions.forEach((entry) => { %>
                    <tr>
                      <td data-label="Date"><%= entry.created_at ? new Date(entry.created_at).toLocaleString() : '' %></td>
                      <td data-label="Type"><%= entry.transaction_type ? entry.transaction_type.replaceAll('_', ' ').replace(/^\w/, (letter) => letter.toUpperCase()) : 'Unknown' %></td>
                      <td data-label="Amount">₱<%= formatMoney(entry.amount) %></td>
                      <td data-label="Description / reference"><%= [entry.description, entry.reference_no].filter(Boolean).join(' · ') || '—' %></td>
                      <td data-label="Recorded by"><%= entry.recorded_by_name %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      <% } %>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
