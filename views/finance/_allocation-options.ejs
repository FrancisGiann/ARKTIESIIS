<% const targetGroups = new Map(); for (const target of allocationTargets) { if (!targetGroups.has(target.group)) targetGroups.set(target.group, []); targetGroups.get(target.group).push(target); } %>
<% for (const [group, targets] of targetGroups) { %><optgroup label="<%= group %>"><% for (const target of targets) { %><option value="<%= target.value %>" data-balance="<%= target.balance %>" data-order="<%= target.order %>" title="<%= target.fullLabel %>" <%= target.value === selectedTarget ? 'selected' : '' %>><%= target.label %> · due ₱<%= formatMoney(target.balance) %></option><% } %></optgroup><% } %>
