<%- include('../partials/head', { title, pageStylesheet: '/css/finance-ui-followups.css' }) %>
<main class="page-shell finance-statement" id="main-content">
  <div class="statement-actions">
    <button class="button button--primary" type="button" data-print-statement>Print enrollment sheet</button>
    <% if (sheet.first_login_pending) { %><form method="post" action="/finance/students/<%= encodeURIComponent(sheet.student_id) %>/annual/<%= encodeURIComponent(sheet.annual_enrollment_id) %>/first-login-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button button--secondary" type="submit">Issue first-login password and print</button>
    </form><% } %>
  </div>
  <%- include('_enrollment-sheet-content', { sheet, formatMoney }) %>
</main>
<script src="/js/statement-print.js" defer></script>
<%- include('../partials/foot') %>
