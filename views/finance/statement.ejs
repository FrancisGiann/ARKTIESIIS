<%- include('../partials/head', { title }) %>
<% const hasNonzeroAmount = (amount) => Number.isFinite(Number(amount)) && Number(amount) !== 0; %>
<main class="page-shell finance-statement" id="main-content">
  <header class="statement-heading"><div><h1>Statement of Account</h1><p><strong><%= [ledger.student.first_name, ledger.student.middle_name, ledger.student.last_name, ledger.student.suffix].filter(Boolean).join(' ') %></strong> · Student no. <%= ledger.student.student_no %></p><p>Prepared <%= formatFinanceDateTime(new Date()) %></p></div><div class="statement-actions"><button class="button button--primary" type="button" data-print-statement>Print statement</button><a class="button button--secondary" href="<%= currentUser.role === 'student' ? '/student/finance' : `/finance/students/${ledger.student.id}/annual` %>"><%= currentUser.role === 'student' ? 'Back to fees & payments' : 'Back to student account' %></a></div></header>
  <p class="muted-copy">Balances are current as of this visit. Payment references show the current record and may have been updated; this statement does not generate an official receipt.</p>
  <section class="finance-panel" aria-labelledby="statement-summary-title"><h2 id="statement-summary-title">Balance summary</h2><dl class="finance-balance-summary">
    <div><dt>School-year balance · <%= ledger.summary.annualBalanceSchoolYear || 'current year' %></dt><dd>₱<%= formatMoney(ledger.summary.annualBalance) %></dd></div>
    <div><dt>All school-year fees due</dt><dd>₱<%= formatMoney(ledger.summary.allYearsAnnualBalance) %></dd></div>
    <% if (hasNonzeroAmount(ledger.summary.unattributedLegacyBalance) && (currentUser.role !== 'student' || ledger.summary.showPreviousAccountBalance)) { %><div><dt>Earlier account balance</dt><dd>₱<%= formatMoney(ledger.summary.unattributedLegacyBalance) %></dd></div><% } %>
    <% if (hasNonzeroAmount(ledger.summary.openingLiabilityDue) && (currentUser.role !== 'student' || ledger.summary.showPreviouslyConfirmedBalance)) { %><div><dt>Confirmed previous balance</dt><dd>₱<%= formatMoney(ledger.summary.openingLiabilityDue) %></dd></div><% } %>
    <div><dt>Combined account balance</dt><dd>₱<%= formatMoney(ledger.summary.totalBalance) %></dd></div>
    <div><dt>Current term due</dt><dd>₱<%= formatMoney(ledger.summary.currentTermOutstanding) %></dd></div>
    <div><dt>Earlier term/year due</dt><dd>₱<%= formatMoney(ledger.summary.priorTermYearDebt) %></dd></div>
    <div><dt>Unused payment credit</dt><dd>₱<%= formatMoney(ledger.summary.availableCredit) %></dd></div>
  </dl></section>
  <section class="finance-panel" aria-labelledby="statement-charges-title"><h2 id="statement-charges-title">Fee breakdown</h2>
    <p>An approved waiver or exemption reduces the assessed fee. Voucher rates are already reflected in the schedule and are not deducted again.</p>
    <% if (ledger.feeBreakdownYears?.length) { %><%- include('../partials/finance-fee-breakdown', { ledger, years: ledger.feeBreakdownYears, staffOnlyDetails: false, openAllYears: true, tableClass: 'admin-table' }) %><% } else { %><p>No school-year fees have been assessed.</p><% } %>
  </section>
  <section class="finance-panel" aria-labelledby="statement-history-title"><div class="admin-section__heading"><div><h2 id="statement-history-title">Account history</h2><p><%= ledger.events.length %> entries in date order.</p></div></div>
    <% if (ledger.events.length) { %><div class="table-scroll"><table class="admin-table"><thead><tr><th>Date</th><th>Entry</th><th>Details</th><th>Current reference</th><th>Amount / snapshot</th><th>Confirmation</th></tr></thead><tbody><% for (const event of ledger.events) { %><tr><td data-label="Date"><%= event.event_type === 'payment' ? String(event.event_date).slice(0, 10) : formatFinanceDateTime(event.event_date) %></td><td data-label="Entry"><%= event.display_label || 'Account update' %></td><td data-label="Details"><%= event.details || '—' %></td><td data-label="Current reference"><%= event.reference_no || '—' %></td><td data-label="Amount / snapshot"><%= event.amount == null ? '—' : `₱${formatMoney(event.amount)}` %></td><td data-label="Confirmation"><% if (event.event_type === 'payment') { %><a href="<%= currentUser.role === 'student' ? `/student/finance/payments/${event.source_id}/confirmation` : `/finance/students/${ledger.student.id}/annual/payments/${event.source_id}/confirmation` %>">Open payment confirmation</a><% } else if (event.event_type === 'unattributed legacy payment') { %><a href="<%= currentUser.role === 'student' ? `/student/finance/legacy-payments/${event.source_id}/confirmation` : `/finance/students/${ledger.student.id}/legacy/payments/${event.source_id}/confirmation` %>">Open payment confirmation</a><% } else { %>—<% } %></td></tr><% } %></tbody></table></div><% } else { %><p>No financial history has been recorded.</p><% } %>
  </section>
</main>
<script src="/js/statement-print.js" defer></script>
<%- include('../partials/foot') %>
