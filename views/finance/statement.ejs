<%- include('../partials/head', { title }) %>
<main class="page-shell finance-statement" id="main-content">
  <header class="statement-heading"><div><h1>Statement of Account</h1><p><strong><%= [ledger.student.first_name, ledger.student.middle_name, ledger.student.last_name, ledger.student.suffix].filter(Boolean).join(' ') %></strong> · Student no. <%= ledger.student.student_no %></p><p>Prepared <%= formatFinanceDateTime(new Date()) %></p></div><div class="statement-actions"><button class="button button--primary" type="button" data-print-statement>Print statement</button><a class="button button--secondary" href="<%= currentUser.role === 'student' ? '/student/finance' : `/finance/students/${ledger.student.id}/annual` %>">Back to finance account</a></div></header>
  <p class="muted-copy">Balances are current as of this visit. Payment references show the current record and may have been updated; this statement does not generate an official receipt.</p>
  <section class="finance-panel" aria-labelledby="statement-summary-title"><h2 id="statement-summary-title">Balance summary</h2><dl class="finance-balance-summary">
    <div><dt>Annual balance · <%= ledger.summary.annualBalanceSchoolYear || 'current year' %></dt><dd>₱<%= formatMoney(ledger.summary.annualBalance) %></dd></div>
    <div><dt>All annual years</dt><dd>₱<%= formatMoney(ledger.summary.allYearsAnnualBalance) %></dd></div>
    <div><dt>Unattributed legacy balance</dt><dd>₱<%= formatMoney(ledger.summary.unattributedLegacyBalance) %></dd></div>
    <div><dt>Verified opening liability</dt><dd>₱<%= formatMoney(ledger.summary.openingLiabilityDue) %></dd></div>
    <div><dt>Combined balance</dt><dd>₱<%= formatMoney(ledger.summary.totalBalance) %></dd></div>
    <div><dt>Current term due</dt><dd>₱<%= formatMoney(ledger.summary.currentTermOutstanding) %></dd></div>
    <div><dt>Prior term/year debt</dt><dd>₱<%= formatMoney(ledger.summary.priorTermYearDebt) %></dd></div>
    <div><dt>Available credit</dt><dd>₱<%= formatMoney(ledger.summary.availableCredit) %></dd></div>
  </dl></section>
  <section class="finance-panel" aria-labelledby="statement-term-balances-title"><h2 id="statement-term-balances-title">Required, applied, and due by term and installment</h2>
    <% if ((ledger.termBalances || []).length) { %><div class="table-scroll"><table class="admin-table"><thead><tr><th>Year · term</th><th>Installment</th><th>Required</th><th>Applied</th><th>Due now</th></tr></thead><tbody>
      <% for (const row of ledger.termBalances) { %><tr><td data-label="Year · term"><%= row.school_year %> · <%= row.term %></td><td data-label="Installment"><%= row.installment %></td><td data-label="Required">₱<%= row.required %></td><td data-label="Applied">₱<%= row.applied %></td><td data-label="Due now">₱<%= row.due %></td></tr><% } %>
    </tbody></table></div><% } else { %><p>No assessed term fees are available.</p><% } %>
  </section>
  <section class="finance-panel" aria-labelledby="statement-charges-title"><h2 id="statement-charges-title">Charges, adjustments, and allocations</h2>
    <% if (ledger.charges.length) { %><div class="table-scroll"><table class="admin-table"><thead><tr><th>Year · term</th><th>Fee / installment</th><th>Required</th><th>Applied</th><th>Due now</th></tr></thead><tbody><% for (const charge of ledger.charges) { %><tr><td data-label="Year · term"><%= charge.school_year %> · <%= charge.term %></td><td data-label="Fee / installment"><%= charge.line_name %> · <%= charge.installment %></td><td data-label="Required">₱<%= charge.required_amount %></td><td data-label="Applied">₱<%= charge.applied_amount %></td><td data-label="Due now">₱<%= charge.due_amount %></td></tr><% } %></tbody></table></div><% } else { %><p>No annual charges recorded.</p><% } %>
  </section>
  <section class="finance-panel" aria-labelledby="statement-history-title"><div class="admin-section__heading"><div><h2 id="statement-history-title">Account history</h2><p><%= ledger.events.length %> entries in date order.</p></div></div>
    <% if (ledger.events.length) { %><div class="table-scroll"><table class="admin-table"><thead><tr><th>Date</th><th>Entry</th><th>Details</th><th>Current reference</th><th>Amount / snapshot</th><th>Confirmation</th></tr></thead><tbody><% for (const event of ledger.events) { %><tr><td data-label="Date"><%= event.event_type === 'payment' ? String(event.event_date).slice(0, 10) : formatFinanceDateTime(event.event_date) %></td><td data-label="Entry"><%= event.event_type.replaceAll('_', ' ') %></td><td data-label="Details"><%= event.details || '—' %></td><td data-label="Current reference"><%= event.reference_no || '—' %></td><td data-label="Amount / snapshot"><%= event.amount == null ? '—' : `₱${formatMoney(event.amount)}` %></td><td data-label="Confirmation"><% if (event.event_type === 'payment') { %><a href="<%= currentUser.role === 'student' ? `/student/finance/payments/${event.source_id}/confirmation` : `/finance/students/${ledger.student.id}/annual/payments/${event.source_id}/confirmation` %>">Open payment confirmation</a><% } else if (event.event_type === 'unattributed legacy payment') { %><a href="<%= currentUser.role === 'student' ? `/student/finance/legacy-payments/${event.source_id}/confirmation` : `/finance/students/${ledger.student.id}/legacy/payments/${event.source_id}/confirmation` %>">Open legacy payment confirmation</a><% } else { %>—<% } %></td></tr><% } %></tbody></table></div><% } else { %><p>No financial history has been recorded.</p><% } %>
  </section>
</main>
<script src="/js/statement-print.js" defer></script>
<%- include('../partials/foot') %>
