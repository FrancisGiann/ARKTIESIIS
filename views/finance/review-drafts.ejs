<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page finance-review-page" id="main-content">
  <a class="context-back" href="/finance/overview">Back to Finance overview</a>
  <header class="dashboard-heading">
    <div><p class="eyebrow">Your saved work</p><h1>Unfinished reviews</h1><p>Resume an update you saved, check its current details, then finish it.</p></div>
    <a class="button button--secondary" href="/finance">Student accounts</a>
  </header>
  <section class="finance-panel" aria-labelledby="saved-review-title">
    <div class="admin-section__heading"><div><h2 id="saved-review-title">Your unfinished reviews</h2><p>These saved changes are private to your account and remain available after sign out.</p></div></div>
    <% if (drafts.length) { %>
      <ul class="finance-review-list">
        <% for (const draft of drafts) { %>
          <li>
            <div><strong><%= actionLabel(draft.actionType) %></strong>
              <% if (draft.studentName) { %><span><%= draft.studentName %><% if (draft.studentNumber) { %> · <%= draft.studentNumber %><% } %></span><% } %>
              <% if (draft.scheduleContext) { %><span><%= draft.scheduleContext %></span><% } %>
              <% if (draft.amount) { %><span>₱<%= draft.amount.replace(/^₱/, '') %></span><% } %>
              <span>Updated <%= formatFinanceDateTime(draft.updatedAt) %></span></div>
            <% if (isRetiredAction(draft.actionType)) { %>
              <form method="post" action="/finance/review-drafts/<%= encodeURIComponent(draft.id) %>/discard">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="button button--secondary" type="submit">Discard retired review</button>
              </form>
            <% } else { %>
              <a class="button button--secondary" href="/finance/review-drafts/<%= encodeURIComponent(draft.id) %>">Resume review</a>
            <% } %>
          </li>
        <% } %>
      </ul>
    <% } else { %>
      <p class="dashboard-empty" role="status">You have no unfinished reviews.</p>
    <% } %>
  </section>
</main>
<%- include('../partials/foot') %>
