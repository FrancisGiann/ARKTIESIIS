<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page finance-review-page" id="main-content">
  <a class="context-back" href="/finance/review-drafts" aria-label="Back to unfinished reviews" title="Back to unfinished reviews">&#8592;</a>
  <header class="dashboard-heading">
    <div><p class="eyebrow">Finance · Review before saving</p><h1><%= actionLabel %></h1><p>Check the complete update below. Saving applies it once and records the reviewed result together.</p></div>
  </header>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (previewUnavailable) { %>
    <p class="form-alert" role="status">The current record could not be validated against this saved review. Your pending draft and values are retained; wait until the record is available, then reload for a fresh review, or discard it.</p>
  <% } else if (status === 409 || draft.requiresReview) { %>
    <p class="form-alert" role="status">The session or current Finance records changed. Read the updated details before saving.</p>
  <% } %>

  <section class="finance-review-summary finance-panel" aria-labelledby="review-summary-title">
    <div class="finance-review-summary__heading">
    <div><h2 id="review-summary-title">Review details</h2><p>Check the saved record, every fee decision, and each amount before saving.</p></div>
      <% if (draft.preview.student) { %>
        <div class="finance-review-student"><strong><%= draft.preview.student.name %></strong><span><%= draft.preview.student.studentNumber || 'Student number unavailable' %></span></div>
      <% } %>
    </div>

    <% if (draft.preview.schoolYear || draft.preview.gradeLevel || draft.preview.voucherCode) { %>
      <p class="finance-review-context"><%= [draft.preview.schoolYear, draft.preview.gradeLevel, draft.preview.voucherCode].filter(Boolean).join(' · ') %></p>
    <% } %>
    <% if (draft.preview.activeSchedule) { %>
      <p class="finance-review-context">Active schedule version at review: <strong><%= draft.preview.activeSchedule.version %></strong></p>
    <% } %>
    <% if (draft.preview.targetDetails?.length) { %>
      <dl class="finance-review-fields finance-review-targets" aria-label="Current record being updated">
        <% for (const target of draft.preview.targetDetails) { %><div><dt><%= target.label %></dt><dd><%= target.label === 'Stopped or transferred review' ? String(target.value).replace(/\bdropped\b/gi, 'stopped') : target.value %></dd></div><% } %>
      </dl>
    <% } %>
    <% if (draft.preview.feeAdjustment) { const correction = draft.preview.feeAdjustment; %>
      <section class="finance-review-fields" aria-label="Projected fee correction">
        <h2>Fee basis and credit release</h2>
        <p>Fee basis is the assessed charge plus all recorded adjustments, including approved coverage once.</p>
        <% if (correction.warning) { %><p class="form-alert" role="status"><%= correction.warning %></p><% } %>
        <dl class="finance-review-fields">
          <div><dt>Fee basis before</dt><dd>₱<%= correction.feeBasisBefore %></dd></div>
          <div><dt>Fee basis after</dt><dd>₱<%= correction.feeBasisAfter %></dd></div>
          <div><dt>Remaining due before</dt><dd>₱<%= correction.currentDue %></dd></div>
          <div><dt>Projected remaining due</dt><dd>₱<%= correction.projectedDue %></dd></div>
          <div><dt>Planned release to account credit</dt><dd>₱<%= correction.plannedRelease %></dd></div>
          <div><dt>Annual payment applications released</dt><dd>₱<%= correction.annualRelease %></dd></div>
          <div><dt>Eligible legacy reconciliations released</dt><dd>₱<%= correction.legacyRelease %></dd></div>
        </dl>
      </section>
    <% } %>

    <% if (draft.actionType === 'retake_item_decision' && draft.preview.retakeDecision) { const retake = draft.preview.retakeDecision; %>
      <section class="finance-review-fields" aria-label="Retake item Finance decision">
        <h2>Retake item decision</h2>
        <% if (retake.decision === 'no_charge') { %>
          <p>No supplementary charge will be created. The saved decision includes the Finance reason below.</p>
        <% } else { %>
          <p>The approved amount is the gross charge. The existing approved-exemption rules apply once through the supplementary-charge process; the voucher rate is not applied again.</p>
          <dl class="finance-review-fields">
            <div><dt>Charge description</dt><dd><%= retake.chargeDescription %></dd></div>
            <div><dt>Approved gross amount</dt><dd>₱<%= retake.charge.grossAmount %></dd></div>
            <div><dt>Approved exemption applied</dt><dd>₱<%= retake.charge.approvedExemption %></dd></div>
            <div><dt>Resulting payable amount</dt><dd>₱<%= retake.charge.payableAmount %></dd></div>
          </dl>
        <% } %>
      </section>
    <% } %>

  <% if (draft.preview.cashAmount) { %>
      <ol class="finance-payment-wizard__steps finance-payment-wizard__steps--review" aria-label="Payment steps"><li>1. Details</li><li>2. Apply payment</li><li aria-current="step">3. Review</li><li>4. Saved</li></ol>
      <dl class="finance-review-totals">
        <div><dt>Payment amount</dt><dd>₱<%= draft.preview.cashAmount %></dd></div>
        <div><dt>Applied to balances</dt><dd>₱<%= draft.preview.appliedAmount || '0.00' %></dd></div>
        <div><dt>Unused payment credit remaining</dt><dd>₱<%= draft.preview.unallocatedCredit || '0.00' %></dd></div>
      </dl>
    <% } %>

    <% if (draft.preview.allocationRows?.length) { %>
      <div class="table-scroll finance-review-table" tabindex="0" aria-label="Reviewed payment purposes and applications">
        <table class="admin-table"><caption>Payment purposes and amounts</caption><thead><tr><th>Fee / payment purpose</th><th>Current fee balance</th><th>Amount applied</th><th>Projected balance after payment</th></tr></thead>
          <tbody><% for (const row of draft.preview.allocationRows) { %><tr><td data-label="Fee / payment purpose"><%= row.targetReference %></td><td data-label="Current fee balance"><%= row.dueBefore == null ? 'Unavailable' : `₱${row.dueBefore}` %><% if (row.feeContext) { %><br><span class="muted-copy"><%= row.feeContext %></span><% } %></td><td data-label="Amount applied">₱<%= row.amount %></td><td data-label="Projected balance after payment"><%= row.dueAfter == null ? 'Unavailable' : `₱${row.dueAfter}` %></td></tr><% } %></tbody>
        </table>
      </div>
    <% } else if (draft.actionType === 'annual_payment') { %>
      <p class="finance-review-empty-note">No balance is selected. Any amount not applied remains as unused payment credit.</p>
    <% } %>

    <% if (draft.preview.schedule?.lines?.length) { %>
      <div class="table-scroll finance-review-table" tabindex="0" aria-label="Fee lines in the active schedule">
        <table class="admin-table"><caption>Approved fee schedule · Version <%= draft.preview.schedule.version %></caption><thead><tr><th>Term</th><th>Fee</th><th>Installment</th><th>Amount</th><th>Included</th></tr></thead>
          <tbody><% for (const line of draft.preview.schedule.lines) { %><tr><td data-label="Term">Term <%= line.term %></td><td data-label="Fee"><%= line.fee %></td><td data-label="Installment"><%= line.installment %></td><td data-label="Amount">₱<%= line.amount %></td><td data-label="Included"><%= line.selected ? 'Yes' : 'No' %></td></tr><% } %></tbody>
        </table>
      </div>
    <% } %>
    <% if (draft.actionType === 'annual_assessment' && draft.preview.annualHandoffRequired) { %>
      <section class="finance-review-fields" aria-label="Annual enrollment payment handoff">
        <h2>Enrollment handoff</h2>
        <p>Entry term: <strong>Term <%= draft.preview.entryTermNumber || 1 %></strong>. The Registrar can confirm enrollment after this assessment has been reviewed and the full scheduled tuition DP for this term is settled.</p>
        <p>Only eligible allocations to the entry-term DP count. Unallocated or unrelated account credit does not satisfy it. The full annual balance is not required here.</p>
        <p>If the entry-term tuition DP is truly zero after approved waivers, explicitly approve that zero case below. Missing DP setup or an incomplete ledger will be blocked.</p>
      </section>
    <% } %>

    <% if (draft.preview.scheduleLines?.length) { %>
      <div class="table-scroll finance-review-table" tabindex="0" aria-label="Fee schedule version being created">
        <table class="admin-table"><caption>Student-payable amounts in this new version</caption><thead><tr><th>Term</th><th>Fee</th><th>Installment</th><th>Amount</th><th>Optional</th></tr></thead>
          <tbody><% for (const line of draft.preview.scheduleLines) { %><tr><td data-label="Term">Term <%= line.term %></td><td data-label="Fee"><%= line.fee %></td><td data-label="Installment"><%= line.installment %></td><td data-label="Amount">₱<%= line.amount %></td><td data-label="Optional"><%= line.optional ? 'Yes' : 'No' %></td></tr><% } %></tbody>
        </table>
      </div>
    <% } %>

    <% if (draft.preview.exemptionRules?.length) { %>
      <div class="table-scroll finance-review-table" tabindex="0" aria-label="Reviewed exemption coverage rules">
        <table class="admin-table"><caption>Exemption coverage</caption><thead><tr><th>Term</th><th>Coverage</th><th>Approved amount</th></tr></thead>
          <tbody><% for (const rule of draft.preview.exemptionRules) { %><tr><td data-label="Term">Term <%= rule.term %></td><td data-label="Coverage"><%= rule.coverage %></td><td data-label="Approved amount"><%= rule.amount === 'Full coverage' ? rule.amount : `₱${rule.amount}` %></td></tr><% } %></tbody>
        </table>
      </div>
    <% } %>

    <% if (draft.actionType === 'departure_review') { %>
      <section class="finance-review-fields" aria-label="Tuition cutoff evidence">
        <h2>Departure tuition cutoff</h2>
        <p>The departure term comes from the saved Registrar placement: <strong><%= draft.preview.departureTermNumber ? `Term ${draft.preview.departureTermNumber}` : 'Placement unavailable' %></strong>. The cutoff records the last tuition installment payable in that term.</p>
        <p><strong>Last payable tuition installment:</strong> <%= ({ dp: 'DP', prelim: 'Prelim', midterm: 'Midterm', finals: 'Finals', none: 'None payable' })[String(draft.preview.departureLastPayableInstallment || '').toLowerCase()] || 'Not recorded' %></p>
        <p>Full departure-term tuition is kept by default. Later recorded tuition installments with no applied payment are proposed for cancellation. Check the amounts before saving; other fees and charges with payment history need an individual decision.</p>
        <% if (!draft.preview.departureReviewReady) { %><p class="form-alert" role="status">Review fees still needing a decision and enter an overall Finance reason. Saving records the confirmed amounts once.</p><% } %>
      </section>
      <% if (draft.preview.departureChargeReviews?.length) { %>
        <div class="finance-review-departure-preview" aria-label="Reviewed fees and proposed departure charge changes">
          <% for (const termNumber of [1, 2, 3]) { const termItems = draft.preview.departureChargeReviews.filter((item) => Number(item.termNumber) === termNumber); if (!termItems.length) continue; const pendingDecisions = termItems.filter((item) => !['retain', 'reduce'].includes(item.decision)).length; %>
            <% const termNeedsCorrection = termItems.some((item) => item.keepAmountNeedsCorrection || (item.decision === 'reduce' && !item.reviewedReductionReady)); %>
            <details class="finance-review-departure-term" <%= (termNeedsCorrection || (draft.preview.departureReviewReady === true && termNumber === Number(draft.preview.departureTermNumber))) ? 'open' : '' %>>
              <summary><strong>Term <%= termNumber %> · <%= termItems.length %> fee<%= termItems.length === 1 ? '' : 's' %></strong><span><%= pendingDecisions ? `${pendingDecisions} decision${pendingDecisions === 1 ? '' : 's'} pending` : 'All decisions recorded' %></span></summary>
              <div class="finance-review-departure-term__fees">
                <% for (const item of termItems) { %>
                  <% const itemCategory = String(item.feeCategory || '').trim(); const itemLineName = String(item.lineName || '').trim(); const itemTitle = itemLineName && itemCategory.toLowerCase() === itemLineName.toLowerCase() ? itemLineName : [itemCategory, itemLineName].filter(Boolean).join(' · ') || item.fee; %>
                  <article class="finance-review-departure-fee">
                    <h3><%= itemTitle %><% if (item.installment) { %> · <%= item.installment %><% } %></h3>
                    <dl class="finance-review-departure-amounts">
                      <div><dt>Current payable</dt><dd>₱<%= item.payableBefore %></dd></div>
                      <div class="finance-review-departure-amounts__proposal"><dt>Suggested amount to cancel or adjust</dt><dd>₱<%= item.proposedReduction %></dd></div>
                    </dl>
                    <dl class="finance-review-fields">
                      <% if (item.reviewCategory !== 'canonical_tuition' && !(item.reviewCategory == null && itemCategory.toLowerCase() === 'tuition' && itemLineName.toLowerCase() === 'tuition')) { %><div><dt>Classification</dt><dd><%= item.reviewCategory === 'manual_tuition' ? 'Whole-term / noncanonical · manual review' : item.categoryLabel %></dd></div><% } %>
                      <div><dt>Finance decision</dt><dd><%= item.decision === 'retain' ? 'Keep payable amount' : item.decision === 'reduce' ? 'Cancel or adjust charge' : 'Needs individual review' %></dd></div>
                      <div><dt>Reviewed change to charge</dt><dd><%= item.reviewedReductionReady ? `₱${item.reductionAmount}` : 'Pending' %></dd></div>
                      <div><dt>Payable after review</dt><dd><%= !item.reviewedReductionReady || item.payableAfter == null ? 'Review required' : `₱${item.payableAfter}` %></dd></div>
                      <div><dt>Finance reason</dt><dd><%= item.reason || 'Overall reason required' %></dd></div>
                    </dl>
                  </article>
                <% } %>
              </div>
            </details>
          <% } %>
        </div>
      <% } else { %><p class="finance-review-empty-note">No assessed charges are linked to the saved departure placements. The Finance review still records the explicit tuition cutoff.</p><% } %>
    <% } %>

    <% if (previewFields.length) { %>
      <dl class="finance-review-fields"><% for (const field of previewFields) { %><div><dt><%= field.name %></dt><dd><%= Array.isArray(field.value) ? field.value.join(', ') : field.value %></dd></div><% } %></dl>
    <% } %>
  </section>

  <details class="finance-review-edit finance-panel" <%= draft.actionType === 'departure_review' && draft.preview.departureReviewReady !== true ? 'open' : '' %>>
    <summary>Edit saved details</summary>
    <div class="finance-review-edit__body">
      <p>Changing a value saves an updated draft. Review the summary again before saving.</p>
      <form class="form-stack" method="post" action="/finance/review-drafts/<%= encodeURIComponent(draft.id) %>/update"<% if (recoveredForm) { %> data-unsaved-initially-dirty="true"<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% for (const field of editorFields) { %>
          <% if (field.kind === 'select') { %>
            <label class="field"><span><%= field.label %></span><select name="field_<%= field.name %>" <%= draft.actionType === 'departure_review' && field.name === 'cutoffInstallment' ? '' : 'required' %>>
              <option value="">Choose <%= field.label.toLowerCase() %></option>
              <% for (const option of field.options || []) { %><option value="<%= option.value %>" <%= String(option.value) === String(field.value) ? 'selected' : '' %>><%= option.label %></option><% } %>
            </select></label>
          <% } else if (field.kind === 'scalar') { %>
            <% if (draft.actionType === 'departure_review' && field.name === 'reason' && draft.preview.registrarDepartureReason) { %>
              <div class="finance-review-context finance-review-registrar-context" role="note">
                <strong>Registrar’s recorded reason · read-only</strong>
                <p><%= draft.preview.registrarDepartureReason %></p>
                <p>Use this as context; enter the required Finance review reason separately.</p>
              </div>
            <% } %>
            <label class="field"><span><%= field.label %></span>
              <% if (field.boolean) { %>
                <select name="field_<%= field.name %>"><option value="1" <%= field.value ? 'selected' : '' %>>Yes</option><option value="0" <%= field.value ? '' : 'selected' %>>No</option></select>
              <% } else if (field.multiline) { %>
                <textarea name="field_<%= field.name %>" rows="3" maxlength="<%= draft.actionType === 'departure_review' && field.name === 'reason' ? '1000' : '2000' %>"><%= field.value ?? '' %></textarea>
              <% } else { %>
                <input name="field_<%= field.name %>" value="<%= field.value ?? '' %>" maxlength="1000">
              <% } %>
            </label>
          <% } else if (field.kind === 'schedule') { %>
            <fieldset class="finance-review-row-editor finance-review-schedule-editor"><legend><%= field.label %></legend>
              <p>Update tuition one term at a time. The school year, grade, and voucher stay with this saved review.</p>
              <% for (const termNumber of [1, 2, 3]) { const termLines = field.lines.filter((line) => Number(line.termNumber) === termNumber); %>
                <details class="finance-review-term-editor" <%= termNumber === 1 ? 'open' : '' %>><summary>Term <%= termNumber %> · <%= termLines.length %> fee line<%= termLines.length === 1 ? '' : 's' %></summary>
                  <% for (const line of termLines) { const tuition = String(line.feeCategory).toLowerCase() === 'tuition' && String(line.lineName).trim().toLowerCase() === 'tuition' && ['dp','prelim','midterm','finals'].includes(String(line.installment).trim().toLowerCase()); %>
                    <% if (tuition) { %>
                      <label class="field"><span><%= line.installment %> tuition · PHP</span><input name="item_lines_<%= line.index %>_amount" value="<%= line.amount ?? '' %>" inputmode="decimal" maxlength="14" required></label>
                    <% } else { %>
                      <div class="finance-review-fee-line"><strong><%= line.lineName || 'Additional fee' %></strong><label class="field"><span>Category</span><select name="item_lines_<%= line.index %>_feeCategory"><% for (const category of ['tuition','miscellaneous','uniform','id','activity','retake','other']) { %><option value="<%= category %>" <%= line.feeCategory === category ? 'selected' : '' %>><%= category %></option><% } %></select></label>
                        <label class="field"><span>Fee name</span><input name="item_lines_<%= line.index %>_lineName" value="<%= line.lineName ?? '' %>" maxlength="120" required></label>
                        <label class="field"><span>Installment</span><input name="item_lines_<%= line.index %>_installment" value="<%= line.installment ?? '' %>" maxlength="40" required></label>
                        <label class="field"><span>Amount (PHP)</span><input name="item_lines_<%= line.index %>_amount" value="<%= line.amount ?? '' %>" inputmode="decimal" maxlength="14" required></label>
                        <label class="field"><span>Selection</span><select name="item_lines_<%= line.index %>_isOptional"><option value="0" <%= line.isOptional ? '' : 'selected' %>>Required</option><option value="1" <%= line.isOptional ? 'selected' : '' %>>Optional</option></select></label>
                      </div>
                    <% } %>
                  <% } %>
                </details>
              <% } %>
              <details class="finance-review-term-editor"><summary>Add an additional fee</summary>
                <% const index = field.lines.length; %>
                <label class="field"><span>Term</span><select name="item_lines_<%= index %>_termNumber"><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option></select></label>
                <label class="field"><span>Category</span><select name="item_lines_<%= index %>_feeCategory"><option value="">Choose category</option><% for (const category of ['tuition','miscellaneous','uniform','id','activity','retake','other']) { %><option value="<%= category %>"><%= category %></option><% } %></select></label>
                <label class="field"><span>Fee name</span><input name="item_lines_<%= index %>_lineName" maxlength="120"></label>
                <label class="field"><span>Installment</span><input name="item_lines_<%= index %>_installment" maxlength="40"></label>
                <label class="field"><span>Amount (PHP)</span><input name="item_lines_<%= index %>_amount" inputmode="decimal" maxlength="14"></label>
                <label class="field"><span>Selection</span><select name="item_lines_<%= index %>_isOptional"><option value="0" selected>Required</option><option value="1">Optional</option></select></label>
              </details>
            </fieldset>
          <% } else if (field.kind === 'departure-charges') { %>
            <fieldset class="finance-review-row-editor finance-review-departure-editor"><legend><%= field.label %></legend>
              <p>Later unpaid tuition installments are prefilled for cancellation; attended-term tuition stays payable. Other fees and charges with applied payments require an individual decision. Confirm every amount before saving. No payment or receipt is deleted.</p>
              <% for (const termNumber of [1, 2, 3]) { const termRows = field.rows.filter((row) => Number(row.termNumber) === termNumber); if (!termRows.length) continue; %>
                <% const termNeedsCorrection = termRows.some((row) => row.keepAmountNeedsCorrection
                  || (row.decision === 'reduce' && !row.reviewedReductionReady)
                  || (typeof row.reason === 'string' && (row.reason.length > 1000 || /[\u0000-\u001f\u007f]/.test(row.reason)))); %>
                <details class="finance-review-term-editor" <%= termNumber === Number(draft.preview.departureTermNumber) || termNeedsCorrection ? 'open' : '' %>><summary>Term <%= termNumber %> · <%= termRows.length %> fee<%= termRows.length === 1 ? '' : 's' %></summary>
                  <% for (const row of termRows) { %>
                    <% const rowCategory = String(row.feeCategory || '').trim(); const rowLineName = String(row.lineName || '').trim(); const rowTitle = rowLineName && rowCategory.toLowerCase() === rowLineName.toLowerCase() ? rowLineName : [rowCategory, rowLineName].filter(Boolean).join(' · '); %>
                    <div class="finance-review-fee-line" data-departure-charge-review data-canonical-tuition="<%= row.reviewCategory === 'canonical_tuition' ? 'true' : 'false' %>" data-keep-amount-needs-correction="<%= row.keepAmountNeedsCorrection ? 'true' : 'false' %>">
                      <h3><%= rowTitle || 'Fee' %><% if (row.installment) { %> · <%= row.installment %><% } %></h3>
                      <% if (row.reviewCategory !== 'canonical_tuition' && !(row.reviewCategory == null && rowCategory.toLowerCase() === 'tuition' && rowLineName.toLowerCase() === 'tuition')) { %><p class="finance-review-departure-classification"><%= row.reviewCategory === 'manual_tuition' ? 'Whole-term / noncanonical · manual review' : row.categoryLabel %></p><% } %>
                      <dl class="finance-review-departure-amounts">
                        <div><dt>Current payable</dt><dd>₱<%= row.payableBefore %></dd></div>
                        <div class="finance-review-departure-amounts__proposal"><dt>Suggested amount to cancel or adjust</dt><dd>₱<%= row.proposedReduction %></dd></div>
                      </dl>
                      <% if (row.automaticSuggestion) { %><p class="finance-review-departure-classification">Prefilled from the saved departure term and current unpaid tuition; confirm before saving.</p><% }
                         else if (row.reviewCategory !== 'canonical_tuition' || row.appliedAmount == null || Number(row.appliedAmount) > 0) { %><p class="finance-review-departure-classification">Individual review required<% if (row.appliedAmount != null && Number(row.appliedAmount) > 0) { %> · ₱<%= row.appliedAmount %> already applied<% } %>.</p><% } %>
                      <fieldset class="finance-review-decision"><legend>Finance decision</legend>
                        <label><input type="radio" name="item_chargeReviews_<%= row.index %>_decision" value="retain" <%= row.decision === 'retain' ? 'checked' : '' %>> Keep payable amount</label>
                        <label><input type="radio" name="item_chargeReviews_<%= row.index %>_decision" value="reduce" <%= row.decision === 'reduce' ? 'checked' : '' %>> Cancel or adjust charge</label>
                      </fieldset>
                      <div class="finance-review-reduction" data-departure-reduction-field>
                        <label class="field"><span>Amount to cancel or adjust (PHP)</span><input name="item_chargeReviews_<%= row.index %>_reductionAmount" value="<%= row.reductionAmount ?? '' %>" inputmode="decimal" maxlength="14" aria-describedby="departure-reduction-help-<%= row.index %> departure-reduction-error-<%= row.index %>"></label>
                        <p id="departure-reduction-help-<%= row.index %>" class="finance-review-reduction-help">Required when adjusting. Keep uses 0.00; clear any entered amount or enter 0.00.</p>
                        <p id="departure-reduction-error-<%= row.index %>" class="finance-review-reduction-error" data-keep-amount-error <%= row.keepAmountNeedsCorrection ? '' : 'hidden' %>>A Keep decision must have a blank amount or 0.00.</p>
                      </div>
                      <details class="finance-review-specific-reason" <%= row.reason ? 'open' : '' %>>
                        <summary><%= row.reason ? 'Specific reason' : 'Add a specific reason' %></summary>
                        <p>When blank, the overall Finance reason applies.</p>
                        <label class="field"><span>Reason for this fee</span><textarea name="item_chargeReviews_<%= row.index %>_reason" rows="2" maxlength="1000"><%= row.reason ?? '' %></textarea></label>
                      </details>
                    </div>
                  <% } %>
                </details>
              <% } %>
            </fieldset>
          <% } else if (field.kind === 'rows') { %>
            <fieldset class="finance-review-row-editor"><legend><%= field.label %></legend>
              <div class="finance-review-row-editor__grid">
                <% for (let index = 0; index <= field.rows.length; index += 1) { const row = field.rows[index] || {}; %>
                  <div class="finance-review-row-editor__row"><h3><%= field.label %> <%= index + 1 %><% if (index === field.rows.length) { %> · Add row<% } %></h3>
                    <% for (const property of field.properties) { %>
                      <label class="field"><span><%= property.label %></span>
                        <% if (property.options) { %>
                          <select name="item_<%= field.name %>_<%= index %>_<%= property.key %>"><option value="">Choose a balance or charge</option><% for (const option of property.options) { %><option value="<%= option.value %>" <%= String(row[property.key] || '') === String(option.value) ? 'selected' : '' %>><%= option.label %> · due ₱<%= option.balance %></option><% } %></select>
                        <% } else if (typeof row[property.key] === 'boolean' || ['isOptional', 'isFullCoverage'].includes(property.key)) { %>
                          <select name="item_<%= field.name %>_<%= index %>_<%= property.key %>"><option value="1" <%= row[property.key] ? 'selected' : '' %>>Yes</option><option value="0" <%= row[property.key] ? '' : 'selected' %>>No</option></select>
                        <% } else if (/reason/i.test(property.key)) { %>
                          <textarea name="item_<%= field.name %>_<%= index %>_<%= property.key %>" rows="2" maxlength="1000"><%= row[property.key] ?? '' %></textarea>
                        <% } else { %>
                          <input name="item_<%= field.name %>_<%= index %>_<%= property.key %>" value="<%= row[property.key] ?? '' %>" maxlength="500">
                        <% } %>
                      </label>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </fieldset>
          <% } else if (field.options) { %>
            <label class="field"><span><%= field.label %></span><select name="field_<%= field.name %>" multiple size="<%= Math.min(6, Math.max(2, field.options.length)) %>">
              <% for (const option of field.options) { const values = (Array.isArray(field.values) ? field.values : [field.values]).map(String); %><option value="<%= option.value %>" <%= values.includes(String(option.value)) ? 'selected' : '' %>><%= option.label %></option><% } %>
            </select></label>
          <% } else { %>
            <fieldset class="finance-review-row-editor"><legend><%= field.label %></legend>
              <% for (let index = 0; index <= field.values.length; index += 1) { %>
                <label class="field"><span><%= field.label %> <%= index + 1 %></span><input name="item_<%= field.name %>_<%= index %>" value="<%= field.values[index] ?? '' %>" maxlength="100"></label>
              <% } %>
            </fieldset>
          <% } %>
        <% } %>
        <button class="button button--secondary" type="submit">Save draft changes</button>
      </form>
    </div>
  </details>

  <div class="finance-review-actions">
    <form method="post" action="/finance/review-drafts/<%= encodeURIComponent(draft.id) %>/commit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="revision" value="<%= draft.revision %>">
      <input type="hidden" name="dependencyFingerprint" value="<%= draft.dependencyFingerprint %>">
      <% if (draft.actionType === 'annual_assessment' && draft.preview.annualHandoffRequired) { %>
        <input type="hidden" name="financeAssessmentAttestation" value="1">
        <p class="finance-review-attestation">Approving confirms that you reviewed the approved fee schedule, selected options, and exact annual assessment shown above. Finance approval is recorded; Registrar confirms enrollment separately.</p>
        <label class="field"><span><input type="checkbox" name="zeroDpApproval" value="1"> If this entry-term DP is zero after approved waivers, I explicitly approve the zero-DP case.</span></label>
      <% } %>
      <button class="button button--primary" type="submit" <%= previewUnavailable || (draft.actionType === 'departure_review' && draft.preview.departureReviewReady !== true) ? 'disabled' : '' %>><%= draft.actionType === 'annual_assessment' ? (draft.preview.annualHandoffRequired ? 'Approve Finance assessment' : 'Post annual assessment') : draft.actionType === 'retake_item_decision' ? 'Save Finance decision' : 'Review complete · Save update' %></button>
    </form>
    <form method="post" action="/finance/review-drafts/<%= encodeURIComponent(draft.id) %>/discard">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button button--secondary" type="submit">Discard unfinished review</button>
    </form>
  </div>
</main>
<script src="/js/finance-departure-decisions.js" defer></script>
<%- include('../partials/foot') %>
