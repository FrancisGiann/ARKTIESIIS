<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page finance-roster-page" id="main-content">
  <% const rosterQuery = new URLSearchParams(); for (const key of ['search', 'schoolYear', 'termId', 'gradeLevel', 'sectionId', 'cluster', 'strand', 'voucherCode', 'status', 'financeStatus', 'installment', 'page']) { if (typeof filters[key] === 'string' && filters[key].trim()) rosterQuery.set(key, filters[key]); } %>
  <header class="dashboard-heading"><div><h1>Student accounts</h1><p>Search for a student, then open an account for a school year. A student may have more than one account here.</p></div></header>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>

  <section class="finance-panel" aria-labelledby="annual-roster-filter-title">
    <div class="admin-section__heading"><div><h2 id="annual-roster-filter-title">Find student accounts</h2><p>Search by student name, student number, or LRN, then narrow by school year or term.</p></div></div>
    <form class="finance-roster-filters" method="get" action="/finance">
      <div class="finance-roster-primary-filters">
        <div class="field"><label for="annual-roster-search">Student name, number, or LRN</label><input id="annual-roster-search" type="search" name="search" maxlength="100" value="<%= filters.search || '' %>" aria-describedby="annual-roster-search-help"><small id="annual-roster-search-help" class="muted-copy">Use the full LRN for a more precise match. Check the student identifiers before opening an account.</small></div>
        <div class="field"><label for="annual-roster-year">School year</label><select id="annual-roster-year" name="schoolYear"><option value="">All years</option><% for (const year of schoolYears) { %><option value="<%= year %>" <%= String(filters.schoolYear || '') === String(year) ? 'selected' : '' %>><%= year %></option><% } %></select></div>
        <div class="field"><label for="annual-roster-term">Term</label><select id="annual-roster-term" name="termId"><option value="">All terms</option><% for (const term of terms) { %><option value="<%= term.id %>" <%= String(filters.termId || '') === String(term.id) ? 'selected' : '' %>><%= term.label %></option><% } %></select></div>
        <button class="button button--primary" type="submit">Apply filters</button>
      </div>
      <% const hasExtraRosterFilters = Boolean(filters.gradeLevel || filters.sectionId || filters.cluster || filters.strand || filters.voucherCode || filters.status || filters.financeStatus || (filters.installment && filters.installment !== 'whole')); %>
      <details class="finance-roster-more-filters" <%= hasExtraRosterFilters ? 'open' : '' %>>
        <summary>More filters</summary>
        <div class="finance-roster-filter-grid">
          <div class="field"><label for="annual-roster-grade">Grade</label><select id="annual-roster-grade" name="gradeLevel"><option value="">All grades</option><% for (const grade of ['Grade 11', 'Grade 12']) { %><option value="<%= grade %>" <%= String(filters.gradeLevel || '') === grade ? 'selected' : '' %>><%= grade %></option><% } %></select></div>
          <div class="field"><label for="annual-roster-section">Section</label><select id="annual-roster-section" name="sectionId"><option value="">All sections</option><% for (const section of sections) { %><option value="<%= section.id %>" <%= String(filters.sectionId || '') === String(section.id) ? 'selected' : '' %>><%= section.label %><%= section.cluster ? ` · ${section.cluster}` : '' %><%= section.strand ? ` · ${section.strand}` : '' %></option><% } %></select></div>
          <div class="field"><label for="annual-roster-cluster">Cluster</label><input id="annual-roster-cluster" type="text" name="cluster" maxlength="100" value="<%= filters.cluster || '' %>"></div>
          <div class="field"><label for="annual-roster-strand">Strand</label><input id="annual-roster-strand" type="text" name="strand" maxlength="100" value="<%= filters.strand || '' %>"></div>
          <div class="field"><label for="annual-roster-voucher">Voucher type</label><select id="annual-roster-voucher" name="voucherCode"><option value="">All voucher types</option><% for (const voucher of ['PUB', 'ESC', 'NV']) { %><option value="<%= voucher %>" <%= String(filters.voucherCode || '') === voucher ? 'selected' : '' %>><%= voucher %></option><% } %></select></div>
          <div class="field"><label for="annual-roster-status">Placement status</label><select id="annual-roster-status" name="status"><option value="">All statuses</option><% for (const [value, label] of [['pending_payment','Pending activation'],['enrolled','Enrolled'],['cancelled','Cancelled'],['dropped','Dropped'],['transferred','Transferred']]) { %><option value="<%= value %>" <%= String(filters.status || '') === value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
          <div class="field"><label for="annual-roster-finance-status">Payment status</label><select id="annual-roster-finance-status" name="financeStatus"><option value="">All payment statuses</option><% for (const [value, label] of [['unpaid','Unpaid'],['partially_paid','Partially paid'],['fully_paid','Fully paid'],['no_payment_required','No payment required'],['needs_review','Payment status unavailable']]) { %><option value="<%= value %>" <%= String(filters.financeStatus || '') === value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
          <div class="field"><label for="annual-roster-installment">Payment period</label><select id="annual-roster-installment" name="installment"><% for (const [value, label] of [['whole','Entire term'],['dp','Down payment'],['prelim','Preliminary'],['midterm','Midterm'],['finals','Finals']]) { %><option value="<%= value %>" <%= String(filters.installment || 'whole') === value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
        </div>
      </details>
      <div class="finance-roster-filter-actions"><a class="table-action" href="/finance">Clear filters</a></div>
    </form>
  </section>

  <section class="finance-panel" aria-labelledby="annual-roster-results-title">
    <div class="admin-section__heading"><div><h2 id="annual-roster-results-title">Student accounts by school year</h2><p>Each row is one student’s account for one school year. Its balance includes all terms in that year, even when a term filter shows only matching placements. Open the account for balances across all years.</p></div></div>
    <% if (!rows.length) { %><p class="empty-state">No student accounts match these filters.</p><% } else { %>
      <% if (pagination) { %>
        <%
          const rosterPageHref = (pageNumber) => {
            const query = new URLSearchParams(rosterQuery);
            query.set('page', String(pageNumber));
            return `/finance?${query.toString()}`;
          };
        %>
        <div class="finance-roster-pagination">
          <p>Showing <strong><%= pagination.from %>–<%= pagination.to %></strong> of <strong><%= pagination.totalRecords %></strong> school-year accounts</p>
          <nav aria-label="School-year account pages">
            <% if (pagination.page > 1) { %><a class="button button--secondary" href="<%= rosterPageHref(pagination.page - 1) %>">Previous</a><% } else { %><span class="finance-roster-page-disabled" aria-disabled="true">Previous</span><% } %>
            <span>Page <%= pagination.page %> of <%= pagination.totalPages %></span>
            <% if (pagination.page < pagination.totalPages) { %><a class="button button--secondary" href="<%= rosterPageHref(pagination.page + 1) %>">Next</a><% } else { %><span class="finance-roster-page-disabled" aria-disabled="true">Next</span><% } %>
          </nav>
        </div>
      <% } else { %><p class="finance-roster-result-count"><%= rows.length %> matching school-year account<%= rows.length === 1 ? '' : 's' %></p><% } %>
      <div class="finance-roster-record-list">
        <% for (const row of rows) { %>
          <% const placements = Array.isArray(row.placements) ? row.placements : (row.enrollment_id ? [row] : []); %>
          <% const voucherNeedsReview = row.voucher_review_required === true || row.voucher_review_required === 1; %>
          <% const hasLegacyBalance = /[1-9]/.test(String(row.unattributed_legacy_balance || '0.00')); %>
          <% const hasOpeningLiability = /[1-9]/.test(String(row.opening_liability_due || '0.00')); %>
          <% const backParams = new URLSearchParams(); for (const key of rosterQuery.keys()) { if (key !== 'page') backParams.set(`back${key[0].toUpperCase()}${key.slice(1)}`, rosterQuery.get(key)); } %>
          <article class="finance-roster-record<%= hasLegacyBalance || hasOpeningLiability ? ' finance-roster-record--with-liabilities' : '' %><%= voucherNeedsReview ? ' finance-roster-record--with-voucher' : '' %>">
            <div class="finance-roster-record-head">
              <span class="finance-roster-identity"><strong><%= [row.first_name, row.middle_name, row.last_name, row.suffix].filter(Boolean).join(' ') %></strong><span>Student number: <%= row.student_no %></span><span>LRN: <%= row.lrn || 'Not recorded' %></span></span>
              <span class="finance-roster-context"><strong><%= row.school_year %> · <%= row.grade_level %></strong><span>Voucher type <%= row.voucher_code %> · <%= placements.length %> term placement<%= placements.length === 1 ? '' : 's' %></span></span>
              <span class="finance-roster-balance"><span>School-year balance</span><strong>₱<%= formatMoney(row.annual_balance) %></strong></span>
              <% if (hasLegacyBalance || hasOpeningLiability) { %><span class="finance-roster-liabilities"><% if (hasLegacyBalance) { %><span>Earlier account · ₱<%= formatMoney(row.unattributed_legacy_balance) %></span><% } %><% if (hasOpeningLiability) { %><span>Confirmed previous balance · ₱<%= formatMoney(row.opening_liability_due) %></span><% } %></span><% } %>
              <% if (voucherNeedsReview) { %><span class="finance-roster-voucher"><span>Voucher review</span><strong class="finance-review-flag">Required · assessed <%= row.assessed_voucher_code || 'voucher' %> / v<%= row.assessed_schedule_version || '?' %></strong></span><% } %>
              <a class="button button--secondary finance-roster-open-account" href="/finance/students/<%= row.student_id %>/annual<%= backParams.size ? `?${backParams.toString()}` : '' %>">Open student account</a>
            </div>
            <details class="finance-roster-record-details">
              <summary>View terms · <%= placements.length %> shown</summary>
            <div class="finance-roster-record-body">
              <dl class="finance-roster-record-financials">
                <div><dt>School-year balance · <%= row.school_year %></dt><dd>₱<%= formatMoney(row.annual_balance) %></dd></div>
                <div><dt>Earlier account balance</dt><dd>₱<%= formatMoney(row.unattributed_legacy_balance) %></dd></div>
                <div><dt>Confirmed previous balance</dt><dd>₱<%= formatMoney(row.opening_liability_due) %></dd></div>
                <div><dt>Voucher review</dt><dd><%= voucherNeedsReview ? 'Required' : 'No review flag' %></dd></div>
              </dl>
              <% if (voucherNeedsReview && row.voucher_review_reason) { %><p class="finance-review-flag">Review reason: <%= row.voucher_review_reason %></p><% } %>
              <% if (!placements.length) { %><p class="empty-state">No term placements are recorded for this annual enrollment.</p><% } else { %>
                <ul class="finance-roster-placement-list">
                  <% for (const placement of placements) { %>
                    <% const periodLabel = ({whole:'Entire term',dp:'Down payment',prelim:'Preliminary',midterm:'Midterm',finals:'Finals'})[String(filters.installment || 'whole').toLowerCase()] || 'Entire term'; %>
                    <li class="finance-roster-placement">
                      <div class="finance-roster-placement-context">
                        <% const numberedTerm = 'Term ' + placement.annual_term_number; %>
                        <strong><%= placement.term && String(placement.term).trim().toLowerCase() !== numberedTerm.toLowerCase() ? numberedTerm + ' · ' + placement.term : numberedTerm %></strong>
                        <% const modality = placement.modality === 'modular' ? (placement.modular_subtype ? `Modular · ${String(placement.modular_subtype).replaceAll('_', ' ')}` : 'Modular') : ({face_to_face:'Face-to-face',online:'Online',hybrid:'Hybrid'})[placement.modality] || String(placement.modality || '').replaceAll('_', ' '); %>
                        <span><%= placement.section_name || 'No section' %><%= placement.cluster ? ` · ${placement.cluster}` : '' %><%= placement.strand ? ` · ${placement.strand}` : '' %><%= modality ? ` · ${modality}` : '' %></span>
                        <span class="finance-status"><%= placement.enrollment_status === 'pending_payment' ? 'Pending activation' : String(placement.enrollment_status || 'unassigned').replaceAll('_', ' ').replace(/(^|\s)\S/g, (letter) => letter.toUpperCase()) %></span>
                      </div>
                      <% const trackingAvailable = Number(placement.tracking_available) === 1 || placement.tracking_available === true; %>
                      <dl class="finance-roster-placement-status">
                        <div><dt><%= periodLabel %> due</dt><dd><%= !trackingAvailable || placement.classified_due == null ? 'Unavailable or not assessed' : `₱${formatMoney(placement.classified_due)}` %></dd></div>
                        <div><dt>Required</dt><dd><%= !trackingAvailable || placement.classified_required == null ? 'Unavailable or not assessed' : `₱${formatMoney(placement.classified_required)}` %></dd></div>
                        <div><dt>Applied</dt><dd><%= !trackingAvailable || placement.classified_applied == null ? 'Unavailable or not assessed' : `₱${formatMoney(placement.classified_applied)}` %></dd></div>
                        <% const paymentStatus = paymentStatusPresentation({ ...placement, finance_status: placement.finance_status, matching_assessment_confirmation_id: placement.matching_assessment_confirmation_id }, filters.installment || 'whole'); %>
                        <div><dt>Payment status</dt><dd><%= paymentStatus.reason || paymentStatus.label %><% if (paymentStatus.guidance) { %><br><span class="muted-copy"><%= paymentStatus.guidance %></span><% } %></dd></div>
                        <% const earlierConfirmation = placement.matching_assessment_confirmation_id === null && placement.registrar_confirmation_id != null; %>
                        <div><dt>Registrar enrollment</dt><dd><%= placement.term_scope_status === 'not_applicable' ? 'Not applicable before entry term' : earlierConfirmation ? 'Earlier confirmation recorded' : placement.registrar_confirmation_id ? 'Confirmed by registrar' : 'Needs registrar confirmation' %></dd></div>
                        <div><dt>Term account clearance</dt><dd><%= placement.signed_clearance_status === 'signed' ? 'Recorded' : 'Not recorded' %></dd></div>
                      </dl>
                    </li>
                  <% } %>
                </ul>
              <% } %>
            </div>
            </details>
          </article>
        <% } %>
      </div>
    <% } %>
  </section>
</main>
<%- include('../partials/foot') %>
