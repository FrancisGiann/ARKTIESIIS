<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page finance-departures-page" id="main-content">
  <a class="context-back" href="/finance">Back to student accounts</a>
  <header class="dashboard-heading"><div><h1>Departure fee reviews</h1><p>Finance reviews the recorded case, effective date, fees, and balances. A scheduled future case does not change enrollment status before its effective date. Academic history and any remaining account debt stay on record.</p></div></header>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% if (!departures.length) { %><section class="finance-panel"><p class="empty-state">No departure cases are waiting for Finance review.</p></section><% } %>
  <div class="finance-departure-list">
    <% for (const departure of departures) { %>
      <%
        const chargeCount = departure.terms.reduce((count, term) => count + term.charges.length, 0);
        const recoveryPath = `/departure-cases/${departure.departure_case_id}/review`;
        const recovered = failedAction?.path === recoveryPath ? failedAction.input : {};
        const effectiveTermNumber = Number(departure.departure_term_number || 0);
        const parseCents = (value) => {
          const match = String(value ?? '').trim().match(/^(-?)(\d+)(?:\.(\d{1,2}))?$/);
          if (!match) return null;
          const cents = BigInt(match[2]) * 100n + BigInt((match[3] || '').padEnd(2, '0'));
          return match[1] ? -cents : cents;
        };
        const displayCents = (value) => {
          if (value == null) return 'Balance unavailable';
          const negative = value < 0n;
          const absolute = negative ? -value : value;
          const formatted = formatMoney(`${absolute / 100n}.${String(absolute % 100n).padStart(2, '0')}`);
          return negative ? `₱${formatted} credit` : `₱${formatted} due`;
        };
        const effectiveDate = departure.effective_date instanceof Date
          ? departure.effective_date.toISOString().slice(0, 10)
          : String(departure.effective_date).slice(0, 10);
      %>
      <details class="finance-departure-case" <%= failedAction?.path === recoveryPath ? 'open' : '' %>>
        <summary>
          <span class="finance-departure-identity"><strong><%= departure.student_name %></strong><span><%= departure.student_no %></span></span>
          <span class="finance-departure-type"><strong><%= departure.application_status === 'scheduled' ? `Scheduled · ${departure.departure_type === 'dropped' ? 'Stopped' : 'Transferred'}` : departure.application_status === 'needs_review' ? 'Needs Registrar review' : departure.application_status === 'legacy_applied' ? `Historical · ${departure.departure_type === 'dropped' ? 'Stopped' : 'Transferred'}` : departure.departure_type === 'dropped' ? 'Stopped' : 'Transferred' %></strong><time datetime="<%= effectiveDate %>">Effective <%= effectiveDate %></time></span>
          <span class="finance-departure-context"><strong><%= departure.school_year %> · <%= departure.grade_level %></strong><span>Departure placement: Term <%= effectiveTermNumber || 'unavailable' %> · <%= departure.terms.length %> affected terms · <%= chargeCount %> fees to review</span></span>
          <span class="finance-departure-review-cue">Review fees</span>
        </summary>
        <div class="finance-departure-case-body">
          <% if (departure.application_status === 'scheduled') { %><p><strong>Placement status:</strong> No enrollment status has changed yet. The departure will apply on <%= effectiveDate %> in Asia/Manila if its saved targets remain valid. Finance may review the recorded case now; this does not apply the placement update.</p>
          <% } else if (departure.application_status === 'needs_review') { %><p><strong>Placement status:</strong> This scheduled departure did not change placement statuses. <%= departure.application_review_message || 'The scheduled departure needs Registrar review before placement statuses can change.' %> Finance may still review the recorded case separately.</p>
          <% } else if (departure.application_status === 'legacy_applied') { %><p><strong>Placement history:</strong> This case predates scheduled departure tracking. Existing enrollment and Finance history was preserved; no earlier status changes were inferred.</p>
          <% } else { %><p><strong>Placement history:</strong> The Registrar departure has been applied. Academic activity flagged here includes assignments present when it was applied.</p><% } %>
          <p><strong>Registrar reason:</strong> <%= departure.reason %></p>
          <form class="form-stack" method="post" action="/finance/departure-cases/<%= departure.departure_case_id %>/review"<% if (failedAction?.path === recoveryPath) { %> data-unsaved-initially-dirty="true"<% } %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= departure.idempotencyKey %>">
            <div class="admin-section__heading"><div><h3>Saved departure and fee basis</h3><p>The saved Registrar effective placement determines the departure term. This first step opens a Finance review draft with proposed reductions for later recorded tuition installments; Finance then decides and records every fee individually.</p></div></div>
            <label class="field"><span>Last payable tuition installment in Term <%= effectiveTermNumber || 'unavailable' %></span><select name="cutoffInstallment" required>
              <option value="">Choose the last payable installment</option>
              <% for (const option of [{ value: 'none', label: 'None payable' }, { value: 'dp', label: 'DP' }, { value: 'prelim', label: 'Prelim' }, { value: 'midterm', label: 'Midterm' }, { value: 'finals', label: 'Finals' }]) { %><option value="<%= option.value %>" <%= recovered.cutoffInstallment === option.value ? 'selected' : '' %>><%= option.label %></option><% } %>
            </select></label>
            <p class="muted-copy">Exemptions and previous adjustments are already reflected in the current payable amount. Tuition is classified only by its fee category and recorded tuition installment; whole-term tuition is never split or estimated. Miscellaneous and named fees receive separate Finance keep/reduce decisions.</p>
            <div class="finance-departure-terms">
              <% for (const term of departure.terms) { %>
                <% if (!term.charges.length) { %>
                  <div class="finance-departure-term-status">
                    <strong>Term <%= term.annual_term_number %></strong>
                    <span>No annual charges are linked to this placement.</span>
                    <% if (term.academic_activity_review_required === true || term.academic_activity_review_required === 1) { %><span class="finance-review-flag">Academic activity exists; verify grade and schedule history separately.</span><% } %>
                  </div>
                <% } else { const termTotalCents = term.charges.reduce((total, charge) => { const amount = parseCents(charge.amount_due); return amount == null || total == null ? null : total + amount; }, 0n); %>
                  <details class="finance-departure-term" <%= Number(term.annual_term_number) === effectiveTermNumber ? 'open' : '' %>>
                    <summary><strong>Term <%= term.annual_term_number %></strong><span><%= term.charges.length %> fees · <%= displayCents(termTotalCents) %></span></summary>
                    <% if (term.academic_activity_review_required === true || term.academic_activity_review_required === 1) { %><p class="finance-review-flag">Academic activity exists in this affected placement; verify grade and schedule history separately.</p><% } %>
                    <div class="finance-departure-charge-list">
                      <% for (const charge of term.charges) { %>
                        <div class="finance-departure-charge">
                          <strong><%= charge.fee_category %> · <%= charge.line_name %><% if (charge.installment) { %> · <%= charge.installment %><% } %></strong>
                          <span>Current payable amount ₱<%= formatMoney(charge.payable_basis) %> · signed remaining balance <%= displayCents(parseCents(charge.amount_due)) %></span>
                        </div>
                      <% } %>
                    </div>
                  </details>
                <% } %>
              <% } %>
            </div>
            <label class="field"><span>Finance review reason</span><textarea name="reason" rows="3" maxlength="1000" required><%= recovered.reason || '' %></textarea></label>
            <button class="button button--primary" type="submit">Review cutoff and open Finance draft</button>
          </form>
        </div>
      </details>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
