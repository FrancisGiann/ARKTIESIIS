<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page" id="main-content">
  <a class="context-back" href="/finance">Back to annual finance roster</a>
  <header class="dashboard-heading"><div><p class="eyebrow">Finance · Approved student-payable rates</p><h1>Fee schedules</h1><p>Choose the school year, grade, and voucher context. Existing active rates are filled in as a starting point for a new version.</p></div></header>
  <% if (notice) { %><p class="form-success" role="status"><%= notice %></p><% } %>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <section class="finance-panel finance-schedule-context" aria-labelledby="schedule-context-title">
    <div class="admin-section__heading"><div><h2 id="schedule-context-title">1. Schedule context</h2><p>Schedule versions are separate for each voucher type.</p></div></div>
    <form class="admin-form-grid" method="get" action="/finance/schedules">
      <input type="hidden" name="voucherCode" value="<%= scheduleContext.voucherCode %>">
      <label class="field"><span>School year</span><input name="schoolYear" value="<%= scheduleContext.schoolYear %>" maxlength="20" placeholder="2026-2027"></label>
      <label class="field"><span>Grade</span><select name="gradeLevel"><option value="">Choose grade</option><% for (const grade of ['Grade 11','Grade 12']) { %><option value="<%= grade %>" <%= scheduleContext.gradeLevel === grade ? 'selected' : '' %>><%= grade %></option><% } %></select></label>
      <button class="button button--secondary" type="submit">Load schedule context</button>
    </form>
    <nav class="finance-schedule-voucher-tabs" aria-label="Voucher schedule tabs">
      <% for (const voucher of scheduleContext.voucherCodes) { const params = new URLSearchParams({ voucherCode: voucher }); if (scheduleContext.schoolYear) params.set('schoolYear', scheduleContext.schoolYear); if (scheduleContext.gradeLevel) params.set('gradeLevel', scheduleContext.gradeLevel); %>
        <a href="/finance/schedules?<%= params.toString() %>"<%= scheduleContext.voucherCode === voucher ? ' aria-current="page"' : '' %>><%= voucher %><span><%= scheduleContext.voucherCounts[voucher] %> version groups</span></a>
      <% } %>
    </nav>
  </section>
  <section class="finance-panel" aria-labelledby="active-schedule-title">
    <div class="admin-section__heading"><div><h2 id="active-schedule-title">2. Current approved amounts</h2><p><%= [scheduleContext.schoolYear, scheduleContext.gradeLevel, scheduleContext.voucherCode].filter(Boolean).join(' · ') %></p></div></div>
    <% if (scheduleContext.activeSchedule) { %>
      <p><strong>Active version <%= scheduleContext.activeSchedule.version_no %></strong><% if (scheduleContext.activeSchedule.created_at) { %> · saved <%= new Date(scheduleContext.activeSchedule.created_at).toLocaleDateString() %><% } %></p>
      <% if (scheduleForm.legacyWholeTermTuition) { %><p class="muted-copy">This schedule contains whole-term tuition totals. They remain visible above for reference. Enter approved installment amounts below; none are estimated from the old totals.</p><% } %>
      <div class="table-scroll" tabindex="0" aria-label="Active fee schedule amounts"><table class="admin-table"><thead><tr><th>Term</th><th>Fee</th><th>Installment</th><th>Amount</th><th>Selection</th></tr></thead><tbody>
        <% for (const line of scheduleContext.activeSchedule.lines) { %><tr><td data-label="Term">Term <%= line.term_number %></td><td data-label="Fee"><%= line.line_name %></td><td data-label="Installment"><%= line.installment %></td><td data-label="Amount">₱<%= formatMoney(line.amount) %></td><td data-label="Selection"><%= line.is_optional ? 'Optional' : 'Included' %></td></tr><% } %>
      </tbody></table></div>
    <% } else { %><p class="empty-state">No active schedule exists for this context. Start with staff-approved amounts for all 12 tuition lines.</p><% } %>
  </section>
  <section class="finance-panel" aria-labelledby="schedule-create-title">
    <details class="finance-schedule-create" <%= error ? 'open' : '' %>>
      <summary id="schedule-create-title">Create or revise this schedule</summary>
      <div class="finance-schedule-create-body">
        <p><strong>3. Enter fees</strong> · Review creates a private saved draft. The previous schedule stays active until the reviewed version is saved. Posted assessments keep their snapshot.</p>
        <% if (!scheduleContext.schoolYear || !scheduleContext.gradeLevel) { %>
          <p class="empty-state">Choose a school year and grade above to load this fee schedule.</p>
        <% } else { %>
    <form class="form-stack" method="post" action="/finance/schedules" data-finance-schedule-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="idempotencyKey" value="<%= idempotencyKey %>">
      <input type="hidden" name="schoolYear" value="<%= scheduleContext.schoolYear %>">
      <input type="hidden" name="gradeLevel" value="<%= scheduleContext.gradeLevel %>">
      <input type="hidden" name="voucherCode" value="<%= scheduleContext.voucherCode %>">
      <section class="finance-schedule-tuition" aria-labelledby="schedule-tuition-title">
        <div class="finance-schedule-tuition-heading"><h3 id="schedule-tuition-title">Tuition by term</h3><p>Enter staff-approved amounts for DP, Prelim, Midterm, and Finals. Use 0.00 when no tuition is payable. Voucher and workbook data do not set amounts.</p></div>
        <% for (const termNumber of [1, 2, 3]) { const termLines = scheduleForm.lines.filter((line) => line.isRequiredTuition && Number(line.termNumber) === termNumber); %>
          <details class="finance-schedule-term" name="schedule-term-fees" data-schedule-term="<%= termNumber %>" open>
            <summary><strong>Term <%= termNumber %></strong><span>4 tuition amounts</span></summary>
            <div class="finance-schedule-term-fields">
              <% for (const formLine of termLines) { const index = scheduleForm.lines.indexOf(formLine); %>
                <div class="finance-schedule-tuition-field" data-required-tuition-line>
                  <input type="hidden" name="termNumber" value="<%= formLine.termNumber %>"><input type="hidden" name="feeCategory" value="tuition"><input type="hidden" name="lineName" value="Tuition"><input type="hidden" name="installment" value="<%= formLine.installment %>">
                  <label for="line-amount-<%= index %>"><%= formLine.installment %></label>
                  <div class="finance-schedule-tuition-amount"><span aria-hidden="true">₱</span><input id="line-amount-<%= index %>" name="lineAmount" inputmode="decimal" maxlength="14" placeholder="0.00" aria-label="Term <%= termNumber %> tuition <%= formLine.installment %> amount in PHP" value="<%= formLine.amount %>" required></div>
                </div>
              <% } %>
            </div>
          </details>
        <% } %>
      </section>
      <% const additionalLines = scheduleForm.lines.filter((line) => !line.isRequiredTuition); %>
      <details class="finance-schedule-additional" <%= additionalLines.length ? 'open' : '' %>>
        <summary><strong>Additional fee lines</strong><span>Optional activities and other charges</span></summary>
        <div class="finance-schedule-additional-body">
          <div class="admin-section__heading"><div><h4>Other fees</h4><p>These lines stay separate from tuition. Optional lines are included in an assessment only when selected.</p></div><button class="button button--secondary" type="button" data-add-finance-line>Add fee line</button></div>
          <div class="table-scroll" tabindex="0" aria-label="Additional schedule fee lines">
            <table class="admin-table"><thead><tr><th>Term</th><th>Category</th><th>Fee name</th><th>Installment</th><th>Amount (PHP)</th><th>Optional</th><th></th></tr></thead>
              <tbody data-finance-line-rows>
                <% for (let index = 12; index < scheduleForm.lines.length; index += 1) { const formLine = scheduleForm.lines[index]; %>
                  <tr data-finance-line-row>
                    <td><label class="visually-hidden" data-label="Term" for="line-term-<%= index %>">Term for fee line <%= index - 11 %></label><select id="line-term-<%= index %>" name="termNumber" required><% if (formLine.termNumber && !['1', '2', '3'].includes(String(formLine.termNumber))) { %><option value="<%= formLine.termNumber %>" selected>Previous selection: <%= formLine.termNumber %></option><% } %><option value="" <%= !formLine.termNumber ? 'selected' : '' %>>Choose term</option><option value="1" <%= String(formLine.termNumber) === '1' ? 'selected' : '' %>>Term 1</option><option value="2" <%= String(formLine.termNumber) === '2' ? 'selected' : '' %>>Term 2</option><option value="3" <%= String(formLine.termNumber) === '3' ? 'selected' : '' %>>Term 3</option></select></td>
                    <td><label class="visually-hidden" data-label="Category" for="line-category-<%= index %>">Category for fee line <%= index - 11 %></label><select id="line-category-<%= index %>" name="feeCategory" required><% if (formLine.feeCategory && !['tuition','miscellaneous','uniform','id','activity','retake','other'].includes(formLine.feeCategory)) { %><option value="<%= formLine.feeCategory %>" selected>Previous selection: <%= formLine.feeCategory %></option><% } %><option value="" <%= !formLine.feeCategory ? 'selected' : '' %>>Choose category</option><% for (const category of ['tuition','miscellaneous','uniform','id','activity','retake','other']) { %><option value="<%= category %>" <%= formLine.feeCategory === category ? 'selected' : '' %>><%= category.replaceAll('_', ' ') %></option><% } %></select></td>
                    <td><label class="visually-hidden" data-label="Fee name" for="line-name-<%= index %>">Name for fee line <%= index - 11 %></label><input id="line-name-<%= index %>" name="lineName" maxlength="120" value="<%= formLine.lineName %>" required></td>
                    <td><label class="visually-hidden" data-label="Installment" for="line-installment-<%= index %>">Installment for fee line <%= index - 11 %></label><input id="line-installment-<%= index %>" name="installment" maxlength="40" placeholder="Prelim / Finals" value="<%= formLine.installment %>" required></td>
                    <td><label class="visually-hidden" data-label="Amount" for="line-amount-<%= index %>">Amount for fee line <%= index - 11 %></label><input id="line-amount-<%= index %>" name="lineAmount" inputmode="decimal" maxlength="14" placeholder="0.00" value="<%= formLine.amount %>" required></td>
                    <td><label><input type="checkbox" name="optionalIndex" value="<%= index %>" <%= formLine.isOptional ? 'checked' : '' %>> Optional</label></td>
                    <td><button class="button button--secondary" type="button" data-remove-finance-line aria-label="Remove fee line <%= index - 11 %>">Remove</button></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </details>
      <template data-finance-line-template>
        <tr data-finance-line-row>
          <td><label class="visually-hidden" data-label="Term">Term</label><select name="termNumber" required><option value="1">Term 1</option><option value="2">Term 2</option><option value="3">Term 3</option></select></td>
          <td><label class="visually-hidden" data-label="Category">Category</label><select name="feeCategory" required><option value="tuition">tuition</option><option value="miscellaneous">miscellaneous</option><option value="uniform">uniform</option><option value="id">id</option><option value="activity">activity</option><option value="retake">retake</option><option value="other">other</option></select></td>
          <td><label class="visually-hidden" data-label="Fee name">Fee name</label><input name="lineName" maxlength="120" required></td>
          <td><label class="visually-hidden" data-label="Installment">Installment</label><input name="installment" maxlength="40" required></td>
          <td><label class="visually-hidden" data-label="Amount">Amount</label><input name="lineAmount" inputmode="decimal" maxlength="14" required></td>
          <td><label><input type="checkbox" name="optionalIndex"> Optional</label></td>
          <td><button class="button button--secondary" type="button" data-remove-finance-line>Remove</button></td>
        </tr>
      </template>
      <button class="button button--primary" type="submit">Review new schedule version</button>
    </form>
        <% } %>
      </div>
    </details>
  </section>

  <section class="finance-panel" aria-labelledby="schedule-history-title">
    <div class="admin-section__heading"><div><h2 id="schedule-history-title">Previous versions · <%= scheduleContext.schoolYear %> · <%= scheduleContext.gradeLevel %> · <%= scheduleContext.voucherCode %></h2><p>Earlier versions are kept for history. New rates are saved as a separate reviewed version.</p></div></div>
    <% const scheduleGroups = new Map(); for (const row of schedules.filter((item) => item.voucher_code === scheduleContext.voucherCode && String(item.school_year) === String(scheduleContext.schoolYear) && item.grade_level === scheduleContext.gradeLevel && item.status !== 'active')) { if (!scheduleGroups.has(row.id)) scheduleGroups.set(row.id, { ...row, lines: [] }); if (row.line_id) scheduleGroups.get(row.id).lines.push(row); } %>
    <% if (!scheduleGroups.size) { %><p class="empty-state">No previous versions are available for this schedule context.</p><% } else { %>
      <div class="finance-schedule-version-list">
        <% for (const schedule of scheduleGroups.values()) { %>
          <details class="finance-schedule-version">
            <summary>
              <strong><%= schedule.school_year %> · <%= schedule.grade_level %> · <%= schedule.voucher_code %> · Version <%= schedule.version_no %></strong>
              <span class="finance-schedule-version-status finance-schedule-version-status--<%= schedule.status === 'active' ? 'active' : 'retired' %>"><%= schedule.status === 'active' ? 'Active' : 'Retired' %></span>
              <span><%= schedule.lines.length %> fee line<%= schedule.lines.length === 1 ? '' : 's' %><% if (schedule.created_at) { %> · Saved <%= new Date(schedule.created_at).toLocaleString() %><% } %></span>
            </summary>
            <div class="finance-schedule-version-body">
              <% if (schedule.lines.length) { %><div class="table-scroll" tabindex="0" aria-label="Fee lines for <%= schedule.school_year %> <%= schedule.grade_level %> <%= schedule.voucher_code %> version <%= schedule.version_no %>"><table class="admin-table"><thead><tr><th>Term</th><th>Fee</th><th>Installment</th><th>Category</th><th>Amount</th><th>Selection</th></tr></thead><tbody><% for (const line of schedule.lines) { %><tr><td data-label="Term">Term <%= line.term_number %></td><td data-label="Fee"><%= line.line_name %></td><td data-label="Installment"><%= line.installment %></td><td data-label="Category"><%= line.fee_category %></td><td data-label="Amount">₱<%= formatMoney(line.amount) %></td><td data-label="Selection"><%= line.is_optional ? 'Optional' : 'Included' %></td></tr><% } %></tbody></table></div><% } else { %><p class="empty-state">No fee lines are saved in this version.</p><% } %>
            </div>
          </details>
        <% } %>
      </div>
    <% } %>
  </section>
</main>
<script src="/js/finance-schedule-form.js" defer></script>
<%- include('../partials/foot') %>
