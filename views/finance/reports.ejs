<%- include('../partials/head', { title }) %>
<main class="page-shell dashboard-page finance-page finance-reports-page" id="main-content">
  <a class="context-back" href="/finance">Back to student accounts</a>
  <header class="dashboard-heading"><div><h1>Finance reports</h1><p>Choose one Finance task. Date filters apply to payments recorded, payment applications, or corrections; term balances show today’s account snapshot.</p></div></header>
  <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
  <% const reportViews = [['collections','Payments received'],['allocations','Payments applied'],['corrections','Corrections'],['term-balances','Term balances']]; %>
  <nav class="finance-report-tabs" aria-label="Finance report views">
    <% for (const [view, label] of reportViews) { const params = new URLSearchParams({ view, fromDate: filters.fromDate, toDate: filters.toDate }); %>
      <a class="finance-report-tab<%= filters.view === view ? ' is-current' : '' %>" href="/finance/reports?<%= params.toString() %>"<% if (filters.view === view) { %> aria-current="page"<% } %>><%= label %></a>
    <% } %>
  </nav>
  <section class="finance-panel finance-report-controls" aria-labelledby="report-range-title">
    <div class="admin-section__heading"><div><h2 id="report-range-title">Report date range</h2><p>Up to 367 calendar days.</p></div></div>
    <form class="finance-report-date-form" method="get" action="/finance/reports">
      <input type="hidden" name="view" value="<%= filters.view %>">
      <label class="field"><span>From actual payment date</span><input type="date" name="fromDate" value="<%= filters.fromDate %>" required></label>
      <label class="field"><span>Through actual payment date</span><input type="date" name="toDate" value="<%= filters.toDate %>" required></label>
      <div class="finance-report-date-form__actions"><button class="button button--primary" type="submit">Run reports</button></div>
    </form>
    <nav class="finance-report-quick-dates" aria-label="Quick report date range">
      <% for (const [label, from, to] of [['Today',today,today],['This week',weekStart,today],['This month',monthStart,today]]) { const params = new URLSearchParams({ view: filters.view, fromDate: from, toDate: to }); %>
        <a class="table-action" href="/finance/reports?<%= params.toString() %>"><%= label %></a>
      <% } %>
      <span>All report dates use Asia/Manila.</span>
    </nav>
  </section>
  <% if (report) { %>
    <% if (filters.view === 'collections') { %>
    <section class="finance-panel" aria-labelledby="daily-collections-title">
      <div class="admin-section__heading"><div><h2 id="daily-collections-title">Payments received by payment date · <%= report.fromDate %> to <%= report.toDate %></h2><p>Reversed payments are excluded. This shows payment amounts recorded on each date.</p></div></div>
      <dl class="finance-report-summary"><div><dt>Students who paid</dt><dd><%= report.collectionSummary.distinct_payers %></dd></div><div><dt>Payment amount</dt><dd>₱<%= formatMoney(report.collectionSummary.valid_collection_amount) %></dd></div><div><dt>Payment records</dt><dd><%= report.collectionSummary.payment_count %></dd></div></dl>
      <% if (!report.dailyCollections.length) { %><p class="empty-state">No non-reversed payments in this date range.</p><% } else { %>
        <div class="table-scroll" tabindex="0"><table class="admin-table"><thead><tr><th>Payment date</th><th>Students who paid</th><th>Payment records</th><th>Amount received</th></tr></thead><tbody>
          <% for (const row of report.dailyCollections) { const params = new URLSearchParams({ kind: 'collections', fromDate: row.collection_date, toDate: row.collection_date }); %><tr><td data-label="Payment date"><%= row.collection_date %></td><td data-label="Students who paid"><%= row.distinct_payers %></td><td data-label="Payment records"><a href="/finance/reports/details?<%= params.toString() %>"><%= row.payment_count %> records</a></td><td data-label="Amount received">₱<%= formatMoney(row.collected_amount) %></td></tr><% } %>
        </tbody></table></div>
      <% } %>
    </section>
    <% } %>
    <% if (filters.view === 'corrections') { %>
      <section class="finance-panel finance-report-reversals" aria-labelledby="reversal-records-title">
        <div class="finance-report-reversals__heading"><div><h2 id="reversal-records-title">Payment corrections by correction date · <%= report.fromDate %> to <%= report.toDate %></h2><p>These are corrections to recorded payments, not a refund report. The original amount is shown for reference and is not deducted twice.</p></div></div>
        <% if (!report.reversals.length) { %><p class="empty-state">No payment corrections in this date range.</p><% } else { %>
        <p class="finance-report-reversals__summary"><%= report.reversalSummary.distinct_payers %> students · <%= report.reversalSummary.reversal_count %> corrections · ₱<%= formatMoney(report.reversalSummary.corrected_record_amount) %> original payment amount referenced.</p>
        <div class="table-scroll" tabindex="0"><table class="admin-table"><thead><tr><th>Correction date</th><th>Students</th><th>Correction records</th><th>Original payments</th></tr></thead><tbody>
          <% for (const row of report.reversals) { const params = new URLSearchParams({ kind: 'corrections', fromDate: row.reversal_date, toDate: row.reversal_date }); %><tr><td data-label="Correction date"><%= row.reversal_date %></td><td data-label="Students"><%= row.distinct_payers %></td><td data-label="Correction records"><a href="/finance/reports/details?<%= params.toString() %>"><%= row.reversal_count %> records</a></td><td data-label="Original payments">₱<%= formatMoney(row.reversed_amount) %></td></tr><% } %>
        </tbody></table></div>
        <% } %>
      </section>
    <% } %>
    <% if (filters.view === 'allocations') { %>
    <section class="finance-panel" aria-labelledby="allocation-reports-title">
      <div class="admin-section__heading"><div><h2 id="allocation-reports-title">Payments applied by school year and fee</h2><p>Students are counted once per displayed group. One payment applied to more than one fee appears in each fee’s total.</p></div></div>
      <p>Payments applied in this range: <%= report.allocationSummary.distinct_payers %> students · ₱<%= formatMoney(report.allocationSummary.target_allocated_amount) %>. These are recorded payments applied to balances, not additional payments received.</p>
      <% const allocationParams = new URLSearchParams({ kind: 'allocations', fromDate: report.fromDate, toDate: report.toDate }); %>
      <p><a class="button button--secondary" href="/finance/reports/details?<%= allocationParams.toString() %>">View student and fee details</a></p>
      <% if (!report.allocationContexts.length) { %><p class="empty-state">No payments were applied to balances in this date range.</p><% } else { %>
        <div class="table-scroll" tabindex="0"><table class="admin-table"><thead><tr><th>Year · term</th><th>Section · strand</th><th>Voucher</th><th>Fee category</th><th>Students</th><th>Payments applied</th></tr></thead><tbody>
          <% for (const row of report.allocationContexts) { %><tr><td data-label="Year · term"><%= row.school_year %><%= row.annual_term_number ? ` · Term ${row.annual_term_number}` : '' %></td><td data-label="Section · strand"><%= row.section_name || '—' %><%= row.strand ? ` · ${row.strand}` : '' %></td><td data-label="Voucher"><%= row.voucher_code || '—' %></td><td data-label="Fee category"><%= row.fee_category %></td><td data-label="Students"><%= row.distinct_payers %></td><td data-label="Payments applied">₱<%= formatMoney(row.allocated_amount) %></td></tr><% } %>
        </tbody></table></div>
      <% } %>
    </section>
    <% } %>
    <% if (filters.view === 'term-balances') { %>
    <section class="finance-panel" aria-labelledby="term-progress-title">
      <div class="admin-section__heading"><div><h2 id="term-progress-title">Term enrollment and payment progress</h2><p>Current snapshot across all recorded annual placements; this section is not limited by the payment date range. Fully waived terms remain visible.</p></div></div>
      <% if (!report.termProgress.length) { %><p class="empty-state">No applicable annual placements are recorded.</p><% } else { %>
        <%
          const progressGroups = new Map();
          for (const row of report.termProgress) {
            const key = String(row.school_year) + '|' + String(row.annual_term_number);
            if (!progressGroups.has(key)) progressGroups.set(key, {
              school_year: row.school_year,
              annual_term_number: row.annual_term_number,
              rows: []
            });
            progressGroups.get(key).rows.push(row);
          }
        %>
        <div class="finance-term-progress-groups">
          <% for (const group of progressGroups.values()) { %>
            <details class="finance-term-progress-group">
              <summary><strong><%= group.school_year %> · Term <%= group.annual_term_number %></strong><span><%= group.rows.length %> grade, section, and voucher breakdowns</span></summary>
              <div class="table-scroll" tabindex="0" aria-label="<%= group.school_year %> Term <%= group.annual_term_number %> breakdowns">
                <table class="admin-table"><thead><tr><th>Grade</th><th>Section · strand</th><th>Voucher</th><th>Applicable placements</th><th>Enrolled</th><th>Paid or waived</th><th>Waived students</th><th>Outstanding</th><th>Waived amount</th></tr></thead><tbody>
                  <% for (const row of group.rows) { const rosterParams = new URLSearchParams({ schoolYear: row.school_year, termId: String(row.academic_term_id), gradeLevel: row.grade_level, voucherCode: row.voucher_code }); if (row.section_id) rosterParams.set('sectionId', String(row.section_id)); %><tr><td data-label="Grade"><%= row.grade_level %></td><td data-label="Section · strand"><a href="/finance?<%= rosterParams.toString() %>"><%= row.section_name || 'No section' %><%= row.strand ? ' · ' + row.strand : '' %></a></td><td data-label="Voucher"><%= row.voucher_code %></td><td data-label="Applicable placements"><%= row.applicable_enrollments %></td><td data-label="Enrolled"><%= row.enrolled_students %></td><td data-label="Paid or waived"><%= row.paid_or_waived_students %></td><td data-label="Waived students"><%= row.waived_students %></td><td data-label="Outstanding">₱<%= formatMoney(row.outstanding_amount) %></td><td data-label="Waived amount">₱<%= formatMoney(row.waived_amount) %></td></tr><% } %>
                </tbody></table>
              </div>
            </details>
          <% } %>
        </div>
      <% } %>
    </section>
    <% } %>
  <% } %>
</main>
<%- include('../partials/foot') %>
