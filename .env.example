NODE_ENV=development
PORT=3000
# Public application origin used in account confirmation and password reset emails.
APP_BASE_URL=http://localhost:3000
# Production requires a unique random secret with at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret
# Password-only authentication is a development-only Phase 2 path.
DEV_PASSWORD_ONLY_LOGIN=false
# Temporary production demo exception. Enable only for a dummy-data demo deployment.
# List only the five demo account emails, separated by commas; malformed or empty lists disable the exception.
DEMO_PASSWORD_ONLY_LOGIN=false
DEMO_PASSWORD_ONLY_EMAILS=

# MariaDB / Hostinger MySQL database credentials.
# Hostinger prefixes both values created in hPanel; copy them exactly.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Email / 2FA. Set a real SMTP host before using email login outside the gated dev bypass.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Set both SMTP_USER and SMTP_PASS when the mail server requires authentication.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ARKTIESIIS <no-reply@example.com>"

# Gemini field extraction. Student documents are sent to the configured Google Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000
DOCUMENT_PROCESSING_CONCURRENCY=2

# Uploads
MAX_UPLOAD_MB=10
DOCUMENT_STORAGE_DIR=storage/uploads
